// chart; RegisterChartLabel() then silently DROPPED new labels (including the
// entry text), so signals were computed but never appeared. Bumped and guarded.
#define QSMC_LABEL_MAX 512
// v6.5.2 AUDIT-01: maximum consecutive OnCalculate attempts that may be spent
