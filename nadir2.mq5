double   g_rm_sl_dist=0.0;
double   g_rm_sl_dist_atr=0.0;          // stop distance expressed in ATR, symbol-agnostic
double   g_rm_tp1=0.0;
double   g_rm_tp2=0.0;
double   g_rm_tp3=0.0;
double   g_rm_rr1=0.0;                  // reward:risk, NOT a probability
double   g_rm_rr2=0.0;
double   g_rm_rr3=0.0;
