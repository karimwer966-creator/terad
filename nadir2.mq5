void PMI_InitReplay(CausalReplayEngine &r)
{
   r.enabled=false;
   r.audits_run=0;
   r.bars_rederived=0;
   r.digests_stored=0;
   r.repaint_failures=0;
   r.lookahead_failures=0;
   r.causality_failures=0;
   r.digest_ring_head=0;
   r.last_audited_bar=-1;
   r.first_failure_detail="";
   r.last_report="not run";
   r.pass_repaint=true;
   r.pass_lookahead=true;
   r.pass_causality=true;
}

//====================================================================
// v6.5.3 ONE CANONICAL PRIOR-PERIOD REFERENCE (PDH / PDL / PWH / PWL)
//
// THE DEFECT THIS FIXES. The file carried TWO incompatible definitions of
// "the previous day/week":
//   (a) POSITION based  : iHigh/iLow/iClose/iTime(_Symbol,PERIOD_D1,1)
//                         (PMI ledger, ZRE candidate collector, S/R builder,
//                          target engine, g_d1_high/g_d1_low, top-down panel)
//   (b) BOUNDARY based  : "the last candle whose NEXT open is at or before the
//                         chart's closed decision boundary"
//                         (ScenarioPreviousClosedPeriod / MTEE window)
//
// A timeseries bar for a new period does not exist until the FIRST TICK of that
// period arrives, so (a) can point at the wrong candle on a weekend / session
// open / on any chart whose feed has not ticked, and (b) and (a) then disagree
// by a whole day. Worse, the two are evaluated per chart at different moments,
// so M5 could print one PDH/PDL pair while M15 printed another. The daily
// reference must be ONE value, identical on every timeframe.
//
// DEFINITION (single source of truth, closed-bar and causal):
//   the last D1 (W1) candle FULLY CLOSED by the chart's closed decision
//   boundary g_buf_t[closed+1]. Its high / low / close, its open time, the
//   first chart bar on which it became available (avail_bar) and the reason
//   string are published TOGETHER, so every consumer - the price level, the
//   level+availability in the PMI ledger, the S/R cluster, the target engine
//   and the zone age of a level-based ZRE candidate - reads the SAME record.
//
// avail_bar is clamped into [0,closed]: a level that closes exactly ON the
// boundary (its close time equals the forming bar's open) is a fact available
// AT the decision boundary, so its age is 0 bars, never "unknown".
//
// The position-based read survives ONLY as a fallback when CopyRates cannot
// serve the window, and any material disagreement between the two conventions
// is logged ONCE (per session) so a data-feed mismatch can never stay silent.
//====================================================================
struct SPriorPeriodRef
{
   bool      ok;             // a fully closed candle was found
   double    high;
   double    low;
   double    close;
   datetime  open_time;      // open time of the prior CLOSED candle
   datetime  close_time;     // its close boundary (== the next candle's open)
   int       avail_bar;      // first chart bar at/after close_time, clamped to closed
   bool      via_shift1;     // true only when the shift-1 fallback had to be used
   string    reason;         // human-readable provenance
};

#define QSMC_PRIORREF_SLOTS 6
ENUM_TIMEFRAMES g_priorref_tf[QSMC_PRIORREF_SLOTS];
datetime        g_priorref_boundary[QSMC_PRIORREF_SLOTS];
SPriorPeriodRef g_priorref_cache[QSMC_PRIORREF_SLOTS];
int             g_priorref_next=0;
bool            g_priorref_mismatch_logged=false;
bool            g_priorref_fallback_logged=false;

void QSMC_PriorRefInit(SPriorPeriodRef &r)
{
   r.ok=false;
   r.high=0.0; r.low=0.0; r.close=0.0;
   r.open_time=0; r.close_time=0;
   r.avail_bar=-1;
   r.via_shift1=false;
   r.reason="";
}

// Only a period whose NEXT candle opened at or before the decision boundary is
// fully closed. Timestamps are validated before any price is read, so a partial
// or mis-ordered history can never be published as a level.
bool QSMC_PriorClosedPeriodRaw(const ENUM_TIMEFRAMES tf,const datetime boundary,
                               const int closed,SPriorPeriodRef &out)
{
   QSMC_PriorRefInit(out);
   int sec=PeriodSeconds(tf);
   if(boundary<=0) { out.reason="NO_DATA - the closed chart boundary is unavailable"; return false; }
   if(sec<=0)      { out.reason="NO_DATA - timeframe duration is unavailable"; return false; }

   // Date-based CopyRates spans calendar time, not a count of trading bars, so
   // the window is padded for weekends / session gaps.
   long span64=(long)5*(long)sec+(long)3*86400;
   if(tf!=PERIOD_W1) span64=(span64*7)/5+(long)3*86400;
   long from64=(long)boundary-span64;
   if(from64<0) from64=0;
   long to64=(long)boundary+(long)sec;

   MqlRates rates[];
   ArraySetAsSeries(rates,false);
   int copied=CopyRates(_Symbol,tf,(datetime)from64,(datetime)to64,rates);

   int last=-1;
   if(copied>=2)
   {
      for(int i=0;i<copied-1;i++)
      {
         if(rates[i].time<=0) break;
         if(rates[i+1].time<=boundary) last=i;
         else break;
      }
   }
   if(last>=0 && last<ArraySize(rates))
   {
      double h=rates[last].high,l=rates[last].low;
      bool valid=(h>0.0 && l>0.0 && h>=l && rates[last].time>0 && rates[last+1].time>rates[last].time);
      if(valid)
      {
         out.ok=true;
         out.via_shift1=false;
         out.high=h; out.low=l; out.close=rates[last].close;
         out.open_time=rates[last].time;
         out.close_time=rates[last+1].time;
         int b=PMI_ChartBarForTime(out.close_time);
         if(b<0) b=closed;
         if(closed>=0 && b>closed) b=closed;
         out.avail_bar=b;
         out.reason=StringFormat("prior closed %s candle opened %s, fully closed by %s (chart boundary definition)",
                                 EnumToString(tf),TimeToString(out.open_time,TIME_DATE|TIME_MINUTES),
                                 TimeToString(out.close_time,TIME_DATE|TIME_MINUTES));
      }
   }

   if(!out.ok)
   {
      // FALLBACK ONLY: the historical position-based read.
      double sh=0.0,sl=0.0,sc=0.0;
      datetime so=0;
      if(tf==PERIOD_W1)
      { sh=iHigh(_Symbol,PERIOD_W1,1); sl=iLow(_Symbol,PERIOD_W1,1); sc=iClose(_Symbol,PERIOD_W1,1); so=iTime(_Symbol,PERIOD_W1,1); }
      else
      { sh=iHigh(_Symbol,PERIOD_D1,1); sl=iLow(_Symbol,PERIOD_D1,1); sc=iClose(_Symbol,PERIOD_D1,1); so=iTime(_Symbol,PERIOD_D1,1); }
      if(sh>0.0 && sl>0.0 && sh>=sl)
      {
         out.ok=true;
         out.via_shift1=true;
         out.high=sh; out.low=sl; out.close=sc;
         out.open_time=so;
         out.close_time=(so>0 ? so+(datetime)sec : 0);
         int b=PMI_ChartBarForTime(out.close_time);
         if(b<0) b=closed;
         if(closed>=0 && b>closed) b=closed;
         out.avail_bar=b;
         out.reason=StringFormat("prior closed %s candle via the shift-1 fallback (bounded window unavailable)",
                                 EnumToString(tf));
         if(!g_priorref_fallback_logged)
         {
            g_priorref_fallback_logged=true;
            Print("[DailyRef] ",EnumToString(tf)," could not be resolved from the bounded closed-candle window; ",
                  "the shift-1 fallback is in use. Reason logged once per attach session.");
         }
      }
      else
      {
         out.reason="NO_DATA - no fully closed "+EnumToString(tf)+
                    " candle by the chart boundary and the shift-1 fallback is unavailable";
         return false;
      }
   }

   // Cross-check (log only, authoritative value does not change): the two
   // conventions must agree in normal live conditions. If they do not, the feed
   // or the day boundary is the problem and that must be visible in the journal.
   if(out.ok && !out.via_shift1 && !g_priorref_mismatch_logged)
   {
      double sh=(tf==PERIOD_W1?iHigh(_Symbol,PERIOD_W1,1):iHigh(_Symbol,PERIOD_D1,1));
      double sl=(tf==PERIOD_W1?iLow(_Symbol,PERIOD_W1,1):iLow(_Symbol,PERIOD_D1,1));
      if(sh>0.0 && sl>0.0 && (MathAbs(sh-out.high)>_Point || MathAbs(sl-out.low)>_Point))
      {
         g_priorref_mismatch_logged=true;
         Print("[DailyRef] ",EnumToString(tf)," disagreement: chart-boundary prior candle H ",
               DoubleToString(out.high,_Digits)," L ",DoubleToString(out.low,_Digits)," (opened ",
               TimeToString(out.open_time,TIME_DATE|TIME_MINUTES),") vs shift 1 H ",
               DoubleToString(sh,_Digits)," L ",DoubleToString(sl,_Digits),
               ". The chart-boundary candle is authoritative and is now the SAME reference on every timeframe.");
      }
   }
   return out.ok;
}

// One cached record per (timeframe, chart boundary). The price levels, the
// availability bar and the zone age of a level therefore cannot disagree inside
// one closed bar, on any timeframe, at any point of the pipeline.
bool QSMC_PriorClosedPeriod(const ENUM_TIMEFRAMES tf,const int closed,SPriorPeriodRef &out)
{
   QSMC_PriorRefInit(out);
   int total=ArraySize(g_buf_t);
   if(closed<1 || closed+1>=total)
   { out.reason="NO_DATA - the closed chart boundary is unavailable"; return false; }
   datetime boundary=g_buf_t[closed+1];
   if(boundary<=0) { out.reason="NO_DATA - the closed chart boundary is unavailable"; return false; }
   for(int i=0;i<QSMC_PRIORREF_SLOTS;i++)
   {
      if(g_priorref_boundary[i]==boundary && g_priorref_tf[i]==tf)
      { out=g_priorref_cache[i]; return out.ok; }
   }
   SPriorPeriodRef r;
   bool ok=QSMC_PriorClosedPeriodRaw(tf,boundary,closed,r);
   int slot=g_priorref_next%QSMC_PRIORREF_SLOTS;
   g_priorref_cache[slot]=r;
   g_priorref_tf[slot]=tf;
   g_priorref_boundary[slot]=boundary;
   g_priorref_next=slot+1;
   out=r;
   return ok;
}

bool QSMC_PriorDayRef(const int closed,SPriorPeriodRef &out)
{
   return QSMC_PriorClosedPeriod(PERIOD_D1,closed,out);
}

bool QSMC_PriorWeekRef(const int closed,SPriorPeriodRef &out)
{
   return QSMC_PriorClosedPeriod(PERIOD_W1,closed,out);
}

// The chart's own last closed bar index (one definition, one place).
int QSMC_ClosedBar()
{
   int total=ArraySize(g_buf_t);
   if(total<2) return -1;
   return total-2;
}

//====================================================================
// PMI — SMALL DETERMINISTIC HELPERS
//====================================================================

// Integer min/max. MathMin/MathMax return double; using them on integer
// quantities would silently truncate and would raise MetaEditor's
// "possible loss of data due to type conversion" warning, so every integer
// bound in the PMI layer goes through these two helpers instead.
int PMI_IMin(const int a,const int b) { return (a<b ? a : b); }
int PMI_IMax(const int a,const int b) { return (a>b ? a : b); }

// Field-by-field copies. SPMILiquidity and StructureEvent own string members,
// and MQL5 does not allow copying structures that contain objects requiring
// initialization as a whole, so explicit copy helpers are used instead.
void PMI_CopyLevel(SPMILiquidity &dst,const SPMILiquidity &src)
{
   dst.id=src.id;
   dst.idText=src.idText;
   dst.type=src.type;
   dst.price=src.price;
   dst.creationTime=src.creationTime;
   dst.confirmationTime=src.confirmationTime;
   dst.availabilityTime=src.availabilityTime;
   dst.timeframe=src.timeframe;
   dst.strength=src.strength;
   dst.status=src.status;
   dst.originBar=src.originBar;
   dst.availabilityBar=src.availabilityBar;
   dst.is_external=src.is_external;
   dst.penetrationATR=src.penetrationATR;
   dst.lastTouchTime=src.lastTouchTime;
   dst.touches=src.touches;
}

void PMI_CopyPath(SPMIPricePath &dst,const SPMIPricePath &src)
{
   dst.pathId=src.pathId;
   dst.label=src.label;
   dst.direction=src.direction;
   dst.targetLiquidity=src.targetLiquidity;
   dst.targetLiquidityType=src.targetLiquidityType;
   dst.targetLiquidityId=src.targetLiquidityId;
   dst.invalidation=src.invalidation;
   dst.requiredCount=PMI_IMin(src.requiredCount,PMI_MAX_MISSING);
   for(int i=0;i<dst.requiredCount;i++) dst.requiredConditions[i]=src.requiredConditions[i];
   dst.satisfiedCount=PMI_IMin(src.satisfiedCount,PMI_MAX_MISSING);
   for(int i=0;i<dst.satisfiedCount;i++) dst.satisfiedConditions[i]=src.satisfiedConditions[i];
   dst.missingCount=PMI_IMin(src.missingCount,PMI_MAX_MISSING);
   for(int i=0;i<dst.missingCount;i++) dst.missingConditions[i]=src.missingConditions[i];
   dst.analogueCount=src.analogueCount;
   dst.mfeAvg=src.mfeAvg;
   dst.maeAvg=src.maeAvg;
   dst.rrAvg=src.rrAvg;
   dst.hitRate=src.hitRate;
   dst.hitRateSufficient=src.hitRateSufficient;
   dst.status=src.status;
   dst.statusText=src.statusText;
}

void PMI_CopyStructEvent(StructureEvent &dst,const StructureEvent &src)
{
   dst.id=src.id;
   dst.idText=src.idText;
   dst.timeframe=src.timeframe;
   dst.type=src.type;
   dst.direction=src.direction;
   dst.originTime=src.originTime;
   dst.confirmationTime=src.confirmationTime;
   dst.availabilityTime=src.availabilityTime;
   dst.brokenLevel=src.brokenLevel;
   dst.sourceSwingIndex=src.sourceSwingIndex;
   dst.confirmed=src.confirmed;
   dst.invalidated=src.invalidated;
   dst.originBar=src.originBar;
   dst.confirmationBar=src.confirmationBar;
   dst.stale_bars=src.stale_bars;
}

// Deterministic 64-bit digest of a string (two independent 32-bit hashes
// combined; fixed-point arithmetic only, identical on every platform).
ulong PMI_HashString(const string s)
{
   ulong h1=0x811C9DC5;              // FNV-1a 32-bit offset basis
   ulong h2=5381;
   int n=StringLen(s);
   for(int i=0;i<n;i++)
   {
      ulong ch=(ulong)(StringGetCharacter(s,i)&0xFF);
      h1=h1^ch;
      h1=(h1*(ulong)16777619)&0xFFFFFFFF;
      h2=((h2*33)+h1+ch)&0xFFFFFFFF;
   }
   return ((h1&0xFFFFFFFF)<<32)|(h2&0xFFFFFFFF);
}

ulong PMI_HashDoubleArray(const double &v[],const int count)
{
   ulong h=0;
   for(int i=0;i<count;i++)
   {
      string s=StringFormat("%.6g",v[i]);
      h^=PMI_HashString(s);
      h=(h*31)+1013904223;
   }
   return h;
}

// Deterministic code for a liquidity type name (used by the replay audit so
// re-derivation never depends on string comparison of stale names).
int PMI_LiquidityTypeCode(const string t)
{
   if(t=="BSL") return 1;
   if(t=="SSL") return 2;
   if(t=="EQH") return 3;
   if(t=="EQL") return 4;
   if(t=="PDH") return 5;
   if(t=="PDL") return 6;
   if(t=="PWH") return 7;
   if(t=="PWL") return 8;
   if(t=="SESS_H") return 9;
   if(t=="SESS_L") return 10;
   return 0;
}

string PMI_LiqStatusName(const ENUM_PMI_LIQ_STATUS s)
{
   if(s==PMI_LIQ_UNTOUCHED)   return "UNTOUCHED";
   if(s==PMI_LIQ_APPROACHED)  return "APPROACHED";
   if(s==PMI_LIQ_SWEPT)       return "SWEPT";
   if(s==PMI_LIQ_CONSUMED)    return "CONSUMED";
   return "INVALIDATED";
}

string PMI_TreeAxisName(const int axis)
{
   if(axis==PMI_AXIS_CONTEXT_DIR)  return "HTF DIRECTION";
   if(axis==PMI_AXIS_PREMIUM_DISC) return "PREMIUM/DISCOUNT";
   if(axis==PMI_AXIS_VOLATILITY)   return "VOLATILITY REGIME";
   if(axis==PMI_AXIS_SWEEP_DIR)    return "SWEEP DIRECTION";
   if(axis==PMI_AXIS_DISPLACEMENT) return "DISPLACEMENT STRENGTH";
   if(axis==PMI_AXIS_MSS)          return "MSS STATE";
   if(axis==PMI_AXIS_SESSION)      return "SESSION";
   if(axis==PMI_AXIS_STRUCTURE)    return "STRUCTURE STATE";
   return "TIME SEGMENT";
}

string PMI_RegimeName(const ENUM_PMI_REGIME r)
{
   if(r==PMI_REGIME_TREND_UP)    return "TREND UP";
   if(r==PMI_REGIME_TREND_DOWN)  return "TREND DOWN";
   if(r==PMI_REGIME_RANGE)       return "RANGE";
   if(r==PMI_REGIME_EXPANSION)   return "EXPANSION";
   if(r==PMI_REGIME_CONTRACTION) return "CONTRACTION";
   if(r==PMI_REGIME_CHOP)        return "CHOP";
   return "UNKNOWN";
}

string PMI_SessionName(const int s)
{
   if(s==PMI_SESS_ASIA)    return "ASIA";
   if(s==PMI_SESS_LONDON)  return "LONDON";
   if(s==PMI_SESS_OVERLAP) return "LONDON/NY OVERLAP";
   if(s==PMI_SESS_NEWYORK) return "NEW YORK";
   return "OFF";
}

string PMI_PathStatusName(const ENUM_PMI_PATH_STATUS s)
{
   if(s==PMI_PATH_ACTIVE)      return "ACTIVE";
   if(s==PMI_PATH_INVALIDATED) return "INVALIDATED";
   if(s==PMI_PATH_COMPLETED)   return "COMPLETED";
   return "WAITING";
}

string PMI_NoTradeText(const ENUM_PMI_NO_TRADE c)
{
   if(c==PMI_NT_INSUFFICIENT_HISTORY)   return "insufficient history";
   if(c==PMI_NT_DATA_QUALITY)           return "historical data quality";
   if(c==PMI_NT_HTF_CONFLICT)           return "HTF conflict";
   if(c==PMI_NT_NO_LIQUIDITY)           return "no meaningful liquidity";
   if(c==PMI_NT_SWEEP_WITHOUT_DISPLACE) return "sweep without displacement";
   if(c==PMI_NT_DISPLACE_WITHOUT_MSS)   return "displacement without Core structure";
   if(c==PMI_NT_MSS_WITHOUT_ZONE)       return "Core structure without valid OB/FVG";
   if(c==PMI_NT_ZONE_INVALIDATED)       return "OB/FVG invalidated";
   if(c==PMI_NT_RETEST_MISSING)         return "retest missing";
   if(c==PMI_NT_LTF_CONFIRM_MISSING)    return "LTF confirmation missing";
   if(c==PMI_NT_POOR_RR)                return "poor reward/risk geometry";
   if(c==PMI_NT_INSUFFICIENT_SAMPLE)    return "insufficient historical sample";
   if(c==PMI_NT_CONFLICTING_PATHS)      return "conflicting conditional paths";
   if(c==PMI_NT_CAUSAL_ORDER_BROKEN)    return "causal order broken";
   return "";
}

// PMI_STRUCT_DEDUPE_CORE_BEGIN
//====================================================================
// PMI — STRUCTURE DEDUPE INDEX CORE
// The original equality is direction + timeframe slot + originTime.
// The configured ring is the dedupe horizon; the full output ledger remains
// unchanged. A ring eviction expires that key from duplicate suppression.
//====================================================================
#define PMI_STRUCT_DEDUPE_ORIGIN_MASK ((ulong)0x0FFFFFFFFFFFFFFF)
struct SPMIStructDedupeEntry
{
   ulong key;
   int   prev;
   int   next;
   bool  used;
};
struct SPMIStructDedupeBucket
{
   ulong key;
   int   head;
   int   tail;
   bool  used;
};
SPMIStructDedupeEntry  g_pmi_struct_dedupe_ring[];
SPMIStructDedupeBucket g_pmi_struct_dedupe_buckets[];
int  g_pmi_struct_dedupe_capacity=0;
int  g_pmi_struct_dedupe_table_size=0;
int  g_pmi_struct_dedupe_ring_mask=0;
int  g_pmi_struct_dedupe_table_mask=0;
int  g_pmi_struct_dedupe_write=0;
int  g_pmi_struct_dedupe_count=0;
bool g_pmi_struct_dedupe_ready=false;

// Clamp the user setting, then round UP to a power of two. The maximum
// remains 65,536; the corresponding table is exactly twice that size.
int PMI_StructDedupeEffectiveCapacity(const int requested)
{
   int clamped=requested;
   if(clamped<128) clamped=128;
   if(clamped>65536) clamped=65536;
   int capacity=128;
   while(capacity<clamped && capacity<65536) capacity*=2;
   return capacity;
}

// Pack the source comparator into 64 bits: direction polarity (1 bit),
// timeframe slot (3 bits for the 8 PMI timeframes), and stable originTime
// (60 bits). MQL5 datetime values from closed market bars are non-negative
// and far below 2^60; out-of-domain values use the legacy scan instead.
ulong PMI_StructDedupePackKey(const int tf_slot,const datetime origin_time,
                              const int direction,bool &valid_out)
{
   valid_out=false;
   if(tf_slot<0 || tf_slot>=PMI_TF_COUNT ||
      (direction!=-1 && direction!=1) || origin_time<0) return 0;
   ulong time_value=(ulong)origin_time;
   if(time_value>PMI_STRUCT_DEDUPE_ORIGIN_MASK) return 0;
   ulong direction_bit=(direction>0 ? (ulong)1 : (ulong)0);
   ulong timeframe_bits=(ulong)tf_slot;
   valid_out=true;
   return (direction_bit<<63) | (timeframe_bits<<60) | time_value;
}

// SplitMix64 finalizer: the golden-ratio increment and the two odd
// avalanche multipliers decorrelate every input bit, including low bits,
// before masking into a power-of-two table.
ulong PMI_StructDedupeMix64(const ulong key)
{
   ulong mixed=key+(ulong)0x9E3779B97F4A7C15;
   mixed=(mixed^(mixed>>30))*(ulong)0xBF58476D1CE4E5B9;
   mixed=(mixed^(mixed>>27))*(ulong)0x94D049BB133111EB;
   return mixed^(mixed>>31);
}

int PMI_StructDedupeFindBucket(const ulong key)
{
   if(g_pmi_struct_dedupe_table_size<=0 ||
      ArraySize(g_pmi_struct_dedupe_buckets)!=g_pmi_struct_dedupe_table_size) return -1;
   int slot=(int)(PMI_StructDedupeMix64(key)&(ulong)g_pmi_struct_dedupe_table_mask);
   for(int probes=0;probes<g_pmi_struct_dedupe_table_size;probes++)
   {
      if(!g_pmi_struct_dedupe_buckets[slot].used) return -1;
      if(g_pmi_struct_dedupe_buckets[slot].key==key) return slot;
      slot=(slot+1)&g_pmi_struct_dedupe_table_mask;
   }
   return -1;
}

bool PMI_StructDedupeContainsKey(const ulong key)
{
   int bucket=PMI_StructDedupeFindBucket(key);
   if(bucket<0) return false;
   int entry=g_pmi_struct_dedupe_buckets[bucket].head;
   for(int traversed=0;entry>=0 && traversed<g_pmi_struct_dedupe_capacity;traversed++)
   {
      if(entry>=g_pmi_struct_dedupe_capacity || !g_pmi_struct_dedupe_ring[entry].used) return false;
      if(g_pmi_struct_dedupe_ring[entry].key==key) return true;
      entry=g_pmi_struct_dedupe_ring[entry].next;
   }
   return false;
}

// Linear reference path for differential testing. It scans exactly the same
// live recent window as the indexed path, including after wrap-around.
bool PMI_StructDedupeContainsLinearWindow(const ulong key)
{
   if(g_pmi_struct_dedupe_capacity<=0 || g_pmi_struct_dedupe_count<=0) return false;
   int oldest=(g_pmi_struct_dedupe_write-g_pmi_struct_dedupe_count)&g_pmi_struct_dedupe_ring_mask;
   for(int offset=0;offset<g_pmi_struct_dedupe_count;offset++)
   {
      int slot=(oldest+offset)&g_pmi_struct_dedupe_ring_mask;
      if(g_pmi_struct_dedupe_ring[slot].used && g_pmi_struct_dedupe_ring[slot].key==key) return true;
   }
   return false;
}

void PMI_StructDedupeClearIndex()
{
   g_pmi_struct_dedupe_write=0;
   g_pmi_struct_dedupe_count=0;
   for(int i=0;i<ArraySize(g_pmi_struct_dedupe_ring);i++)
   {
      g_pmi_struct_dedupe_ring[i].key=0;
      g_pmi_struct_dedupe_ring[i].prev=-1;
      g_pmi_struct_dedupe_ring[i].next=-1;
      g_pmi_struct_dedupe_ring[i].used=false;
   }
   for(int i=0;i<ArraySize(g_pmi_struct_dedupe_buckets);i++)
   {
      g_pmi_struct_dedupe_buckets[i].key=0;
      g_pmi_struct_dedupe_buckets[i].head=-1;
      g_pmi_struct_dedupe_buckets[i].tail=-1;
      g_pmi_struct_dedupe_buckets[i].used=false;
   }
}

// Backward-shift deletion. The modular distance test moves an entry only
// when the hole lies on that key's probe path; no tombstones are retained.
void PMI_StructDedupeRemoveBucket(const int removed_bucket)
{
   if(removed_bucket<0 || removed_bucket>=g_pmi_struct_dedupe_table_size ||
      !g_pmi_struct_dedupe_buckets[removed_bucket].used) return;
   int hole=removed_bucket;
   int scan=(hole+1)&g_pmi_struct_dedupe_table_mask;
   while(g_pmi_struct_dedupe_buckets[scan].used)
   {
      ulong mixed=PMI_StructDedupeMix64(g_pmi_struct_dedupe_buckets[scan].key);
      int home=(int)(mixed&(ulong)g_pmi_struct_dedupe_table_mask);
      int hole_distance=(hole-home)&g_pmi_struct_dedupe_table_mask;
      int scan_distance=(scan-home)&g_pmi_struct_dedupe_table_mask;
      if(hole_distance<scan_distance)
      {
         g_pmi_struct_dedupe_buckets[hole].key=g_pmi_struct_dedupe_buckets[scan].key;
         g_pmi_struct_dedupe_buckets[hole].head=g_pmi_struct_dedupe_buckets[scan].head;
         g_pmi_struct_dedupe_buckets[hole].tail=g_pmi_struct_dedupe_buckets[scan].tail;
         g_pmi_struct_dedupe_buckets[hole].used=true;
         g_pmi_struct_dedupe_buckets[scan].key=0;
         g_pmi_struct_dedupe_buckets[scan].head=-1;
         g_pmi_struct_dedupe_buckets[scan].tail=-1;
         g_pmi_struct_dedupe_buckets[scan].used=false;
         hole=scan;
      }
      scan=(scan+1)&g_pmi_struct_dedupe_table_mask;
   }
   g_pmi_struct_dedupe_buckets[hole].key=0;
   g_pmi_struct_dedupe_buckets[hole].head=-1;
   g_pmi_struct_dedupe_buckets[hole].tail=-1;
   g_pmi_struct_dedupe_buckets[hole].used=false;
}

// Remove one ring node from its intrusive key chain. Chain pointer updates
// are O(1); locating the bucket is O(1) average via linear probing.
bool PMI_StructDedupeUnlinkSlot(const int ring_slot)
{
   if(ring_slot<0 || ring_slot>=g_pmi_struct_dedupe_capacity ||
      !g_pmi_struct_dedupe_ring[ring_slot].used) return false;
   int bucket=PMI_StructDedupeFindBucket(g_pmi_struct_dedupe_ring[ring_slot].key);
   if(bucket<0) return false;
   int previous=g_pmi_struct_dedupe_ring[ring_slot].prev;
   int next=g_pmi_struct_dedupe_ring[ring_slot].next;
   if(previous>=0 && (previous>=g_pmi_struct_dedupe_capacity ||
      !g_pmi_struct_dedupe_ring[previous].used ||
      g_pmi_struct_dedupe_ring[previous].next!=ring_slot)) return false;
   if(next>=0 && (next>=g_pmi_struct_dedupe_capacity ||
      !g_pmi_struct_dedupe_ring[next].used ||
      g_pmi_struct_dedupe_ring[next].prev!=ring_slot)) return false;
   if(previous<0 && g_pmi_struct_dedupe_buckets[bucket].head!=ring_slot) return false;
   if(next<0 && g_pmi_struct_dedupe_buckets[bucket].tail!=ring_slot) return false;
   if(previous>=0) g_pmi_struct_dedupe_ring[previous].next=next;
   else            g_pmi_struct_dedupe_buckets[bucket].head=next;
   if(next>=0) g_pmi_struct_dedupe_ring[next].prev=previous;
   else        g_pmi_struct_dedupe_buckets[bucket].tail=previous;
   g_pmi_struct_dedupe_ring[ring_slot].key=0;
   g_pmi_struct_dedupe_ring[ring_slot].prev=-1;
   g_pmi_struct_dedupe_ring[ring_slot].next=-1;
   g_pmi_struct_dedupe_ring[ring_slot].used=false;
   if(g_pmi_struct_dedupe_buckets[bucket].head<0)
   {
      if(g_pmi_struct_dedupe_buckets[bucket].tail>=0) return false;
      PMI_StructDedupeRemoveBucket(bucket);
   }
   return true;
}

// Insert a raw key (duplicates are allowed here for rebuild/testing); the
// production caller checks ContainsKey first. The ring overwrites its oldest
// slot, unlinks it, and appends the replacement to the key chain tail.
bool PMI_StructDedupeInsertRaw(const ulong key)
{
   if(g_pmi_struct_dedupe_capacity<=0 || g_pmi_struct_dedupe_table_size<=0 ||
      ArraySize(g_pmi_struct_dedupe_ring)!=g_pmi_struct_dedupe_capacity ||
      ArraySize(g_pmi_struct_dedupe_buckets)!=g_pmi_struct_dedupe_table_size) return false;
   int ring_slot=g_pmi_struct_dedupe_write;
   bool was_full=(g_pmi_struct_dedupe_count==g_pmi_struct_dedupe_capacity);
   if(was_full)
   {
      if(!PMI_StructDedupeUnlinkSlot(ring_slot)) return false;
   }
   else if(g_pmi_struct_dedupe_ring[ring_slot].used) return false;
   int bucket=PMI_StructDedupeFindBucket(key);
   if(bucket<0)
   {
      int probe=(int)(PMI_StructDedupeMix64(key)&(ulong)g_pmi_struct_dedupe_table_mask);
      for(int probes=0;probes<g_pmi_struct_dedupe_table_size;probes++)
      {
         if(!g_pmi_struct_dedupe_buckets[probe].used)
         {
            bucket=probe;
            g_pmi_struct_dedupe_buckets[bucket].key=key;
            g_pmi_struct_dedupe_buckets[bucket].head=-1;
            g_pmi_struct_dedupe_buckets[bucket].tail=-1;
            g_pmi_struct_dedupe_buckets[bucket].used=true;
            break;
         }
         probe=(probe+1)&g_pmi_struct_dedupe_table_mask;
      }
   }
   if(bucket<0) return false;
   int old_tail=g_pmi_struct_dedupe_buckets[bucket].tail;
   g_pmi_struct_dedupe_ring[ring_slot].key=key;
   g_pmi_struct_dedupe_ring[ring_slot].prev=old_tail;
   g_pmi_struct_dedupe_ring[ring_slot].next=-1;
   g_pmi_struct_dedupe_ring[ring_slot].used=true;
   if(old_tail>=0) g_pmi_struct_dedupe_ring[old_tail].next=ring_slot;
   else            g_pmi_struct_dedupe_buckets[bucket].head=ring_slot;
   g_pmi_struct_dedupe_buckets[bucket].tail=ring_slot;
   if(!was_full) g_pmi_struct_dedupe_count++;
   g_pmi_struct_dedupe_write=(ring_slot+1)&g_pmi_struct_dedupe_ring_mask;
   return true;
}

bool PMI_StructDedupeReset(const int requested_capacity)
{
   g_pmi_struct_dedupe_ready=false;
   int capacity=PMI_StructDedupeEffectiveCapacity(requested_capacity);
   int table_size=capacity*2;
   int ring_resize=ArrayResize(g_pmi_struct_dedupe_ring,capacity,capacity);
   int table_resize=ArrayResize(g_pmi_struct_dedupe_buckets,table_size,table_size);
   if(ring_resize!=capacity || table_resize!=table_size)
   {
      ArrayResize(g_pmi_struct_dedupe_ring,0,0);
      ArrayResize(g_pmi_struct_dedupe_buckets,0,0);
      g_pmi_struct_dedupe_capacity=0;
      g_pmi_struct_dedupe_table_size=0;
      g_pmi_struct_dedupe_ring_mask=0;
      g_pmi_struct_dedupe_table_mask=0;
      g_pmi_struct_dedupe_write=0;
      g_pmi_struct_dedupe_count=0;
      return false;
   }
   g_pmi_struct_dedupe_capacity=capacity;
   g_pmi_struct_dedupe_table_size=table_size;
   g_pmi_struct_dedupe_ring_mask=capacity-1;
   g_pmi_struct_dedupe_table_mask=table_size-1;
   PMI_StructDedupeClearIndex();
   g_pmi_struct_dedupe_ready=true;
   return true;
}

// Expensive invariant checker is exercised by the g++ harness, not on ticks.
bool PMI_StructDedupeCheckInvariants()
{
   if(g_pmi_struct_dedupe_capacity<128 || g_pmi_struct_dedupe_capacity>65536 ||
      (g_pmi_struct_dedupe_capacity&(g_pmi_struct_dedupe_capacity-1))!=0 ||
      g_pmi_struct_dedupe_table_size!=g_pmi_struct_dedupe_capacity*2 ||
      (g_pmi_struct_dedupe_table_size&(g_pmi_struct_dedupe_table_size-1))!=0 ||
      g_pmi_struct_dedupe_ring_mask!=g_pmi_struct_dedupe_capacity-1 ||
      g_pmi_struct_dedupe_table_mask!=g_pmi_struct_dedupe_table_size-1 ||
      g_pmi_struct_dedupe_count<0 || g_pmi_struct_dedupe_count>g_pmi_struct_dedupe_capacity ||
      g_pmi_struct_dedupe_write<0 || g_pmi_struct_dedupe_write>=g_pmi_struct_dedupe_capacity) return false;
   int live_count=0;
   int bucket_count=0;
   for(int i=0;i<g_pmi_struct_dedupe_capacity;i++)
   {
      if(!g_pmi_struct_dedupe_ring[i].used)
      {
         if(g_pmi_struct_dedupe_ring[i].prev!=-1 || g_pmi_struct_dedupe_ring[i].next!=-1) return false;
         continue;
      }
      live_count++;
      int bucket=PMI_StructDedupeFindBucket(g_pmi_struct_dedupe_ring[i].key);
      if(bucket<0 || g_pmi_struct_dedupe_buckets[bucket].key!=g_pmi_struct_dedupe_ring[i].key) return false;
      int previous=g_pmi_struct_dedupe_ring[i].prev;
      int next=g_pmi_struct_dedupe_ring[i].next;
      if(previous<0)
      {
         if(g_pmi_struct_dedupe_buckets[bucket].head!=i) return false;
      }
      else if(previous>=g_pmi_struct_dedupe_capacity ||
              !g_pmi_struct_dedupe_ring[previous].used ||
              g_pmi_struct_dedupe_ring[previous].key!=g_pmi_struct_dedupe_ring[i].key ||
              g_pmi_struct_dedupe_ring[previous].next!=i) return false;
      if(next<0)
      {
         if(g_pmi_struct_dedupe_buckets[bucket].tail!=i) return false;
      }
      else if(next>=g_pmi_struct_dedupe_capacity ||
              !g_pmi_struct_dedupe_ring[next].used ||
              g_pmi_struct_dedupe_ring[next].key!=g_pmi_struct_dedupe_ring[i].key ||
              g_pmi_struct_dedupe_ring[next].prev!=i) return false;
   }
   for(int i=0;i<g_pmi_struct_dedupe_table_size;i++)
   {
      if(!g_pmi_struct_dedupe_buckets[i].used)
      {
         if(g_pmi_struct_dedupe_buckets[i].head!=-1 || g_pmi_struct_dedupe_buckets[i].tail!=-1) return false;
         continue;
      }
      bucket_count++;
      if(g_pmi_struct_dedupe_buckets[i].head<0 || g_pmi_struct_dedupe_buckets[i].tail<0 ||
         PMI_StructDedupeFindBucket(g_pmi_struct_dedupe_buckets[i].key)!=i) return false;
      int probe=(int)(PMI_StructDedupeMix64(g_pmi_struct_dedupe_buckets[i].key)&(ulong)g_pmi_struct_dedupe_table_mask);
      int steps=0;
      while(probe!=i && steps<g_pmi_struct_dedupe_table_size)
      {
         if(!g_pmi_struct_dedupe_buckets[probe].used) return false;
         probe=(probe+1)&g_pmi_struct_dedupe_table_mask;
         steps++;
      }
      if(probe!=i) return false;
      int entry=g_pmi_struct_dedupe_buckets[i].head;
      int previous=-1;
      int chain_count=0;
      while(entry>=0 && chain_count<g_pmi_struct_dedupe_capacity)
      {
         if(entry>=g_pmi_struct_dedupe_capacity || !g_pmi_struct_dedupe_ring[entry].used ||
            g_pmi_struct_dedupe_ring[entry].key!=g_pmi_struct_dedupe_buckets[i].key ||
            g_pmi_struct_dedupe_ring[entry].prev!=previous) return false;
         previous=entry;
         entry=g_pmi_struct_dedupe_ring[entry].next;
         chain_count++;
      }
      if(entry>=0 || previous!=g_pmi_struct_dedupe_buckets[i].tail) return false;
   }
   return live_count==g_pmi_struct_dedupe_count && bucket_count<=live_count;
}
// PMI_STRUCT_DEDUPE_CORE_END

int PMI_StructDedupeTimeframeSlot(const ENUM_TIMEFRAMES tf)
{
   for(int slot=0;slot<PMI_TF_COUNT;slot++)
      if(PMI_TFAt(slot)==tf) return slot;
   return -1;
}

// Exact pre-index source scan, retained as the allocation-failure fallback.
bool PMI_StructDedupeLegacyScan(const int tf_slot,const datetime origin_time,
                                const int direction)
{
   if(tf_slot<0 || tf_slot>=PMI_TF_COUNT) return false;
   ENUM_TIMEFRAMES tf=PMI_TFAt(tf_slot);
   int nlev=ArraySize(g_pmi_structs);
   for(int q=nlev-1;q>=0;q--)
   {
      if(g_pmi_structs[q].timeframe!=tf) continue;
      if(g_pmi_structs[q].originTime<origin_time) break;
      if(g_pmi_structs[q].originTime==origin_time &&
         g_pmi_structs[q].direction==direction) return true;
   }
   return false;
}

bool PMI_StructDedupeIsDuplicate(const int tf_slot,const datetime origin_time,
                                 const int direction)
{
   bool valid_key=false;
   ulong key=PMI_StructDedupePackKey(tf_slot,origin_time,direction,valid_key);
   if(!valid_key || !g_pmi_struct_dedupe_ready)
      return PMI_StructDedupeLegacyScan(tf_slot,origin_time,direction);
// Test builds can select either the original all-history scan or the linear
// reference over the configured bounded window.
#ifdef PMI_STRUCT_DEDUPE_LEGACY_REFERENCE_SCAN
   return PMI_StructDedupeLegacyScan(tf_slot,origin_time,direction);
#else
#ifdef PMI_STRUCT_DEDUPE_REFERENCE_SCAN
   return PMI_StructDedupeContainsLinearWindow(key);
#else
   return PMI_StructDedupeContainsKey(key);
#endif
#endif
}

void PMI_StructDedupeRecord(const int tf_slot,const datetime origin_time,
                            const int direction)
{
   if(!g_pmi_struct_dedupe_ready) return;
   bool valid_key=false;
   ulong key=PMI_StructDedupePackKey(tf_slot,origin_time,direction,valid_key);
   if(!valid_key || !PMI_StructDedupeInsertRaw(key))
      g_pmi_struct_dedupe_ready=false;
}

// Rebuild the recent index from the current ledger tail after a timeframe
// change. This prevents slot mappings from a prior chart context surviving.
void PMI_StructDedupeRebuild()
{
   g_pmi_struct_dedupe_chart_period=(int)_Period;
   if(!g_pmi_struct_dedupe_ready) return;
   PMI_StructDedupeClearIndex();
   int nlev=ArraySize(g_pmi_structs);
   int first=PMI_IMax(0,nlev-g_pmi_struct_dedupe_capacity);
   for(int i=first;i<nlev;i++)
   {
      int tf_slot=PMI_StructDedupeTimeframeSlot(g_pmi_structs[i].timeframe);
      bool valid_key=false;
      ulong key=PMI_StructDedupePackKey(tf_slot,g_pmi_structs[i].originTime,
                                        g_pmi_structs[i].direction,valid_key);
      if(!valid_key || !PMI_StructDedupeInsertRaw(key))
      {
         g_pmi_struct_dedupe_ready=false;
         break;
      }
   }
}

//====================================================================
// v6.5.3 WEIGHTED HIGHER-TIMEFRAME CONSENSUS (D1 50 / H4 30 / H1 20)
//
// One reduction, used by every panel and by the candidate ranking, so the
// dashboard can never print a bare "CONFLICT" with no direction again. The
// weights are constants, the arithmetic is integer, and the tie-break is
// explicit: an exact tie (D1 opposing the two lower timeframes) is resolved by
// the HIGHEST timeframe that still has a direction.
//
// This is a classification/ranking input ONLY. It does not loosen any gate:
// execution qualification still requires full D1/H4/H1 alignment.
//====================================================================
#define QSMC_HTF_W_D1 50
#define QSMC_HTF_W_H4 30
#define QSMC_HTF_W_H1 20

string QSMC_BiasWord(const bool known,const int bias)
{
   if(!known) return "n/a";
   if(bias>0) return "BULL";
   if(bias<0) return "BEAR";
   return "RANGE";
}

int QSMC_HTFWeightedBias(const bool d1_known,const int d1_bias,
                         const bool h4_known,const int h4_bias,
                         const bool h1_known,const int h1_bias,
                         int &score_out,string &text_out,string &rule_out)
{
   int b1=(d1_known?d1_bias:0);
   int b2=(h4_known?h4_bias:0);
   int b3=(h1_known?h1_bias:0);
   int raw=(QSMC_HTF_W_D1*b1)+(QSMC_HTF_W_H4*b2)+(QSMC_HTF_W_H1*b3);
   int dir=(raw>0?1:(raw<0?-1:0));
   int conflicts=0;
   if(b1!=0 && b2!=0 && b1!=b2) conflicts++;
   if(b1!=0 && b3!=0 && b1!=b3) conflicts++;
   if(b2!=0 && b3!=0 && b2!=b3) conflicts++;

   string rule="";
   if(dir==0)
   {
      if(b1!=0)      { dir=b1; rule="exact weighted tie -> D1 decides"; }
      else if(b2!=0) { dir=b2; rule="D1 is range/neutral -> H4 decides"; }
      else if(b3!=0) { dir=b3; rule="D1 and H4 are range/neutral -> H1 decides"; }
      else           { rule="all three timeframes are range/neutral -> no bias"; }
   }
   else if(b1!=0 && dir!=b1 && b2!=0 && b3!=0 && b2==b3)
      rule="the two lower timeframes weigh 50 against D1 50 -> the LTF net decides";
   else
      rule="weighted majority";

   score_out=(int)MathMin(100,MathAbs(raw));
   text_out=StringFormat("D1 %s(%d) | H4 %s(%d) | H1 %s(%d) => NET %s %d/100",
                         QSMC_BiasWord(d1_known,d1_bias),QSMC_HTF_W_D1,
                         QSMC_BiasWord(h4_known,h4_bias),QSMC_HTF_W_H4,
                         QSMC_BiasWord(h1_known,h1_bias),QSMC_HTF_W_H1,
                         (dir>0?"BULLISH":(dir<0?"BEARISH":"NONE")),score_out);
   if(conflicts>0)
      rule_out=rule+" | "+IntegerToString(conflicts)+" timeframe pair(s) disagree and are shown, not hidden";
   else
      rule_out=rule;
   return dir;
}

//====================================================================
// PMI — CONFIG + LIFECYCLE
//====================================================================
void PMI_ApplyConfig()
{
   g_pmicfg.enabled            = InpUsePredictiveEngine;
   g_pmicfg.fractal_n          = PMI_IMax(2,PMI_IMin(10,InpPMIFractalN));
   g_pmicfg.mtf_window         = PMI_IMax(60,PMI_IMin(400,InpPMIMTFWindow));
   g_pmicfg.structure_dedupe_window=PMI_IMax(128,PMI_IMin(65536,InpPMIStructureDedupeWindow));
   g_pmicfg.liq_tolerance_atr  = MathMax(0.0,MathMin(2.0,(double)InpPMILiquidityToleranceATR100/100.0));
   g_pmicfg.sweep_depth_min_atr= MathMax(0.0,MathMin(1.0,(double)InpPMISweepDepthMinATR100/100.0));
   g_pmicfg.sweep_to_mss_bars  = PMI_IMax(1,PMI_IMin(80,InpPMISweepToMSSBars));
   g_pmicfg.outcome_horizon    = PMI_IMax(5,PMI_IMin(400,InpPMIOutcomeHorizonBars));
   g_pmicfg.risk_atr           = MathMax(0.05,MathMin(5.0,(double)InpPMIRiskATR100/100.0));
   g_pmicfg.target_r           = MathMax(0.5,MathMin(10.0,(double)InpPMITargetR100/100.0));
   g_pmicfg.k_nearest          = PMI_IMax(5,PMI_IMin(200,InpPMIKNearest));
   g_pmicfg.min_samples        = PMI_IMax(5,PMI_IMin(500,InpPMIMinSamples));
   g_pmicfg.snapshot_cap       = PMI_IMax(100,PMI_IMin(6000,InpPMISnapshotCap));
   g_pmicfg.max_tree_depth     = PMI_IMax(2,PMI_IMin(PMI_MAX_TREE_RECURSION,InpPMIMaxTreeDepth));
   g_pmicfg.min_tree_segment   = PMI_IMax(8,PMI_IMin(500,InpPMIMinTreeSegment));
   g_pmicfg.tree_rebuild_every = PMI_IMax(0,PMI_IMin(500,InpPMITreeRebuildEveryBars));
   g_pmicfg.replay_every       = PMI_IMax(0,PMI_IMin(500,InpPMIReplayAuditEveryBars));
   g_pmicfg.replay_bars        = PMI_IMax(20,PMI_IMin(2000,InpPMIReplayAuditBars));
   g_pmicfg.valid              = true;
   g_pmi_enabled               = InpUsePredictiveEngine;
}

void PMI_ResetState()
{
   g_pmi_last_closed=-1;
   g_pmi_last_closed_time=0;
   g_pmi_builds=0;
   g_pmi_sequence_id=0;
   g_pmi_context_dir=0;
   g_pmi_context_text="NEUTRAL";
   g_pmi_context_conflict=false;
   g_pmi_notrade=PMI_NT_NONE;
   g_pmi_notrade_text="";
   g_pmi_confluence=0.0;
   g_pmi_confluence_detail="";
   g_pmi_analogue_quality=0.0;
   g_pmi_analogue_sample=0;
   g_pmi_analogue_sufficient=false;
   g_pmi_explanation_count=0;
   g_pmi_walkforward_text="";
   g_pmi_stat_count=0;
   g_pmi_path_count=0;
   g_pmi_log_count=0;
   ArrayResize(g_pmi_levels,0,32);
   ArrayResize(g_pmi_structs,0,32);
   bool dedupe_ok=PMI_StructDedupeReset(g_pmicfg.structure_dedupe_window);
   g_pmi_struct_dedupe_chart_period=(int)_Period;
   if(!dedupe_ok) g_pmi_struct_dedupe_ready=false;
   ArrayResize(g_pmi_analogues,0,32);
   ArrayResize(g_pmi_snap,0,64);
   for(int i=0;i<PMI_MAX_COND_STATS;i++) SPMIStatInit(g_pmi_stats[i]);
   for(int i=0;i<PMI_MAX_PATHS;i++) PMI_InitPath(g_pmi_paths[i]);
   PMI_InitSetup(g_pmi_setup);
   PMI_InitSequence(g_pmi_seq);
   PMI_InitState(g_pmi_state);
   PMI_InitSweep(g_pmi_sweep);
   PMI_InitDisplacement(g_pmi_disp);
   PMI_InitLocation(g_pmi_loc);
   PMI_InitRegime(g_pmi_regime);
   PMI_InitSession(g_pmi_session);
   PMI_InitDQ(g_pmi_dq);
   PMI_InitPriceAction(g_pmi_pa);
   for(int i=0;i<PMI_TF_COUNT;i++) PMI_InitTFState(g_pmi_tf[i]);
   for(int i=0;i<PMI_DIGEST_RING;i++)
   {
      g_pmi_digests[i].used=false;
      g_pmi_digests[i].bar=-1;
      g_pmi_digests[i].time=0;
      g_pmi_digests[i].level_set_hash=0;
      g_pmi_digests[i].level_status_hash=0;
      g_pmi_digests[i].sequence_hash=0;
      g_pmi_digests[i].level_count=0;
   }
   PMI_InitReplay(g_pmi_replay);
}

