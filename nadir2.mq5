string ScenarioStateName(const int state)
{
   switch(state)
   {
      case SCN_WATCHING_ZONE:          return "WATCHING ZONE";
      case SCN_ZONE_APPROACHING:       return "ZONE APPROACHING";
      case SCN_TOUCHED_PREVIEW:        return "TOUCHED PREVIEW";
      case SCN_REACTION_CONFIRMED:     return "REACTION CONFIRMED";
      case SCN_DISPLACEMENT_CONFIRMED: return "DISPLACEMENT CONFIRMED";
      case SCN_STRUCTURE_CONFIRMED:    return "STRUCTURE CONFIRMED";
      case SCN_WAITING_FOR_RETEST:     return "WAITING FOR RETEST";
      case SCN_RETEST_CONFIRMED:       return "RETEST CONFIRMED";
      case SCN_EXECUTION_READY:        return "EXECUTION READY";
      case SCN_LATE_WAIT_FOR_RETEST:   return "LATE - WAIT FOR RETEST";
      case SCN_INVALIDATED:            return "INVALIDATED";
      case SCN_COMPLETED:              return "COMPLETED";
      case SCN_EXPIRED:                return "EXPIRED";
      case SCN_COUNTERTREND_WATCH:     return "COUNTERTREND WATCH";
   }
   return "UNAVAILABLE";
}

string ScenarioVerdictName(const int verdict)
{
   switch(verdict)
   {
      case SCV_BUY_EXECUTION_READY:  return "BUY EXECUTION READY";
      case SCV_SELL_EXECUTION_READY: return "SELL EXECUTION READY";
      case SCV_WAIT_BUY_CONFIRMATION:return "WAIT FOR BUY CONFIRMATION";
      case SCV_WAIT_SELL_CONFIRMATION:return "WAIT FOR SELL CONFIRMATION";
      case SCV_WAIT_BREAKOUT:        return "WAIT FOR BREAKOUT";
      case SCV_WAIT_RETEST:          return "WAIT FOR RETEST";
      case SCV_WAIT_STRUCTURE:       return "WAIT FOR STRUCTURE";
      case SCV_INVALIDATED:          return "INVALIDATED";
      case SCV_LATE_WAIT_RETEST:     return "LATE - WAIT FOR RETEST";
   }
   return "NO TRADE";
}

color ScenarioStateColor(const SScenarioPlan &p)
{
   if(p.execution_ready) return (p.is_buy?clrLime:clrTomato);
   if(p.invalidated || p.plan_dead || p.state==SCN_INVALIDATED || p.state==SCN_EXPIRED) return clrDarkGray;
   if(p.state==SCN_LATE_WAIT_FOR_RETEST) return clrOrange;
   if(p.state==SCN_TOUCHED_PREVIEW) return clrAqua;
   if(p.state==SCN_COUNTERTREND_WATCH) return clrKhaki;
   if(p.has_retest) return (p.is_buy?clrDeepSkyBlue:clrOrangeRed);
   if(p.has_structure || p.has_displacement || p.has_reaction)
      return (p.is_buy?clrLimeGreen:clrTomato);
   return clrSilver;
}

void ScenarioLoadTF(const ENUM_TIMEFRAMES tf,const int lookback,const datetime boundary,SScenarioTF &out)
{
   ScenarioTFInit(out,tf);
   int need=MathMax(2,MathMin(lookback,299));
   MqlRates rates[];
   int last_closed=-1;
   string reason="";
   if(!ScenarioCopyClosedRates(tf,need,boundary,rates,last_closed,reason))
   {
      out.data_ok=false;
      out.known=false;
      out.direction_state="NO_DATA";
      out.data_reason=reason;
      out.state=reason;
      return;
   }
   if(last_closed-need+1<0)
   {
      out.data_reason="NO_DATA — "+EnumToString(tf)+" closed-rate window is shorter than requested";
      out.state=out.data_reason;
      return;
   }
   out.data_ok=true;
   double hi=0.0,lo=0.0,eq=0.0;
   TopDown_RangeEq(rates,last_closed-need+1,last_closed,hi,lo,eq);
   if(!(hi>0.0) || !(lo>0.0) || !(hi>=lo))
   {
      out.data_ok=false;
      out.direction_state="NO_DATA";
      out.data_reason="NO_DATA — "+EnumToString(tf)+" closed range is invalid";
      out.state=out.data_reason;
      return;
   }
   out.range_high=hi;
   out.range_low=lo;
   out.equilibrium=eq;
   out.atr=TopDown_ATR(rates,last_closed,14);

   double structure_eq=0.0;
   string st="";
   datetime ev=0,cf=0,av=0;
   int bias=ComputeClosedStructureBias(tf,lookback,InpHTFStructureFractalN,
                                      structure_eq,st,ev,cf,av,boundary);
   out.event_time=ev;
   out.confirmation_time=cf;
   out.availability_time=av;
   if(bias!=0 && (av<=0 || av>boundary))
   {
      out.data_ok=false;
      out.known=false;
      out.bias=0;
      out.direction_state="NO_DATA";
      out.data_reason="NO_DATA — "+EnumToString(tf)+" structural confirmation is not available by ModelBoundary";
      out.state=out.data_reason;
      return;
   }
   out.bias=bias;
   out.known=(bias!=0);
   out.direction_state=ScenarioDirectionToken(out.data_ok,bias);
   out.state=(st=="" || st=="NEUTRAL" ?
              (bias==0?"RANGE — sufficient closed bars; no confirmed directional swing":"STRUCTURE CONFIRMED") : st);
   out.data_reason=(bias==0 ?
      "closed "+EnumToString(tf)+" rates available; no confirmed directional swing (RANGE)" :
      "closed "+EnumToString(tf)+" structural event available at "+TimeToString(av,TIME_DATE|TIME_MINUTES));
   if(!(out.atr>0.0)) out.data_reason+="; ATR unavailable from this closed window";
}

void ScenarioFindExecutionStructure(const int closed)
{
   g_scn_ctx.execution_dir=0;
   g_scn_ctx.execution_type="NO CONFIRMED STRUCTURE";
   g_scn_ctx.execution_time=0;
   for(int i=ArraySize(g_structures)-1;i>=0;i--)
   {
      if(g_structures[i].type=="INIT" || g_structures[i].bar<0 ||
         g_structures[i].bar>closed || g_structures[i].bar+1>=ArraySize(g_buf_t)) continue;
      datetime available=g_buf_t[g_structures[i].bar+1];
      if(available<=0 || available>g_scn_ctx.boundary) continue;
      g_scn_ctx.execution_dir=(g_structures[i].bullish?1:-1);
      g_scn_ctx.execution_type=g_structures[i].type;
      g_scn_ctx.execution_time=available;
      return;
   }
}

void ScenarioBuildContext(const int closed)
{
   ScenarioContextInit(g_scn_ctx);
   if(closed<1 || closed+1>=ArraySize(g_buf_t) || closed>=ArraySize(g_buf_c))
   {
      g_scn_ctx.data_reason="NO_DATA — closed chart boundary is unavailable";
      return;
   }
   g_scn_ctx.closed=closed;
   g_scn_ctx.boundary=g_buf_t[closed+1];
   g_scn_ctx.close_price=g_buf_c[closed];
   g_scn_ctx.atr=(closed<ArraySize(g_atr_buf) && g_atr_buf[closed]>0.0 ? g_atr_buf[closed] : 0.0);
   ScenarioLoadTF(PERIOD_D1,MathMax(60,InpSwingLookback),g_scn_ctx.boundary,g_scn_ctx.d1);
   ScenarioLoadTF(PERIOD_H4,InpSwingLookback,g_scn_ctx.boundary,g_scn_ctx.h4);
   ScenarioLoadTF(PERIOD_H1,InpSwingLookback,g_scn_ctx.boundary,g_scn_ctx.h1);
   g_scn_ctx.selection_atr=g_scn_ctx.h1.atr;
   ScenarioFindExecutionStructure(closed);

   if(g_scn_ctx.d1.data_ok && g_scn_ctx.d1.range_high>g_scn_ctx.d1.range_low)
   {
      g_scn_ctx.dealing_range_ok=true;
      g_scn_ctx.dealing_high=g_scn_ctx.d1.range_high;
      g_scn_ctx.dealing_low=g_scn_ctx.d1.range_low;
      g_scn_ctx.dealing_eq=g_scn_ctx.d1.equilibrium;
      g_scn_ctx.dealing_range_reason="D1 closed range: "+DoubleToString(g_scn_ctx.dealing_low,_Digits)+
         " to "+DoubleToString(g_scn_ctx.dealing_high,_Digits)+"; EQ "+
         DoubleToString(g_scn_ctx.dealing_eq,_Digits)+" (last "+IntegerToString(MathMax(60,InpSwingLookback))+
         " closed D1 bars ending by ModelBoundary)";
   }
   else
      g_scn_ctx.dealing_range_reason=(g_scn_ctx.d1.data_reason!="" ? g_scn_ctx.d1.data_reason :
                                       "NO_DATA — D1 closed range unavailable");

   // v6.5.3: the DSE reads the SAME canonical prior-period record as every other
   // consumer (PMI ledger, S/R cluster, ZRE candidates, target engine), so the
   // daily reference shown here cannot differ from the one shown elsewhere - on
   // this timeframe or on any other.
   int ref_closed=(closed<ArraySize(g_buf_t)-1 ? closed : ArraySize(g_buf_t)-2);
   SPriorPeriodRef d1ref,w1ref;
   bool d1_ref_ok=QSMC_PriorDayRef(ref_closed,d1ref);
   if(d1_ref_ok && d1ref.high>0.0 && d1ref.low>0.0)
   {
      g_scn_ctx.pdh=d1ref.high; g_scn_ctx.pdl=d1ref.low;
      g_scn_ctx.pdh_ok=true; g_scn_ctx.pdl_ok=true;
      g_scn_ctx.pdh_period_time=d1ref.open_time; g_scn_ctx.pdl_period_time=d1ref.open_time;
      g_scn_ctx.pd_reason=d1ref.reason;
   }
   else g_scn_ctx.pd_reason=(d1ref.reason!=""?d1ref.reason:"NO_DATA - prior closed D1 candle unavailable");
   bool w1_ref_ok=QSMC_PriorWeekRef(ref_closed,w1ref);
   if(w1_ref_ok && w1ref.high>0.0 && w1ref.low>0.0)
   {
      g_scn_ctx.pwh=w1ref.high; g_scn_ctx.pwl=w1ref.low;
      g_scn_ctx.pwh_ok=true; g_scn_ctx.pwl_ok=true;
      g_scn_ctx.pwh_period_time=w1ref.open_time; g_scn_ctx.pwl_period_time=w1ref.open_time;
      g_scn_ctx.pw_reason=w1ref.reason;
   }
   else g_scn_ctx.pw_reason=(w1ref.reason!=""?w1ref.reason:"NO_DATA - prior closed W1 candle unavailable");

   if(g_scn_ctx.dealing_range_ok && g_scn_ctx.close_price>0.0 && g_scn_ctx.d1.atr>0.0)
   {
      double eq_buffer=MathMax(_Point,InpEquilibriumBufferATR*g_scn_ctx.d1.atr);
      if(g_scn_ctx.close_price<g_scn_ctx.dealing_eq-eq_buffer)
      {
         g_scn_ctx.daily_location=-1;
         g_scn_ctx.daily_location_text="DISCOUNT: closed price "+DoubleToString(g_scn_ctx.close_price,_Digits)+
            " below D1 EQ "+DoubleToString(g_scn_ctx.dealing_eq,_Digits)+" by more than "+
            DoubleToString(eq_buffer,_Digits)+" (buffer = InpEquilibriumBufferATR x closed D1 ATR)";
      }
      else if(g_scn_ctx.close_price>g_scn_ctx.dealing_eq+eq_buffer)
      {
         g_scn_ctx.daily_location=1;
         g_scn_ctx.daily_location_text="PREMIUM: closed price "+DoubleToString(g_scn_ctx.close_price,_Digits)+
            " above D1 EQ "+DoubleToString(g_scn_ctx.dealing_eq,_Digits)+" by more than "+
            DoubleToString(eq_buffer,_Digits)+" (buffer = InpEquilibriumBufferATR x closed D1 ATR)";
      }
      else
      {
         g_scn_ctx.daily_location=0;
         g_scn_ctx.daily_location_text="EQUILIBRIUM: closed price is within "+DoubleToString(eq_buffer,_Digits)+
            " of D1 EQ "+DoubleToString(g_scn_ctx.dealing_eq,_Digits);
      }
   }
   else g_scn_ctx.daily_location_text="NO_DATA — D1 dealing range, close, or closed D1 ATR unavailable";

   string gap="";
   if(!g_scn_ctx.d1.data_ok) gap="D1 "+g_scn_ctx.d1.data_reason;
   else if(!g_scn_ctx.d1.known) gap="D1 RANGE — no confirmed directional swing";
   if(!g_scn_ctx.h4.data_ok) gap+=(gap==""?"":"; ")+"H4 "+g_scn_ctx.h4.data_reason;
   else if(!g_scn_ctx.h4.known) gap+=(gap==""?"":"; ")+"H4 RANGE — no confirmed directional swing";
   if(!g_scn_ctx.h1.data_ok) gap+=(gap==""?"":"; ")+"H1 "+g_scn_ctx.h1.data_reason;
   else if(!g_scn_ctx.h1.known) gap+=(gap==""?"":"; ")+"H1 RANGE — no confirmed directional swing";
   g_scn_ctx.tf_gap=gap;

   if(!g_scn_ctx.d1.data_ok || !g_scn_ctx.h4.data_ok || !g_scn_ctx.h1.data_ok)
   {
      g_scn_ctx.alignment="NO_DATA";
      g_scn_ctx.data_reason="NO_DATA — closed directional context incomplete: "+gap;
      return;
   }
   if(!g_scn_ctx.d1.known || !g_scn_ctx.h4.known || !g_scn_ctx.h1.known)
   {
      g_scn_ctx.alignment="RANGE / NO DIRECTION";
      g_scn_ctx.data_reason="closed D1/H4/H1 bars are available, but at least one timeframe is RANGE: "+gap;
      return;
   }
   g_scn_ctx.data_reason="closed D1/H4/H1 directional structure available by ModelBoundary";
   // v6.5.3: the bare CONFLICT label is replaced by the weighted verdict. The
   // conflict flag (and therefore the execution gate) is unchanged; what changes
   // is that the panel now names the direction the weights favour and the exact
   // rule that produced it, instead of a directionless "CONFLICT".
   string bias_text="",bias_rule="";
   int bias_score=0;
   g_scn_ctx.bias_raw=((QSMC_HTF_W_D1*g_scn_ctx.d1.bias)+(QSMC_HTF_W_H4*g_scn_ctx.h4.bias)+
                       (QSMC_HTF_W_H1*g_scn_ctx.h1.bias));
   g_scn_ctx.bias_net_dir=QSMC_HTFWeightedBias(true,g_scn_ctx.d1.bias,true,g_scn_ctx.h4.bias,
                                               true,g_scn_ctx.h1.bias,bias_score,bias_text,bias_rule);
   g_scn_ctx.bias_net_score=bias_score;
   g_scn_ctx.bias_net_text=bias_text;
   g_scn_ctx.bias_rule_text=bias_rule;
   bool all_three=(g_scn_ctx.d1.bias==g_scn_ctx.h4.bias && g_scn_ctx.h4.bias==g_scn_ctx.h1.bias);
   if(all_three)
      g_scn_ctx.alignment="ALIGNED - "+bias_text;
   else
   {
      g_scn_ctx.conflict=true;
      g_scn_ctx.alignment="CONFLICT (weighted) - "+bias_text+" | "+bias_rule;
   }
}

// MTEE copies only individual fields from this string-containing RXN record.
// Whole-record assignment risks invalid string ownership in the target compiler.
void ScenarioCopyRxnEvidence(SRxnEvidence &dst,const SRxnEvidence &src)
{
   RXN_EvidenceInit(dst);
   dst.valid=src.valid;
   dst.direction=src.direction;
   dst.zone_id=src.zone_id;
   dst.zone_lo=src.zone_lo;
   dst.zone_hi=src.zone_hi;
   dst.zone_strength=src.zone_strength;
   dst.zone_intrinsic=src.zone_intrinsic;
   dst.zone_context=src.zone_context;
   dst.zone_detected=src.zone_detected;
   dst.zone_recovered=src.zone_recovered;
   dst.zone_time=src.zone_time;
   dst.zone_tf=src.zone_tf;
   dst.zone_sources=src.zone_sources;
   dst.approach_detected=src.approach_detected;
   dst.touch_detected=src.touch_detected;
   dst.outcome=src.outcome;
   dst.penetration_atr=src.penetration_atr;
   dst.pen_budget=src.pen_budget;
   dst.strict_reclaim=src.strict_reclaim;
   dst.close_outside_zone=src.close_outside_zone;
   dst.close_loc=src.close_loc;
   dst.prev_close=src.prev_close;
   dst.prev_dir_reversed=src.prev_dir_reversed;
   dst.accept_bars=src.accept_bars;
   dst.liq.apply=src.liq.apply;
   dst.liq.pool_type=src.liq.pool_type;
   dst.liq.pool_price=src.liq.pool_price;
   dst.liq.pool_bar=src.liq.pool_bar;
   dst.liq.pool_time=src.liq.pool_time;
   dst.liq.pool_priority=src.liq.pool_priority;
   dst.liq.pool_available=src.liq.pool_available;
   dst.liq.swept=src.liq.swept;
   dst.liq.sweep_bar=src.liq.sweep_bar;
   dst.liq.sweep_time=src.liq.sweep_time;
   dst.liq.sweep_availability=src.liq.sweep_availability;
   dst.liq.sweep_depth_atr=src.liq.sweep_depth_atr;
   dst.liq.sweep_quality=src.liq.sweep_quality;
   dst.liq.pool_id=src.liq.pool_id;
   dst.liq.sweep_id=src.liq.sweep_id;
   dst.rejection_detected=src.rejection_detected;
   dst.rejection_points=src.rejection_points;
   dst.wick_points=src.wick_points;
   dst.reclaim_points=src.reclaim_points;
   dst.close_points=src.close_points;
   dst.engulf_points=src.engulf_points;
   dst.wick_ratio=src.wick_ratio;
   dst.reclaimed=src.reclaimed;
   dst.accepted=src.accepted;
   dst.engulf=src.engulf;
   dst.evidence_groups=src.evidence_groups;
   dst.rejection_reason=src.rejection_reason;
   dst.disp.detected=src.disp.detected;
   dst.disp.bar=src.disp.bar;
   dst.disp.time=src.disp.time;
   dst.disp.body_atr=src.disp.body_atr;
   dst.disp.range_atr=src.disp.range_atr;
   dst.disp.body_range_ratio=src.disp.body_range_ratio;
   dst.disp.close_location=src.disp.close_location;
   dst.disp.consecutive=src.disp.consecutive;
   dst.disp.expansion=src.disp.expansion;
   dst.disp.fvg_created=src.disp.fvg_created;
   dst.disp.leg_validated=src.disp.leg_validated;
   dst.disp.consequence=src.disp.consequence;
   dst.disp.quality=src.disp.quality;
   dst.disp.points=src.disp.points;
   dst.disp.detail=src.disp.detail;
   dst.struct_ev.detected=src.struct_ev.detected;
   dst.struct_ev.type=src.struct_ev.type;
   dst.struct_ev.aligned=src.struct_ev.aligned;
   dst.struct_ev.bar=src.struct_ev.bar;
   dst.struct_ev.time=src.struct_ev.time;
   dst.struct_ev.availability_time=src.struct_ev.availability_time;
   dst.struct_ev.points=src.struct_ev.points;
   dst.struct_ev.detail=src.struct_ev.detail;
   dst.fvg_detected=src.fvg_detected;
   dst.ob_detected=src.ob_detected;
   dst.htf_alignment=src.htf_alignment;
   dst.d1_alignment=src.d1_alignment;
   dst.htf_bias_time=src.htf_bias_time;
   dst.d1_bias_time=src.d1_bias_time;
   dst.pd_context=src.pd_context;
   dst.vwap_state=src.vwap_state;
   dst.ema_state=src.ema_state;
   dst.vol_regime=src.vol_regime;
   dst.atr_ratio=src.atr_ratio;
   dst.context_points=src.context_points;
   dst.arrival_points=src.arrival_points;
   dst.zone_points=src.zone_points;
   dst.liquidity_points=src.liquidity_points;
   dst.reaction_score=src.reaction_score;
   dst.score_detail=src.score_detail;
   dst.origin_bar=src.origin_bar;
   dst.origin_time=src.origin_time;
   dst.rejection_bar=src.rejection_bar;
   dst.rejection_time=src.rejection_time;
   dst.confirmation_bar=src.confirmation_bar;
   dst.confirmation_time=src.confirmation_time;
   dst.available_bar=src.available_bar;
   dst.availability_time=src.availability_time;
   dst.causal_parent_id=src.causal_parent_id;
   dst.phase=src.phase;
   dst.level=src.level;
   dst.exec_state=src.exec_state;
   dst.suppression_reason=src.suppression_reason;
   dst.path_text=src.path_text;
}

// Exact-zone memo lookup deliberately bypasses RXN's best-of-direction and
// whole-structure accessors. The per-zone memo stores every eligible reaction;
// the boundary and timeframe checks below decide whether it is usable here.
bool ScenarioRxnForZone(const bool is_buy,const string zone_id,SRxnEvidence &out)
{
   RXN_EvidenceInit(out);
   int dir=(is_buy?1:-1);
   if(zone_id=="") return false;
   int at=RXN_ZoneMemoFind(dir,zone_id);
   if(at<0 || at>=ArraySize(g_rxn_zone_ev)) return false;
   ScenarioCopyRxnEvidence(out,g_rxn_zone_ev[at]);
   if(!out.valid || out.direction!=dir || out.zone_id!=zone_id)
   {
      out.suppression_reason="NOT_EVALUATED — exact-zone RXN memo record failed identity/validity checks";
      return false;
   }
   if(out.availability_time<=0 || g_scn_ctx.boundary<=0 ||
      out.availability_time>g_scn_ctx.boundary)
   {
      RXN_EvidenceInit(out);
      out.suppression_reason="NO_DATA — exact-zone RXN availability timestamp is missing or not available by ModelBoundary";
      return false;
   }
   return true;
}

bool ScenarioZoneAlreadyKnown(const string zone_id,const int until)
{
   int n=MathMin(until,ArraySize(g_zre_zones));
   for(int i=0;i<n;i++)
      if(g_zre_zones[i].id==zone_id) return true;
   return false;
}

void ScenarioNearestBarrier(SScenarioPlan &p)
{
   p.nearest_barrier=0.0;
   p.barrier_type="N/A";
   p.barrier_unavailable="NO_DATA — opposing barrier not evaluated";
   if(!(p.reference_entry>0.0) || g_scn_ctx.boundary<=0)
   {
      p.barrier_unavailable="NO_DATA — entry reference or ModelBoundary unavailable";
      return;
   }
   string type="",event_id="";
   int event_bar=-1;
   double level=NearestOpposingBarrier(p.reference_entry,p.is_buy,type,event_id,event_bar,
                                       g_scn_ctx.boundary);
   bool valid=(level>0.0 && (p.is_buy?level>p.reference_entry:level<p.reference_entry));
   if(valid)
   {
      p.nearest_barrier=level;
      p.barrier_type=(type!=""?type:"causally available opposing OB/FVG");
      p.barrier_unavailable="";
      return;
   }
   p.barrier_unavailable="NO_DATA — no causally available opposing OB/FVG beyond the reference entry by "+
                          TimeToString(g_scn_ctx.boundary,TIME_DATE|TIME_MINUTES);
}

// True when the two intervals share at least one tick. Used to test whether the
// zone the existing TopDown engine built its M15 sequence on overlaps the exact
// ZRE/RXN zone ID under consideration; TopDown exposes bounds, not a stable ID.
bool ScenarioZonesOverlap(const double alo,const double ahi,const double blo,const double bhi)
{
   if(!(ahi>alo) || !(bhi>blo)) return false;
   double lo=MathMax(alo,blo);
   double hi=MathMin(ahi,bhi);
   return (hi-lo>=_Point-1e-12);
}

void ScenarioEvaluateGeometry(SScenarioPlan &p)
{
   p.geometry_valid=false;
   p.m5_data_ok=false;
   p.m5_invalidation_history_ok=false;
   p.m5_atr=0.0;
   p.m5_spread_points=-1;
   p.stop_loss=0.0;
   p.nearest_barrier=0.0;
   p.barrier_type="N/A";
   p.barrier_unavailable="NO_DATA — M5 risk geometry not evaluated";
   p.target1=0.0; p.target2=0.0; p.target3=0.0;
   p.target1_type="N/A"; p.target2_type="N/A"; p.target3_type="N/A";
   p.tp2_unavailable="N/A + TP2 not evaluated";
   p.tp3_unavailable="N/A + TP3 not evaluated";
   p.expected_r=0.0;
   p.barrier_distance=0.0;
   p.barrier_room_atr=0.0;
   p.stop_distance_atr=0.0;
   p.sl_buffer=0.0;
   p.has_sl=false;
   p.sl_price=0.0;
   p.stop_unavailable="N/A + M5 risk not evaluated";
   p.has_trigger=false;
   p.trigger_price=0.0;
   p.preferred_entry_area="N/A + no qualified entry area";
   p.entry_basis="none";
   p.has_proposed_entry=false;
   p.proposed_entry=0.0;
   p.entry_confirmation="N/A + no qualified entry area";
   p.trigger_price_note="N/A + no trigger price derivable";
   p.entry_unavailable="";
   p.entry_zone_low=0.0;
   p.entry_zone_high=0.0;
   p.entry_zone_reason="";
   p.retest_low=0.0;
   p.retest_high=0.0;
   if(!p.valid || p.invalidated || !(p.zone_high>p.zone_low) || !(p.zone_low>0.0))
   {
      p.entry_unavailable="NO_DATA — selected registry zone has no usable low/high";
      p.blocking_gate=p.entry_unavailable;
      return;
   }
   if(g_scn_ctx.boundary<=0 || g_scn_ctx.closed<0 ||
      g_scn_ctx.closed+1>=ArraySize(g_buf_t))
   {
      p.entry_unavailable="NO_DATA — ModelBoundary unavailable for closed M5 planning";
      p.blocking_gate=p.entry_unavailable;
      return;
   }

   p.entry_zone_low=p.zone_low;
   p.entry_zone_high=p.zone_high;
   p.entry_zone_reason="selected ZRE registry zone "+p.zone_id+
      " (source timeframe is not encoded by the registry)";
   if(p.mtf_aligned && p.m5_zone_match &&
      p.chain_zone_hi>p.chain_zone_lo &&
      ScenarioZonesOverlap(p.zone_low,p.zone_high,p.chain_zone_lo,p.chain_zone_hi))
   {
      double lo=MathMax(p.zone_low,p.chain_zone_lo);
      double hi=MathMin(p.zone_high,p.chain_zone_hi);
      if(hi-lo>=_Point-1e-12)
      {
         p.entry_zone_low=lo;
         p.entry_zone_high=hi;
         p.entry_zone_reason="intersection of selected ZRE/RXN zone ID "+p.zone_id+
            " and the causally available TopDown M15 zone bounds (same price level; g_td publishes bounds, not its zone ID)";
      }
      else
      {
         p.m5_zone_match=false;
         p.entry_zone_reason="selected ZRE zone retained; g_td overlap is less than one tick";
      }
   }
   else if(p.chain_zone_hi>p.chain_zone_lo)
      p.entry_zone_reason="selected ZRE zone retained; g_td chain zone is on a different level or direction";
   p.retest_low=p.entry_zone_low;
   p.retest_high=p.entry_zone_high;

   // The entry is a conditional protected edge, not an order. A same-level g_td
   // entry is only adopted when it is a real price inside the intersected area.
   p.reference_entry=(p.is_buy?p.entry_zone_high:p.entry_zone_low);
   if(p.m5_ok && p.mtf_aligned && p.m5_zone_match && p.m5_entry>0.0 &&
      p.m5_entry>=p.entry_zone_low-_Point*0.5 && p.m5_entry<=p.entry_zone_high+_Point*0.5)
   {
      p.reference_entry=p.m5_entry;
      p.entry_basis="existing TopDown entry, inside the same-level zone intersection";
   }
   else
      p.entry_basis="selected zone protected edge (conditional reference only)";
   p.has_proposed_entry=(p.reference_entry>0.0);
   p.proposed_entry=p.reference_entry;
   p.preferred_entry_area=(p.is_buy?"BUY upper protected edge ":"SELL lower protected edge ")+
      DoubleToString(p.reference_entry,_Digits)+" within ["+
      DoubleToString(p.entry_zone_low,_Digits)+", "+DoubleToString(p.entry_zone_high,_Digits)+"]";
   p.has_trigger=(p.reference_entry>0.0);
   p.trigger_price=p.reference_entry;
   p.trigger_price_note=(p.is_buy?
      "a CLOSED M5 candle must touch this selected area after M15 confirmation, then a later CLOSED M5 candle must close above the protected upper edge":
      "a CLOSED M5 candle must touch this selected area after M15 confirmation, then a later CLOSED M5 candle must close below the protected lower edge");
   p.entry_confirmation="after causally ordered M30 rejection/displacement and M15 structure, a closed M5 touch must be followed by a later closed reclaim beyond the selected area edge";
   p.structural_invalidation=(p.is_buy?p.zone_low:p.zone_high);

   int want=MathMax(16,InpTopDownExecBars+2);
   MqlRates m5[];
   int last_m5=-1;
   string m5_reason="";
   bool have_m5=ScenarioCopyClosedRates(PERIOD_M5,want,g_scn_ctx.boundary,m5,last_m5,m5_reason);
   if(have_m5 && last_m5>=14)
   {
      p.m5_atr=TopDown_ATR(m5,last_m5,14);
      if(p.m5_atr>0.0)
      {
         p.m5_data_ok=true;
         p.m5_spread_points=m5[last_m5].spread;
      }
      else m5_reason="NO_DATA — M5 closed ATR cannot be calculated from the available history";
   }
   else if(have_m5)
      m5_reason="NO_DATA — insufficient closed M5 bars for the existing ATR/risk window";
   if(!p.m5_data_ok)
   {
      p.stop_unavailable=m5_reason;
      p.blocking_gate=m5_reason;
      p.entry_unavailable=m5_reason;
      p.sl_buffer=0.0;
      // Still inspect any M5 bars that did arrive for a closed invalidation or a
      // causally post-confirmation retest; never synthesize missing ATR/targets.
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }
   if(p.m5_spread_points<0)
   {
      p.stop_unavailable="NO_DATA — latest closed M5 spread field is unavailable";
      p.blocking_gate=p.stop_unavailable;
      p.entry_unavailable=p.stop_unavailable;
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }

   p.sl_buffer=InpSLBufferATR*p.m5_atr;
   p.stop_loss=NormalizePriceToTick(p.is_buy ?
      p.structural_invalidation-p.sl_buffer : p.structural_invalidation+p.sl_buffer);
   double stop_risk=MathAbs(p.reference_entry-p.stop_loss);
   p.stop_distance_atr=(p.m5_atr>0.0?stop_risk/p.m5_atr:0.0);
   bool spread_gate_active=!(g_is_backtest && InpIgnoreSpreadInBacktest);
   bool spread_ok=(!spread_gate_active || p.m5_spread_points<=InpMaxSpreadPts);
   bool stop_side_ok=(p.is_buy ? p.stop_loss<p.reference_entry : p.stop_loss>p.reference_entry);
   bool stop_ok=(p.stop_loss>0.0 && stop_side_ok && stop_risk>_Point &&
                 p.stop_distance_atr<=InpMaxStopATR+1e-9);
   if(!spread_ok)
   {
      p.stop_unavailable=StringFormat("M5 spread %d pts exceeds InpMaxSpreadPts %d",
                                      p.m5_spread_points,InpMaxSpreadPts);
      p.blocking_gate="risk gate: "+p.stop_unavailable;
      p.entry_unavailable=p.blocking_gate;
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }
   if(!stop_ok)
   {
      p.stop_unavailable=StringFormat("structural stop distance %.2f ATR exceeds InpMaxStopATR %.2f or is below one tick",
                                      p.stop_distance_atr,InpMaxStopATR);
      p.blocking_gate="risk gate: "+p.stop_unavailable;
      p.entry_unavailable=p.blocking_gate;
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }
   p.has_sl=true;
   p.sl_price=p.stop_loss;
   p.stop_unavailable="";

   ScenarioNearestBarrier(p);
   double hard_barrier=p.nearest_barrier;
   double min_dist=MathMax(p.m5_atr*0.50,InstrumentMinStopDistance());
   string t1_type="",t2_type="",t3_type="";
   string t1_id="",t2_id="",t3_id="";
   int t1_bar=-1,t2_bar=-1,t3_bar=-1;
   bool t1_used=false,t2_used=false,t3_used=false;
   bool t1_bound=false,t2_bound=false,t3_bound=false;
   double tp1=FindInstitutionalTarget(p.reference_entry,p.reference_entry,p.stop_loss,p.is_buy,
      min_dist,InpMinRR1,1,hard_barrier,t1_type,t1_id,t1_bar,t1_used,t1_bound,
      g_scn_ctx.boundary,p.m5_atr);
   if(tp1<=0.0)
   {
      p.barrier_unavailable=(p.barrier_unavailable=="" ?
         "NO_DATA — existing FindInstitutionalTarget found no valid TP1 beyond InpMinRR1 by ModelBoundary" :
         p.barrier_unavailable+"; no valid TP1 passed the existing target selector/RR floor");
      p.blocking_gate="target gate: "+p.barrier_unavailable;
      p.entry_unavailable=p.blocking_gate;
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }
   double base_rr=DirectionalRR(p.is_buy,p.reference_entry,p.stop_loss,tp1);
   double spread_price=(double)p.m5_spread_points*_Point;
   double net_risk=stop_risk+spread_price;
   double net_reward=MathAbs(tp1-p.reference_entry)-spread_price;
   if(base_rr+1e-9<InpMinRR1 || !(net_risk>_Point) || !(net_reward>_Point))
   {
      p.blocking_gate="risk/target gate: existing DirectionalRR failed or M5 spread consumes the TP1 reward";
      p.entry_unavailable=p.blocking_gate;
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }
   p.expected_r=net_reward/net_risk;
   if(p.expected_r+1e-9<InpMinRR1)
   {
      p.blocking_gate=StringFormat("risk gate: net-of-M5-spread RR %.2f is below InpMinRR1 %.2f",
                                   p.expected_r,InpMinRR1);
      p.entry_unavailable=p.blocking_gate;
      ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
      return;
   }
   p.target1=tp1;
   p.target1_type=t1_type;
   p.geometry_valid=true;
   if(!(p.nearest_barrier>0.0))
   {
      p.nearest_barrier=tp1;
      p.barrier_type=(t1_type!=""?t1_type:"verified TP1");
      p.barrier_unavailable="nearest causally available OB/FVG absent; this is the existing validated TP1 target";
   }
   p.barrier_distance=MathAbs(p.nearest_barrier-p.reference_entry);
   p.barrier_room_atr=(p.m5_atr>0.0?p.barrier_distance/p.m5_atr:0.0);

   double tp2=FindInstitutionalTarget(tp1,p.reference_entry,p.stop_loss,p.is_buy,
      min_dist,InpMinRR1,2,hard_barrier,t2_type,t2_id,t2_bar,t2_used,t2_bound,
      g_scn_ctx.boundary,p.m5_atr);
   double tp3=(tp2>0.0 ? FindInstitutionalTarget(tp2,p.reference_entry,p.stop_loss,p.is_buy,
      min_dist,InpMinRR1,3,hard_barrier,t3_type,t3_id,t3_bar,t3_used,t3_bound,
      g_scn_ctx.boundary,p.m5_atr) : 0.0);
   if(tp2>0.0 && tp3>0.0 &&
      ValidateTargetGeometry(p.is_buy,p.reference_entry,p.stop_loss,tp1,tp2,tp3))
   {
      p.target2=tp2; p.target3=tp3;
      p.target2_type=t2_type; p.target3_type=t3_type;
      p.tp2_unavailable=""; p.tp3_unavailable="";
   }
   else
   {
      p.target2=0.0; p.target3=0.0;
      p.target2_type="N/A"; p.target3_type="N/A";
      p.tp2_unavailable=(tp2<=0.0 ?
         "N/A + no next causally available institutional target passed InpMinRR1" :
         "N/A + TP2/TP3 pair failed existing ValidateTargetGeometry strict ordering");
      p.tp3_unavailable=(tp3<=0.0 ?
         "N/A + no third causally available institutional target passed InpMinRR1" :
         "N/A + TP2/TP3 pair failed existing ValidateTargetGeometry strict ordering");
   }
   p.blocking_gate="M30 rejection/displacement -> same-level M15 structure -> closed M5 retest -> Core authorization";
   p.entry_unavailable="conditional planning only; Scenario/MTEE never authorizes entry";
   ScenarioM5RetestScan(p,m5,last_m5,g_scn_ctx.boundary);
}

// The TopDown cache is keyed by the current chart-close plus each timeframe's
// last-closed open. Re-check every close boundary against this plan's explicit
// ModelBoundary before using any mirrored leg.
bool ScenarioTopDownLegCausal(const int leg,const datetime boundary)
{
   if(!g_td.computed || leg<0 || leg>=6 || boundary<=0 ||
      g_td.fp[leg]<=0 || g_td.fp_next[leg]<=g_td.fp[leg]) return false;
   // fp_next is the exact next TF candle open captured with this g_td snapshot;
   // unlike PeriodSeconds(), it remains correct across weekends/session gaps/DST.
   return (g_td.fp_next[leg]<=boundary);
}

bool ScenarioTopDownSnapshotCausal(const datetime boundary)
{
   if(!g_td.computed || boundary<=0 || g_scn_ctx.closed<0 ||
      g_scn_ctx.closed>=ArraySize(g_buf_t) || g_td.fp_chart!=g_buf_t[g_scn_ctx.closed]) return false;
   for(int leg=0;leg<6;leg++)
      if(!ScenarioTopDownLegCausal(leg,boundary)) return false;
   return true;
}

// CHAIN MIRROR: read-only, boundary-checked TopDown context. A g_td M15 zone is
// linked to this plan only by a same-price-area overlap; the TopDown engine does
// not publish a stable zone ID. The M30 RXN leg below requires the exact ZRE/RXN
// zone ID, and M15 event times are compared with the M30 displacement boundary.
void ScenarioChainMirror(SScenarioPlan &p)
{
   p.mtf_context=(g_scn_ctx.d1.data_ok && g_scn_ctx.h4.data_ok && g_scn_ctx.h1.data_ok);
   p.mtf_dir=0;
   p.mtf_aligned=false;
   p.mtf_opposed=false;
   p.mtf_gate_blocks=false;
   p.mtf_blocker="NOT_EVALUATED(TopDown snapshot not available)";
   p.m30_ok=false; p.m15_ok=false; p.m5_ok=false;
   p.m5_zone_match=false;
   p.m5_entry=0.0; p.m5_sl=0.0; p.m5_tp1=0.0; p.m5_rr=0.0;
   p.m5_target_source="";
   p.chain_zone_lo=0.0; p.chain_zone_hi=0.0; p.chain_sweep=0.0;
   if(!InpTopDownEnabled)
   {
      p.mtf_blocker="NOT_EVALUATED(InpTopDownEnabled=false)";
      return;
   }
   if(!ScenarioTopDownSnapshotCausal(g_scn_ctx.boundary))
   {
      p.mtf_blocker="NO_DATA — g_td fingerprint is missing, stale, or contains a TF candle not available by ModelBoundary";
      return;
   }
   int dir=(p.is_buy?1:-1);
   p.mtf_dir=g_td.dir;
   p.mtf_blocker=(g_td.blocker!=""?g_td.blocker:"TopDown chain has no blocker (full chain verdict)");
   p.mtf_aligned=(g_td.dir==dir);
   p.mtf_opposed=(g_td.dir!=0 && g_td.dir!=dir);
   p.mtf_gate_blocks=TopDown_BlocksDirection(p.is_buy);
   // The generic TopDown stage flags are not exact-zone evidence by themselves.
   // M30/M15 are promoted below only after RXN identity and strict stage order;
   // M5 chain geometry is usable only after the M15 price-area link is verified.
   p.m30_ok=false;
   p.m15_ok=false;
   p.m5_ok=false;
   if(g_td.tf_ok[4] && ScenarioTopDownLegCausal(4,g_scn_ctx.boundary) &&
      g_td.m15_zone_hi>g_td.m15_zone_lo)
   {
      p.chain_zone_lo=g_td.m15_zone_lo;
      p.chain_zone_hi=g_td.m15_zone_hi;
      p.chain_sweep=g_td.m15_sweep;
      p.m5_zone_match=(p.mtf_aligned &&
         ScenarioZonesOverlap(p.zone_low,p.zone_high,p.chain_zone_lo,p.chain_zone_hi));
   }
   p.m5_ok=(g_td.tf_ok[5] && ScenarioTopDownLegCausal(5,g_scn_ctx.boundary) &&
            p.mtf_aligned && p.m5_zone_match);
   if(p.m5_ok && g_td.entry>0.0)
   {
      p.m5_entry=g_td.entry;
      p.m5_sl=g_td.sl;
      p.m5_tp1=g_td.tp1;
      p.m5_rr=g_td.rr;
      p.m5_target_source=g_td.tp_src;
   }
   if(p.mtf_opposed)
      p.mtf_blocker="g_td resolved the other direction ("+(g_td.dir>0?"BUY":"SELL")+")";
   else if(g_td.dir==0)
      p.mtf_blocker=(g_td.blocker!=""?g_td.blocker:"g_td direction is WAIT");
}

void ScenarioEvaluateM30M15(SScenarioPlan &p,const SRxnEvidence &rx,const bool have_rx)
{
   p.has_reaction=false;
   p.has_displacement=false;
   p.has_structure=false;
   p.structure_type="";
   p.m30_rejection_time=0;
   p.m30_rejection_availability=0;
   p.m30_displacement_time=0;
   p.m30_displacement_availability=0;
   p.m15_structure_time=0;
   p.m15_structure_availability=0;
   p.evidence_available=0;
   p.m30_state="NOT_EVALUATED(M30 stage not evaluated)";
   p.m15_state="NOT_EVALUATED(M30 displacement prerequisite unavailable)";
   if(!InpUseRXN)
      p.m30_state="NOT_EVALUATED(InpUseRXN=false; no closed rejection evidence source)";
   else if((ENUM_TIMEFRAMES)_Period!=PERIOD_M30)
      p.m30_state="NOT_EVALUATED(RXN evidence is chart-TF scoped; no zone-linked M30 rejection data on this chart)";
   else if(!have_rx)
   {
      if(StringFind(rx.suppression_reason,"NO_DATA")==0)
         p.m30_state=rx.suppression_reason;
      else if(g_rxn_built_time>0 && g_scn_ctx.boundary>0 && g_rxn_built_time<=g_scn_ctx.boundary)
         p.m30_state="PENDING — no closed M30 rejection has been published for selected zone "+p.zone_id;
      else
         p.m30_state="NO_DATA — RXN M30 snapshot is not available by ModelBoundary";
   }
   else if(rx.zone_id!=p.zone_id || rx.direction!=(p.is_buy?1:-1) ||
           rx.zone_tf!=TFName(PERIOD_M30))
      p.m30_state="NOT_EVALUATED(RXN record is not the same selected zone ID, direction, and M30 timeframe)";
   else if(rx.availability_time<=0 || rx.availability_time>g_scn_ctx.boundary)
      p.m30_state="NO_DATA — exact-zone RXN availability is missing or after ModelBoundary";
   else if(!rx.rejection_detected)
   {
      if(rx.outcome==(int)RXN_OC_ACCEPTANCE || rx.outcome==(int)RXN_OC_BREAKOUT)
         p.m30_state="NOT_EVALUATED(selected zone was accepted/broken, not rejected)";
      else
         p.m30_state="PENDING — waiting for a closed M30 rejection on selected zone ID "+p.zone_id;
   }
   else
   {
      int rb=rx.rejection_bar;
      if(rb<0 || rb+1>=ArraySize(g_buf_t) || g_buf_t[rb]<=0 || g_buf_t[rb+1]<=0)
         p.m30_state="NO_DATA — exact-zone rejection bar or next-open availability is outside chart history";
      else if(rx.rejection_time>0 && rx.rejection_time!=g_buf_t[rb])
         p.m30_state="NOT_EVALUATED(RXN rejection timestamp does not match the canonical chart bar)";
      else
      {
         p.m30_rejection_time=(rx.rejection_time>0?rx.rejection_time:g_buf_t[rb]);
         p.m30_rejection_availability=g_buf_t[rb+1];
         if(p.m30_rejection_availability>g_scn_ctx.boundary)
            p.m30_state="NOT_EVALUATED(M30 rejection close is after ModelBoundary)";
         else
         {
            p.has_reaction=true;
            if(!rx.disp.detected)
               p.m30_state="PENDING — closed M30 rejection confirmed; waiting for later displacement";
            else
            {
               int db=rx.disp.bar;
               if(db<0 || db+1>=ArraySize(g_buf_t) || g_buf_t[db]<=0 || g_buf_t[db+1]<=0)
                  p.m30_state="NO_DATA — M30 displacement bar or next-open availability is outside chart history";
               else if(db<=rb || (rx.disp.time>0 && rx.disp.time<=p.m30_rejection_time))
                  p.m30_state="NOT_EVALUATED(CAUSAL_ORDER: M30 displacement is not strictly after the rejection)";
               else
               {
                  p.m30_displacement_time=(rx.disp.time>0?rx.disp.time:g_buf_t[db]);
                  p.m30_displacement_availability=g_buf_t[db+1];
                  if(g_buf_t[db]!=p.m30_displacement_time ||
                     p.m30_displacement_availability<=p.m30_rejection_availability)
                     p.m30_state="NOT_EVALUATED(CAUSAL_ORDER: displacement timestamp/availability is not later)";
                  else if(p.m30_displacement_availability>g_scn_ctx.boundary)
                     p.m30_state="NOT_EVALUATED(M30 displacement close is after ModelBoundary)";
                  else
                  {
                     p.has_displacement=true;
                     p.m30_ok=true;
                     p.m30_state="CONFIRMED — exact-zone M30 rejection at "+
                        TimeToString(p.m30_rejection_time,TIME_DATE|TIME_MINUTES)+
                        " (available "+TimeToString(p.m30_rejection_availability,TIME_DATE|TIME_MINUTES)+
                        ") -> later displacement at "+TimeToString(p.m30_displacement_time,TIME_DATE|TIME_MINUTES)+
                        " (available "+TimeToString(p.m30_displacement_availability,TIME_DATE|TIME_MINUTES)+")";
                  }
               }
            }
         }
      }
   }

   if(!p.has_displacement)
   {
      p.m15_state="NOT_EVALUATED(M30 displacement prerequisite is not confirmed for this zone)";
      return;
   }
   if(!InpTopDownEnabled || !ScenarioTopDownSnapshotCausal(g_scn_ctx.boundary))
   {
      p.m15_state="NO_DATA — causally bounded g_td M15 sequence/timestamps are unavailable";
      return;
   }
   if(!p.mtf_aligned)
   {
      p.m15_state="NOT_EVALUATED(g_td did not resolve the selected plan's direction)";
      return;
   }
   if(!g_td.tf_ok[4] || !ScenarioTopDownLegCausal(4,g_scn_ctx.boundary))
   {
      p.m15_state="PENDING — existing g_td M15 sweep/displacement/break/zone sequence is not confirmed: "+
                  (g_td.blocker!=""?g_td.blocker:"M15 stage not reached");
      return;
   }
   if(!p.m5_zone_match)
   {
      p.m15_state="NOT_EVALUATED(g_td M15 zone is on a different price level from selected zone ID "+p.zone_id+")";
      return;
   }
   datetime m15_event=g_td.m15_structure_time;
   datetime m15_available=g_td.m15_structure_availability;
   if(m15_event<=0 || m15_available<=0)
   {
      p.m15_state="NO_DATA — g_td did not publish the M15 break bar and next-open availability";
      return;
   }
   if(m15_event<=p.m30_displacement_time || m15_available<=p.m30_displacement_availability)
   {
      p.m15_state="NOT_EVALUATED(CAUSAL_ORDER: same-level M15 break is not later than M30 displacement availability)";
      return;
   }
   if(m15_available>g_scn_ctx.boundary)
   {
      p.m15_state="NOT_EVALUATED(M15 structure close is after ModelBoundary)";
      return;
   }
   p.has_structure=true;
   p.m15_ok=true;
   p.m15_structure_time=m15_event;
   p.m15_structure_availability=m15_available;
   p.structure_type="TopDown M15 closed sequence break (existing engine; event type not separately published)";
   p.evidence_available=m15_available;
   p.m15_state="CONFIRMED — g_td same-level M15 sequence break at "+
      TimeToString(m15_event,TIME_DATE|TIME_MINUTES)+"; available "+
      TimeToString(m15_available,TIME_DATE|TIME_MINUTES)+
      " (M30 displacement available "+TimeToString(p.m30_displacement_availability,TIME_DATE|TIME_MINUTES)+")";
}

// The three ladder strings preserve the stage result's leading state token and
// append the g_td mirror only when its closed-timeframe fingerprint is causal.
void ScenarioLegTexts(SScenarioPlan &p)
{
   bool td_ok=(InpTopDownEnabled && ScenarioTopDownSnapshotCausal(g_scn_ctx.boundary));
   if(p.m30_state=="") p.m30_state="NOT_EVALUATED(M30 RXN stage not evaluated)";
   if(p.m15_state=="") p.m15_state="NOT_EVALUATED(M30 displacement prerequisite unavailable)";
   if(td_ok)
   {
      string chain30=(g_td.tf_ok[3] ? g_td.tf_state[3] : "M30 chain step not confirmed");
      string chain15=(g_td.tf_ok[4] ? g_td.m15_detail : "M15 chain step not confirmed");
      p.m30_state+=" | g_td M30="+chain30;
      p.m15_state+=" | g_td M15="+chain15;
      string m5_chain=(p.m5_zone_match?"same price area as selected zone":"different level / unavailable");
      p.m5_state+=" | g_td M5 geometry "+m5_chain+
         (p.m5_entry>0.0?" entry "+DoubleToString(p.m5_entry,_Digits):" entry N/A");
   }
   else
   {
      p.m5_state+=" | NOT_EVALUATED(g_td chain fingerprint is not causal by ModelBoundary)";
   }
   if(p.m5_state=="") p.m5_state="NOT_EVALUATED(M5 scan not evaluated)";
}

// Chase policy uses only the last closed chart price and the closed H1 ATR used
// for zone-distance selection. PREVIEW touches never change this classification.
void ScenarioMarkLate(SScenarioPlan &p)
{
   p.late=false;
   if(!InpChaseFilter || !(g_scn_ctx.selection_atr>0.0) || !(g_scn_ctx.close_price>0.0) ||
      !(p.zone_high>p.zone_low)) return;
   double chase=(InpChaseMaxATR>0.0?InpChaseMaxATR:InpLateEntryMaxATR);
   if(!(chase>0.0)) return;
   p.late=(p.is_buy ? g_scn_ctx.close_price>p.zone_high+chase*g_scn_ctx.selection_atr
                    : g_scn_ctx.close_price<p.zone_low-chase*g_scn_ctx.selection_atr);
}

//====================================================================
// v6.6.10 AUDIT-TAC  TACTICAL AUTHORITY GATE
//
// THE DEFECT THIS CLOSES. Three modules publish a direction for the same
// symbol and the same bar, and before this pass only two of them asked
// anybody else what the state was:
//
//   * the Core lifecycle        (g_active_setup, blacklist, STATE_INVALIDATED)
//   * the Directional Scenario  (g_scn_buy / g_scn_sell, SCN_INVALIDATED,
//     Engine                      SCN_EXPIRED, plan_dead)  <- prints
//                                 "BUY PLAN - CONDITIONAL - INVALIDATED"
//   * the MTF tactical preview  (UpdateMTFExecutionEntry)  <- prints
//                                 "TACTICAL / PREVIEW MTF BUY ENTRY PREVIEW"
//
// The tactical preview read NONE of the others. Its direction could come from
// the higher-timeframe bias alone plus any past structure event of the same
// side, with no age bound, so an invalidated BUY plan and a live BUY entry
// preview were drawn on the same chart at the same time. Two independent
// modules, two inconsistent snapshots - the contradiction the operator sees.
//
// THE RULE, in one total order (highest wins):
//   BLOCKED  an authoritative module retired this exact side  -> no display,
//            no entry mark, and the fact is NOT handed to the arbiter either;
//   STALE    the bias-only trigger is older than the Core retirement window
//            -> same as BLOCKED;
//   CONTEXT  the direction came from the HTF bias alone and the DSE holds no
//            live plan on that side -> the level line stays, the word becomes
//            CONTEXT, no entry mark is painted, and the arbiter still receives
//            the fact so its own refusal stays explainable;
//   OK       an authoritative module still owns a live scenario on this side.
//
// Nothing here authorizes, arms, scores or executes anything, no threshold is
// relaxed, and no gate loses authority: this only removes a display that
// contradicted the modules that already had the authority.
//
// CAUSALITY: every input is a published CLOSED-BAR verdict (a DSE plan built by
// ScenarioUpdate for the last closed bar, or a Core blacklist entry whose own
// horizon is InpBlacklistExpiryBars). No forming-bar value is read, and no
// future bar can change a verdict already returned here.
//====================================================================

// Does the Directional Scenario Engine hold a TERMINAL plan for this side?
// Mirrored halves rather than a struct pointer: MQL5 has no pointer to a struct
// and copying an SScenarioPlan (it owns ~40 strings) per tick would be waste.
bool TacticalScenarioTerminal(const bool bull,string &state_name,string &why)
{
   state_name=""; why="";
   if(bull)
   {
      if(!g_scn_buy.valid) return false;
      if(!g_scn_buy.invalidated && !g_scn_buy.plan_dead &&
         g_scn_buy.state!=SCN_INVALIDATED && g_scn_buy.state!=SCN_EXPIRED) return false;
      state_name=ScenarioStateName(g_scn_buy.state);
      why=(g_scn_buy.plan_dead && g_scn_buy.dead_note!="" ? g_scn_buy.dead_note
                                                          : g_scn_buy.qualification_reason);
      return true;
   }
   if(!g_scn_sell.valid) return false;
   if(!g_scn_sell.invalidated && !g_scn_sell.plan_dead &&
      g_scn_sell.state!=SCN_INVALIDATED && g_scn_sell.state!=SCN_EXPIRED) return false;
   state_name=ScenarioStateName(g_scn_sell.state);
   why=(g_scn_sell.plan_dead && g_scn_sell.dead_note!="" ? g_scn_sell.dead_note
                                                         : g_scn_sell.qualification_reason);
   return true;
}

// Does it hold a LIVE (non-terminal, currently relevant) plan for this side?
// `relevant` is ScenarioMarkRelevant's own Priority-A verdict: live, correctly
// sided, fresh, unchased and inside the closed-H1 approach horizon. A plan the
// DSE is still tracking but has NOT made current (LATE, countertrend, outside the
// approach horizon) is not live - and `state_name` then carries the DSE's own
// state name, so the reason printed on the chart is the DSE's wording and never a
// guess. state_name stays "" when the DSE has no plan for this side at all.
bool TacticalScenarioLive(const bool bull,string &state_name)
{
   state_name="";
   if(bull)
   {
      if(!g_scn_buy.valid) return false;
      state_name=ScenarioStateName(g_scn_buy.state);
      return (g_scn_buy.relevant && !g_scn_buy.invalidated && !g_scn_buy.plan_dead &&
              g_scn_buy.state!=SCN_INVALIDATED && g_scn_buy.state!=SCN_EXPIRED);
   }
   if(!g_scn_sell.valid) return false;
   state_name=ScenarioStateName(g_scn_sell.state);
   return (g_scn_sell.relevant && !g_scn_sell.invalidated && !g_scn_sell.plan_dead &&
           g_scn_sell.state!=SCN_INVALIDATED && g_scn_sell.state!=SCN_EXPIRED);
}

string TacticalAuthorityName(const int auth)
{
   if(auth==(int)TAC_AUTH_BLOCKED) return "BLOCKED";
   if(auth==(int)TAC_AUTH_STALE)   return "STALE";
   if(auth==(int)TAC_AUTH_CONTEXT) return "CONTEXT";
   if(auth==(int)TAC_AUTH_OK)      return "OK";
   return "UNKNOWN";
}

// The PURE total order. No global is read in here, which is what makes it
// exercisable from TacticalAuthoritySelfTest() with local values only, and
// transcribable 1:1 by tools/test_tactical_authority.py - the same arrangement
// QSMC_BuildGeometry() already uses so the two implementations cannot diverge.
// `trigger_age_bars` is -1 when the trigger's chart bar is unknown, which skips
// the staleness rule instead of guessing an age.
ENUM_TACTICAL_AUTHORITY TacticalAuthorityDecide(const bool bull,const int src,
                                                const int trigger_age_bars,const int retest_timeout_bars,
                                                const bool dse_on,const bool dse_terminal,
                                                const string terminal_state,const string terminal_why,
                                                const bool blacklisted,
                                                const bool dse_live,const string live_state,
                                                string &reason)
{
   reason="";
   string side=(bull?"BUY":"SELL");

   //--- (1) BLOCKED: the Directional Scenario Engine retired this side. This is
   //---     the module that prints "<SIDE> PLAN - <state>" on the same chart, so
   //---     it is the one a contradictory preview must yield to.
   if(dse_on && dse_terminal)
   {
      reason="the DSE "+side+" scenario is "+terminal_state+
             (terminal_why!=""?" ("+terminal_why+")":"")+" - a retired scenario keeps no preview";
      return TAC_AUTH_BLOCKED;
   }

   //--- (2) BLOCKED: the Core lifecycle retired the SAME side-and-level idea and
   //---     the retirement is still inside its own documented horizon. This is
   //---     the existing veto CalculateAITradeSetup already applies before it
   //---     seeds a new setup; the tactical preview was the only reader that
   //---     never asked. Bounded by InpBlacklistExpiryBars, so it cannot stick
   //---     forever and silently mute a genuinely new setup on the same side.
   if(src!=1 && blacklisted)
   {
      reason="the Core lifecycle blacklisted this "+side+" idea within InpBlacklistExpiryBars "+
             IntegerToString(InpBlacklistExpiryBars)+" bars - a retired idea keeps no preview";
      return TAC_AUTH_BLOCKED;
   }

   //--- (3) STALE: a bias-only trigger carries no age bound of its own, so any
   //---     structure event still in g_structures could produce a fresh-looking
   //---     preview whenever price wandered back to it. The bound reused here is
   //---     the Core lifecycle's own retirement window (InpRetestTimeoutBars,
   //---     measured in closed CHART bars) - an existing, documented parameter,
   //---     not a new one. Only src==2 is bounded: an early-break preview and a
   //---     Core-owned entry are anchored to a recent event by construction.
   if(src==2 && retest_timeout_bars>0 && trigger_age_bars>=0 &&
      trigger_age_bars>retest_timeout_bars)
   {
      reason="the "+side+" trigger is "+IntegerToString(trigger_age_bars)+
             " closed chart bars old (limit InpRetestTimeoutBars "+
             IntegerToString(retest_timeout_bars)+
             ") - returning to an old level is not a fresh entry";
      return TAC_AUTH_STALE;
   }

   //--- (4) CONTEXT: the direction came from the higher-timeframe bias alone.
   //---     A bullish bias is contextual evidence, not an unconditional BUY
   //---     instruction, and the arbitration layer already refuses to trade on it
   //---     ("the MTF trigger alone is not a location fact"). The display now says
   //---     the same thing instead of printing ENTRY. The fact is STILL handed to
   //---     the arbiter, so its own explained refusal is unchanged. `live_state`
   //---     is the DSE's own wording, so a LATE plan is reported as LATE and
   //---     never as "no scenario".
   if(src==2 && !(dse_on && dse_live))
   {
      reason=(dse_on?(live_state!=""?"the DSE "+side+" scenario is "+live_state
                                   :"no DSE "+side+" scenario")
                    :"the scenario engine is off")+
             " - the direction came from the HTF bias alone, which is context, not an entry";
      return TAC_AUTH_CONTEXT;
   }
   return TAC_AUTH_OK;
}

// The adapter: it gathers the PUBLISHED closed-bar facts and nothing else, then
// hands them to the pure order above. Every input here is a fact some
// authoritative module already committed on a closed bar - a DSE plan built by
// ScenarioUpdate(), or a Core blacklist entry inside its own horizon.
//
// COMPLEXITY, stated because this runs on the per-tick path: the DSE predicates
// are O(1) field reads plus one switch in ScenarioStateName(); the age bound is
// O(1); IsSameIdeaAsBlacklisted() is O(1) when the blacklist is empty (its own
// first statement) and otherwise O(B*log N) with B<=64 retained entries (the list
// prunes itself at 64) and N retained chart bars, each probe being the binary
// search IsBlacklistEntryActive() already performs. Nothing is cached here on
// purpose: a cached authority verdict is exactly the stale state that would let a
// retired scenario keep a preview, which is the defect this gate exists to close.
ENUM_TACTICAL_AUTHORITY TacticalAuthorityGate(const bool bull,const int src,const int trigger_bar,
                                              const double trigger,string &reason)
{
   reason="";
   string terminal_state="",terminal_why="",live_state="";
   bool dse_on=(InpUseDirectionalScenarioEngine && g_scn_built_time>0);
   bool dse_terminal=(dse_on && TacticalScenarioTerminal(bull,terminal_state,terminal_why));
   bool dse_live=(dse_on && TacticalScenarioLive(bull,live_state));
   bool blacklisted=(src!=1 && trigger>0.0 && IsSameIdeaAsBlacklisted(bull,trigger,trigger));
   int closed_now=ArraySize(g_buf_t)-2;
   int age=((src==2 && trigger_bar>=0 && closed_now>=trigger_bar) ? closed_now-trigger_bar : -1);
   return TacticalAuthorityDecide(bull,src,age,InpRetestTimeoutBars,dse_on,dse_terminal,
                                  terminal_state,terminal_why,blacklisted,dse_live,
                                  live_state,reason);
}

// In-terminal contract for the pure order above. Runs once from OnInit next to
// ScenarioMTEESelfTest(); it touches no global and draws nothing, so it cannot
// change a decision - it only proves the total order still holds in the build
// that is actually attached to the chart.
bool TacticalAuthoritySelfTest(string &where)
{
   where="";
   string r="";

   // T1 A terminal DSE scenario outranks everything else on that side.
   if(TacticalAuthorityDecide(true,2,0,40,true,true,"INVALIDATED","closed M5 breached 4044.00",
                              false,true,"EXECUTION READY",r)!=TAC_AUTH_BLOCKED ||
      StringFind(r,"INVALIDATED")<0 || StringFind(r,"4044.00")<0)
   { where="TAC-1 terminal DSE scenario must block, and say why"; return false; }

   // T2 The Core blacklist veto is horizon-bounded and never applies to a
   //    Core-owned direction (src==1).
   if(TacticalAuthorityDecide(true,0,-1,40,true,false,"","",true,true,"WATCHING ZONE",r)
      !=TAC_AUTH_BLOCKED)
   { where="TAC-2 a blacklisted idea must block"; return false; }
   if(TacticalAuthorityDecide(true,1,-1,40,true,false,"","",true,true,"WATCHING ZONE",r)
      !=TAC_AUTH_OK)
   { where="TAC-2 a Core-owned direction is exempt from the blacklist veto"; return false; }
   if(TacticalAuthorityDecide(true,0,-1,40,true,false,"","",false,true,"WATCHING ZONE",r)
      ==TAC_AUTH_BLOCKED)
   { where="TAC-2 releasing the blacklist must unblock the side"; return false; }

   // T3 A stale bias-only trigger is refused; the same age is fine when the
   //    trigger bar is unknown, and src!=2 is never aged out here.
   if(TacticalAuthorityDecide(true,2,180,40,true,false,"","",false,true,"WATCHING ZONE",r)
      !=TAC_AUTH_STALE || StringFind(r,"180")<0)
   { where="TAC-3 a 180-bar-old bias-only trigger must be STALE"; return false; }
   if(TacticalAuthorityDecide(true,2,-1,40,true,false,"","",false,true,"WATCHING ZONE",r)
      ==TAC_AUTH_STALE)
   { where="TAC-3 an unknown trigger age must not be guessed"; return false; }
   if(TacticalAuthorityDecide(true,0,180,40,true,false,"","",false,true,"WATCHING ZONE",r)
      ==TAC_AUTH_STALE)
   { where="TAC-3 only the bias-only source is aged out by this rule"; return false; }
   if(TacticalAuthorityDecide(true,2,40,40,true,false,"","",false,true,"WATCHING ZONE",r)
      ==TAC_AUTH_STALE)
   { where="TAC-3 the age bound is exclusive (age == limit is still fresh)"; return false; }

   // T4 A bias-only direction with no live scenario is CONTEXT, quoting the DSE's
   //    own state name when it has one - a LATE plan is never called "no plan".
   if(TacticalAuthorityDecide(false,2,0,40,true,false,"","",false,false,"LATE - WAIT FOR RETEST",r)
      !=TAC_AUTH_CONTEXT || StringFind(r,"LATE - WAIT FOR RETEST")<0)
   { where="TAC-4 CONTEXT must quote the DSE state name"; return false; }
   if(TacticalAuthorityDecide(false,2,0,40,true,false,"","",false,false,"",r)
      !=TAC_AUTH_CONTEXT || StringFind(r,"no DSE SELL scenario")<0)
   { where="TAC-4 with no plan at all CONTEXT must say so"; return false; }
   if(TacticalAuthorityDecide(false,2,0,40,false,false,"","",false,false,"",r)
      !=TAC_AUTH_CONTEXT || StringFind(r,"scenario engine is off")<0)
   { where="TAC-4 with the DSE off a bias-only preview is still CONTEXT"; return false; }

   // T5 A live scenario on that side is allowed, for every direction source.
   if(TacticalAuthorityDecide(true,2,0,40,true,false,"","",false,true,"REACTION CONFIRMED",r)
      !=TAC_AUTH_OK || r!="")
   { where="TAC-5 a live scenario must be allowed with no reason"; return false; }
   if(TacticalAuthorityDecide(true,1,0,40,false,false,"","",false,false,"",r)!=TAC_AUTH_OK)
   { where="TAC-5 a Core-owned direction is never CONTEXT"; return false; }
   if(TacticalAuthorityDecide(true,0,0,40,false,false,"","",false,false,"",r)!=TAC_AUTH_OK)
   { where="TAC-5 an early-break preview is never CONTEXT"; return false; }

   // T6 Determinism: identical inputs give an identical verdict and reason.
   string r2="";
   ENUM_TACTICAL_AUTHORITY a1=TacticalAuthorityDecide(true,2,10,40,true,false,"","",false,false,
                                                      "WATCHING ZONE",r);
   ENUM_TACTICAL_AUTHORITY a2=TacticalAuthorityDecide(true,2,10,40,true,false,"","",false,false,
                                                      "WATCHING ZONE",r2);
   if(a1!=a2 || r!=r2)
   { where="TAC-6 the order is not deterministic"; return false; }

   // T7 The verdict vocabulary the panel prints is complete and stable.
   if(TacticalAuthorityName((int)TAC_AUTH_OK)!="OK" ||
      TacticalAuthorityName((int)TAC_AUTH_CONTEXT)!="CONTEXT" ||
      TacticalAuthorityName((int)TAC_AUTH_STALE)!="STALE" ||
      TacticalAuthorityName((int)TAC_AUTH_BLOCKED)!="BLOCKED")
   { where="TAC-7 authority verdict names drifted"; return false; }
   return true;
}

// Directional location is read from the same D1 closed range and price stored in
// SScenarioContext. Premium favours SELL; discount favours BUY; equilibrium and
// missing data are explicit non-favourable states, not neutral substitutes.
void ScenarioMarkLocation(SScenarioPlan &p)
{
   p.location_class=0;
   if(!g_scn_ctx.dealing_range_ok || g_scn_ctx.daily_location_text=="" ||
      StringFind(g_scn_ctx.daily_location_text,"NO_DATA")>=0)
   {
      p.location_state=(g_scn_ctx.daily_location_text!=""?g_scn_ctx.daily_location_text:
                        "NO_DATA — D1 dealing range/location unavailable");
      return;
   }
   bool favourable=(p.is_buy ? g_scn_ctx.daily_location<0 : g_scn_ctx.daily_location>0);
   bool opposite=(p.is_buy ? g_scn_ctx.daily_location>0 : g_scn_ctx.daily_location<0);
   p.location_class=(favourable?1:(opposite?-1:0));
   p.location_state=g_scn_ctx.daily_location_text+" | for "+(p.is_buy?"BUY":"SELL")+
      (favourable?" = FAVOURABLE":(opposite?" = AGAINST SIDE":" = EQUILIBRIUM / NO EDGE"));
}

// Pure closed-M5 retest/invalidation scan over a preloaded, chronological tape.
// Confirmation is two distinct M5 candles: the first intersects the selected
// entry area after M15 availability; a later candle closes beyond its protected
// edge. A candle can never both touch and confirm its own retest.
bool ScenarioM5RetestScan(SScenarioPlan &p,const MqlRates &m5[],const int last_closed,
                          const datetime boundary)
{
   p.has_retest=false;
   p.retest_bar=-1;
   p.retest_time=0;
   p.retest_touch_time=0;
   p.retest_touch_low=0.0;
   p.retest_touch_high=0.0;
   p.retest_close=0.0;
   p.plan_dead=false;
   p.dead_note="";
   p.retest_note="";
   if(!p.valid || p.invalidated)
   {
      p.retest_note="NOT_EVALUATED(no live selected zone)";
      p.m5_state="NOT_EVALUATED(no live selected zone)";
      return false;
   }
   if(boundary<=0 || last_closed<0 || last_closed+1>=ArraySize(m5))
   {
      p.retest_note="NO_DATA — no closed M5 bar/next-open pair is available by ModelBoundary";
      p.m5_state=p.retest_note;
      return false;
   }
   if(!(p.structural_invalidation>0.0) || !(p.entry_zone_high>p.entry_zone_low))
   {
      p.retest_note="NOT_EVALUATED(no selected entry-zone/invalidation geometry)";
      p.m5_state=p.retest_note;
      return false;
   }
   p.m5_invalidation_history_ok=(p.zone_origin_time>0 && ArraySize(m5)>0 &&
      m5[0].time>0 && m5[0].time<=p.zone_origin_time);
   int scan_last=MathMin(last_closed,ArraySize(m5)-2);
   bool touched_before_confirmation=false;
   int touch_index=-1;
   int inspected=0;
   for(int i=0;i<=scan_last;i++)
   {
      if(m5[i].time<=0 || m5[i+1].time<=m5[i].time || m5[i+1].time>boundary ||
         !(m5[i].open>0.0) || !(m5[i].high>0.0) || !(m5[i].low>0.0) ||
         !(m5[i].close>0.0) || m5[i].high<m5[i].low ||
         m5[i].high<MathMax(m5[i].open,m5[i].close) ||
         m5[i].low>MathMin(m5[i].open,m5[i].close))
      {
         if(m5[i+1].time>boundary) break;
         p.retest_note="NO_DATA — M5 times/OHLC are invalid or non-chronological";
         p.m5_state=p.retest_note;
         return false;
      }
      inspected++;
      datetime available=m5[i+1].time;
      bool origin_proven=(p.zone_origin_time>0);
      if(origin_proven && m5[i].time<p.zone_origin_time) continue;
      // With no source birth time, pre-confirmation bars cannot safely be
      // attributed to this zone. Post-confirmation bars remain testable.
      bool after_evidence=(p.evidence_available>0 && m5[i].time>=p.evidence_available &&
                           available>p.evidence_available);
      if(!origin_proven && !after_evidence) continue;

      bool broken=(p.is_buy ? m5[i].close<p.structural_invalidation
                            : m5[i].close>p.structural_invalidation);
      if(broken)
      {
         p.plan_dead=true;
         p.dead_note="closed M5 candle "+TimeToString(m5[i].time,TIME_DATE|TIME_MINUTES)+
            " closed at "+DoubleToString(m5[i].close,_Digits)+
            (p.is_buy?" below BUY structural invalidation ":" above SELL structural invalidation ")+
            DoubleToString(p.structural_invalidation,_Digits);
         p.retest_note="INVALIDATED_BEFORE_RETEST — "+p.dead_note;
         p.m5_state="INVALIDATED — "+p.dead_note;
         return false;
      }

      bool intersects=(m5[i].high>=p.entry_zone_low && m5[i].low<=p.entry_zone_high);
      bool close_inside=(m5[i].close>=p.entry_zone_low && m5[i].close<=p.entry_zone_high);
      bool hit_zone=(intersects || close_inside);
      if(p.evidence_available>0 && available<=p.evidence_available && hit_zone)
         touched_before_confirmation=true;
      if(!after_evidence) continue;
      if(touch_index<0 && hit_zone)
      {
         touch_index=i;
         p.retest_touch_time=m5[i].time;
         p.retest_touch_low=m5[i].low;
         p.retest_touch_high=m5[i].high;
         continue;
      }
      if(touch_index>=0 && i>touch_index)
      {
         bool reclaimed=(p.is_buy ? m5[i].close>p.entry_zone_high
                                  : m5[i].close<p.entry_zone_low);
         if(reclaimed)
         {
            p.has_retest=true;
            p.retest_bar=i;
            p.retest_time=m5[i].time;
            p.retest_close=m5[i].close;
            p.retest_note="CONFIRMED — M5 touch candle "+
               TimeToString(p.retest_touch_time,TIME_DATE|TIME_MINUTES)+" range "+
               DoubleToString(p.retest_touch_low,_Digits)+".."+
               DoubleToString(p.retest_touch_high,_Digits)+"; later M5 reclaim candle "+
               TimeToString(p.retest_time,TIME_DATE|TIME_MINUTES)+" closed "+
               DoubleToString(p.retest_close,_Digits)+" beyond "+
               (p.is_buy?"upper":"lower")+" entry-zone edge "+
               DoubleToString(p.is_buy?p.entry_zone_high:p.entry_zone_low,_Digits);
            if(!p.m5_invalidation_history_ok)
               p.retest_note+=" | NO_DATA — closed M5 invalidation history does not cover the zone origin";
            p.m5_state="CONFIRMED — "+p.retest_note;
            return true;
         }
      }
   }
   if(!p.m5_data_ok)
   {
      p.retest_note="NO_DATA — M5 ATR/spread/risk window is incomplete; retest scan inspected "+
                     IntegerToString(inspected)+" closed M5 bars only";
      if(!p.m5_invalidation_history_ok)
         p.retest_note+=" | NO_DATA — closed M5 invalidation history does not cover the zone origin";
      p.m5_state=p.retest_note;
      return false;
   }
   if(p.evidence_available<=0 || !p.has_structure)
   {
      p.retest_note="NOT_EVALUATED(M15 structure confirmation/availability prerequisite is not satisfied)";
      if(!p.m5_invalidation_history_ok)
         p.retest_note+=" | NO_DATA — closed M5 invalidation history does not cover the zone origin";
      p.m5_state=p.retest_note;
      return false;
   }
   if(touch_index>=0)
   {
      p.retest_note="PENDING — WAITING_FOR_RETEST: M5 touched the selected area at "+
         TimeToString(p.retest_touch_time,TIME_DATE|TIME_MINUTES)+
         "; no later closed M5 candle has reclaimed beyond the protected edge";
      p.m5_state=p.retest_note;
   }
   else if(touched_before_confirmation)
   {
      p.retest_note="PENDING — RETEST_OCCURRED_BEFORE_CONFIRMATION: a closed M5 touch preceded M15 structure availability; a new post-confirmation touch is required";
      p.m5_state=p.retest_note;
   }
   else
   {
      p.retest_note="PENDING — RETEST_NOT_OCCURRED: no closed M5 bar after M15 availability intersected the selected entry area";
      p.m5_state=p.retest_note;
   }
   if(!p.m5_invalidation_history_ok)
      p.retest_note+=" | NO_DATA — closed M5 invalidation history does not cover the zone origin";
   p.m5_state=(p.has_retest?"CONFIRMED — "+p.retest_note:p.retest_note);
   return false;
}

// Evidence-quality score only. The ZRE intrinsic term already includes its
// source-count, tier, sweep and freshness evidence, so those are not counted a
// second time. RXN's aggregate reaction_score is also excluded because it embeds
// the zone term; only distinct stage completion flags add evidence points.
int ScenarioRankScore(const SScenarioPlan &p)
{
   int score=(int)MathMax(0,MathMin(100,p.zone_intrinsic));
   if(p.has_reaction) score+=6;
   if(p.has_displacement) score+=3;
   if(p.has_structure) score+=3;
   if(p.has_retest) score+=2;
   if(p.causal_zone) score+=1;
   return score;
}

// Candidate qualification is explicit and ordered: A) current zone validity,
// B) D1/H4 alignment, C) intrinsic/causal evidence, D) closed-M5 risk/target.
// Secondary missing stages remain on the plan with NO_DATA/NOT_EVALUATED reasons.
void ScenarioMarkRelevant(SScenarioPlan &p)
{
   p.relevant=false;
   p.validity_pass=false;
   p.candidate_qualified=false;
   p.countertrend=false;
   p.distance_available=false;
   p.distance_atr=0.0;
   p.alignment_rank=0;
   p.alignment_state="NO_DATA — D1/H4 directional context unavailable";
   p.qualification_reason="NO_QUALIFIED_CANDIDATE — candidate not evaluated";
   if(!p.valid) return;
   int dir=(p.is_buy?1:-1);
   bool d1_dir=(g_scn_ctx.d1.data_ok && g_scn_ctx.d1.known);
   bool h4_dir=(g_scn_ctx.h4.data_ok && g_scn_ctx.h4.known);
   bool h1_dir=(g_scn_ctx.h1.data_ok && g_scn_ctx.h1.known);
   if(d1_dir && h4_dir)
   {
      if(g_scn_ctx.d1.bias==dir && g_scn_ctx.h4.bias==dir)
      {
         if(h1_dir && g_scn_ctx.h1.bias==dir)
         {
            p.alignment_rank=3;
            p.alignment_state="D1/H4/H1 ALIGNED "+(p.is_buy?"BULL":"BEAR");
         }
         else if(h1_dir)
         {
            p.alignment_rank=2;
            p.alignment_state="D1/H4 ALIGNED "+(p.is_buy?"BULL":"BEAR")+
               "; H1 CONFLICTS (candidate remains visible, not qualified)";
         }
         else
         {
            p.alignment_rank=1;
            p.alignment_state="D1/H4 ALIGNED "+(p.is_buy?"BULL":"BEAR")+
               "; H1 "+g_scn_ctx.h1.direction_state+
               " (NO_DATA/RANGE: candidate retained but not qualified)";
         }
      }
      else if(g_scn_ctx.d1.bias==g_scn_ctx.h4.bias && g_scn_ctx.d1.bias!=dir)
      {
         p.countertrend=true;
         p.alignment_rank=0;
         p.alignment_state="COUNTERTREND - D1/H4 both "+
            (g_scn_ctx.d1.bias>0?"BULL":"BEAR")+" against "+(p.is_buy?"BUY":"SELL")+
            "; weighted verdict "+
            (g_scn_ctx.bias_net_dir>0?"BULLISH":(g_scn_ctx.bias_net_dir<0?"BEARISH":"NO NET DIRECTION"))+
            " "+IntegerToString(g_scn_ctx.bias_net_score)+"/100; H1 "+g_scn_ctx.h1.direction_state;
      }
      else
      {
         // v6.5.3 (D7): when D1 and H4 disagree, the candidate is now ranked by
         // the WEIGHTED verdict of the three closed biases (D1 50 / H4 30 / H1 20,
         // explicit HTF-wins tie-break) instead of being flattened to "one leg
         // happens to agree". Qualification is NOT loosened - rank 3 (full
         // D1/H4/H1 alignment) is still required for candidate_qualified - but
         // WHICH side the conflict favours is stated instead of left undecided.
         p.alignment_rank=(g_scn_ctx.bias_net_dir==dir?1:0);
         p.alignment_state="D1/H4 CONFLICT - weighted verdict "+
            (g_scn_ctx.bias_net_dir>0?"BULLISH ": (g_scn_ctx.bias_net_dir<0?"BEARISH ":"NO NET DIRECTION "))+
            IntegerToString(g_scn_ctx.bias_net_score)+"/100 ("+g_scn_ctx.bias_rule_text+"); D1 "+
            g_scn_ctx.d1.direction_state+"; H4 "+g_scn_ctx.h4.direction_state+
            "; H1 "+g_scn_ctx.h1.direction_state+
            (g_scn_ctx.bias_net_dir==dir?" (the weighting favours this candidate; it is still not qualified)"
                                       :" (the weighting opposes this candidate)");
      }
   }
   else
   {
      p.alignment_rank=0;
      p.alignment_state="NO_DATA/RANGE — D1 "+g_scn_ctx.d1.direction_state+
         "; H4 "+g_scn_ctx.h4.direction_state+"; H1 "+g_scn_ctx.h1.direction_state+
         (g_scn_ctx.d1.data_reason!=""?" | "+g_scn_ctx.d1.data_reason:"");
   }
   if(g_scn_ctx.selection_atr>0.0 && g_scn_ctx.close_price>0.0)
   {
      double gap=0.0;
      if(g_scn_ctx.close_price<p.zone_low) gap=p.zone_low-g_scn_ctx.close_price;
      else if(g_scn_ctx.close_price>p.zone_high) gap=g_scn_ctx.close_price-p.zone_high;
      p.distance_atr=gap/g_scn_ctx.selection_atr;
      p.distance_available=true;
   }
   bool side_ok=(p.is_buy ? g_scn_ctx.close_price>=p.zone_low
                          : g_scn_ctx.close_price<=p.zone_high);
   bool age_known=(p.zone_age>=0);
   bool fresh=(age_known && (InpZREFreshBars<=0 || p.zone_age<=InpZREFreshBars));
   bool within_horizon=(p.distance_available &&
      p.distance_atr<=MathMax(0.0,InpZREApproachATR*SCN_RELEVANCE_APPROACH_MULT));
   p.validity_pass=(!p.invalidated && !p.plan_dead && side_ok && age_known && fresh &&
                    !p.late && within_horizon);
   p.relevant=p.validity_pass;
   if(p.invalidated) p.qualification_reason="INVALIDATED — zone is broken or expired";
   else if(p.plan_dead) p.qualification_reason="INVALIDATED — closed M5 candle breached the selected-zone boundary";
   else if(!side_ok) p.qualification_reason="NO_QUALIFIED_CANDIDATE — last closed price is beyond the wrong side of this zone";
   // v6.5.3: an unknown age is a ZONE-PROVENANCE fact, not a data-feed failure,
   // and it is named as such so it can never be read as contradicting FEED OK.
   else if(!age_known) p.qualification_reason="AGE_UNKNOWN — this zone publishes no birth bar, so freshness cannot be verified (provenance fact; the feed itself is unaffected)";
   else if(!fresh) p.qualification_reason="NO_QUALIFIED_CANDIDATE — zone age exceeds InpZREFreshBars";
   else if(p.late) p.qualification_reason="LATE_WAIT_RETEST — existing InpChaseFilter/InpChaseMaxATR limit exceeded";
   else if(!p.distance_available) p.qualification_reason="METRIC_MISSING — closed H1 ATR / last closed chart price distance is unavailable (provenance fact; the feed itself is unaffected)";
   else if(!within_horizon) p.qualification_reason="NO_QUALIFIED_CANDIDATE — distance exceeds the existing ZRE approach horizon in closed H1 ATR";
   else p.qualification_reason="Priority A passed: live, correctly sided, fresh, unchased zone within the closed-H1 approach horizon";

   p.scenario_type=(p.countertrend?"COUNTERTREND WATCH":
      (p.alignment_rank==2?(p.is_buy?"D1/H4 ALIGNED BUY":"D1/H4 ALIGNED SELL"):
       (g_scn_ctx.conflict?("D1/H4 CONFLICT (weighted "+
                            (g_scn_ctx.bias_net_dir>0?"BULLISH":(g_scn_ctx.bias_net_dir<0?"BEARISH":"NONE"))+
                            " "+IntegerToString(g_scn_ctx.bias_net_score)+"/100)"):
                           "DIRECTIONAL CONTEXT UNAVAILABLE")));
   if(p.validity_pass && p.countertrend)
      p.qualification_reason="COUNTERTREND_WATCH — valid zone, but D1/H4 resolved the opposite direction";
   else if(p.validity_pass && p.alignment_rank<3)
      p.qualification_reason="NO_QUALIFIED_CANDIDATE — required D1/H4/H1 directional alignment is absent, conflicting, or unavailable; "+p.alignment_state;
   else if(p.validity_pass && p.location_class!=1)
      p.qualification_reason=(p.location_class<0 ?
         "NO_QUALIFIED_CANDIDATE — daily premium/discount location is against this side" :
         "NO_QUALIFIED_CANDIDATE — D1 EQ location is neutral or unavailable");
   else if(p.validity_pass && !p.geometry_valid)
      p.qualification_reason=(p.entry_unavailable!=""?"NO_QUALIFIED_CANDIDATE — "+p.entry_unavailable:
                             "NO_QUALIFIED_CANDIDATE — closed-M5 target/risk geometry is unavailable");
   else if(p.validity_pass && !p.m5_data_ok)
      p.qualification_reason="NO_DATA — M5 ATR/spread/risk planning is incomplete";
   else if(p.validity_pass && !p.m5_invalidation_history_ok)
      p.qualification_reason="NO_DATA — closed M5 invalidation history does not cover the zone origin";
   p.candidate_qualified=(p.validity_pass && p.alignment_rank==3 &&
                          p.location_class==1 && p.geometry_valid && p.m5_data_ok &&
                          p.m5_invalidation_history_ok);
   if(p.candidate_qualified)
      p.qualification_reason="QUALIFIED — D1/H4 aligned; D1 location favourable; M5 stop, spread, TP1 and net RR passed";
}

void ScenarioClassifyPlan(SScenarioPlan &p)
{
   if(!p.valid) return;
   if(p.execution_ready)
   {
      p.state=SCN_EXECUTION_READY; // only the existing Core authorization may set this flag
      return;
   }
   if(p.invalidated)
   {
      p.state=(p.zone_state==(int)ZRE_ST_EXPIRED ||
               (p.zone_age>=0 && InpZREExpireBars>0 && p.zone_age>InpZREExpireBars) ?
               SCN_EXPIRED:SCN_INVALIDATED);
      p.trigger="N/A — selected zone is broken or expired";
      p.missing="fresh, valid zone";
      p.blocking_gate="INVALIDATED — "+p.qualification_reason;
      p.entry_unavailable=p.blocking_gate;
      return;
   }
   if(p.plan_dead)
   {
      p.state=SCN_INVALIDATED;
      p.trigger="N/A — "+p.dead_note;
      p.missing="fresh, valid zone after M5 invalidation";
      p.blocking_gate="INVALIDATED — "+p.dead_note;
      p.entry_unavailable=p.blocking_gate;
      return;
   }
   if(p.late)
      p.state=SCN_LATE_WAIT_FOR_RETEST;
   else if(p.zone_state==(int)ZRE_ST_TOUCHED_PREVIEW)
      p.state=SCN_TOUCHED_PREVIEW; // forming candle is preview only
   else if(p.countertrend && p.validity_pass)
      p.state=SCN_COUNTERTREND_WATCH;
   else if(p.has_retest)
      p.state=SCN_RETEST_CONFIRMED;
   else if(p.has_structure && !p.m5_data_ok)
      p.state=SCN_STRUCTURE_CONFIRMED;
   else if(p.has_structure)
      p.state=SCN_WAITING_FOR_RETEST;
   else if(p.has_displacement)
      p.state=SCN_DISPLACEMENT_CONFIRMED;
   else if(p.has_reaction)
      p.state=SCN_REACTION_CONFIRMED;
   else if(p.distance_available && p.distance_atr<=InpZREApproachATR)
      p.state=SCN_ZONE_APPROACHING;
   else
      p.state=SCN_WATCHING_ZONE;

   string side=(p.is_buy?"BUY":"SELL");
   if(p.late)
   {
      p.trigger="do not chase; wait for a new closed-M5 touch/reclaim after price returns to the selected area";
      p.missing="fresh post-extension M5 retest";
      p.blocking_gate="LATE_WAIT_RETEST — existing chase limit exceeded";
   }
   else if(p.has_retest)
   {
      p.trigger=p.retest_note+"; Core has not authorized entry";
      p.missing="Scenario/MTEE retest is planning evidence only; existing Core setup/lifecycle and validation gates remain required";
      p.blocking_gate="Core setup/lifecycle authority";
   }
   else if(p.has_structure)
   {
      p.trigger="wait for a closed M5 touch of ["+DoubleToString(p.entry_zone_low,_Digits)+", "+
         DoubleToString(p.entry_zone_high,_Digits)+"] then a later close beyond "+
         DoubleToString(p.is_buy?p.entry_zone_high:p.entry_zone_low,_Digits);
      p.missing=p.retest_note;
      p.blocking_gate="M5 retest stage; Core authorization remains separate";
   }
   else if(p.has_reaction || p.has_displacement)
   {
      p.trigger="wait for the same-level, causally later M15 structure stage";
      p.missing=p.m15_state;
      p.blocking_gate=(p.m15_state!=""?p.m15_state:"M15 structure prerequisite");
   }
   else
   {
      p.trigger="wait for a closed M30 rejection followed by later displacement on the exact selected zone ID";
      p.missing=p.m30_state;
      p.blocking_gate=(p.m30_state!=""?p.m30_state:"M30 exact-zone rejection prerequisite");
   }
   if(p.countertrend && !p.execution_ready && !p.late)
   {
      p.state=SCN_COUNTERTREND_WATCH;
      p.blocking_gate="COUNTERTREND_WATCH — D1/H4 resolved the other direction; visible for context only";
      p.missing=p.qualification_reason;
   }
   else if(!p.validity_pass)
   {
      p.blocking_gate=p.qualification_reason;
      p.missing=p.qualification_reason;
   }
   else if(p.alignment_rank<3)
   {
      p.blocking_gate=p.alignment_state;
      p.missing=p.alignment_state;
   }
   else if(p.location_class!=1)
   {
      p.blocking_gate=p.location_state;
      p.missing=p.location_state;
   }
   else if(!p.geometry_valid)
   {
      p.blocking_gate=(p.entry_unavailable!=""?p.entry_unavailable:
                       "NO_DATA — closed-M5 risk/target geometry unavailable");
      p.missing=p.blocking_gate;
   }
   else if(!p.m5_invalidation_history_ok)
   {
      p.blocking_gate="NO_DATA — closed M5 invalidation history does not cover the zone origin";
      p.missing=p.blocking_gate;
   }
   if(!p.execution_ready)
   {
      if(p.entry_unavailable=="" || p.entry_unavailable=="conditional planning only; Scenario/MTEE never authorizes entry")
      {
         if(!p.candidate_qualified) p.entry_unavailable=p.qualification_reason;
         else if(p.has_retest)
            p.entry_unavailable="Core has not independently authorized this setup; MTEE retest is not execution readiness";
         else p.entry_unavailable=p.entry_confirmation;
      }
   }
}

void ScenarioBuildZonePlan(const SZREZone &z,const int zre_index,const bool recovered,
                           const int closed,SScenarioPlan &out)
{
   bool flipped=false;
   int zstate=(int)ZRE_ST_IDLE;
   if(zre_index>=0 && zre_index<ArraySize(g_zre_status))
   {
      zstate=(int)g_zre_status[zre_index].base_state;
      flipped=g_zre_status[zre_index].flipped;
   }
   ENUM_ZRE_SIDE effective_side=z.side;
   if(flipped) effective_side=(z.side==ZRE_SUPPORT?ZRE_RESISTANCE:ZRE_SUPPORT);
   bool is_buy=(effective_side==ZRE_SUPPORT);
   ScenarioPlanInit(out,is_buy);
   if(z.id=="")
   {
      out.unavailable_reason="NO_DATA — source registry zone has no stable zone_id";
      return;
   }
   if(!(z.hi>z.lo) || !(z.lo>0.0))
   {
      out.unavailable_reason="NO_DATA — invalid low/high geometry in the source registry";
      return;
   }
   out.valid=true;
   out.recovered_zone=recovered;
   out.role_flipped=flipped;
   out.zone_id=z.id;
   out.zone_sources=z.sources;
   out.zone_low=z.lo;
   out.zone_high=z.hi;
   out.zone_strength=z.strength;
   out.zone_intrinsic=z.intrinsic; // ZRE publishes intrinsic separately from context
   out.zone_age=z.age_bars;
   out.zone_timeframe="UNAVAILABLE — ZRE/RXN zone record does not expose its source timeframe";
   out.zone_state=zstate;
   if(z.age_bars>=0 && closed>=z.age_bars)
   {
      int origin=closed-z.age_bars;
      if(origin>=0 && origin<ArraySize(g_buf_t) && g_buf_t[origin]>0 &&
         g_scn_ctx.boundary>0 && g_buf_t[origin]<=g_scn_ctx.boundary)
         out.zone_origin_time=g_buf_t[origin];
   }
   out.invalidated=(zstate==(int)ZRE_ST_BROKEN || zstate==(int)ZRE_ST_EXPIRED ||
      (z.age_bars>=0 && InpZREExpireBars>0 && z.age_bars>InpZREExpireBars));
   out.volume_context=CoreDashVolumeLine(closed); // informational only, never a gate
   out.confluence_zone=(z.units>=2); // already represented in ZRE intrinsic; display only
   out.zone_swept=z.swept;            // already represented in ZRE intrinsic; display only

   SRxnEvidence rx;
   bool have_rx=ScenarioRxnForZone(is_buy,z.id,rx);
   if(have_rx)
   {
      out.reaction_phase=rx.phase;
      out.reaction_level=rx.level;
      out.reaction_outcome=rx.outcome;
      out.reaction_score=rx.reaction_score; // display only; aggregate includes intrinsic and is not re-scored
      out.causal_zone=(rx.fvg_detected || rx.ob_detected);
   }
   ScenarioChainMirror(out);
   ScenarioEvaluateM30M15(out,rx,have_rx);
   ScenarioMarkLocation(out);
   ScenarioMarkLate(out);
   ScenarioEvaluateGeometry(out);
   ScenarioLegTexts(out);
   out.rank_score=ScenarioRankScore(out);
   ScenarioMarkRelevant(out);
   ScenarioClassifyPlan(out);
}

bool ScenarioPlanBetter(const SScenarioPlan &a,const SScenarioPlan &b)
{
   if(!a.valid) return false;
   if(!b.valid) return true;
   // Total order implements the requested priority classes before deterministic
   // tie-breakers: A validity, B D1/H4/H1 alignment, C independent evidence quality,
   // D validated room/RR, then closed-H1-ATR distance, freshness age and stable ID.
   if(a.validity_pass!=b.validity_pass) return a.validity_pass;                    // A
   if(a.invalidated!=b.invalidated) return !a.invalidated;
   if(a.plan_dead!=b.plan_dead) return !a.plan_dead;
   if(a.alignment_rank!=b.alignment_rank) return a.alignment_rank>b.alignment_rank; // B
   if(a.rank_score!=b.rank_score) return a.rank_score>b.rank_score;                 // C
   if(a.geometry_valid!=b.geometry_valid) return a.geometry_valid;                 // D
   if(MathAbs(a.barrier_room_atr-b.barrier_room_atr)>1e-9)
      return a.barrier_room_atr>b.barrier_room_atr;
   if(MathAbs(a.expected_r-b.expected_r)>1e-9) return a.expected_r>b.expected_r;
   if(a.candidate_qualified!=b.candidate_qualified) return a.candidate_qualified;
   if(a.distance_available!=b.distance_available) return a.distance_available;
   if(a.distance_available && MathAbs(a.distance_atr-b.distance_atr)>1e-9)
      return a.distance_atr<b.distance_atr;
   if(a.zone_age>=0 && b.zone_age>=0 && a.zone_age!=b.zone_age) return a.zone_age<b.zone_age;
   if((a.zone_age>=0)!=(b.zone_age>=0)) return a.zone_age>=0;
   return StringCompare(a.zone_id,b.zone_id)<0;
}

void ScenarioConsiderPlan(const SScenarioPlan &candidate,SScenarioPlan &best)
{
   if(!candidate.valid) return;
   if(ScenarioPlanBetter(candidate,best)) ScenarioPlanCopy(best,candidate);
}

void ScenarioDiscover(const int closed)
{
   ScenarioPlanInit(g_scn_buy,true);
   ScenarioPlanInit(g_scn_sell,false);
   if(!InpUseZRE)
   {
      g_scn_buy.unavailable_reason="NO_DATA — zone registry disabled (InpUseZRE=false)";
      g_scn_sell.unavailable_reason="NO_DATA — zone registry disabled (InpUseZRE=false)";
      return;
   }
   if(closed<0 || closed>=ArraySize(g_buf_t) || g_zre_built_time!=g_buf_t[closed])
   {
      g_scn_buy.unavailable_reason="NO_DATA — ZRE zone registry is not available for this closed chart bar";
      g_scn_sell.unavailable_reason="NO_DATA — ZRE zone registry is not available for this closed chart bar";
      return;
   }

   int buy_seen=0,sell_seen=0,buy_bad=0,sell_bad=0;
   string buy_bad_reason="",sell_bad_reason="";
   // Deliberately consume every kept ZRE zone, without applying chart-drawing
   // caps or display filters; the downstream comparator decides the best plan.
   for(int i=0;i<ArraySize(g_zre_zones);i++)
   {
      SScenarioPlan candidate;
      ScenarioBuildZonePlan(g_zre_zones[i],i,false,closed,candidate);
      if(candidate.is_buy)
      {
         buy_seen++;
         if(!candidate.valid){ buy_bad++; if(buy_bad_reason=="") buy_bad_reason=candidate.unavailable_reason; }
         ScenarioConsiderPlan(candidate,g_scn_buy);
      }
      else
      {
         sell_seen++;
         if(!candidate.valid){ sell_bad++; if(sell_bad_reason=="") sell_bad_reason=candidate.unavailable_reason; }
         ScenarioConsiderPlan(candidate,g_scn_sell);
      }
   }
   // RXN retains dropped/tail zones that are not necessarily drawn. Include each
   // unique non-empty ID once, independent of rendering lists and chart filters.
   for(int i=0;i<ArraySize(g_rxn_extra_zones);i++)
   {
      string zid=g_rxn_extra_zones[i].id;
      if(zid!="" && ScenarioZoneAlreadyKnown(zid,ArraySize(g_zre_zones))) continue;
      bool duplicate=false;
      if(zid!="")
         for(int j=0;j<i;j++) if(g_rxn_extra_zones[j].id==zid){ duplicate=true; break; }
      if(duplicate) continue;
      SScenarioPlan candidate;
      ScenarioBuildZonePlan(g_rxn_extra_zones[i],-1,true,closed,candidate);
      if(candidate.is_buy)
      {
         buy_seen++;
         if(!candidate.valid){ buy_bad++; if(buy_bad_reason=="") buy_bad_reason=candidate.unavailable_reason; }
         ScenarioConsiderPlan(candidate,g_scn_buy);
      }
      else
      {
         sell_seen++;
         if(!candidate.valid){ sell_bad++; if(sell_bad_reason=="") sell_bad_reason=candidate.unavailable_reason; }
         ScenarioConsiderPlan(candidate,g_scn_sell);
      }
   }
   if(!g_scn_buy.valid)
      g_scn_buy.unavailable_reason=(buy_seen==0 ?
         "NO_QUALIFIED_CANDIDATE — no BUY-side zone in kept ZRE or undrawn RXN candidate lists" :
         "NO_QUALIFIED_CANDIDATE — examined "+IntegerToString(buy_seen)+" BUY records; "+
         IntegerToString(buy_bad)+" had unusable source geometry/ID: "+buy_bad_reason);
   if(!g_scn_sell.valid)
      g_scn_sell.unavailable_reason=(sell_seen==0 ?
         "NO_QUALIFIED_CANDIDATE — no SELL-side zone in kept ZRE or undrawn RXN candidate lists" :
         "NO_QUALIFIED_CANDIDATE — examined "+IntegerToString(sell_seen)+" SELL records; "+
         IntegerToString(sell_bad)+" had unusable source geometry/ID: "+sell_bad_reason);
}

bool ScenarioCoreReady(bool &is_buy)
{
   is_buy=true;
   if(!g_trade_setup.valid || g_trade_setup.confirmation_pending) return false;
   if(g_trade_setup.confirmation_bar<=g_trade_setup.created_bar ||
      g_trade_setup.confirmation_bar<0 || g_trade_setup.confirmation_time<=g_trade_setup.created_time)
      return false;
   if(!ValidateTargetGeometry(g_trade_setup.is_buy,g_trade_setup.entry,g_trade_setup.sl,
                              g_trade_setup.tp1,g_trade_setup.tp2,g_trade_setup.tp3))
      return false;
   is_buy=g_trade_setup.is_buy;
   return true;
}

void ScenarioApplyCoreReady()
{
   bool is_buy=true;
   if(!ScenarioCoreReady(is_buy)) return;
   SScenarioPlan p;
   ScenarioPlanInit(p,is_buy);
   p.valid=true;
   p.is_buy=is_buy;
   p.execution_ready=true;
   p.zone_id=g_trade_setup.setup_event_id;
   p.zone_sources="CORE "+g_trade_setup.zone_source;
   p.zone_low=g_trade_setup.zone_bottom;
   p.zone_high=g_trade_setup.zone_top;
   p.zone_strength=0;
   p.zone_intrinsic=0;
   p.zone_age=-1;
   p.zone_state=(int)ZRE_ST_REACTION_CONFIRMED;
   p.scenario_type="CORE AUTHORIZED";
   p.state=SCN_EXECUTION_READY;
   p.reaction_phase=(int)RXN_P9_EXECUTION_READY;
   p.reaction_level=(int)RXN_LEVEL_EXECUTION_READY;
   p.has_reaction=true;
   p.has_displacement=true;
   p.has_structure=true;
   p.has_retest=true;
   p.retest_low=g_trade_setup.zone_bottom;
   p.retest_high=g_trade_setup.zone_top;
   p.entry_zone_low=g_trade_setup.zone_bottom;
   p.entry_zone_high=g_trade_setup.zone_top;
   p.entry_zone_reason="immutable Core setup zone (authoritative)";
   p.target1_type="Core target 1";
   p.target2_type="Core target 2";
   p.target3_type="Core target 3";
   p.reference_entry=g_trade_setup.entry;
   p.has_proposed_entry=true;
   p.proposed_entry=g_trade_setup.entry;
   p.structural_invalidation=g_trade_setup.sl;
   p.geometry_valid=true;
   p.stop_loss=g_trade_setup.sl;
   p.nearest_barrier=g_trade_setup.immutable_target_barrier;
   p.barrier_type=g_trade_setup.immutable_target_barrier_type;
   p.target1=g_trade_setup.tp1;
   p.target2=g_trade_setup.tp2;
   p.target3=g_trade_setup.tp3;
   p.expected_r=g_trade_setup.rr1;
   p.trigger="Core lifecycle confirmed a later closed-bar retest";
   p.missing="none — existing Core setup is authoritative";
   p.blocking_gate="none";
   p.rank_score=0;
   // v6.5.2 The exact-entry vocabulary of an authorized plan is Core's own,
   // verbatim - no scenario arithmetic is mixed into it, and the ladder rows say
   // so instead of pretending the chain re-derived it.
   p.preferred_entry_area=DoubleToString(g_trade_setup.entry,_Digits)+" (Core authorized)";
   p.entry_basis="CORE LIFECYCLE (authorized entry price, not a scenario estimate)";
   p.has_trigger=true;
   p.trigger_price=g_trade_setup.entry;
   p.trigger_price_note="already triggered and confirmed by the Core lifecycle on a closed bar";
   p.entry_confirmation="Core confirmed: bar "+IntegerToString((int)g_trade_setup.confirmation_bar)+
                        " at "+TimeToString(g_trade_setup.confirmation_time,TIME_DATE|TIME_MINUTES);
   p.entry_unavailable="";
   p.has_sl=true;
   p.sl_price=g_trade_setup.sl;
   p.barrier_distance=MathAbs(g_trade_setup.tp1-g_trade_setup.entry);
   p.barrier_room_atr=(g_scn_ctx.atr>0.0?p.barrier_distance/g_scn_ctx.atr:0.0);
   p.location_state="not applicable: Core authorization does not depend on the scenario equilibrium term";
   p.relevant=true;
   p.retest_note="Core's own closed-bar retest is the authority for this plan";
   p.m30_state="CONFIRMED — mirrored from the Core causal chain (authoritative)";
   p.m15_state="CONFIRMED — Core structure and target validation (authoritative)";
   p.m5_state ="CONFIRMED — Core confirmed its closed-bar retest; Core alone authorized entry";
   p.mtf_blocker=(g_td.computed?g_td.blocker:"");
   if(is_buy) ScenarioPlanCopy(g_scn_buy,p);
   else       ScenarioPlanCopy(g_scn_sell,p);
}

string ScenarioEntryStatusToken(const SScenarioPlan &p)
{
   if(p.execution_ready) return "EXECUTION_READY"; // flag is written only by ScenarioApplyCoreReady
   if(p.invalidated || p.plan_dead) return "INVALIDATED";
   if(!p.valid) return "NO_QUALIFIED_CANDIDATE";
   if(p.late) return "LATE_WAIT_RETEST";
   if(p.countertrend && p.validity_pass) return "COUNTERTREND_WATCH";
   if(!p.candidate_qualified || !p.m5_invalidation_history_ok) return "NO_QUALIFIED_CANDIDATE";
   if(p.has_retest && p.m5_data_ok && p.geometry_valid) return "RETEST_CONFIRMED";
   if(p.has_structure) return (p.m5_data_ok?"WAITING_RETEST":"STRUCTURE_CONFIRMED");
   if(p.has_reaction || p.has_displacement) return "REACTION_CONFIRMED";
   return "WATCH";
}

string ScenarioPlanHeadline(const SScenarioPlan &p)
{
   string status=ScenarioEntryStatusToken(p);
   if(!p.valid) return status+" — "+p.unavailable_reason;
   if(p.execution_ready) return "EXECUTION_READY — existing Core authorization only";
   if(p.invalidated || p.plan_dead) return "INVALIDATED — "+p.qualification_reason;
   if(p.late) return "LATE_WAIT_RETEST — "+p.qualification_reason;
   if(p.countertrend && p.validity_pass) return "COUNTERTREND_WATCH — "+p.alignment_state;
   if(!p.candidate_qualified) return status+" — "+p.qualification_reason;
   if(p.has_retest) return status+" — M5 touch at "+
      TimeToString(p.retest_touch_time,TIME_DATE|TIME_MINUTES)+" then reclaim at "+
      TimeToString(p.retest_time,TIME_DATE|TIME_MINUTES)+"; Core not authorized";
   if(p.has_structure) return status+" — "+p.m5_state;
   if(p.has_reaction || p.has_displacement) return status+" — "+p.m15_state;
   return status+" — "+p.m30_state;
}

// Name the exact criterion in the same total order used for both candidate
// selection and the buy-vs-sell comparison.
string ScenarioPlanLeadKey(const SScenarioPlan &a,const SScenarioPlan &b)
{
   if(a.validity_pass!=b.validity_pass) return "Priority A current validity/freshness/chase/horizon";
   if(a.invalidated!=b.invalidated) return "zone invalidation/expiry";
   if(a.plan_dead!=b.plan_dead) return "closed-M5 invalidation";
   if(a.alignment_rank!=b.alignment_rank) return "Priority B D1/H4/H1 alignment";
   if(a.rank_score!=b.rank_score) return "Priority C independent evidence quality";
   if(a.geometry_valid!=b.geometry_valid) return "Priority D validated M5 target geometry";
   if(MathAbs(a.barrier_room_atr-b.barrier_room_atr)>1e-9) return "Priority D ATR-normalized opposing-barrier room";
   if(MathAbs(a.expected_r-b.expected_r)>1e-9) return "Priority D net-of-M5-spread expected R";
   if(a.candidate_qualified!=b.candidate_qualified) return "complete candidate qualification";
   if(a.distance_available!=b.distance_available) return "closed-H1-ATR distance availability";
   if(a.distance_available && MathAbs(a.distance_atr-b.distance_atr)>1e-9) return "shorter closed-H1-ATR distance";
   if(a.zone_age!=b.zone_age) return "zone freshness age";
   return "stable zone_id ordering";
}

void ScenarioBuildVerdict()
{
   g_scn_verdict=(int)SCV_NO_TRADE;
   g_scn_verdict_reason="no authorized Core entry";
   g_scn_next_action="wait for the next closed-bar planning condition; MTEE does not execute";
   g_scn_preferred="NONE";
   g_scn_preferred_reason="no qualified candidate on either side";
   g_scn_entry_status="NO_QUALIFIED_CANDIDATE";
   if(g_scn_buy.execution_ready)
   {
      g_scn_verdict=(int)SCV_BUY_EXECUTION_READY;
      g_scn_verdict_reason="ScenarioApplyCoreReady mirrored an existing validated Core BUY setup";
      g_scn_next_action="use only the existing Core BUY setup and its immutable geometry";
      g_scn_preferred="BUY";
      g_scn_preferred_reason="existing Core authorization; MTEE did not create readiness";
      g_scn_entry_status="EXECUTION_READY";
      return;
   }
   if(g_scn_sell.execution_ready)
   {
      g_scn_verdict=(int)SCV_SELL_EXECUTION_READY;
      g_scn_verdict_reason="ScenarioApplyCoreReady mirrored an existing validated Core SELL setup";
      g_scn_next_action="use only the existing Core SELL setup and its immutable geometry";
      g_scn_preferred="SELL";
      g_scn_preferred_reason="existing Core authorization; MTEE did not create readiness";
      g_scn_entry_status="EXECUTION_READY";
      return;
   }
   if(g_scn_buy.valid && g_scn_buy.invalidated && g_scn_sell.valid && g_scn_sell.invalidated)
   {
      g_scn_verdict=(int)SCV_INVALIDATED;
      g_scn_verdict_reason="both selected plans are invalidated/expired; no new candidate is promoted";
      g_scn_next_action="wait for a fresh valid ZRE/RXN zone";
      g_scn_entry_status="INVALIDATED";
      return;
   }

   SScenarioPlan lead;
   ScenarioPlanInit(lead,true);
   if(ScenarioPlanBetter(g_scn_buy,lead)) ScenarioPlanCopy(lead,g_scn_buy);
   if(ScenarioPlanBetter(g_scn_sell,lead)) ScenarioPlanCopy(lead,g_scn_sell);
   if(!lead.valid)
   {
      g_scn_verdict_reason=(g_scn_ctx.data_reason!=""?g_scn_ctx.data_reason:
                            "no zone is available in the kept or undrawn candidate lists");
      g_scn_next_action="wait for closed source data and a valid registry candidate";
      g_scn_entry_status="NO_QUALIFIED_CANDIDATE";
      return;
   }
   g_scn_preferred=(lead.is_buy?"BUY":"SELL");
   if(lead.is_buy && g_scn_sell.valid)
      g_scn_preferred_reason="BUY leads SELL on "+ScenarioPlanLeadKey(g_scn_buy,g_scn_sell)+
         " (evidence quality "+IntegerToString(g_scn_buy.rank_score)+" vs "+
         IntegerToString(g_scn_sell.rank_score)+")";
   else if(!lead.is_buy && g_scn_buy.valid)
      g_scn_preferred_reason="SELL leads BUY on "+ScenarioPlanLeadKey(g_scn_sell,g_scn_buy)+
         " (evidence quality "+IntegerToString(g_scn_sell.rank_score)+" vs "+
         IntegerToString(g_scn_buy.rank_score)+")";
   else g_scn_preferred_reason="only the "+g_scn_preferred+" direction has a visible zone; qualification is stated separately";
   g_scn_entry_status=ScenarioEntryStatusToken(lead);
   if(g_scn_entry_status=="INVALIDATED")
   {
      g_scn_verdict=(int)SCV_INVALIDATED;
      g_scn_verdict_reason=lead.qualification_reason;
      g_scn_next_action="wait for a newly valid zone; this plan is retired";
      return;
   }
   if(g_scn_entry_status=="COUNTERTREND_WATCH")
   {
      g_scn_verdict=(int)SCV_NO_TRADE;
      g_scn_verdict_reason=lead.qualification_reason;
      g_scn_next_action="no countertrend entry; monitor only for a new D1/H4-aligned plan";
      return;
   }
   if(g_scn_entry_status=="NO_QUALIFIED_CANDIDATE")
   {
      g_scn_verdict=(int)SCV_NO_TRADE;
      g_scn_verdict_reason=lead.qualification_reason;
      g_scn_next_action="do not use conditional prices; wait for Priority A-D qualification";
      return;
   }
   if(lead.late)
   {
      g_scn_verdict=(int)SCV_LATE_WAIT_RETEST;
      g_scn_verdict_reason=lead.qualification_reason;
      g_scn_next_action=lead.trigger;
      return;
   }
   if(lead.has_structure)
   {
      g_scn_verdict=(int)SCV_WAIT_RETEST;
      g_scn_verdict_reason=(lead.has_retest?
         "closed M5 retest observed, but the existing Core setup/lifecycle has not independently authorized entry":
         "same-level M15 structure confirmed; waiting for the two-candle closed-M5 retest rule");
      g_scn_next_action=lead.trigger;
      return;
   }
   if(lead.has_reaction || lead.has_displacement)
   {
      g_scn_verdict=(int)SCV_WAIT_STRUCTURE;
      g_scn_verdict_reason=lead.m15_state;
      g_scn_next_action=lead.trigger;
      return;
   }
   g_scn_verdict=(lead.is_buy?(int)SCV_WAIT_BUY_CONFIRMATION:(int)SCV_WAIT_SELL_CONFIRMATION);
   g_scn_verdict_reason=lead.m30_state;
   g_scn_next_action=lead.trigger;
}

bool ScenarioMTEESelfTest(string &where)
{
   where="";
   SScenarioPlan a,b;
   ScenarioPlanInit(a,true); ScenarioPlanInit(b,true);
   a.valid=true; b.valid=true; a.zone_id="A"; b.zone_id="B";

   // 1/7 Priority A validity precedes every later quality/tie-breaker.
   a.validity_pass=true; a.alignment_rank=0; a.rank_score=1;
   b.validity_pass=false; b.alignment_rank=3; b.rank_score=100;
   if(!ScenarioPlanBetter(a,b)){ where="MTEE-1 Priority A validity"; return false; }

   // 2/7 Priority B uses the complete closed D1/H4/H1 alignment rank.
   ScenarioPlanInit(a,true); ScenarioPlanInit(b,true);
   a.valid=b.valid=true; a.zone_id="A"; b.zone_id="B";
   a.validity_pass=b.validity_pass=true;
   a.alignment_rank=3; b.alignment_rank=2;
   if(!ScenarioPlanBetter(a,b)){ where="MTEE-2 Priority B D1/H4/H1"; return false; }

   // 3/7 Priority C orders independent evidence-quality scores, not probabilities.
   ScenarioPlanInit(a,true); ScenarioPlanInit(b,true);
   a.valid=b.valid=true; a.zone_id="A"; b.zone_id="B";
   a.validity_pass=b.validity_pass=true;
   a.alignment_rank=b.alignment_rank=3;
   a.rank_score=74; b.rank_score=61;
   if(!ScenarioPlanBetter(a,b)){ where="MTEE-3 Priority C evidence quality"; return false; }

   // 4/7 Priority D requires usable geometry; same-level linkage needs overlap.
   ScenarioPlanInit(a,true); ScenarioPlanInit(b,true);
   a.valid=b.valid=true; a.zone_id="A"; b.zone_id="B";
   a.validity_pass=b.validity_pass=true;
   a.alignment_rank=b.alignment_rank=3;
   a.rank_score=b.rank_score=70;
   a.geometry_valid=true; b.geometry_valid=false;
   a.barrier_room_atr=1.25; b.barrier_room_atr=0.0;
   double test_tick=(_Point>0.0?_Point:0.01);
   double zone_lo=100.0,zone_hi=100.0+2.0*test_tick;
   if(!ScenarioPlanBetter(a,b) ||
      !ScenarioZonesOverlap(zone_lo,zone_hi,zone_lo+test_tick,zone_lo+3.0*test_tick) ||
      ScenarioZonesOverlap(zone_lo,zone_hi,zone_hi+test_tick,zone_hi+2.0*test_tick))
   { where="MTEE-4 Priority D geometry/same-level overlap"; return false; }

   // 5/7 A planning retest remains conditional; it cannot imply Core readiness.
   ScenarioPlanInit(a,true);
   a.valid=true; a.candidate_qualified=true; a.geometry_valid=true; a.m5_data_ok=true;
   a.m5_invalidation_history_ok=true;
   a.has_retest=true;
   if(ScenarioEntryStatusToken(a)!="RETEST_CONFIRMED" || a.execution_ready)
   { where="MTEE-5 conditional retest is not Core authorization"; return false; }

   // 6/7 Chase and invalidation precedence cannot be hidden by an earlier retest.
   a.late=true;
   if(ScenarioEntryStatusToken(a)!="LATE_WAIT_RETEST")
   { where="MTEE-6 late plan must wait for a fresh retest"; return false; }
   a.invalidated=true;
   if(ScenarioEntryStatusToken(a)!="INVALIDATED")
   { where="MTEE-6 invalidation precedence"; return false; }

   // 7/7 Missing H1 is retained with an explicit reason, never silently qualified.
   ScenarioPlanInit(a,true);
   a.valid=true; a.validity_pass=true; a.alignment_rank=1; a.candidate_qualified=false;
   a.qualification_reason="NO_DATA — H1 closed directional context unavailable";
   if(ScenarioEntryStatusToken(a)!="NO_QUALIFIED_CANDIDATE" ||
      StringFind(a.qualification_reason,"NO_DATA")<0)
   { where="MTEE-7 missing H1 context remains explicit"; return false; }
   return true;
}

void ScenarioUpdate(const int rates_total,const bool force_rebuild)
{
   if(!InpUseDirectionalScenarioEngine)
   {
      if(g_scn_built_time!=0) ScenarioClear();
      return;
   }
   int closed=rates_total-2;
   if(closed<1 || closed+1>=ArraySize(g_buf_t) || closed>=ArraySize(g_buf_c) ||
      g_buf_t[closed]<=0 || g_buf_t[closed+1]<=g_buf_t[closed])
   {
      if(g_scn_built_time!=0 || g_scn_buy.valid || g_scn_sell.valid) ScenarioClear();
      g_scn_ctx.data_reason="NO_DATA — no valid closed chart bar/next-open ModelBoundary is available";
      g_scn_buy.unavailable_reason=g_scn_ctx.data_reason;
      g_scn_sell.unavailable_reason=g_scn_ctx.data_reason;
      ScenarioBuildVerdict();
      ScenarioDraw();
      return;
   }
   datetime stamp=g_buf_t[closed];
   if(force_rebuild || g_scn_built_time!=stamp)
   {
      ScenarioBuildContext(closed);
      ScenarioDiscover(closed);
      // An execution-ready scenario is never generated here: this only mirrors
      // an already-confirmed Core setup with Core's own entry/SL/TP geometry.
      ScenarioApplyCoreReady();
      ScenarioBuildVerdict();
      g_scn_built_time=stamp;
   }
   ScenarioDraw();
}

void ScenarioClear()
{
   ScenarioDeleteObjects();
   ScenarioContextInit(g_scn_ctx);
   ScenarioPlanInit(g_scn_buy,true);
   ScenarioPlanInit(g_scn_sell,false);
   g_scn_verdict=(int)SCV_NO_TRADE;
   g_scn_verdict_reason="scenario engine has not evaluated a closed bar";
   g_scn_next_action="wait for closed-bar market data";
   g_scn_preferred="NONE";
   g_scn_preferred_reason="scenario engine has not evaluated a closed bar";
   g_scn_entry_status="NO_QUALIFIED_CANDIDATE";
   g_scn_built_time=0;
   g_scn_draw_sig="";
}

void ScenarioDeleteObjects()
{
   ObjectsDeleteAll(0,PFX+"SCN_");
   g_scn_draw_sig="";
}

void ScenarioDrawOne(const SScenarioPlan &p,const string tag)
{
   if(!p.valid || p.execution_ready || !(p.zone_high>p.zone_low)) return;
   if(g_scn_ctx.closed<0 || g_scn_ctx.closed>=ArraySize(g_buf_t)) return;
   // v6.6.10 AUDIT-DSE1: a TERMINAL plan is still drawn, but as what it is.
   // The old guard dropped the plan when `invalidated` was set and KEPT it when
   // only `plan_dead` was set, so the chart could carry a tinted conditional
   // retest box tagged "BUY PLAN - CONDITIONAL - INVALIDATED": a live-looking
   // zone whose own tag said it was dead. One rule now - a terminal plan is drawn
   // in the terminal colour, its tag never says CONDITIONAL, and its tooltip says
   // retired instead of "a plan to monitor". Hiding it was not an option either:
   // an operator has to be able to SEE that a scenario was retired and why.
   bool terminal=(p.invalidated || p.plan_dead ||
                  p.state==SCN_INVALIDATED || p.state==SCN_EXPIRED);
   color col=(terminal?clrDarkGray:(p.is_buy?clrDarkSeaGreen:clrTomato));
   datetime t1=g_buf_t[MathMax(0,g_scn_ctx.closed-6)];
   datetime t2=g_buf_t[g_scn_ctx.closed];
   string base=PFX+"SCN_"+tag+"_";
   // A tinted box is explicitly a conditional retest area, not an entry arrow.
   DrawZoneBox(base+"ZONE",t1,p.zone_high,t2,p.zone_low,col,"",92);
   ObjectSetString(0,base+"ZONE",OBJPROP_TOOLTIP,
                   (terminal?"DIRECTIONAL SCENARIO ENGINE / RETIRED PLAN\n"+
                             "This scenario is terminal. It stays on the chart so the retirement is\n"+
                             "visible and explainable; it is not a plan to monitor and not an entry.\n":
                    "DIRECTIONAL SCENARIO ENGINE / CONDITIONAL ONLY\n"+
                    "This zone is a plan to monitor, not an authorized entry.\n")+
                   "State: "+ScenarioStateName(p.state)+"\n"+
                   "Headline: "+ScenarioPlanHeadline(p)+"\n"+
                   "Zone timeframe provenance: "+p.zone_timeframe+"\n"+
                   "Trigger: "+p.trigger+"\nMissing: "+p.missing+"\n"+
                   "Entry: "+ScenarioPlanEntryText(p)+"\n"+
                   "Trigger price: "+ScenarioPlanTriggerText(p)+"\n"+
                   "Stop: "+ScenarioPlanStopText(p)+"\n"+
                   "Targets: "+ScenarioPlanTargetsText(p)+" | TP1 type "+p.target1_type+
                      " | TP2 type "+p.target2_type+" | TP3 type "+p.target3_type+"\n"+
                   "Barrier: "+(p.geometry_valid?DoubleToString(p.nearest_barrier,_Digits)+" ("+p.barrier_type+")":p.barrier_unavailable)+"\n"+
                   "TP2: "+(p.target2>0.0?DoubleToString(p.target2,_Digits):p.tp2_unavailable)+"\n"+
                   "TP3: "+(p.target3>0.0?DoubleToString(p.target3,_Digits):p.tp3_unavailable)+"\n"+
                   "Legs: "+ScenarioPlanLegsText(p)+"\n"+
                   p.m30_state+"\n"+p.m15_state+"\n"+p.m5_state+"\n"+
                   p.volume_context);
   if(InpShowEntries)
      DrawTextLabel(base+"TAG",t2,(p.is_buy?p.zone_low:p.zone_high),
                    string(p.is_buy?"BUY":"SELL")+" PLAN — "+
                       (terminal?ScenarioStateName(p.state)+" — NOT AN ENTRY":
                                 "CONDITIONAL — "+ScenarioStateName(p.state)),
                    col,!p.is_buy,8);
   if(InpShowSLTP && p.structural_invalidation>0.0)
      DrawHLine(base+"INV",p.structural_invalidation,col,
                string(p.is_buy?"BUY":"SELL")+" structural invalidation (conditional)",1);
}

void ScenarioDraw()
{
   if(!InpUseDirectionalScenarioEngine || !InpShowScenarioPlans)
   {
      if(g_scn_draw_sig!="") ScenarioDeleteObjects();
      return;
   }
   string sig=g_scn_buy.zone_id+"|"+IntegerToString(g_scn_buy.state)+"|"+
      IntegerToString((int)g_scn_buy.candidate_qualified)+"|"+
      IntegerToString((int)g_scn_buy.has_reaction)+IntegerToString((int)g_scn_buy.has_displacement)+
      IntegerToString((int)g_scn_buy.has_structure)+IntegerToString((int)g_scn_buy.has_retest)+"|"+
      DoubleToString(g_scn_buy.entry_zone_low,_Digits)+"|"+DoubleToString(g_scn_buy.entry_zone_high,_Digits)+"|"+
      DoubleToString(g_scn_buy.stop_loss,_Digits)+"|"+DoubleToString(g_scn_buy.target1,_Digits)+"|"+
      DoubleToString(g_scn_buy.target2,_Digits)+"|"+DoubleToString(g_scn_buy.target3,_Digits)+"|"+
      g_scn_buy.target1_type+"|"+g_scn_buy.target2_type+"|"+g_scn_buy.target3_type+"|"+
      g_scn_buy.m30_state+"|"+g_scn_buy.m15_state+"|"+g_scn_buy.m5_state+"|"+
      g_scn_buy.blocking_gate+"|"+g_scn_sell.zone_id+"|"+IntegerToString(g_scn_sell.state)+"|"+
      IntegerToString((int)g_scn_sell.candidate_qualified)+"|"+
      IntegerToString((int)g_scn_sell.has_reaction)+IntegerToString((int)g_scn_sell.has_displacement)+
      IntegerToString((int)g_scn_sell.has_structure)+IntegerToString((int)g_scn_sell.has_retest)+"|"+
      DoubleToString(g_scn_sell.entry_zone_low,_Digits)+"|"+DoubleToString(g_scn_sell.entry_zone_high,_Digits)+"|"+
      DoubleToString(g_scn_sell.stop_loss,_Digits)+"|"+DoubleToString(g_scn_sell.target1,_Digits)+"|"+
      DoubleToString(g_scn_sell.target2,_Digits)+"|"+DoubleToString(g_scn_sell.target3,_Digits)+"|"+
      g_scn_sell.target1_type+"|"+g_scn_sell.target2_type+"|"+g_scn_sell.target3_type+"|"+
      g_scn_sell.m30_state+"|"+g_scn_sell.m15_state+"|"+g_scn_sell.m5_state+"|"+
      g_scn_sell.blocking_gate+"|"+g_scn_entry_status+"|"+IntegerToString(g_scn_verdict);
   // v6.6.10 AUDIT-DSE1: must match ScenarioDrawOne's own guard exactly, or the
   // redraw signature either waits forever for an object that is never drawn or
   // leaves a retired plan's objects on the chart after the plan changed.
   bool expect_buy=(g_scn_buy.valid && !g_scn_buy.execution_ready);
   bool expect_sell=(g_scn_sell.valid && !g_scn_sell.execution_ready);
   bool objects_ok=(!expect_buy || ObjectFind(0,PFX+"SCN_BUY_ZONE")>=0) &&
                   (!expect_sell || ObjectFind(0,PFX+"SCN_SELL_ZONE")>=0);
   if(sig==g_scn_draw_sig && objects_ok) return;
   ScenarioDeleteObjects();
   g_scn_draw_sig=sig;
   ScenarioDrawOne(g_scn_buy,"BUY");
   ScenarioDrawOne(g_scn_sell,"SELL");
}

void ScenarioOnChartChange()
{
   if(InpUseDirectionalScenarioEngine) ScenarioDraw();
}

void ScenarioDashAdd(string &L[],color &C[],int &ln,const int cap,const string text,const color col)
{
   if(ln>=cap) return;
   L[ln]=text;
   C[ln]=col;
   ln++;
}

string ScenarioPlanZoneText(const SScenarioPlan &p)
{
   if(!p.valid) return "N/A — "+p.unavailable_reason;
   string z=DoubleToString(p.zone_low,_Digits)+"-"+DoubleToString(p.zone_high,_Digits);
   if(p.role_flipped) z+=" role-flipped";
   if(p.recovered_zone) z+=" recovered";
   return z;
}

string ScenarioPlanTargetsText(const SScenarioPlan &p)
{
   if(!p.valid) return "N/A";
   if(!p.geometry_valid) return "N/A — "+p.blocking_gate;
   string x="TP1 "+DoubleToString(p.target1,_Digits)+" ("+p.barrier_type+")";
   if(p.target2>0.0 && p.target3>0.0)
      x+=" | TP2 "+DoubleToString(p.target2,_Digits)+" | TP3 "+DoubleToString(p.target3,_Digits);
   else
      x+=" | TP2/TP3 N/A — first opposing barrier caps conditional plan";
   x+=" | "+DoubleToString(p.expected_r,2)+"R after spread";
   return x;
}

// v6.5.2 The side the two-sided comparison selected, re-derived here with the
// SAME total order so the ladder and the plans can never disagree.
void ScenarioLead(SScenarioPlan &lead)
{
   ScenarioPlanInit(lead,true);
   if(ScenarioPlanBetter(g_scn_buy,lead)) ScenarioPlanCopy(lead,g_scn_buy);
   if(ScenarioPlanBetter(g_scn_sell,lead)) ScenarioPlanCopy(lead,g_scn_sell);
}

// "M30: REACTION ..." -> "REACTION ..." so one leg string serves both the per-plan
// row and the top-down ladder row.
string ScenarioLegStrip(const string s)
{
   int c=StringFind(s,": ");
   if(c==2 || c==3) return StringSubstr(s,c+2);
   return s;
}

// v6.5.2 TOP-DOWN LADDER. One row per required timeframe, for the side the
// comparison selected. Higher legs state context and location, lower legs state
// execution; a leg with no closed-bar evidence says so instead of going quiet.
void ScenarioDashLadder(string &L[],color &C[],int &ln,const int cap,const SScenarioPlan &p)
{
   string bias1=(g_scn_ctx.d1.known?(g_scn_ctx.d1.bias>0?"BULLISH":"BEARISH"):g_scn_ctx.d1.state);
   if(g_scn_ctx.d1.known && g_d1_high>0.0)
      bias1+=" | PDH "+DoubleToString(g_d1_high,_Digits)+" PDL "+DoubleToString(g_d1_low,_Digits);
   if(g_scn_ctx.d1.equilibrium>0.0)
      bias1+=" | eq "+DoubleToString(g_scn_ctx.d1.equilibrium,_Digits);
   ScenarioDashAdd(L,C,ln,cap,"D1 BIAS: "+bias1,
                   (g_scn_ctx.d1.bias>0?clrLimeGreen:(g_scn_ctx.d1.bias<0?clrTomato:clrSilver)));
   string h4=(g_scn_ctx.h4.known?(g_scn_ctx.h4.bias>0?"BULLISH":"BEARISH")+" ("+g_scn_ctx.h4.state+")":"H4 "+g_scn_ctx.h4.state);
   if(g_scn_ctx.d1.known && g_scn_ctx.h4.known)
      h4+=(g_scn_ctx.h4.bias==g_scn_ctx.d1.bias?" confirms D1":" qualifies D1 (pullback/conflict)");
   ScenarioDashAdd(L,C,ln,cap,"H4 CONTEXT: "+h4,
                   (g_scn_ctx.h4.known?(g_scn_ctx.h4.bias==g_scn_ctx.d1.bias?clrSilver:clrOrange):clrDimGray));
   ScenarioDashAdd(L,C,ln,cap,"H1 BEST ZONE: "+(p.valid?ScenarioPlanZoneText(p):"N/A — "+p.unavailable_reason)+
                   (p.valid?" | strength "+IntegerToString(p.zone_strength)+"/100 (intrinsic "+
                             IntegerToString(p.zone_intrinsic)+" + HTF/D1 context "+
                             IntegerToString(p.zone_strength-p.zone_intrinsic)+") | "+
                             DoubleToString(p.distance_atr,2)+" ATR away":""),
                   (p.valid?clrWhite:clrDimGray));
   ScenarioDashAdd(L,C,ln,cap,"M30 REACTION: "+ScenarioLegStrip(p.m30_state),
                   (p.has_displacement?clrLimeGreen:(p.has_reaction?clrSilver:clrDimGray)));
   ScenarioDashAdd(L,C,ln,cap,"M15 STRUCTURE: "+ScenarioLegStrip(p.m15_state),
                   (p.has_structure?clrLimeGreen:clrDimGray));
   ScenarioDashAdd(L,C,ln,cap,"M5 ENTRY: "+(p.execution_ready?
                      DoubleToString(p.proposed_entry,_Digits)+" (CORE AUTHORIZED)":
                      (p.has_proposed_entry?p.preferred_entry_area+" (CONDITIONAL)":
                       "N/A — "+(p.entry_unavailable!=""?p.entry_unavailable:"no reference price is derivable")))+
                   " | "+(p.has_retest?"closed-bar retest confirmed":"no valid retest yet"),
                   (p.execution_ready?(p.is_buy?clrLime:clrTomato):(p.has_retest?clrDeepSkyBlue:clrSilver)));
}

void ScenarioDashCompact(string &L[],color &C[],int &ln,const int cap)
{
   if(!InpUseDirectionalScenarioEngine) return;
   ScenarioDashAdd(L,C,ln,cap,"BUY PLAN: CONDITIONAL / NOT AUTHORIZED | "+
                   ScenarioStateName(g_scn_buy.state)+" | "+ScenarioPlanZoneText(g_scn_buy),ScenarioStateColor(g_scn_buy));
   ScenarioDashAdd(L,C,ln,cap,"SELL PLAN: CONDITIONAL / NOT AUTHORIZED | "+
                   ScenarioStateName(g_scn_sell.state)+" | "+ScenarioPlanZoneText(g_scn_sell),ScenarioStateColor(g_scn_sell));
   // v6.5.2 one condensed ladder line + the headline that says WHAT is missing,
   // so a WAIT in mini mode is never an unexplained WAIT.
   SScenarioPlan lead;
   ScenarioLead(lead);
   ScenarioDashAdd(L,C,ln,cap,"TOP-DOWN: D1 "+(g_scn_ctx.d1.known?(g_scn_ctx.d1.bias>0?"BULL":"BEAR"):"?")+
                   " | H4 "+(g_scn_ctx.h4.known?(g_scn_ctx.h4.bias>0?"BULL":"BEAR"):"?")+
                   " | H1 "+(g_scn_ctx.h1.known?(g_scn_ctx.h1.bias>0?"BULL":"BEAR"):"?")+
                   " | M30 "+(lead.has_reaction?(lead.has_displacement?"DISP+":"REJ+"):"REJ-")+
                   " | M15 "+(lead.has_structure?(lead.structure_type!=""?lead.structure_type+"+":"MSS+"):"MSS-")+
                   " | M5 "+(lead.execution_ready?"READY":(lead.has_retest?"RETEST":"N/A")),clrSilver);
   string pdh=(g_scn_ctx.pdh_ok?DoubleToString(g_scn_ctx.pdh,_Digits):"N/A + "+g_scn_ctx.pd_reason);
   string pdl=(g_scn_ctx.pdl_ok?DoubleToString(g_scn_ctx.pdl,_Digits):"N/A + "+g_scn_ctx.pd_reason);
   // v6.5.3 (D1): the row names the SAME canonical record the S/R cluster, the
   // PMI ledger, the target engine and the ZRE candidates read, together with the
   // chart bar it became available on. If the bounded window could not be served
   // and the shift-1 fallback was used, that is stated here instead of hidden.
   ScenarioDashAdd(L,C,ln,cap,"D1 REAL REFS: prior closed PDH "+pdh+" | PDL "+pdl+
                   (g_d1_ref_avail_bar>=0?" | available on chart bar "+IntegerToString(g_d1_ref_avail_bar):"")+
                   (g_d1_ref_via_shift1?" | SHIFT-1 FALLBACK (bounded window unavailable)":""),
                   clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"ENTRY STATUS: "+g_scn_entry_status,
                   (g_scn_verdict==SCV_BUY_EXECUTION_READY?clrLime:
                    (g_scn_verdict==SCV_SELL_EXECUTION_READY?clrTomato:
                     (lead.late?clrOrange:clrSilver))));
   ScenarioDashAdd(L,C,ln,cap,"VERDICT: "+ScenarioVerdictName(g_scn_verdict)+" | "+g_scn_verdict_reason,
                   (g_scn_verdict==SCV_BUY_EXECUTION_READY?clrLime:
                    (g_scn_verdict==SCV_SELL_EXECUTION_READY?clrTomato:clrSilver)));
   // v6.6.10 AUDIT-TAC2: the non-authoritative tactical preview and this card
   // used to be able to disagree about the same side with nothing explaining it.
   // One row now states the tactical verdict and its reason. It appears ONLY when
   // there is something to explain (a suppression or a downgrade), so the compact
   // card's normal row budget is unchanged.
   if(g_mtf_entry_authority!="")
      ScenarioDashAdd(L,C,ln,cap,"TACTICAL: "+(g_mtf_entry_blocked?"SUPPRESSED":"DOWNGRADED")+
                      " | "+g_mtf_entry_authority,
                      (g_mtf_entry_blocked?clrDarkGray:clrOrange));
}

string ScenarioPlanEntryText(const SScenarioPlan &p)
{
   if(!p.valid) return "N/A — no qualified zone";
   string x="ZONE_LOW "+DoubleToString(p.zone_low,_Digits)+" ZONE_HIGH "+DoubleToString(p.zone_high,_Digits);
   x+=" | PREFERRED "+(p.has_proposed_entry && p.preferred_entry_area!="" ?
                        p.preferred_entry_area : "N/A — no reference price is derivable");
   if(p.has_proposed_entry && p.preferred_entry_area!="") x+=" ["+p.entry_basis+"]";
   return x;
}

string ScenarioPlanTriggerText(const SScenarioPlan &p)
{
   if(!p.valid) return "N/A";
   string x="TRIGGER "+(p.has_trigger?DoubleToString(p.trigger_price,_Digits):"N/A — "+p.trigger_price_note);
   x+=" | CONFIRM "+(p.entry_confirmation!=""?p.entry_confirmation:"N/A");
   return x;
}

string ScenarioPlanStopText(const SScenarioPlan &p)
{
   if(!p.valid) return "N/A";
   string x="STOP INVALIDATION "+(p.structural_invalidation>0.0?DoubleToString(p.structural_invalidation,_Digits):"N/A");
   if(p.execution_ready) x+=" | SL "+DoubleToString(p.stop_loss,_Digits)+" (Core authorized)";
   else if(p.has_sl) x+=" | SL "+DoubleToString(p.sl_price,_Digits)+" (conditional: risk rules carry it)";
   else x+=" | SL N/A — "+(p.stop_unavailable!=""?p.stop_unavailable:"the risk rules do not carry a stop yet");
   // The chain's own invalidation anchor, when this plan is the level it was
   // built on: the liquidity price its M15 sweep actually took.
   if(p.chain_sweep>0.0 && p.m5_zone_match)
      x+=" | chain sweep "+DoubleToString(p.chain_sweep,_Digits);
   return x;
}

// v6.5.2 Compressed per-plan leg tokens. The verbose per-leg sentences are in the
// ladder (lead side) and in the plan tooltip; the card row has to survive a
// truncated panel width and still be readable on its own for BOTH sides.
string ScenarioPlanLegsText(const SScenarioPlan &p)
{
   string m30=(p.has_reaction?(p.has_displacement?"REJ+ DISP+":"REJ+ DISP-"):"REJ- DISP-");
   if(p.m30_ok) m30+="+chain";
   string m15=(p.has_structure?("STRUCT+"+(p.structure_type!=""?"("+p.structure_type+")":"")):"STRUCT-");
   if(p.m15_ok) m15+="+chain";
   string m5=(p.has_retest?"RETEST+":(p.m5_ok?"RETEST-":"n/a"));
   if(p.m5_ok) m5+=(p.m5_zone_match?"+chain(same level)":"+chain(other level)");
   string chain=(p.mtf_aligned?"CHAIN ALIGNS":(p.mtf_opposed?"CHAIN OPPOSES":"CHAIN WAIT"));
   return "LEGS: M30 "+m30+" | M15 "+m15+" | M5 "+m5+" | "+chain+
          (p.mtf_gate_blocks?" (veto active)":"");
}

void ScenarioDashPlanFull(string &L[],color &C[],int &ln,const int cap,const SScenarioPlan &p)
{
   string dir=(p.is_buy?"BUY":"SELL");
   string role=(p.is_buy?"Support/demand":"Resistance/supply");
   color col=ScenarioStateColor(p);
   ScenarioDashAdd(L,C,ln,cap,"BEST "+dir+" SCENARIO: "+
                   (p.execution_ready?"CORE AUTHORIZED":"CONDITIONAL — NOT AUTHORIZED"),col);
   if(!p.valid)
   {
      ScenarioDashAdd(L,C,ln,cap,"  BEST "+dir+" ZONE: N/A — "+p.unavailable_reason,clrDimGray);
      return;
   }
   ScenarioDashAdd(L,C,ln,cap,"  BEST "+dir+" ZONE: "+ScenarioPlanZoneText(p)+" | "+role+" | "+p.zone_sources,clrWhite);
   ScenarioDashAdd(L,C,ln,cap,"  Type: "+p.scenario_type+" | State: "+ScenarioStateName(p.state)+
                   " | rank "+IntegerToString(p.rank_score)+(p.relevant?" (current)":" (not current)")+
                   " | chain "+(p.mtf_dir>0?"BUY":(p.mtf_dir<0?"SELL":"WAIT")),col);
   // v6.5.2 LOCATION + CAUSAL STAGE. Premium/discount and the RXN phase are the
   // two facts the planner already computed for every plan and the card never
   // showed; both are required by the entry contract, so they are stated here
   // rather than left as unconsumed fields.
   ScenarioDashAdd(L,C,ln,cap,"  Location: "+
                   (p.location_state!=""?p.location_state:"premium/discount not evaluated")+
                   " | reaction "+RXN_PhaseName(p.reaction_phase)+" / "+RXN_LevelName(p.reaction_level),
                   (p.location_class>0?clrDeepSkyBlue:(p.location_class<0?clrOrange:clrDimGray)));
   ScenarioDashAdd(L,C,ln,cap,"  Entry: "+ScenarioPlanEntryText(p),clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"  "+ScenarioPlanTriggerText(p),clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"  "+ScenarioPlanStopText(p),clrSilver);
   string tgt=ScenarioPlanTargetsText(p);
   if(p.geometry_valid)
      tgt+=" | BARRIER "+DoubleToString(p.nearest_barrier,_Digits)+" ("+p.barrier_type+
           ") "+DoubleToString(p.barrier_room_atr,2)+" ATR away";
   ScenarioDashAdd(L,C,ln,cap,"  Targets: "+tgt,clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"  Retest: "+DoubleToString(p.retest_low,_Digits)+"-"+
                   DoubleToString(p.retest_high,_Digits)+" | "+
                   (p.retest_note!=""?p.retest_note:"not evaluated"),clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"  "+ScenarioPlanLegsText(p),clrSilver);
   string miss=p.missing;
   if(!p.execution_ready && p.entry_unavailable!="")
      miss+=" | PRICE N/A BECAUSE: "+p.entry_unavailable;
   ScenarioDashAdd(L,C,ln,cap,"  Missing: "+miss+" | Gate: "+p.blocking_gate,clrDimGray);
}

void ScenarioDashFull(string &L[],color &C[],int &ln,const int cap)
{
   if(!InpUseDirectionalScenarioEngine) return;
   SScenarioPlan lead;
   ScenarioLead(lead);
   ScenarioDashAdd(L,C,ln,cap,"MARKET ALIGNMENT: "+g_scn_ctx.alignment+" | EXEC "+
                   (g_scn_ctx.execution_dir>0?"BULLISH ": (g_scn_ctx.execution_dir<0?"BEARISH ":"N/A "))+
                   g_scn_ctx.execution_type+(g_scn_ctx.tf_gap!=""?" | "+g_scn_ctx.tf_gap:""),clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"D1/H4/H1 BIAS: "+g_scn_ctx.bias_net_text+
                   " | rule: "+g_scn_ctx.bias_rule_text,clrSilver);
   // v6.5.3 (D7): an undecided bias must never look like a missing decision.
   // The gate is stated with the verdict, and a conflict states the rule that
   // resolved it, so "no trade" is readable as a decision instead of as a fault.
   if(g_scn_ctx.conflict)
      ScenarioDashAdd(L,C,ln,cap,
         "DECISION: STAND ASIDE - execution needs the full D1/H4/H1 alignment; "+
         "a weighted conflict keeps every candidate unqualified BY DESIGN (no loosening, no guess).",
         clrOrange);
   else if(g_scn_ctx.bias_net_dir!=0)
      ScenarioDashAdd(L,C,ln,cap,
         "DECISION: weighted HTF context is "+
         (g_scn_ctx.bias_net_dir>0?"BULLISH":"BEARISH")+" "+
         IntegerToString(g_scn_ctx.bias_net_score)+"/100 - candidates on that side rank first.",
         clrSilver);
   string best_zone="BEST CANDIDATE ZONE: "+(lead.valid?ScenarioPlanZoneText(lead):
                      "N/A + "+(lead.unavailable_reason!=""?lead.unavailable_reason:g_scn_ctx.data_reason));
   if(lead.valid)
      best_zone+=" | strength "+IntegerToString(lead.zone_strength)+"/100 (intrinsic "+
         IntegerToString(lead.zone_intrinsic)+" + HTF/D1 context "+
         IntegerToString(lead.zone_strength-lead.zone_intrinsic)+") | "+
         (lead.distance_available?DoubleToString(lead.distance_atr,2)+" closed-H1 ATR away":
          "N/A + METRIC_MISSING — closed-H1 ATR or last closed chart price unavailable");
   ScenarioDashAdd(L,C,ln,cap,best_zone,(lead.valid?clrWhite:clrDimGray));
   string d1_range=(g_scn_ctx.dealing_range_ok ?
      "D1 REAL RANGE: H "+DoubleToString(g_scn_ctx.dealing_high,_Digits)+
      " L "+DoubleToString(g_scn_ctx.dealing_low,_Digits)+
      " EQ "+DoubleToString(g_scn_ctx.dealing_eq,_Digits) :
      "D1 REAL RANGE: N/A + "+g_scn_ctx.dealing_range_reason);
   string pdh=(g_scn_ctx.pdh_ok?DoubleToString(g_scn_ctx.pdh,_Digits):"N/A + "+g_scn_ctx.pd_reason);
   string pdl=(g_scn_ctx.pdl_ok?DoubleToString(g_scn_ctx.pdl,_Digits):"N/A + "+g_scn_ctx.pd_reason);
   string pwh=(g_scn_ctx.pwh_ok?DoubleToString(g_scn_ctx.pwh,_Digits):"N/A + "+g_scn_ctx.pw_reason);
   string pwl=(g_scn_ctx.pwl_ok?DoubleToString(g_scn_ctx.pwl,_Digits):"N/A + "+g_scn_ctx.pw_reason);
   ScenarioDashAdd(L,C,ln,cap,d1_range+" | PRIOR D1 PDH "+pdh+" PDL "+pdl+
                   " | PRIOR W1 PWH "+pwh+" PWL "+pwl,clrSilver);
   string buy_tp2=(g_scn_buy.target2>0.0?DoubleToString(g_scn_buy.target2,_Digits):g_scn_buy.tp2_unavailable);
   string buy_tp3=(g_scn_buy.target3>0.0?DoubleToString(g_scn_buy.target3,_Digits):g_scn_buy.tp3_unavailable);
   string sell_tp2=(g_scn_sell.target2>0.0?DoubleToString(g_scn_sell.target2,_Digits):g_scn_sell.tp2_unavailable);
   string sell_tp3=(g_scn_sell.target3>0.0?DoubleToString(g_scn_sell.target3,_Digits):g_scn_sell.tp3_unavailable);
   ScenarioDashAdd(L,C,ln,cap,"BUY TARGET AVAILABILITY: TP2 "+buy_tp2+" | TP3 "+buy_tp3,clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"SELL TARGET AVAILABILITY: TP2 "+sell_tp2+" | TP3 "+sell_tp3,clrSilver);
   ScenarioDashPlanFull(L,C,ln,cap,g_scn_buy);
   ScenarioDashPlanFull(L,C,ln,cap,g_scn_sell);
   ScenarioDashAdd(L,C,ln,cap,"PREFERRED SCENARIO: "+g_scn_preferred+" — "+g_scn_preferred_reason+
                   (lead.valid?" | target sources TP1="+lead.target1_type+" TP2="+lead.target2_type+
                               " TP3="+lead.target3_type+" | zone TF provenance "+lead.zone_timeframe:""),
                   (g_scn_preferred=="BUY"?clrLimeGreen:
                    (g_scn_preferred=="SELL"?clrTomato:clrSilver)));
   ScenarioDashAdd(L,C,ln,cap,"CURRENT VERDICT: "+ScenarioVerdictName(g_scn_verdict),
                   (g_scn_verdict==SCV_BUY_EXECUTION_READY?clrLime:
                    (g_scn_verdict==SCV_SELL_EXECUTION_READY?clrTomato:clrSilver)));
   ScenarioDashAdd(L,C,ln,cap,"Reason: "+g_scn_verdict_reason,clrSilver);
   ScenarioDashAdd(L,C,ln,cap,"ENTRY STATUS: "+g_scn_entry_status,
                   (lead.execution_ready?(lead.is_buy?clrLime:clrTomato):(lead.late?clrOrange:clrSilver)));
   ScenarioDashAdd(L,C,ln,cap,"SCENARIO BLOCKER: "+(lead.valid?lead.blocking_gate:g_scn_ctx.data_reason),clrOrange);
   ScenarioDashAdd(L,C,ln,cap,"NEXT ACTION: "+g_scn_next_action,clrSilver);
   // v6.6.10 AUDIT-TAC2: same reconciliation row as the compact card. States the
   // tactical preview's own verdict so a reader can never be left choosing
   // between two chart annotations that appear to disagree.
   ScenarioDashAdd(L,C,ln,cap,"TACTICAL PREVIEW: "+
                   (g_mtf_entry_state==""?"none":
                     (g_mtf_entry_src==2?"HTF-bias only":
                      (g_mtf_entry_src==1?"Core-owned":"early-break preview")))+
                   (g_mtf_entry_state!=""?" | "+g_mtf_entry_state+" @ "+
                     DoubleToString(g_mtf_entry_price,_Digits)+" on "+TFName(g_mtf_entry_tf):""),
                   (g_mtf_entry_blocked?clrDarkGray:(g_mtf_entry_state!=""?clrAqua:clrDimGray)));
   if(g_mtf_entry_authority!="")
      ScenarioDashAdd(L,C,ln,cap,"TACTICAL AUTHORITY: "+(g_mtf_entry_blocked?"SUPPRESSED":"DOWNGRADED")+
                      " | "+g_mtf_entry_authority,
                      (g_mtf_entry_blocked?clrDarkGray:clrOrange));
   ScenarioDashAdd(L,C,ln,cap,"Evidence-quality score only — not a probability or win rate.",clrDimGray);
}

void CoreDashboardDeleteObjects()
{
   ObjectsDeleteAll(0,PFX+"CORE_DASH_");
   g_dash_lines=0;
   g_dash_h=0;
}

//====================================================================
// v6.5.3 (D4) PLACEHOLDER-TEXT SWEEP
//
// A chart text object that was created but never given a string is drawn by the
// terminal with its DEFAULT word - "Label" for OBJ_LABEL, "Text" for OBJ_TEXT.
// Four such words in a corner is exactly the "Label Label Label Label" report.
// Whatever path produced them (an early return, a shrunken panel row count, a
// stale object left by an earlier build), the invariant enforced here is that an
// indicator-owned text object may not exist without text:
//   * only objects whose name starts with this indicator's prefix are touched,
//     so no other tool's objects can ever be affected;
//   * only OBJ_LABEL / OBJ_TEXT are considered, never a line, box or arrow;
//   * a removal is logged ONCE per session with the object's name, so the origin
//     of the orphan is visible in the journal instead of guessed at.
//====================================================================
bool g_placeholder_purge_logged=false;
int  g_placeholder_purge_total=0;
void QSMC_PurgePlaceholderTextObjects()
{
   int total=ObjectsTotal(0,-1,-1);
   for(int i=total-1;i>=0;i--)
   {
      string name=ObjectName(0,i,-1,-1);
      if(name=="" || StringFind(name,PFX)!=0) continue;
      ENUM_OBJECT type=(ENUM_OBJECT)ObjectGetInteger(0,name,OBJPROP_TYPE);
      if(type!=OBJ_LABEL && type!=OBJ_TEXT) continue;
      string txt=ObjectGetString(0,name,OBJPROP_TEXT);
      if(txt!="" && txt!="Label" && txt!="Text") continue;
      ObjectDelete(0,name);
      g_placeholder_purge_total++;
      if(!g_placeholder_purge_logged)
      {
         g_placeholder_purge_logged=true;
         Print("[Objects] placeholder text object removed: ",name,
               " (created without text, so the terminal default word was on screen). ",
               "Further removals in this session are counted silently.");
      }
   }
}

void DrawQuantumDashboard(const int total,const double &c[])
{
   if(!InpShowAIDashboard)
   {
      CoreDashboardDeleteObjects();
      return;
   }
   int closed=total-2;
   if(closed<1 || closed+1>=ArraySize(g_buf_t) || closed>=ArraySize(c))
   {
      CoreDashboardDeleteObjects();
      return;
   }
   DiagnoseCausalChain(total,g_buf_o,g_buf_h,g_buf_l,c,g_buf_t);
   DiagnoseDirectionalWatch(total,g_buf_o,g_buf_h,g_buf_l,c);
   SResolvedCorePath path;
   ResolveCoreCausalPath(closed,path);
   int core_dir=CoreDashDirection(path);
   string core_state=CoreDashState(path,core_dir);

   int primary_dir=(g_alert_primary.valid?g_alert_primary.direction:0);
   string status=(primary_dir>0?"BUY":(primary_dir<0?"SELL":"WAIT"));
   color status_col=(primary_dir>0?clrLimeGreen:(primary_dir<0?clrLightCoral:clrOrange));
   // AUDIT-RS1: with the resolver on, the card STATUS is the resolver verdict
   // - one verdict on every surface instead of four separate opinions.
   if(InpUseFinalResolver)
     {
      status=(g_final_signal==1?"BUY":(g_final_signal==-1?"SELL":
              (g_final_signal==2?"CONFLICT - WAIT":"WAIT")));
      status_col=(g_final_signal==1?clrLimeGreen:
                  (g_final_signal==-1?clrLightCoral:clrOrange));
     }
   string source=(g_alert_primary.source==3?"CORE":(g_alert_primary.source==2?"RXN":"ZRE"));
   string primary="PRIMARY: none (closed-bar only)";
   string needs="NEEDS: wait for a closed-bar reaction";
   string invalid="INVALIDATION: n/a";
   if(g_alert_primary.valid && primary_dir!=0)
   {
      string level_tag=(g_alert_primary.source==2?RXN_LevelName(g_alert_primary.level):source);
      primary=StringFormat("PRIMARY %s %s %s-%s | %d/100",
                           level_tag,(primary_dir>0?"S":"R"),
                           DoubleToString(g_alert_primary.zone_lo,_Digits),
                           DoubleToString(g_alert_primary.zone_hi,_Digits),
                           g_alert_primary.score);
      needs="NEEDS: "+(g_alert_primary.needs==""?"none":g_alert_primary.needs);
      invalid="INVALIDATION: "+AlertInvalidationText(g_alert_primary);
   }
   // v6.6.8: when this closed bar produced NO directional candidate, the panel
   // says WHY instead of a generic "wait": a live-candle preview, a reaction
   // below InpZREAlertMinStrength, a distance/cooldown/RXN-level refusal, or the
   // arbiter's top blocker. Read-only (AlertWhyNoPopup changes no state), and it
   // replaces a row rather than adding one, so the ten-row cap still holds.
   if(!g_alert_primary.valid)
      needs="NEEDS: "+AlertWhyNoPopup(closed,g_buf_t[closed]);
   string opposing="OPPOSING: none";
   if(g_alert_opposite.valid)
      opposing=StringFormat("OPPOSING: %s %s-%s | %d/100 | %.2f ATR",
                            (g_alert_opposite.direction>0?"BUY S":"SELL R"),
                            DoubleToString(g_alert_opposite.zone_lo,_Digits),
                            DoubleToString(g_alert_opposite.zone_hi,_Digits),
                            g_alert_opposite.score,g_alert_opposite.distance_atr);
   int d1=(g_d1_structure_state=="BULLISH"?1:(g_d1_structure_state=="BEARISH"?-1:0));
   // Show disagreement explicitly instead of forcing a single market direction.
   // This is display context only; it does not alter the entry authority.
   int direction_vote=0;
   bool direction_conflict=false;
   int direction_sources=0;
   if(g_htf_bias!=0)
   { direction_vote=g_htf_bias; direction_sources++; }
   if(d1!=0)
   { if(direction_vote!=0 && direction_vote!=d1) direction_conflict=true;
     else direction_vote=d1; direction_sources++; }
   if(InpTopDownEnabled && g_td.dir!=0)
   { if(direction_vote!=0 && direction_vote!=g_td.dir) direction_conflict=true;
     else direction_vote=g_td.dir; direction_sources++; }
   string market_direction=(direction_conflict?"MIXED - WAIT":
                            (direction_sources==0?"NEUTRAL":
                             (direction_vote>0?"BULLISH":(direction_vote<0?"BEARISH":"NEUTRAL"))));
   color direction_col=(direction_conflict?clrOrange:
                        (direction_vote>0?clrLimeGreen:(direction_vote<0?clrLightCoral:clrSilver)));
   string bias=StringFormat("DIRECTION: %s | HTF %s | D1 %s | TD %s",
                            market_direction,
                            (g_htf_bias>0?"BUY":(g_htf_bias<0?"SELL":"WAIT")),
                            (d1>0?"BUY":(d1<0?"SELL":"WAIT")),
                            (g_td.dir>0?"BUY":(g_td.dir<0?"SELL":"WAIT")));

   // The MTF sniper level is a ranked area, not a probability or an order.
   // Show its exact band and the closed-bar trigger state so the user can
   // distinguish a strong location from an actually confirmed reaction.
   string best_level="BEST LEVEL: none | waiting for validated MTF confluence";
   string entry_check="ENTRY CHECK: no validated level; wait for a closed-bar reaction";
   color best_level_col=clrSilver;
   color entry_check_col=clrOrange;
   if(InpUseSniperZoneEngine && g_sniper_best.level.strength>0.0 &&
      g_sniper_best.level.direction!=0)
   {
      bool best_buy=(g_sniper_best.level.direction>0);
      best_level=StringFormat("BEST LEVEL: %s %s-%s | strength %.2f | %s | %s",
                 (best_buy?"BUY SUPPORT":"SELL RESISTANCE"),
                 DoubleToString(g_sniper_best.level.price_low,_Digits),
                 DoubleToString(g_sniper_best.level.price_high,_Digits),
                 g_sniper_best.level.strength,
                 (g_sniper_best.tf_label==""?"MTF":g_sniper_best.tf_label),
                 (g_sniper_best.type_label==""?"confluence":g_sniper_best.type_label));
      best_level_col=(best_buy?clrLimeGreen:clrLightCoral);
      string check_state=(g_sniper_best.entry_triggered?"READY - CLOSED BAR":
                          (g_sniper_best.entry_grade==""?"WAIT":g_sniper_best.entry_grade));
      if(g_sniper_best.entry_triggered && direction_conflict)
         check_state="LOCAL READY / DIRECTION MIXED - WAIT";
      string price_plan=StringFormat("%s %s | SL %s | TP1 %s",
                    (g_sniper_best.entry_triggered?"entry":"zone edge"),
                    DoubleToString(g_sniper_best.entry_price,_Digits),
                    DoubleToString(g_sniper_best.sl_price,_Digits),
                    DoubleToString(g_sniper_best.tp1_price,_Digits));
      entry_check=StringFormat("ENTRY CHECK: %s | %s | %s | rejection evidence %d/5 | %s",
                    (best_buy?"BUY":"SELL"),check_state,price_plan,g_sniper_best.conds_met,
                    (g_sniper_best.gate_fail_reason==""?"closed-bar gates":g_sniper_best.gate_fail_reason));
      entry_check_col=(g_sniper_best.entry_triggered && !direction_conflict?
                       (best_buy?clrLimeGreen:clrLightCoral):clrOrange);
   }

   double price=c[closed];
   double sup=0.0,res=0.0;
   for(int i=0;i<ArraySize(g_confluent_sr);i++)
   {
      double q=g_confluent_sr[i].price;
      if(q<=price && (sup==0.0 || q>sup)) sup=q;
      if(q>=price && (res==0.0 || q<res)) res=q;
   }
   if(sup==0.0 || res==0.0)
   {
      for(int i=0;i<ArraySize(g_zre_zones);i++)
      {
         if(g_zre_zones[i].side==ZRE_SUPPORT && g_zre_zones[i].hi<=price &&
            (sup==0.0 || g_zre_zones[i].hi>sup)) sup=g_zre_zones[i].hi;
         if(g_zre_zones[i].side==ZRE_RESISTANCE && g_zre_zones[i].lo>=price &&
            (res==0.0 || g_zre_zones[i].lo<res)) res=g_zre_zones[i].lo;
      }
   }
   string sr=StringFormat("S/R: S %s | R %s",
                          (sup>0.0?DoubleToString(sup,_Digits):"n/a"),
                          (res>0.0?DoubleToString(res,_Digits):"n/a"));
   string bias_sr=bias+" | S "+(sup>0.0?DoubleToString(sup,_Digits):"n/a")+
                  " R "+(res>0.0?DoubleToString(res,_Digits):"n/a");
   string core_profile="CORE: "+core_state;
   if(InpUseMasterVolumeProfile && g_mvp_active>=0 && g_mvp_active<g_mvp_count &&
      g_mvp[g_mvp_active].valid)
      core_profile+=" | POC "+DoubleToString(g_mvp[g_mvp_active].poc,_Digits);

   string lines[11]; color cols[11]; int ln=0;
   lines[ln]="STATUS: "+status+" | "+_Symbol+" "+TFName((ENUM_TIMEFRAMES)_Period);
   cols[ln++]=status_col;
   lines[ln]=primary; cols[ln++]=(primary_dir>0?clrLimeGreen:(primary_dir<0?clrLightCoral:clrSilver));
   lines[ln]=best_level; cols[ln++]=best_level_col;
   lines[ln]=entry_check; cols[ln++]=entry_check_col;
   if(InpDisplayMode!=QSMC_MODE_MINIMAL)
   {
      lines[ln]=needs; cols[ln++]=clrSilver;
      lines[ln]=invalid; cols[ln++]=clrSilver;
      lines[ln]=opposing; cols[ln++]=clrSilver;
      lines[ln]=(InpDisplayMode==QSMC_MODE_FULL || g_dashboard_expanded?bias:bias_sr);
      cols[ln++]=direction_col;
      if(InpDisplayMode==QSMC_MODE_FULL || g_dashboard_expanded)
      {
         lines[ln]=sr; cols[ln++]=clrSilver;
         lines[ln]=core_profile; cols[ln++]=clrSilver;
      }
   }
   else
   {
      lines[ln]=needs; cols[ln++]=clrSilver;
      lines[ln]=invalid; cols[ln++]=clrSilver;
      lines[ln]=sr; cols[ln++]=clrSilver;
   }
   if(ln>11) ln=11;
   int rows_total=ln;                       // before any budget or width cut

   // v6.6.8 ROW BUDGET: the card shows InpDashboardMaxRows rows and says so
   // when it is hiding some, instead of growing down the chart. Nothing is lost:
   // the full list is in the tooltip of every row.
   int max_rows=(int)MathMax(3,MathMin(10,InpDashboardMaxRows));
   if(InpDashboardFullWidth) max_rows=(int)MathMin(9,max_rows+2);
   if(ln>max_rows) ln=max_rows;             // +1 slot is kept for the hint row

   // Full detail is retained in tooltips; the visible surface is deliberately
   // capped and never cuts a word or a number mid-string.
   string tooltip="QUANTUM SMC | closed-bar decision dashboard ("+IntegerToString(ln)+" of "+
                  IntegerToString(rows_total)+" rows shown)\n"+
                  "Best MTF level: "+best_level+"\nEntry check: "+entry_check+"\n"+
                  "Why no alert this bar: "+AlertWhyNoPopup(closed,g_buf_t[closed])+"\n"+
                  "Direction consensus: "+market_direction+" (context only)\n"+
                  "Primary: "+(g_alert_primary_tooltip==""?"none":g_alert_primary_tooltip)+"\n"+
                  (InpUseFinalResolver?
                   "Resolver: "+(g_final_why==""?"none":g_final_why)+"\n":"")+
                  (InpUseWeightedGates?
                   "Weighted gate: "+(g_wgate_why==""?"none":g_wgate_why)+"\n":"")+
                  (InpEnableScalping?
                   "Scalp: "+(g_sc_why==""?"none":g_sc_why)+"\n":"")+
                  (InpEnableDecisionJournal?
                   OBS_JournalText(InpObsTooltipBars):"")+
                  "Core state: "+core_state+" | blocker: "+CoreDashBlocker(core_state,path)+"\n"+
                  "Core chain: "+CoreDashChain(path,core_state,closed)+"\n"+
                  CoreDashBiasLine(g_buf_t[closed+1])+"\n"+
                  CoreDashVolumeLine(closed)+"\n"+CoreDashLevelsLine(closed,price)+"\n"+
                  g_alert_context_text;
   if(InpUseDirectionalScenarioEngine)
   {
      string dse_lines[SCN_DASH_MAX_ROWS]; color dse_cols[SCN_DASH_MAX_ROWS]; int dse_n=0;
      ScenarioDashFull(dse_lines,dse_cols,dse_n,SCN_DASH_MAX_ROWS);
      for(int i=0;i<dse_n;i++) tooltip+="\n"+dse_lines[i];
   }
   for(int i=0;i<ArraySize(g_rxn_zone_ev);i++)
      if(g_rxn_zone_ev[i].valid && g_rxn_zone_ev[i].level>=(int)RXN_LEVEL_REACTION)
      { tooltip+="\nRXN: "+g_rxn_zone_ev[i].path_text+" | "+g_rxn_zone_ev[i].score_detail; break; }

   // AUDIT-CF1 Confluence Engine. This is the SUMMARY block, so it goes first,
   // ahead of the per-module detail below it. Same rule as every other
   // display-only module: tooltip only, never the 11-row card. The card's budget
   // is fixed and pinned by test_dashboard_clarity.py, and a display-only extra
   // must not be able to push a Core row off it.
   if((InpEnableConfluence||InpEnableAllModules) && (InpCFShowOnDashboard||InpEnableAllModules))
   {
      string cf_legs_a="structure "+DoubleToString(g_cf_pillar_structure,0)+(g_cf_has_structure?"":" (absent)")+
                       " | liquidity "+DoubleToString(g_cf_pillar_liquidity,0)+(g_cf_has_liquidity?"":" (absent)")+
                       " | zone "+DoubleToString(g_cf_pillar_zone,0)+(g_cf_has_zone?"":" (absent)");
      string cf_legs_b="session "+DoubleToString(g_cf_pillar_session,0)+(g_cf_has_session?"":" (absent)")+
                       " | candle "+DoubleToString(g_cf_pillar_candle,0)+(g_cf_has_candle?"":" (absent)")+
                       " | MTF "+DoubleToString(g_cf_pillar_mtf,0)+(g_cf_has_mtf?"":" (absent)");
      string cf_best=(g_cf_best_strategy==""?"none":
                      g_cf_best_strategy+" score "+IntegerToString(g_cf_best_strategy_score)+
                      " dir "+(g_cf_best_strategy_dir>0?"BUY":"SELL"));
      string cf_head=(g_cf_no_trade?g_cf_reason:
                      ((g_cf_dir>0?"BUY":(g_cf_dir<0?"SELL":"none"))+" score "+
                       IntegerToString(g_cf_score)+" of 100"));
      tooltip+="\nCF: "+cf_head+" | weights "+IntegerToString(g_cf_weight_sum)+"/100";
      tooltip+="\nCF legs: "+cf_legs_a;
      tooltip+="\nCF legs: "+cf_legs_b;
      tooltip+="\nCF sides: buy "+IntegerToString(g_cf_buy_score)+
               " vs sell "+IntegerToString(g_cf_sell_score)+
               " (min display "+IntegerToString(InpCFMinDisplayScore)+")";
      tooltip+="\nCF best strategy: "+cf_best;
      if(g_cf_contradictions>0)
         tooltip+="\nCF contradictions: "+IntegerToString(g_cf_contradictions);
      if(g_cf_invalidation!="")
         tooltip+="\nCF invalidation: "+g_cf_invalidation;
      tooltip+="\nCF: rule-based confluence count, not a probability.";
   }

   // AUDIT-RM1 Risk Model. Advisory text, directly after the confluence summary
   // it belongs to. Tooltip only, never the 11-row card, for the same reason: a
   // display-only extra must not be able to push a Core row off the card.
   if((InpEnableRiskModel||InpEnableAllModules) && (InpRMShowOnDashboard||InpEnableAllModules))
   {
      tooltip+="\nRM: "+g_rm_verdict+(g_rm_dir>0?" BUY":(g_rm_dir<0?" SELL":""))+
               (g_rm_plan_src==""?"":" ("+g_rm_plan_src+")");
      if(g_rm_reason!="") tooltip+="\nRM why: "+g_rm_reason;
      if(g_rm_entry>0.0 && g_rm_sl>0.0)
      {
         tooltip+="\nRM plan: entry "+DoubleToString(g_rm_entry,_Digits)+
                  " | SL "+DoubleToString(g_rm_sl,_Digits)+
                  " ("+DoubleToString(g_rm_sl_dist_atr,2)+" ATR, behind "+g_rm_sl_src+")";
         tooltip+="\nRM targets: TP1 "+DoubleToString(g_rm_tp1,_Digits)+
                  " ("+DoubleToString(g_rm_rr1,2)+"R, "+g_rm_tp1_src+")"+
                  " | TP2 "+DoubleToString(g_rm_tp2,_Digits)+
                  " ("+DoubleToString(g_rm_rr2,2)+"R)"+
                  " | TP3 "+DoubleToString(g_rm_tp3,_Digits)+
                  " ("+DoubleToString(g_rm_rr3,2)+"R)";
         tooltip+="\nRM floor: "+DoubleToString(InpTopDownMinRR,2)+"R from InpTopDownMinRR"+
                  (InpRMUseRRFloor?"":" (disabled by InpRMUseRRFloor)");
         tooltip+="\nRM size: "+g_rm_size_text;
      }
      if(g_rm_invalidation!="") tooltip+="\nRM invalidation: "+g_rm_invalidation;
      tooltip+="\nRM: reward:risk and suggested size are advisory text - not a probability, not an order.";
   }

   // AUDIT-SB1 Power of 3 + Silver Bullet. These rows go into the TOOLTIP and
   // never into the 11-row card: the card's budget is fixed and pinned by
   // test_dashboard_clarity.py, and a display-only extra must not be able to push
   // a Core row off the card. This is the same merge the DSE section uses.
   if((InpEnablePowerOf3||InpEnableAllModules) && (InpP3ShowOnDashboard||InpEnableAllModules))
   {
      string p3_dir="";
      if(g_p3_phase==P3_PHASE_DISTRIBUTION && g_p3_dir!=0)
         p3_dir=(g_p3_dir>0?" (distribution UP)":" (distribution DOWN)");
      else if(g_p3_phase==P3_PHASE_MANIPULATION && g_p3_dir!=0)
         p3_dir=(g_p3_dir>0?" (prospective UP)":" (prospective DOWN)");
      tooltip+="\nP3: "+P3_PhaseName((int)g_p3_phase)+p3_dir+
               " | score "+IntegerToString(g_p3_score)+"/100 (confluence, not a win rate)";
      if(g_p3_reason!="") tooltip+="\nP3 why: "+g_p3_reason;
      if(g_p3_invalidation!="") tooltip+="\nP3 invalidation: "+g_p3_invalidation;
   }
   if((InpEnableSilverBullet||InpEnableAllModules) && (InpSBShowOnDashboard||InpEnableAllModules))
   {
      // No direction is printed unless the setup is ACTIVE, so the card can never
      // show a direction next to a stand-aside.
      string sb_dir=(g_sb_active?(g_sb_dir>0?"BUY":(g_sb_dir<0?"SELL":"none")):"stand aside");
      tooltip+="\nSB: "+(g_sb_active?"ACTIVE":"not active")+" | dir "+sb_dir+
               " | "+(g_sb_window>=0?SB_WindowName(g_sb_window):"outside every window")+
               " | score "+IntegerToString(g_sb_score)+"/100 (confluence, not a win rate)";
      if(g_sb_reason!="") tooltip+="\nSB why: "+g_sb_reason;
      if(g_sb_active && g_sb_invalidation!="") tooltip+="\nSB invalidation: "+g_sb_invalidation;
   }
   // The optional entry zone is drawn here, after PrepareDynamicRedraw() has
   // already swept the SBP3_ prefix earlier in this same pass.
   SB_DrawEntryZone(closed);

   // AUDIT-WY1 Wyckoff Spring / Upthrust. Tooltip, never the 11-row card, for the
   // same reason as the two above.
   if((InpEnableWyckoff||InpEnableAllModules) && (InpWyckoffShowOnDashboard||InpEnableAllModules))
   {
      // A direction is printed only while the event is ACTIVE, so an invalidated or
      // conflicted event can never show a side next to a stand-aside.
      string wy_dir=(g_wy_active?(g_wy_dir>0?"BUY":(g_wy_dir<0?"SELL":"none")):"stand aside");
      tooltip+="\nWY: "+WY_EventName(g_wy_event)+(g_wy_active?"":" (not active)")+
               " | dir "+wy_dir+
               " | score "+IntegerToString(g_wy_score)+"/100 (confluence, not a win rate)";
      if(g_wy_range_valid)
         tooltip+="\nWY range: "+DoubleToString(g_wy_range_low,_Digits)+"-"+
                  DoubleToString(g_wy_range_high,_Digits)+" ("+
                  IntegerToString(g_wy_range_end-g_wy_range_start+1)+" bars, touches "+
                  IntegerToString(g_wy_touches_high)+"/"+IntegerToString(g_wy_touches_low)+")";
      if(g_wy_reason!="") tooltip+="\nWY why: "+g_wy_reason;
      if(g_wy_active && g_wy_invalidation!="") tooltip+="\nWY invalidation: "+g_wy_invalidation;
   }
   WY_DrawRange(closed);

   // AUDIT-PA1 Pure Price Action. Tooltip, never the 11-row card, for the same
   // reason as the modules above.
   if((InpEnablePriceAction||InpEnableAllModules) && (InpPAShowOnDashboard||InpEnableAllModules))
   {
      // A direction is printed only when one is actually resolved, so a standalone
      // or conflicted pattern can never show a side next to a stand-aside.
      string pa_dir=(g_pa_dir>0?"BUY":(g_pa_dir<0?"SELL":"none"));
      tooltip+="\nPA: "+g_pa_pattern+" strength "+IntegerToString(g_pa_strength)+
               "/100 | dir "+pa_dir+" | "+(g_pa_confirms?"CONFIRMS":"not confirmation")+
               " | score "+IntegerToString(g_pa_score)+"/100 (confluence, not a win rate)";
      if(g_pa_in_zone)
         tooltip+="\nPA zone: "+g_pa_zone_name+" "+
                  DoubleToString(g_pa_zone_bottom,_Digits)+"-"+
                  DoubleToString(g_pa_zone_top,_Digits);
      if(g_pa_reason!="") tooltip+="\nPA why: "+g_pa_reason;
      if(g_pa_invalidation!="") tooltip+="\nPA invalidation: "+g_pa_invalidation;
   }

   // AUDIT-MR1 Mean Reversion / Momentum. Tooltip, never the 11-row card, for the
   // same reason as the modules above.
   if((InpEnableMeanReversion||InpEnableAllModules) && (InpMRShowOnDashboard||InpEnableAllModules))
   {
      // A side is printed only when one is actually resolved, so a bare stretch or
      // a vetoed fade can never show a direction next to a stand-aside.
      string mr_dir=(g_mr_dir>0?"BUY":(g_mr_dir<0?"SELL":"none"));
      tooltip+="\nMR: stretch "+DoubleToString(g_mr_stretch,2)+" sigma | dir "+mr_dir+
               " | score "+IntegerToString(g_mr_score)+"/100 (confluence, not a win rate)";
      if(g_mr_sigma>0.0)
         tooltip+="\nMR bands: VWAP "+DoubleToString(g_mr_vwap,_Digits)+
                  "  upper "+DoubleToString(g_mr_upper,_Digits)+
                  "  lower "+DoubleToString(g_mr_lower,_Digits);
      if(g_mr_div_dir!=0)
         tooltip+="\nMR divergence: "+(g_mr_div_dir>0?"BULLISH":"BEARISH")+
                  " on confirmed swings (RSI "+DoubleToString(g_mr_rsi_old,1)+" -> "+
                  DoubleToString(g_mr_rsi_new,1)+")";
      if(InpMRUseMACD)
         tooltip+="\nMR momentum: "+
                  (g_mr_macd_ready?(g_mr_macd_dir>0?"up":(g_mr_macd_dir<0?"down":"flat"))
                                   :"unavailable")+
                  (g_mr_macd_conflict?" - VETOES the fade":"");
      if(g_mr_reason!="") tooltip+="\nMR why: "+g_mr_reason;
      if(g_mr_invalidation!="") tooltip+="\nMR invalidation: "+g_mr_invalidation;
   }

   int chart_w=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS,0);

   int chart_h=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS,0);
   if(chart_w<=0) chart_w=800;
   if(chart_h<=0) chart_h=600;
   // v6.6.8 COMPACT CARD. The card used to default to the full chart width with
   // a 10-11pt font and ten rows, which covered the candles it was explaining.
   // It is now a small left-docked card by default: a bounded pixel width, a
   // smaller font, tighter spacing and a row budget the operator sets.
   int safe_w=0;
   if(InpDashboardFullWidth)
      safe_w=(int)MathMax(100,MathMin(chart_w-16,900));
   else
   {
      int cap_px=(InpDashboardMaxWidthPx>0?InpDashboardMaxWidthPx:430);
      int cap_pct=(int)(chart_w*2/5);                 // never more than 40% of the chart
      safe_w=(int)MathMin(SafeLeftPanelWidth(),MathMin(cap_px,cap_pct));
      safe_w=(int)MathMax(210,MathMin(safe_w,chart_w-16));
   }
   int panel_font=(InpPanelFontSize>0?InpPanelFontSize:(InpDashboardFullWidth?9:8));
   panel_font=(int)MathMax(7,MathMin(10,panel_font));
   int pad=6,line_h=panel_font+5;
   int text_max=(int)MathMax(40,safe_w-2*pad-4);
   if(TextWidthPx(lines[0],"Consolas",panel_font,true)>text_max)
      lines[0]="STATUS: "+status;
   if(ln>1 && TextWidthPx(lines[1],"Consolas",panel_font,false)>text_max &&
      g_alert_primary.valid && primary_dir!=0)
      lines[1]=StringFormat("PRIMARY %s @ %s | %d/100",(primary_dir>0?"BUY":"SELL"),
                            DoubleToString((g_alert_primary.zone_lo+g_alert_primary.zone_hi)*0.5,_Digits),
                            g_alert_primary.score);
   // Drop optional lines that cannot fit as whole strings. Their full versions
   // remain in the tooltip; no displayed row is ever truncated.
   for(int i=1;i<ln;)
   {
      int w=TextWidthPx(lines[i],"Consolas",panel_font,false);
      if(w>text_max)
      {
         for(int j=i;j<ln-1;j++){lines[j]=lines[j+1];cols[j]=cols[j+1];}
         ln--;
      }
      else i++;
   }
   // Rows dropped for width are hidden too: say how many in ONE dim row rather
   // than growing the card. This is the only row that is not a decision fact.
   int hidden_rows=rows_total-ln;
   if(hidden_rows>0 && ln<11)
   {
      lines[ln]="... +"+IntegerToString(hidden_rows)+" more (hover)";
      cols[ln]=clrDimGray;
      ln++;
   }
   int text_w=0;
   for(int i=0;i<ln;i++)
      text_w=(int)MathMax(text_w,TextWidthPx(lines[i],"Consolas",panel_font,(i==0)));
   int width=(InpDashboardFullWidth?safe_w:
              (int)MathMin(safe_w,text_w+2*pad+6));
   int height=ln*line_h+2*pad;
   UpdateTradeLevelKeepOut();
   int x=8;
   int y=AvoidTradeLevelKeepOut(8,height,true);
   if(y+height>chart_h-6) y=8;

   string bg=PFX+"CORE_DASH_BG";
   if(ObjectFind(0,bg)<0) ObjectCreate(0,bg,OBJ_RECTANGLE_LABEL,0,0,0);
   ObjectSetInteger(0,bg,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,bg,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,bg,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,bg,OBJPROP_XSIZE,width);
   ObjectSetInteger(0,bg,OBJPROP_YSIZE,height);
   ObjectSetInteger(0,bg,OBJPROP_BGCOLOR,(color)0x0C0C12);
   ObjectSetInteger(0,bg,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,bg,OBJPROP_COLOR,clrDimGray);
   ObjectSetInteger(0,bg,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,bg,OBJPROP_BACK,false);
   ObjectSetInteger(0,bg,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,bg,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,bg,OBJPROP_ZORDER,20);
   for(int i=0;i<ln;i++)
   {
      string name=PFX+"CORE_DASH_ROW_"+IntegerToString(i);
      if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
      ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x+pad);
      ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y+pad+i*line_h);
      ObjectSetString(0,name,OBJPROP_TEXT,lines[i]);
      ObjectSetString(0,name,OBJPROP_FONT,(i==0?"Consolas Bold":"Consolas"));
      ObjectSetInteger(0,name,OBJPROP_FONTSIZE,panel_font);
      ObjectSetInteger(0,name,OBJPROP_COLOR,cols[i]); // only STATUS uses a directional color
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,
                       (i==0 && InpDashboardCollapsible && InpDisplayMode==QSMC_MODE_STANDARD));
      ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
      ObjectSetInteger(0,name,OBJPROP_ZORDER,21);
      ObjectSetString(0,name,OBJPROP_TOOLTIP,tooltip);
   }
   for(int i=ln;i<11;i++)
   {
      string stale=PFX+"CORE_DASH_ROW_"+IntegerToString(i);
      if(ObjectFind(0,stale)>=0) ObjectDelete(0,stale);
   }
   for(int i=8;i<SCN_DASH_MAX_ROWS;i++)
   {
      string stale=PFX+"CORE_DASH_ROW_"+IntegerToString(i);
      if(ObjectFind(0,stale)>=0) ObjectDelete(0,stale);
   }
   g_dash_lines=ln;
   g_dash_width=width;
   g_dash_x=x;
   g_dash_y=y;
   g_dash_h=height;
}


//====================================================================
// DRAW: MTF PANEL (MN/W1/D1/H4/H1, closed HTF candles only)
//====================================================================
// ---------------------------------------------------------------------------
// v6.5.1 MTF AUDIT (F-02): single refresh point for the MTF alignment vector.
//
// Reads ONLY closed bars of each configured timeframe (CopyBuffer/CopyClose at
// shift 1 = last closed bar), so the vector is a closed-bar fact. `force`
// refreshes immediately; otherwise the fetch is throttled to every 10th call to
// keep the per-tick cost bounded (5 handle reads per call, 5 timeframes).
// Throttling is a latency/accuracy trade for a CONTEXT indicator only - the
// authoritative D1->M5 chain (TopDown_*) does its own closed-bar loads and
// never reads this vector.
// ---------------------------------------------------------------------------
void MTF_RefreshAlignment(const bool force)
{
   g_mtf_panel_tick++;
   if(!force && (g_mtf_panel_tick%10)!=1) return;
   ENUM_TIMEFRAMES tfs[MTF_TF_COUNT];
   tfs[0]=InpMTF1; tfs[1]=InpMTF2; tfs[2]=InpMTF3; tfs[3]=InpMTF4; tfs[4]=InpMTF5;
   for(int i=0;i<MTF_TF_COUNT;i++)
   {
      int aligned=0;
      string note="";
      double ema[2],c_[2];
      if(h_ema_mtf[i]!=INVALID_HANDLE &&
         CopyBuffer(h_ema_mtf[i],0,1,2,ema)==2 &&
         CopyClose(_Symbol,tfs[i],1,1,c_)==1)
      {
         // Oldest-first: ema[0] is shift 2; ema[1] matches the shift-1 close.
         if(ema[1]!=EMPTY_VALUE && ema[1]>0.0)
         {
            aligned=(c_[0]>ema[1] ? 1 : -1);
            note=(c_[0]>ema[1]?"CLOSE > EMA200":"CLOSE < EMA200");
         }
         else note="EMA warm-up";
      }
      else note="no data";
      g_mtf_aligned[i]=aligned;
      g_mtf_note[i]=note;
   }
   g_mtf_align_cache_seq=-1;   // the aggregate must be recomputed after a refresh
}

void DrawMTFPanel()
{
   if(InpDisplayMode==QSMC_MODE_MINIMAL)
   { ObjectsDeleteAll(0,PFX+"MTFP_"); return; }
   ENUM_TIMEFRAMES tfs[MTF_TF_COUNT];
   tfs[0]=InpMTF1; tfs[1]=InpMTF2; tfs[2]=InpMTF3; tfs[3]=InpMTF4; tfs[4]=InpMTF5;
   g_mtf_self_index=-1;
   int self=(int)_Period;
   for(int i=0;i<MTF_TF_COUNT;i++)
      if((int)tfs[i]==self) g_mtf_self_index=i;

   // v6.5.1 MTF AUDIT (F-02): the refresh moved OUT of the panel. It used to
   // live here, so `InpShowMTFPanel=false` or `InpUltraCleanMode=true` froze
   // g_mtf_aligned[] at its zero-initialised value for the whole session while
   // PMI_BuildSweep() and the dashboard kept reading it as if it were a
   // measurement. It is now called from the OnCalculate data path; the panel is
   // a pure consumer.
   MTF_RefreshAlignment(false);

   if(!g_mtf_panel_expanded)
   {
      ObjectsDeleteAll(0,PFX+"MTFP_");
      return;
   }

   // Expanded: an opaque boxed panel stacked under the badge / dashboard,
   // width-capped away from the newest candles, clear of trade-level labels.
   int line_h=16;
   if(InpPanelFontSize>0) line_h=InpPanelFontSize+8;
   const int pad=5,x=8;
   int panel_h=(MTF_TF_COUNT+1)*line_h+2*pad;
   int chart_h=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS,0);
   int safe_w=SafeLeftPanelWidth();
   int top=AvoidTradeLevelKeepOut(g_panel_stack_bottom,panel_h,true);
   if((chart_h>0 && top+panel_h>chart_h-8) || safe_w<120)
   {
      ObjectsDeleteAll(0,PFX+"MTFP_");   // no room: stay expanded, draw nothing
      return;
   }

   string rows[MTF_TF_COUNT+1];
   color  cols[MTF_TF_COUNT+1];
   rows[0]="EMA ALIGNMENT (closed candles; context only) [-]"; cols[0]=clrSilver;
   for(int i=0;i<MTF_TF_COUNT;i++)
   {
      int aligned=g_mtf_aligned[i];
      rows[i+1]=StringFormat("%-4s %s  %s",TFName(tfs[i]),
                aligned>0?"ABOVE EMA":(aligned<0?"BELOW EMA":"N/A"),
                g_mtf_note[i]+(i==g_mtf_self_index?"  <- chart TF":""));
      cols[i+1]=(aligned>0?clrLimeGreen:(aligned<0?clrTomato:clrDarkGray));
   }
   int text_w=0;
   for(int i=0;i<=MTF_TF_COUNT;i++)
   {
      rows[i]=TruncateToWidth(rows[i],"Consolas",8,safe_w-2*pad-6);
      text_w=(int)MathMax(text_w,TextWidthPx(rows[i],"Consolas",8));
   }
   int width=(int)MathMin(safe_w,text_w+2*pad+6);

   string bg=PFX+"MTFP_BG";
   if(ObjectFind(0,bg)<0) ObjectCreate(0,bg,OBJ_RECTANGLE_LABEL,0,0,0);
   ObjectSetInteger(0,bg,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,bg,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,bg,OBJPROP_YDISTANCE,top);
   ObjectSetInteger(0,bg,OBJPROP_XSIZE,width);
   ObjectSetInteger(0,bg,OBJPROP_YSIZE,panel_h);
   ObjectSetInteger(0,bg,OBJPROP_BGCOLOR,(color)0x0C0C12);
   ObjectSetInteger(0,bg,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,bg,OBJPROP_COLOR,clrDarkSlateGray);
   ObjectSetInteger(0,bg,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,bg,OBJPROP_BACK,false);
   ObjectSetInteger(0,bg,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,bg,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,bg,OBJPROP_ZORDER,0);

   for(int i=0;i<=MTF_TF_COUNT;i++)
   {
      string name=(i==0 ? PFX+"MTFP_TITLE" : PFX+"MTFP_"+IntegerToString(i-1));
      if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
      ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x+pad+3);
      ObjectSetInteger(0,name,OBJPROP_YDISTANCE,top+pad+i*line_h);
      ObjectSetString(0,name,OBJPROP_TEXT,rows[i]);
      ObjectSetString(0,name,OBJPROP_FONT,(i==0?"Consolas Bold":"Consolas"));
      ObjectSetInteger(0,name,OBJPROP_FONTSIZE,8);
      ObjectSetInteger(0,name,OBJPROP_COLOR,cols[i]);
      // the title row is the click target that collapses the panel
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,(i==0));
      ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
      ObjectSetInteger(0,name,OBJPROP_ZORDER,10);
   }
   g_panel_stack_bottom=top+panel_h+6;
}

//====================================================================
// v6.4.0 TOP-DOWN DECISION ENGINE (D1 -> H4 -> H1 -> M30 -> M15 -> M5)
// Thinks like a discretionary top-down trader, strictly on CLOSED bars
// of the six canonical timeframes. The chain (every step AND):
//   D1 structure bias -> H4 context -> H1 idea/zone (discount/premium
//   + value area) -> M30 closed reaction -> M15 sweep/displacement/
//   break/OB-FVG sequence -> M5 execution geometry with a hard R:R
// floor. Output: BUY / SELL / WAIT + reason chain + entry/SL/TP1 +
// precise invalidation price. Missing data on ANY required timeframe
// => WAIT (never guess). Authority: veto-only overlay on Layer A; it
// can never create a signal by itself and never loosens any gate.
//====================================================================

void TopDown_Reset()
{
   g_td.computed=false;
   g_td.dir=0;
   g_td.blocker="";
   g_td.reason_count=0;
   g_td.confluences=0;
   for(int i=0;i<6;i++)
   {
      g_td.tf_ok[i]=false;
      g_td.tf_state[i]="NO DATA";
      g_td.tf_eq[i]=0.0;
      g_td.fp[i]=0;
      g_td.fp_next[i]=0;
   }
   g_td.fp_chart=0;
   g_td.profile_ok=false;
   g_td.poc=0.0; g_td.vah=0.0; g_td.val=0.0;
   g_td.entry=0.0; g_td.sl=0.0; g_td.tp1=0.0; g_td.rr=0.0;
   g_td.tp_src="";
   // v6.5.2: the published tuple resets with the rest of the state, so a failed
   // or partially evaluated bar can never leak the previous bar's zone.
   g_td.m15_sweep=0.0; g_td.m15_zone_lo=0.0; g_td.m15_zone_hi=0.0;
   g_td.m15_sweep_bar=-1; g_td.m15_displacement_bar=-1;
   g_td.m15_sweep_time=0; g_td.m15_displacement_time=0;
   g_td.m15_structure_time=0; g_td.m15_structure_availability=0;
   g_td.m15_detail="";
   g_td.m15_atr=0.0; g_td.m30_atr=0.0; g_td.m5_atr=0.0;
}

void TopDown_Reason(const string s)
{
   if(g_td.reason_count>=16) return;
   g_td.reasons[g_td.reason_count]=s;
   g_td.reason_count++;
}

void TopDown_Fail(const string why)
{
   g_td.dir=0;
   if(g_td.blocker=="") g_td.blocker=why;
   TopDown_Reason("FAIL: "+why);
}

//--- strict loader: only bars whose close boundary has passed are readable
bool TopDown_LoadClosed(const ENUM_TIMEFRAMES tf,const int want,MqlRates &rt[],int &n_closed)
{
   n_closed=0;
   ArraySetAsSeries(rt,false);
   int copied=CopyRates(_Symbol,tf,0,want+1,rt);
   if(copied<2) return false;
   n_closed=copied-1;
   while(n_closed>0 && rt[n_closed].time+(datetime)PeriodSeconds(tf)>TimeCurrent())
      n_closed--;
   if(n_closed<4) return false;
   return true;
}

void TopDown_RangeEq(const MqlRates &rt[],const int from,const int to,
                     double &hi,double &lo,double &eq)
{
   hi=-DBL_MAX; lo=DBL_MAX;
   for(int i=from;i<=to;i++)
   {
      if(rt[i].high>hi) hi=rt[i].high;
      if(rt[i].low<lo)  lo=rt[i].low;
   }
   if(hi<lo){ hi=0.0; lo=0.0; eq=0.0; }
   else eq=(hi+lo)*0.5;
}

double TopDown_ATR(const MqlRates &rt[],const int n,const int len)
{
   int cnt=(int)MathMin(len,n-1);
   if(cnt<2) return 0.0;
   double sum=0.0;
   for(int i=n-cnt+1;i<=n;i++)
   {
      double pc=rt[i-1].close;
      double tr=MathMax(rt[i].high-rt[i].low,
                MathMax(MathAbs(rt[i].high-pc),MathAbs(rt[i].low-pc)));
      sum+=tr;
   }
   return sum/cnt;
}

double TopDown_MaxHigh(const MqlRates &rt[],const int from,const int to)
{
   double hi=-DBL_MAX;
   for(int i=from;i<=to;i++) if(rt[i].high>hi) hi=rt[i].high;
   return hi;
}

double TopDown_MinLow(const MqlRates &rt[],const int from,const int to)
{
   double lo=DBL_MAX;
   for(int i=from;i<=to;i++) if(rt[i].low<lo) lo=rt[i].low;
   return lo;
}

//--- lightweight H1 value area: tick volume distributed uniformly across
//--- each bar's range; 70% volume envelope walked outward from the POC.
bool TopDown_Profile(const MqlRates &rt[],const int from,const int to,
                     double &poc,double &vah,double &val)
{
   int n=to-from+1;
   if(n<10) return false;
   double hi=-DBL_MAX,lo=DBL_MAX;
   for(int i=from;i<=to;i++)
   {
      if(rt[i].high>hi) hi=rt[i].high;
      if(rt[i].low<lo)  lo=rt[i].low;
   }
   if(!(hi>lo)) return false;
   int rows=(int)MathMin(60,n);
   if(rows<8) rows=8;
   double rs=(hi-lo)/rows;
   if(rs<=0.0) return false;
   double vol[60];
   ArrayInitialize(vol,0.0);
   double total=0.0;
   for(int i=from;i<=to;i++)
   {
      double v=(double)rt[i].tick_volume;
      if(v<=0.0) continue;
      int i0=(int)MathFloor((rt[i].low-lo)/rs);
      int i1=(int)MathFloor((rt[i].high-lo)/rs);
      if(i0<0) i0=0;
      if(i1>rows-1) i1=rows-1;
      if(i1<i0) continue;
      double share=v/(double)(i1-i0+1);
      for(int r=i0;r<=i1;r++){ vol[r]+=share; total+=share; }
   }
   if(total<=0.0) return false;
   int pr=0;
   for(int r=1;r<rows;r++) if(vol[r]>vol[pr]) pr=r;
   double acc=vol[pr];
   int lo_r=pr,hi_r=pr;
   double target=0.70*total;
   while(acc<target && (lo_r>0 || hi_r<rows-1))
   {
      double left=(lo_r>0)?vol[lo_r-1]:-1.0;
      double right=(hi_r<rows-1)?vol[hi_r+1]:-1.0;
      // v6.4.2: walk the envelope SYMMETRICALLY. The previous version expanded
      // up on any tie, which pushed VAH away from the POC and VAL towards it,
      // i.e. it graded bullish reactions from a shifted value area.
      bool can_up=(hi_r<rows-1), can_dn=(lo_r>0);
      if(can_up && can_dn)
      {
         if(right>left){ hi_r++; acc+=vol[hi_r]; }
         else if(left>right){ lo_r--; acc+=vol[lo_r]; }
         else { hi_r++; lo_r--; acc+=vol[hi_r]+vol[lo_r]; }
      }
      else if(can_up){ hi_r++; acc+=vol[hi_r]; }
      else if(can_dn){ lo_r--; acc+=vol[lo_r]; }
      else break;
   }
   poc=lo+(pr+0.5)*rs;
   val=lo+(double)lo_r*rs;
   vah=lo+(double)(hi_r+1)*rs;
   return true;
}

//--- M30: a CLOSED displacement candle breaking the prior 3-bar extreme
//--- inside/near the H1 area of interest = zone reaction confirmed.
bool TopDown_React30(const MqlRates &rt[],const int from,const int n,
                     const bool buy,const double atr)
{
   if(atr<=0.0) return false;
   for(int i=(int)MathMax(from,3);i<=n;i++)
   {
      double body=rt[i].close-rt[i].open;
      if(buy)
      {
         double prior=rt[i-1].high;
         for(int k=i-3;k<=i-1;k++) if(k>=0 && rt[k].high>prior) prior=rt[k].high;
         if(rt[i].close>prior && body>=InpTopDownReactBodyATR*atr) return true;
      }
      else
      {
         double prior=rt[i-1].low;
         for(int k=i-3;k<=i-1;k++) if(k>=0 && rt[k].low<prior) prior=rt[k].low;
         if(rt[i].close<prior && -body>=InpTopDownReactBodyATR*atr) return true;
      }
   }
   return false;
}

//--- M15 textbook sequence on closed bars only:
//--- liquidity sweep -> displacement body -> closed structure break ->
//--- causal zone (last opposing candle before the impulse, else its FVG).
bool TopDown_Sequence15(const MqlRates &rt[],const int from,const int n,const bool buy,
                        const double atr,const double disp_atr,
                        double &sweep_px,double &zone_top,double &zone_bottom,
                        string &detail,int &sweep_bar,int &displacement_bar)
{
   sweep_px=0.0; zone_top=0.0; zone_bottom=0.0; detail="";
   sweep_bar=-1; displacement_bar=-1;
   if(atr<=0.0 || n<8) return false;
   int sn=(int)MathMax(2,InpTopDownSweepN);
   for(int s=n-1;s>=from+sn;s--)
   {
      bool sweep=false;
      if(buy)
      {
         double prior=rt[s-1].low;
         for(int k=s-sn;k<=s-1;k++) if(k>=0 && rt[k].low<prior) prior=rt[k].low;
         sweep=(rt[s].low<prior && rt[s].close>prior);
         if(sweep) sweep_px=rt[s].low;
      }
      else
      {
         double prior=rt[s-1].high;
         for(int k=s-sn;k<=s-1;k++) if(k>=0 && rt[k].high>prior) prior=rt[k].high;
         sweep=(rt[s].high>prior && rt[s].close<prior);
         if(sweep) sweep_px=rt[s].high;
      }
      if(!sweep) continue;

      int d=-1;
      for(int i=s+1;i<=n;i++)
      {
         double body=rt[i].close-rt[i].open;
         bool body_ok=(buy ? body>=disp_atr*atr : -body>=disp_atr*atr);
         if(!body_ok) continue;
         if(buy)
         {
            double prior=rt[i-1].high;
            for(int k=(int)MathMax(from,s-3);k<=i-1;k++) if(rt[k].high>prior) prior=rt[k].high;
            if(rt[i].close>prior){ d=i; break; }
         }
         else
         {
            double prior=rt[i-1].low;
            for(int k=(int)MathMax(from,s-3);k<=i-1;k++) if(rt[k].low<prior) prior=rt[k].low;
            if(rt[i].close<prior){ d=i; break; }
         }
      }
      if(d<0) continue;

      bool zok=false;
      for(int k=d-1;k>=s;k--)
      {
         bool opposing=(buy ? rt[k].close<rt[k].open : rt[k].close>rt[k].open);
         if(opposing)
         {
            zone_bottom=rt[k].low;
            zone_top=rt[k].high;
            zok=true;
            detail=StringFormat("sweep %s -> OB %s..%s",
                                DoubleToString(sweep_px,_Digits),
                                DoubleToString(zone_bottom,_Digits),
                                DoubleToString(zone_top,_Digits));
            break;
         }
      }
      if(!zok && d+1<=n && d-1>=0)
      {
         if(buy && rt[d+1].low>rt[d-1].high)
         {
            zone_bottom=rt[d-1].high;
            zone_top=rt[d+1].low;
            zok=true;
            detail=StringFormat("sweep %s -> FVG %s..%s",
                                DoubleToString(sweep_px,_Digits),
                                DoubleToString(zone_bottom,_Digits),
                                DoubleToString(zone_top,_Digits));
         }
         else if(!buy && rt[d+1].high<rt[d-1].low)
         {
            zone_top=rt[d+1].high;
            zone_bottom=rt[d-1].low;
            zok=true;
            detail=StringFormat("sweep %s -> FVG %s..%s",
                                DoubleToString(sweep_px,_Digits),
                                DoubleToString(zone_bottom,_Digits),
                                DoubleToString(zone_top,_Digits));
         }
      }
      if(zok)
      {
         sweep_bar=s;
         displacement_bar=d; // the same closed M15 bar satisfies the existing break test
         return true;
      }
   }
   return false;
}

//--- the full top-down chain; single exit via TopDown_Fail / success tail
void TopDown_Evaluate()
{
   MqlRates r_d1[],r_h4[],r_h1[],r_m30[],r_m15[],r_m5[];
   int n_d1=0,n_h4=0,n_h1=0,n_m30=0,n_m15=0,n_m5=0;
   int bars=InpTopDownStructureBars;
   if(bars<20) bars=20;
   if(!TopDown_LoadClosed(PERIOD_D1,bars,r_d1,n_d1))       { TopDown_Fail("D1 data missing"); return; }
   if(!TopDown_LoadClosed(PERIOD_H4,bars,r_h4,n_h4))       { TopDown_Fail("H4 data missing"); return; }
   if(!TopDown_LoadClosed(PERIOD_H1,bars,r_h1,n_h1))       { TopDown_Fail("H1 data missing"); return; }
   if(!TopDown_LoadClosed(PERIOD_M30,bars,r_m30,n_m30))    { TopDown_Fail("M30 data missing"); return; }
   if(!TopDown_LoadClosed(PERIOD_M15,bars,r_m15,n_m15))    { TopDown_Fail("M15 data missing"); return; }
   if(!TopDown_LoadClosed(PERIOD_M5,bars,r_m5,n_m5))       { TopDown_Fail("M5 data missing"); return; }

   double eqb=0.0,hi=0.0,lo=0.0,eq=0.0;
   string stb="";
   datetime evb=0,cfb=0,avb=0;

   //--- STEP 1: D1 directional bias (decides trade direction, or WAIT)
   int d1b=ComputeClosedStructureBias(PERIOD_D1,bars,InpTopDownFractalN,
                                      eqb,stb,evb,cfb,avb);
   TopDown_RangeEq(r_d1,(int)MathMax(0,n_d1-bars+1),n_d1,hi,lo,eq);
   g_td.tf_ok[0]=true;
   g_td.tf_state[0]=stb;
   g_td.tf_eq[0]=eq;
   TopDown_Reason("D1 "+stb);
   if(d1b==0){ TopDown_Fail("D1 structure undecided - WAIT"); return; }
   int d1_dir=d1b;
   g_td.confluences++;

   //--- STEP 2: H4 context (aligned = continuation; opposite = pullback
   //--- context, allowed only because H1 must still align with D1 below)
   int h4b=ComputeClosedStructureBias(PERIOD_H4,bars,InpTopDownFractalN,
                                      eqb,stb,evb,cfb,avb);
   TopDown_RangeEq(r_h4,(int)MathMax(0,n_h4-bars+1),n_h4,hi,lo,eq);
   g_td.tf_ok[1]=true;
   g_td.tf_state[1]=stb;
   g_td.tf_eq[1]=eq;
   if(h4b==d1_dir)
   {
      g_td.confluences++;
      TopDown_Reason("H4 aligned "+stb);
   }
   else
      TopDown_Reason("H4 "+stb+" vs D1 (pullback context)");

   //--- STEP 3: H1 idea structure must align with D1 (HTF override)
   int h1b=ComputeClosedStructureBias(PERIOD_H1,bars,InpTopDownFractalN,
                                      eqb,stb,evb,cfb,avb);
   TopDown_RangeEq(r_h1,(int)MathMax(0,n_h1-bars+1),n_h1,hi,lo,eq);
   double h1_hi=hi,h1_lo=lo,h1_eq=eq;
   g_td.tf_ok[2]=true;
   g_td.tf_state[2]=stb;
   g_td.tf_eq[2]=eq;
   if(h1b!=d1_dir)
   {
      TopDown_Fail("H1 structure "+stb+" opposes D1 (higher timeframe override)");
      return;
   }

   //--- H1 Area of Interest: value area + discount/premium location
   int pfrom=(int)MathMax(0,n_h1-InpTopDownProfileBars+1);
   g_td.profile_ok=TopDown_Profile(r_h1,pfrom,n_h1,g_td.poc,g_td.vah,g_td.val);
   double px=r_h1[n_h1].close;
   bool discount=(d1_dir>0 ? px<=h1_eq : px>=h1_eq);
   if(!discount)
   {
      TopDown_Fail(d1_dir>0 ? "H1 in premium vs equilibrium - no buy AOI"
                            : "H1 in discount vs equilibrium - no sell AOI");
      return;
   }
   g_td.confluences++;
   if(g_td.profile_ok)
      TopDown_Reason(StringFormat("H1 %s | POC %.2f VAH %.2f VAL %.2f",
                                  (d1_dir>0?"discount":"premium"),
                                  g_td.poc,g_td.vah,g_td.val));
   else
      TopDown_Reason(StringFormat("H1 %s (value area unavailable)",
                                  (d1_dir>0?"discount":"premium")));

   //--- STEP 4: M30 closed reaction/displacement inside the H1 AOI idea
   double atr30=TopDown_ATR(r_m30,n_m30,14);
   int rfrom=(int)MathMax(1,n_m30-InpTopDownReactBars+1);
   if(!TopDown_React30(r_m30,rfrom,n_m30,d1_dir>0,atr30))
   {
      TopDown_Fail("M30: no closed reaction/displacement for the idea");
      return;
   }
   g_td.tf_ok[3]=true;
   g_td.tf_state[3]=(d1_dir>0?"REACT UP":"REACT DN");
   g_td.tf_eq[3]=0.0;
   g_td.m30_atr=atr30;                 // v6.5.2 published tuple (M30 leg)
   g_td.confluences++;
   TopDown_Reason("M30 reaction confirmed on a closed bar");

   //--- STEP 5: M15 sequence: sweep -> displacement -> break -> OB/FVG
   ComputeClosedStructureBias(PERIOD_M30,bars,InpTopDownFractalN,
                              eqb,stb,evb,cfb,avb);
   TopDown_Reason("M30 structure "+stb);
   ComputeClosedStructureBias(PERIOD_M15,bars,InpTopDownFractalN,
                              eqb,stb,evb,cfb,avb);
   g_td.tf_state[4]=stb;
   double atr15=TopDown_ATR(r_m15,n_m15,14);
   double sweep_px=0.0,ztop=0.0,zbot=0.0;
   string seq_detail="";
   int m15_sweep_bar=-1,m15_disp_bar=-1;
   int sfrom=(int)MathMax(1,n_m15-InpTopDownSetupBars+1);
   if(!TopDown_Sequence15(r_m15,sfrom,n_m15,d1_dir>0,atr15,InpDisplacementATR,
                          sweep_px,ztop,zbot,seq_detail,m15_sweep_bar,m15_disp_bar))
   {
      TopDown_Fail("M15: sequence incomplete (sweep -> displacement -> break -> OB/FVG)");
      return;
   }
   double c15=r_m15[n_m15].close;
   if(d1_dir>0 ? c15<zbot : c15>ztop)
   {
      TopDown_Fail("M15: price closed back through the zone - setup dead");
      return;
   }
   double entry=(d1_dir>0 ? ztop : zbot);
   if(d1_dir>0 ? c15>entry+InpTopDownChaseATR*atr15
               : c15<entry-InpTopDownChaseATR*atr15)
   {
      TopDown_Fail("M15: price extended beyond the chase limit from the entry edge");
      return;
   }
   g_td.tf_ok[4]=true;
   g_td.tf_eq[4]=0.0;
   // v6.5.2 published tuple (M15 leg): the exact closed-bar structural facts this
   // leg was built from. A planner can now test whether ITS zone is this zone.
   g_td.m15_sweep=sweep_px;
   g_td.m15_zone_lo=zbot;
   g_td.m15_zone_hi=ztop;
   g_td.m15_sweep_bar=m15_sweep_bar;
   g_td.m15_displacement_bar=m15_disp_bar;
   if(m15_sweep_bar>=0 && m15_sweep_bar+1<ArraySize(r_m15))
      g_td.m15_sweep_time=r_m15[m15_sweep_bar].time;
   if(m15_disp_bar>=0 && m15_disp_bar+1<ArraySize(r_m15))
   {
      g_td.m15_displacement_time=r_m15[m15_disp_bar].time;
      g_td.m15_structure_time=r_m15[m15_disp_bar].time;
      g_td.m15_structure_availability=r_m15[m15_disp_bar+1].time;
   }
   g_td.m15_detail=seq_detail;
   g_td.m15_atr=atr15;
   g_td.confluences++;
   TopDown_Reason("M15 "+seq_detail);

   //--- STEP 6: M5 execution geometry: precise entry, stop behind the
   //--- sweep/liquidity, TP1 = nearest opposing liquidity, hard R:R floor
   if(n_m5<InpTopDownExecBars)
   {
      TopDown_Fail(StringFormat("M5: %d closed bars shorter than execution window %d",
                                n_m5,InpTopDownExecBars));
      return;
   }
   double atr5=TopDown_ATR(r_m5,n_m5,14);
   if(atr5<=0.0){ TopDown_Fail("M5 ATR unavailable"); return; }
   ComputeClosedStructureBias(PERIOD_M5,bars,InpTopDownFractalN,
                              eqb,stb,evb,cfb,avb);
   g_td.tf_state[5]=stb;
   double sl=(d1_dir>0 ? MathMin(sweep_px,zbot)-InpSLBufferATR*atr15
                       : MathMax(sweep_px,ztop)+InpSLBufferATR*atr15);
   double risk=MathAbs(entry-sl);
   if(risk<=_Point){ TopDown_Fail("M5: stop geometry invalid"); return; }

   double cands[6];
   string csrc[6];
   int nc=0;
   double m15_swing=(d1_dir>0 ? TopDown_MaxHigh(r_m15,sfrom,n_m15)
                              : TopDown_MinLow(r_m15,sfrom,n_m15));
   if(d1_dir>0 ? m15_swing>entry : m15_swing<entry)
   { cands[nc]=m15_swing; csrc[nc]="M15 swing liquidity"; nc++; }
   if(g_td.profile_ok)
   {
      double v=(d1_dir>0 ? g_td.vah : g_td.val);
      if(d1_dir>0 ? v>entry : v<entry)
      { cands[nc]=v; csrc[nc]=(d1_dir>0?"H1 VAH":"H1 VAL"); nc++; }
      if(d1_dir>0 ? g_td.poc>entry : g_td.poc<entry)
      { cands[nc]=g_td.poc; csrc[nc]="H1 POC"; nc++; }
   }
   if(d1_dir>0 ? h1_hi>entry : h1_lo<entry)
   { cands[nc]=(d1_dir>0?h1_hi:h1_lo); csrc[nc]="H1 dealing extreme"; nc++; }
   if(d1_dir>0 && g_d1_high>entry)
   { cands[nc]=g_d1_high; csrc[nc]="PDH"; nc++; }
   if(d1_dir<0 && g_d1_low>0.0 && g_d1_low<entry)
   { cands[nc]=g_d1_low; csrc[nc]="PDL"; nc++; }
   if(nc==0){ TopDown_Fail("M5: no opposing liquidity target"); return; }
   int bi=0;
   for(int i=1;i<nc;i++)
      if(d1_dir>0 ? cands[i]<cands[bi] : cands[i]>cands[bi]) bi=i;
   double tp1=cands[bi];
   double rr=(d1_dir>0 ? (tp1-entry)/risk : (entry-tp1)/risk);
   if(rr+1e-9<InpTopDownMinRR)
   {
      TopDown_Fail(StringFormat("R:R %.2f below required %.2f (nearest target %s)",
                                rr,InpTopDownMinRR,csrc[bi]));
      return;
   }
   g_td.entry=entry;
   g_td.sl=sl;
   g_td.tp1=tp1;
   g_td.rr=rr;
   g_td.tp_src=csrc[bi];
   g_td.tf_ok[5]=true;
   g_td.tf_eq[5]=0.0;
   g_td.m5_atr=atr5;                   // v6.5.2 published tuple (M5 leg)
   g_td.confluences++;
   TopDown_Reason(StringFormat("M5 plan E %s SL %s TP1 %s (%s) RR %.2f",
                               DoubleToString(entry,_Digits),
                               DoubleToString(sl,_Digits),
                               DoubleToString(tp1,_Digits),
                               csrc[bi],rr));

   //--- optional strict session filter (adds a requirement, never removes)
   if(InpTopDownRequireSession && (g_signal_mask&BIT_KILLZONE)==0)
   {
      TopDown_Fail("outside killzone (InpTopDownRequireSession=true)");
      return;
   }
   if(g_td.confluences<InpTopDownMinConfluences)
   {
      TopDown_Fail(StringFormat("confluences %d below required %d",
                                g_td.confluences,InpTopDownMinConfluences));
      return;
   }

   g_td.dir=d1_dir;
   TopDown_Reason(d1_dir>0 ? "VERDICT: BUY (top-down chain complete)"
                           : "VERDICT: SELL (top-down chain complete)");
}

void TopDown_Update(const int total,const bool force)
{
   if(!InpTopDownEnabled)
   {
      if(g_td.computed) TopDown_Reset();
      return;
   }
   //--- closed-bar fingerprint: last CLOSED open time of each canonical TF
   //--- plus the chart's last closed bar (session mask can change on it).
   ENUM_TIMEFRAMES tfs[6];
   tfs[0]=PERIOD_D1; tfs[1]=PERIOD_H4; tfs[2]=PERIOD_H1;
   tfs[3]=PERIOD_M30; tfs[4]=PERIOD_M15; tfs[5]=PERIOD_M5;
   datetime fp[6],fp_next[6];
   for(int i=0;i<6;i++)
   {
      fp[i]=iTime(_Symbol,tfs[i],1);
      fp_next[i]=iTime(_Symbol,tfs[i],0);
   }
   datetime fp_chart=(total>=2 && total-2<ArraySize(g_buf_t) ? g_buf_t[total-2] : 0);
   if(!force && g_td.computed)
   {
      bool same=(g_td.fp_chart==fp_chart);
      for(int i=0;i<6 && same;i++) same=(g_td.fp[i]==fp[i] && g_td.fp_next[i]==fp_next[i]);
      if(same) return;
   }
   TopDown_Reset();
   g_td.fp_chart=fp_chart;
   for(int i=0;i<6;i++)
   {
      g_td.fp[i]=fp[i];
      g_td.fp_next[i]=fp_next[i];
   }
   long td_t0=(long)GetMicrosecondCount();
   TopDown_Evaluate();
   long td_us=(long)GetMicrosecondCount()-td_t0;
   g_perf_td_us=(g_perf_td_us<=0 ? td_us : (g_perf_td_us*7+td_us)/8);
   g_td.computed=true;
   if(!g_td.logged)
   {
      g_td.logged=true;
      Print(" - TopDown engine: gate=",InpTopDownGateCore?"ON":"OFF",
            " minRR=",DoubleToString(InpTopDownMinRR,2),
            " confluences>=",InpTopDownMinConfluences,
            " session=",InpTopDownRequireSession?"required":"optional");
   }
   if(InpTopDownAlerts && g_td.dir!=0 && g_td.dir!=g_td.last_alert_dir)
   {
      FireQuantAlert("TD"+IntegerToString(g_td.dir),
                     StringFormat("%s | TOP-DOWN %s | confluences %d/6 | RR %.2f | invalidation: close beyond SL %s",
                                  _Symbol,(g_td.dir>0?"BUY":"SELL"),
                                  g_td.confluences,g_td.rr,
                                  DoubleToString(g_td.sl,_Digits)));
   }
   g_td.last_alert_dir=g_td.dir;
}

//--- AND-gate used by the Layer A candidate path, both confirmation paths
//--- and the core badge. Disabled => never blocks (opt-out preserved).
bool TopDown_BlocksDirection(const bool is_buy)
{
   if(!InpTopDownEnabled || !InpTopDownGateCore) return false;
   if(!g_td.computed) return true;   // no closed-bar verdict yet => block
   if(g_td.dir==0) return true;      // WAIT blocks both directions
   return (is_buy ? (g_td.dir<0) : (g_td.dir>0));
}
// v6.4.1 SIGNAL VISIBILITY: the top-down "institutional confirmation" is a hard
// gate only when the operator asks for it. With the shipped default
// (InpRequireInstitutionalConfirm=false) an undecided/partial chain downgrades the
// quality grade instead of vetoing publication. The old unconditional veto made
// BOTH directions unpublishable on every WAIT bar - the main reason nothing was
// ever drawn - and it also cancelled a retest that was already valid.
bool TopDown_VetoesDirection(const bool is_buy)
{
   if(TopDown_BlocksDirection(is_buy) && InpRequireInstitutionalConfirm) return true;
   return false;
}

// v6.4.1: WAIT must be distinguishable from "no data" and from "the chain
// disagrees with itself", otherwise an operator cannot tell a slow market from a
// broken chain. Names follow the audit request; nothing here gates a signal.
string TopDown_VerdictState()
{
   if(!InpTopDownEnabled) return "DISABLED";
   if(!g_td.computed)     return "DATA_UNAVAILABLE";      // no closed-bar verdict yet
   if(g_td.dir>0) return "BUY";
   if(g_td.dir<0) return "SELL";
   // blocker strings are produced by TopDown_Fail(); these three families are the
   // ones an operator needs told apart: a TF leg that has no closed data, an HTF
   // that actively opposes the idea, and a chain that is simply not complete yet.
   string b=g_td.blocker;
   if(StringFind(b,"opposes")>=0)  return "CONFLICT";        // e.g. "H1 structure ... opposes D1"
   if(StringFind(b,"data missing")>=0 ||
      StringFind(b,"ATR unavailable")>=0)                    return "DATA_UNAVAILABLE";
   if(b=="")  return "PARTIAL";                              // still evaluating this bar
   return "WAIT";
}

// Audit/diagnostic only: what the two top-down switches currently DO to a Core
// candidate. "WAIT != automatically destroy Core candidate" is exactly the mode
// the shipped defaults run in, and it has to be visible in the log.
string TopDown_GatingModeLine()
{
   if(!InpTopDownEnabled)
      return StringFormat("topdown verdict %s | gating OFF (engine disabled)",TopDown_VerdictState());
   if(!InpTopDownGateCore)
      return StringFormat("topdown verdict %s | gating OFF (InpTopDownGateCore=false, diagnostic only)",
                          TopDown_VerdictState());
   if(!InpRequireInstitutionalConfirm)
      return StringFormat("topdown verdict %s | CORE GATED=GRADE ONLY (InpRequireInstitutionalConfirm=false)"
                          " - a WAIT/DATA_UNAVAILABLE downgrades the grade, it does not destroy the candidate",
                          TopDown_VerdictState());
   return StringFormat("topdown verdict %s | CORE GATED=HARD (InpRequireInstitutionalConfirm=true)"
                       " - WAIT/DATA_UNAVAILABLE block BOTH directions",TopDown_VerdictState());
}

void DrawTopDownPanel()
{
   if(InpDisplayMode==QSMC_MODE_MINIMAL || !InpTopDownEnabled || !InpShowTopDownPanel || InpUltraCleanMode)
   {
      ObjectsDeleteAll(0,PFX+"TDP_");
      return;
   }
   int line_h=16;
   if(InpPanelFontSize>0) line_h=InpPanelFontSize+8;
   const int pad=5,x=8;

   string rows[12];
   color  cols[12];
   int rows_n=0;
   string verdict_txt=TopDown_VerdictState();
   rows[rows_n]=StringFormat("TOP-DOWN D1->M5 : %s  (%d/6)%s",
                             verdict_txt,g_td.confluences,
                             (InpTopDownGateCore ? (InpRequireInstitutionalConfirm?" [CORE GATED: HARD]"
                                                                                     :" [CORE GATED: GRADE]")
                                                : " [DIAGNOSTIC]"));
   cols[rows_n]=(g_td.dir>0?clrLimeGreen:(g_td.dir<0?clrTomato:clrOrange));
   rows_n++;

   ENUM_TIMEFRAMES tfs[6];
   tfs[0]=PERIOD_D1; tfs[1]=PERIOD_H4; tfs[2]=PERIOD_H1;
   tfs[3]=PERIOD_M30; tfs[4]=PERIOD_M15; tfs[5]=PERIOD_M5;
   bool chain_started=false;
   for(int i=0;i<6;i++)
   {
      string note=g_td.tf_state[i];
      // REVIEW-Q1: every unevaluated row downstream of an evaluated HTF leg was
      // skipped by the first upstream return.  The old immediate-predecessor test
      // marked only M30 after an H1 veto; M15/M5 fell back to the reset text
      // "NO DATA" even though all six CopyRates loads had already succeeded.
      if(g_td.tf_ok[i])
         chain_started=true;
      else if(chain_started && note=="NO DATA")
         note="SKIPPED (HTF)";
      if(g_td.tf_eq[i]>0.0) note=note+"  eq "+DoubleToString(g_td.tf_eq[i],_Digits);
      if(i==0 && g_d1_high>0.0)
         note=note+"  PDH "+DoubleToString(g_d1_high,_Digits)+" PDL "+DoubleToString(g_d1_low,_Digits);
      if(i==2 && g_td.profile_ok)
         note=note+StringFormat("  POC %.2f VA %.2f-%.2f",
                                g_td.poc,g_td.val,g_td.vah);
      rows[rows_n]=StringFormat("%-4s %s",TFName(tfs[i]),note);
      cols[rows_n]=(!g_td.tf_ok[i]?clrRed:
                    (StringFind(g_td.tf_state[i],"BULL")>=0?clrLimeGreen:
                     (StringFind(g_td.tf_state[i],"BEAR")>=0?clrTomato:clrSilver)));
      rows_n++;
   }
   if(g_td.dir!=0)
   {
      rows[rows_n]=StringFormat("PLAN %s  E %s  SL %s  TP1 %s  RR %.2f",
                                (g_td.dir>0?"BUY":"SELL"),
                                DoubleToString(g_td.entry,_Digits),
                                DoubleToString(g_td.sl,_Digits),
                                DoubleToString(g_td.tp1,_Digits),
                                g_td.rr);
      cols[rows_n]=(g_td.dir>0?clrLimeGreen:clrTomato);
      rows_n++;
      rows[rows_n]=StringFormat("INVALIDATION: close beyond SL %s (%s)",
                                DoubleToString(g_td.sl,_Digits),g_td.tp_src);
      cols[rows_n]=clrOrange;
      rows_n++;
   }
   else
   {
      string why=(g_td.blocker=="" ? "evaluating closed bars..." : g_td.blocker);
      rows[rows_n]="WAIT  "+why;
      cols[rows_n]=clrOrange;
      rows_n++;
   }

   if(InpShowPerfMeter)
   {
      rows[rows_n]="PERF  topdown "+IntegerToString(g_perf_td_us)+"us  tick "+IntegerToString(g_perf_calc_us)+"us";
      cols[rows_n]=clrSilver;
      rows_n++;
   }
   int panel_h=rows_n*line_h+2*pad;
   int chart_h=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS,0);
   int safe_w=SafeLeftPanelWidth();
   int top=AvoidTradeLevelKeepOut(g_panel_stack_bottom,panel_h,true);
   if((chart_h>0 && top+panel_h>chart_h-8) || safe_w<120)
   {
      ObjectsDeleteAll(0,PFX+"TDP_");
      return;
   }
   int text_w=0;
   for(int i=0;i<rows_n;i++)
   {
      rows[i]=TruncateToWidth(rows[i],"Consolas",8,safe_w-2*pad-6);
      text_w=(int)MathMax(text_w,TextWidthPx(rows[i],"Consolas",8));
   }
   int width=(int)MathMin(safe_w,text_w+2*pad+6);

   string bg=PFX+"TDP_BG";
   if(ObjectFind(0,bg)<0) ObjectCreate(0,bg,OBJ_RECTANGLE_LABEL,0,0,0);
   ObjectSetInteger(0,bg,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,bg,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,bg,OBJPROP_YDISTANCE,top);
   ObjectSetInteger(0,bg,OBJPROP_XSIZE,width);
   ObjectSetInteger(0,bg,OBJPROP_YSIZE,panel_h);
   ObjectSetInteger(0,bg,OBJPROP_BGCOLOR,(color)0x0C0C12);
   ObjectSetInteger(0,bg,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,bg,OBJPROP_COLOR,clrDarkSlateGray);
   ObjectSetInteger(0,bg,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,bg,OBJPROP_BACK,false);
   ObjectSetInteger(0,bg,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,bg,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,bg,OBJPROP_ZORDER,0);

   for(int i=0;i<rows_n;i++)
   {
      string name=(i==0 ? PFX+"TDP_TITLE" : PFX+"TDP_"+IntegerToString(i-1));
      if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_LABEL,0,0,0);
      ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
      ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x+pad+3);
      ObjectSetInteger(0,name,OBJPROP_YDISTANCE,top+pad+i*line_h);
      ObjectSetString(0,name,OBJPROP_TEXT,rows[i]);
      ObjectSetString(0,name,OBJPROP_FONT,(i==0?"Consolas Bold":"Consolas"));
      ObjectSetInteger(0,name,OBJPROP_FONTSIZE,8);
      ObjectSetInteger(0,name,OBJPROP_COLOR,cols[i]);
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
      ObjectSetInteger(0,name,OBJPROP_ZORDER,10);
   }
   g_panel_stack_bottom=top+panel_h+6;
}

//====================================================================
// v5.6.9 CAUSAL GRAPH PATH OPTIMIZATION
// Diagnostic ranking support for flexible mode. Deterministic;
// reads the causal event store only.
//====================================================================
void ResetCausalPathResult(SCausalPathResult &r)
{
   r.valid=false;
   r.negative_cycle=false;
   r.cost=0.0;
   r.score=0.0;
   r.hops=0;
   r.start_event=-1;
   r.target_event=-1;
   r.algorithm="";
   r.agreement=false;
   for(int i=0;i<16;i++) r.nodes[i]=-1;
}
double CausalEdgeSignedWeight(const int from,const int to)
{
   if(from<0 || to<0 || from>=ArraySize(g_causal_events) ||
      to>=ArraySize(g_causal_events)) return 0.0;
   SCausalEvent a=g_causal_events[from],b=g_causal_events[to];
   if(a.availability_time<=0 || b.availability_time<=0) return 0.0;
   // reward direct causal linkage, penalise temporal distance (ATR units)
   double gap_bars=(double)MathMax(0,b.event_bar-a.event_bar);
   double penalty=InpGraphTemporalPenaltyATR*g_atr*gap_bars/MathMax(1.0,g_atr);
   double reward=(a.type==CE_DISPLACEMENT&&b.type==CE_MSS)?InpGraphCausalReward:0.0;
   double w=b.strength/20.0-penalty+reward;
   if((a.bullish!=b.bullish)) w-=InpGraphConflictPenalty;
   return w;
}
double CausalEdgeCost(const int from,const int to)
{
   // Dijkstra/Bellman-Ford work on non-negative costs.
   double w=CausalEdgeSignedWeight(from,to);
   return MathMax(0.0,-w);
}
bool RunDijkstraCausalPath(const int start_event,const int target_event,SCausalPathResult &out)
{
   ResetCausalPathResult(out);
   int n=ArraySize(g_causal_events);
   if(start_event<0||target_event<0||start_event>=n||target_event>=n) return false;
   out.algorithm="Dijkstra";
   double dist[]; ArrayResize(dist,n);
   int prev[]; ArrayResize(prev,n);
   bool done[]; ArrayResize(done,n);
   for(int i=0;i<n;i++){dist[i]=DBL_MAX; prev[i]=-1; done[i]=false;}
   dist[start_event]=0.0;
   for(int iter=0;iter<n;iter++)
   {
      int u=-1; double best=DBL_MAX;
      for(int i=0;i<n;i++) if(!done[i] && dist[i]<best){best=dist[i]; u=i;}
      if(u<0) break;
      done[u]=true;
      if(u==target_event) break;
      for(int v=0;v<n;v++)
      {
         if(done[v]) continue;
         // edge exists only via explicit parent links (child->parent walk)
         double c=DBL_MAX;
         if(g_causal_events[v].parent_primary==u || g_causal_events[v].parent_secondary==u)
            c=CausalEdgeCost(u,v);
         if(c<DBL_MAX && dist[u]+c<dist[v]){dist[v]=dist[u]+c; prev[v]=u;}
      }
   }
   if(dist[target_event]>=DBL_MAX) return false;
   out.valid=true;
   out.cost=dist[target_event];
   int hop=target_event;
   while(hop>=0 && out.hops<16){out.nodes[out.hops++]=hop; if(hop==start_event) break; hop=prev[hop];}
   // reverse path order
   for(int i=0;i<out.hops/2;i++)
   {
      int tmp=out.nodes[i]; out.nodes[i]=out.nodes[out.hops-1-i]; out.nodes[out.hops-1-i]=tmp;
   }
   out.start_event=start_event; out.target_event=target_event;
   out.score=MathMax(0.0,100.0-out.cost);
   return true;
}
bool RunBellmanFordCausalPath(const int start_event,const int target_event,SCausalPathResult &out)
{
   ResetCausalPathResult(out);
   int n=ArraySize(g_causal_events);
   if(start_event<0||target_event<0||start_event>=n||target_event>=n) return false;
   out.algorithm="BellmanFord";
   double dist[]; ArrayResize(dist,n);
   int prev[]; ArrayResize(prev,n);
   for(int i=0;i<n;i++){dist[i]=DBL_MAX; prev[i]=-1;}
   dist[start_event]=0.0;
   // parent-direction edges with signed weights (can be negative)
   for(int iter=0;iter<n-1;iter++)
   {
      bool changed=false;
      for(int v=0;v<n;v++)
      {
         int ps[2]; ps[0]=g_causal_events[v].parent_primary; ps[1]=g_causal_events[v].parent_secondary;
         for(int pi=0;pi<2;pi++)
         {
            int u=ps[pi];
            if(u<0 || (pi==1 && u==ps[0])) continue;
            if(dist[u]>=DBL_MAX) continue;
            double w=CausalEdgeSignedWeight(u,v);
            double nd=dist[u]-w; // negative weight reduces cost
            if(nd<dist[v]){dist[v]=nd; prev[v]=u; changed=true;}
         }
      }
      if(!changed) break;
   }
   // negative cycle detection
   for(int v=0;v<n;v++)
   {
      int ps[2]; ps[0]=g_causal_events[v].parent_primary; ps[1]=g_causal_events[v].parent_secondary;
      for(int pi=0;pi<2;pi++)
      {
         int u=ps[pi];
         if(u<0 || dist[u]>=DBL_MAX) continue;
         if(dist[u]-CausalEdgeSignedWeight(u,v)<dist[v]-1e-9)
         {
            out.negative_cycle=true;
            if(InpRejectGraphNegativeCycle){out.valid=false; return false;}
         }
      }
   }
   if(dist[target_event]>=DBL_MAX) return false;
   out.valid=true;
   out.cost=dist[target_event];
   int hop=target_event;
   while(hop>=0 && out.hops<16){out.nodes[out.hops++]=hop; if(hop==start_event) break; hop=prev[hop];}
   for(int i=0;i<out.hops/2;i++)
   {
      int tmp=out.nodes[i]; out.nodes[i]=out.nodes[out.hops-1-i]; out.nodes[out.hops-1-i]=tmp;
   }
   out.start_event=start_event; out.target_event=target_event;
   out.score=MathMax(0.0,100.0+out.cost);
   return true;
}
bool RunBeamCausalPath(const int start_event,const int target_event,SCausalPathResult &out)
{
   ResetCausalPathResult(out);
   int n=ArraySize(g_causal_events);
   if(start_event<0||target_event<0||start_event>=n||target_event>=n) return false;
   out.algorithm="Beam";
   // beam over child->parent chains from the target (bounded width)
   int beam[]; ArrayResize(beam,InpBeamWidth*4);
   int beam_score[]; ArrayResize(beam_score,InpBeamWidth*4);
   int cnt=1; beam[0]=target_event; beam_score[0]=0;
   for(int depth=0;depth<InpGraphMaxPathHops;depth++)
   {
      int next[]; ArrayResize(next,InpBeamWidth*16);
      int nscore[]; ArrayResize(nscore,InpBeamWidth*16);
      int ncnt=0;
      for(int b=0;b<cnt;b++)
      {
         int cur=beam[b];
         if(cur==start_event) continue;
         int ps[2]; ps[0]=g_causal_events[cur].parent_primary; ps[1]=g_causal_events[cur].parent_secondary;
         for(int pi=0;pi<2;pi++)
         {
            int p=ps[pi];
            if(p<0 || (pi==1 && p==ps[0])) continue;
            if(ncnt<InpBeamWidth*16)
            {
               next[ncnt]=p;
               nscore[ncnt]=beam_score[b]+(g_causal_events[p].confirmed?1:0);
               ncnt++;
            }
         }
      }
      if(ncnt==0) break;
      // keep best InpBeamWidth by score (deterministic tiebreak: lower index)
      for(int i=1;i<ncnt;i++)
      {
         int k=next[i],ks=nscore[i],j=i-1;
         while(j>=0 && nscore[j]<ks){next[j+1]=next[j]; nscore[j+1]=nscore[j]; j--;}
         next[j+1]=k; nscore[j+1]=ks;
      }
      cnt=MathMin(ncnt,InpBeamWidth);
      for(int i=0;i<cnt;i++){beam[i]=next[i]; beam_score[i]=nscore[i];}
      for(int i=0;i<cnt;i++)
         if(beam[i]==start_event)
         {
            out.valid=true;
            out.cost=MathMax(0.0,(double)-beam_score[i]);
            out.score=(double)beam_score[i]*20.0;
            out.hops=depth+2;
            out.algorithm="Beam";
            out.start_event=start_event; out.target_event=target_event;
            return true;
         }
   }
   return false;
}
bool OptimizeCausalGraphPath(const int start_event,const int target_event,SCausalPathResult &out)
{
   ResetCausalPathResult(out);
   if(!InpUseCausalGraphOptimizer) return false;
   SCausalPathResult best;
   bool have=false;
   if(InpUseDijkstraPathSearch && RunDijkstraCausalPath(start_event,target_event,out))
   {best=out; have=true;}
   SCausalPathResult bf;
   if(InpUseBellmanFordValidation && RunBellmanFordCausalPath(start_event,target_event,bf))
   {
      if(!have || bf.cost<best.cost){best=bf; have=true;}
      if(have) best.agreement=ValidateCausalPathAgreement(out,bf);
   }
   if(!have && InpUseBeamSearch && RunBeamCausalPath(start_event,target_event,out))
   {best=out; have=true;}
   if(!have){ResetCausalPathResult(out); return false;}
   if(InpRequireGraphAgreement && !best.agreement &&
      InpUseBellmanFordValidation && InpUseDijkstraPathSearch)
   {ResetCausalPathResult(out); return false;}
   out=best;
   return true;
}
bool ValidateCausalPathAgreement(const SCausalPathResult &a,const SCausalPathResult &b)
{
   if(!a.valid || !b.valid) return false;
   if(a.start_event!=b.start_event || a.target_event!=b.target_event) return false;
   if(a.negative_cycle!=b.negative_cycle) return false;
   // both algorithms must reach the target; hop counts may differ
   return true;
}
int CausalEvidenceDP(SSignalFactor &factors[],const int max_weight)
{
   if(!InpUseCausalDPOptimizer || max_weight<=0) return 0;
   int n=ArraySize(factors);
   int dp[]; ArrayResize(dp,max_weight+1); ArrayInitialize(dp,0);
   for(int i=0;i<n;i++)
   {
      if(!factors[i].active) continue;
      int w=factors[i].weight;
      if(w<=0 || w>max_weight) continue;
      for(int cap=max_weight;cap>=w;cap--)
         dp[cap]=MathMax(dp[cap],dp[cap-w]+factors[i].value);
   }
   return dp[max_weight];
}
