//====================================================================
// v6.4.1 SIGNAL VISIBILITY - entry marks, trade-level display, chase filter
// -------------------------------------------------------------------
// WHY THIS EXISTS: the pipeline computed and published CONFIRMED/PREVIEW
// entries (log + Alert) but the only drawing was 5 unlabeled trend lines
// behind g_trade_setup.valid, and the tactical MTF path drew a full-width
// HLINE plus one text label that the collision resolver could hide outright.
// There was no arrow anywhere in the file (no DRAW_ARROW plot, no OBJ_ARROW)
// and PFX+"ENTRY_ARROW" was deleted in SmartObjectCleanup but never created.
// These helpers add the missing display layer ONLY: they read published
// state, they never create/confirm/invalidate a setup, and every mark sits
// on a CLOSED bar (or on the forming bar for PREVIEW, which is the whole
// point of a preview). No-repaint guarantee: the only bars written for a
// CONFIRMED signal are confirmed_bar (immutable) and, for the tactical
// layer, the last bar at the moment of the closed execution-bar confirm.
//====================================================================

double SignalDrawStrength(const int conf,const int rel)
{
   return (conf+rel)*0.5;
}

// "Institutional confirmation" becomes a QUALITY GRADE, never a drawing gate.
string InstitutionalLetterGrade(const int conf,const int rel,const double path_score)
{
   int t=(int)MathRound(conf*0.30+rel*0.30+path_score*0.40);
   if(t>=85) return "A";
   if(t>=68) return "B";
   return "C";
}

bool EntryKeySeen(const string key)
{
   for(int i=0;i<ArraySize(g_entry_keys);i++)
      if(g_entry_keys[i]==key) return true;
   return false;
}

// v6.4.2: "one signal per zone+direction" plus a COOLDOWN IN BARS - a zone that
// re-arms on the very next bar is noise, not a new idea. Returns true while the
// key is both known and younger than InpSignalDedupCooldownBars.
bool EntryKeyCooling(const string key)
{
   if(!EntryKeySeen(key)) return false;
   if(InpSignalDedupCooldownBars<=0 || ArraySize(g_buf_t)<=0) return false;
   int n=ArraySize(g_buf_t);
   for(int i=0;i<ArraySize(g_entry_keys);i++)
   {
      if(g_entry_keys[i]!=key) continue;
      int at=-1;
      for(int k=n-1;k>=0;k--){ if(g_entry_key_bar[i]>0 && g_buf_t[k]<=g_entry_key_bar[i]){ at=k; break; } }
      if(at<0) return false;
      return ((n-1)-at) < InpSignalDedupCooldownBars;
   }
   return false;
}

void EntryKeyAdd(const string key,const datetime bar_time,const int src=0,const bool buy=true,
                 const double price=0.0)
{
   if(key=="") return;
   int n=ArraySize(g_entry_keys);
   for(int i=0;i<n;i++)
      if(g_entry_keys[i]==key)
      {   // already registered: refresh the paint metadata, never duplicate
         g_entry_key_bar[i]=bar_time; g_entry_key_src[i]=src;
         g_entry_key_buy[i]=buy;      if(price>0.0) g_entry_key_price[i]=price;
         return;
      }
   ArrayResize(g_entry_keys,n+1);
   ArrayResize(g_entry_key_bar,n+1);
   ArrayResize(g_entry_key_buy,n+1);
   ArrayResize(g_entry_key_src,n+1);
   ArrayResize(g_entry_key_price,n+1);
   g_entry_keys[n]=key;
   g_entry_key_bar[n]=bar_time;
   g_entry_key_buy[n]=buy;
   g_entry_key_src[n]=src;
   g_entry_key_price[n]=price;
}

void EntryKeyRemoveBySetup(const string setup_id)
{
   if(setup_id=="") return;
   int n=ArraySize(g_entry_keys);
   for(int i=n-1;i>=0;i--)
   {
      if(StringFind(g_entry_keys[i],setup_id)!=0) continue;
      for(int k=i;k<n-1;k++)
      {
         g_entry_keys[k]=g_entry_keys[k+1];         g_entry_key_bar[k]=g_entry_key_bar[k+1];
         g_entry_key_buy[k]=g_entry_key_buy[k+1];   g_entry_key_src[k]=g_entry_key_src[k+1];
         g_entry_key_price[k]=g_entry_key_price[k+1];
      }
      n--;
   }
   ArrayResize(g_entry_keys,n);
   ArrayResize(g_entry_key_bar,n);
   ArrayResize(g_entry_key_buy,n);
   ArrayResize(g_entry_key_src,n);
   ArrayResize(g_entry_key_price,n);
}

// Deterministic repaint-safe write: index by bar time, never by position.
void EntryMarkWriteAt(const datetime bar_time,const int src,const bool buy,const bool confirmed,
                      const double price)
{
   if(InpDisplayMode==QSMC_MODE_MINIMAL) return;
   int n=ArraySize(g_buf_t);
   if(bar_time<=0 || n<=0 || ArraySize(BufEntryBuy0)<n) return;
   int idx=-1;   // bounds are re-checked per array below (buffers can lag g_buf_t)
   for(int i=n-1;i>=0;i--){ if(g_buf_t[i]==bar_time){ idx=i; break; } if(g_buf_t[i]<bar_time) break; }
   if(idx<0 || idx>=n) return;
   // 0.5pt offset keeps the ZRE layer visually beside the CORE level in the data window
   double v=(src==1 ? price+0.5*_Point : price);
   if(src==2) return;   // tactical marks live on the last bar only (EntryMarkTactical)
   if(idx>=ArraySize(BufEntryBuy0) || idx>=ArraySize(BufEntrySell0) ||
      idx>=ArraySize(BufPrevBuy0) || idx>=ArraySize(BufPrevSell0)) return;
   if(confirmed){ if(buy) BufEntryBuy0[idx]=v; else BufEntrySell0[idx]=v; }
   else         { if(buy) BufPrevBuy0[idx]=v;  else BufPrevSell0[idx]=v; }
}

void EntryMarkClearBar0Preview()
{
   int k=ArraySize(g_buf_t)-1;
   if(k<0) return;
   // Bar 0 never holds a durable mark (nothing is confirmed on a forming bar),
   // so clearing it is safe and keeps PREVIEW->CONFIRMED transitions flicker-free.
   if(k<ArraySize(BufPrevBuy0))  BufPrevBuy0[k]=EMPTY_VALUE;
   if(k<ArraySize(BufPrevSell0)) BufPrevSell0[k]=EMPTY_VALUE;
   if(k<ArraySize(BufEntryBuy0)) BufEntryBuy0[k]=EMPTY_VALUE;
   if(k<ArraySize(BufEntrySell0)) BufEntrySell0[k]=EMPTY_VALUE;
   EntryMarkObject("CORE",k,true, false,true); EntryMarkObject("CORE",k,false,false,true);
   EntryMarkObject("ZRE", k,true, false,true); EntryMarkObject("ZRE", k,false,false,true);
}

// Tactical (MTF execution) mark: the chart's last bar is the only honest slot
// for an execution-TF event, and it is re-derived every tick, so nothing on it
// is a historical repaint.
void EntryMarkTactical(const bool buy,const bool confirmed,const double price)
{
   if(InpDisplayMode==QSMC_MODE_MINIMAL)
   { EntryMarkClearTactical(); return; }
   int n=ArraySize(g_buf_t);
   if(n<=0 || ArraySize(BufEntryBuy0)<n || ArraySize(BufEntrySell0)<n ||
      ArraySize(BufPrevBuy0)<n || ArraySize(BufPrevSell0)<n)
   { EntryMarkClearTactical(); return; }
   int k=n-1;
   datetime at=(InpAlertOnSignalBar && g_mtf_sig_time>0 ? g_mtf_sig_time : 0);
   if(at>0 && ArraySize(g_buf_t)>0 && at>=g_buf_t[0] && at<=g_buf_t[n-1])
   {  int j=n-1; for(;j>=0;j--) if(g_buf_t[j]<=at) break; if(j>=0) k=j; }
   if(price<=0.0){ EntryMarkClearTactical(); return; }
   if(!InpShowTacticalEntries){ EntryMarkClearTactical(); return; }
   if(confirmed){ if(buy) BufEntryBuy0[k]=price; else BufEntrySell0[k]=price; }
   else         { if(buy) BufPrevBuy0[k]=price;  else BufPrevSell0[k]=price; }
   string nm=PFX+"MTF_MARK"+(buy?"_BUY":"_SELL")+(confirmed?"_C":"_P");
   double p=(buy ? g_buf_l[k] : g_buf_h[k]);
   double off=MathMax(2.0*_Point,InpEntryLabelATR*MathMax(g_atr,_Point));
   double y=p+(buy ? -off*0.6 : off*0.6);
   int code=(confirmed ? (buy?241:242) : (buy?159:160));   // big solid vs small hollow
   color  col=(g_mtf_entry_late ? clrOrange
                : (confirmed ? (buy?clrLime:clrTomato) : clrAqua));
   if(ObjectFind(0,nm)<0) ObjectCreate(0,nm,OBJ_ARROW,0,g_buf_t[k],y);
   ObjectMove(0,nm,0,g_buf_t[k],y);   // chart-timeframe bar under the execution bar
   ObjectSetInteger(0,nm,OBJPROP_ARROWCODE,code);
   ObjectSetInteger(0,nm,OBJPROP_ANCHOR,(buy?ANCHOR_TOP:ANCHOR_BOTTOM));
   ObjectSetInteger(0,nm,OBJPROP_COLOR,col);
   ObjectSetInteger(0,nm,OBJPROP_WIDTH,2);
   ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,nm,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,nm,OBJPROP_BACK,false);
}
void EntryMarkClearTactical()
{
   int k=ArraySize(g_buf_t)-1;
   if(k>=0)
   {
      if(k<ArraySize(BufEntryBuy0)) BufEntryBuy0[k]=EMPTY_VALUE;
      if(k<ArraySize(BufEntrySell0)) BufEntrySell0[k]=EMPTY_VALUE;
      if(k<ArraySize(BufPrevBuy0))  BufPrevBuy0[k]=EMPTY_VALUE;
      if(k<ArraySize(BufPrevSell0)) BufPrevSell0[k]=EMPTY_VALUE;
   }
   string names[4];
   names[0]=PFX+"MTF_MARK_BUY_C";  names[1]=PFX+"MTF_MARK_SELL_C";
   names[2]=PFX+"MTF_MARK_BUY_P";  names[3]=PFX+"MTF_MARK_SELL_P";
   for(int i=0;i<4;i++) if(ObjectFind(0,names[i])>=0) ObjectDelete(0,names[i]);
}

// Confirmed objects are keyed by source, side and bar time; live previews stay singletons.
void EntryMarkObject(const string base,const int idx,const bool buy,const bool confirmed,
                     const bool force_delete=false)
{
   if(idx<0 || idx>=ArraySize(g_buf_t)) return;
   string nm=PFX+"EMARK_"+base+(buy?"_BUY":"_SELL")+
             (confirmed ? "_C_"+IntegerToString((long)g_buf_t[idx]) : "_P");
   if(force_delete){ if(ObjectFind(0,nm)>=0) ObjectDelete(0,nm); return; }
   double current_px=(buy?g_buf_l[idx]:g_buf_h[idx]);
   if(!QSMC_DisplayAllowsObject(nm) || !QSMC_InVisualDistance(current_px))
   { if(ObjectFind(0,nm)>=0) ObjectDelete(0,nm); return; }
   if(!InpShowEntries && confirmed)      { if(ObjectFind(0,nm)>=0) ObjectDelete(0,nm); return; }
   if(!InpShowEntryPreviewMarks && !confirmed){ if(ObjectFind(0,nm)>=0) ObjectDelete(0,nm); return; }
   double p=(buy ? g_buf_l[idx] : g_buf_h[idx]);
   double off=MathMax(2.0*_Point,InpEntryLabelATR*MathMax(g_atr,_Point));
   double y=p+(buy ? -off : off);
   int code=(confirmed ? (buy?233:234) : (buy?108:109));   // wingdings: solid up/down vs diamond
   color  col=(confirmed ? (buy?clrLime:clrTomato) : (buy?clrAqua:clrMagenta));
   if(ObjectFind(0,nm)<0) ObjectCreate(0,nm,OBJ_ARROW,0,g_buf_t[idx],y);
   ObjectMove(0,nm,0,g_buf_t[idx],y);
   ObjectSetInteger(0,nm,OBJPROP_ARROWCODE,code);
   ObjectSetInteger(0,nm,OBJPROP_ANCHOR,(buy?ANCHOR_TOP:ANCHOR_BOTTOM));
   ObjectSetInteger(0,nm,OBJPROP_COLOR,col);
   ObjectSetInteger(0,nm,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,nm,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,nm,OBJPROP_BACK,false);
}

void EntryMarkObjectsFor(const datetime bar_time,const int src,const bool buy,const bool confirmed,
                         const bool force_delete=false)
{
   if(src==2) return;   // tactical arrow is drawn by EntryMarkTactical at the last bar
   int n=ArraySize(g_buf_t), idx=-1;
   for(int i=n-1;i>=0;i--){ if(g_buf_t[i]==bar_time){ idx=i; break; } if(g_buf_t[i]<bar_time) break; }
   EntryMarkObject((src==0?"CORE":"ZRE"),idx,buy,confirmed,force_delete);
}

void EntryMarkDropObjectAt(const int idx,const string suffix)
{
   if(idx<0 || idx>=ArraySize(g_buf_t)) return;
   string nm=PFX+"ENTLVL_"+IntegerToString((long)g_buf_t[idx])+"_"+suffix;
   if(ObjectFind(0,nm)>=0) ObjectDelete(0,nm);
}

void DrawEntryLevelsFor(const datetime sig_bar_time,const bool is_buy,
                        const double entry,const double sl,const double tp1,const double tp2,
                        const double tp3,const datetime t_end,const color dir_col)
{
   string k=PFX+"ENTLVL_"+IntegerToString((long)sig_bar_time)+"_";
   datetime lo=0, hi=t_end;
   if(sig_bar_time>0 && ArraySize(g_buf_t)>0)
   {
      int n=ArraySize(g_buf_t);
      lo=g_buf_t[0];
      for(int i=n-1;i>=0;i--) if(g_buf_t[i]>=sig_bar_time){ lo=g_buf_t[i]; break; }
   }
   if(lo<=0 || hi<=lo) return;
   string dir=(is_buy?"BUY":"SELL");
   DrawFibLine(k+"E",lo,hi,entry,clrAqua,STYLE_SOLID,2);
   DrawFibLine(k+"SL",lo,hi,sl,clrRed,STYLE_SOLID,2);
   DrawFibLine(k+"TP1",lo,hi,tp1,clrLimeGreen,STYLE_DASH,1);
   DrawFibLine(k+"TP2",lo,hi,tp2,clrLimeGreen,STYLE_DASH,1);
   if(tp3>0.0 && (is_buy ? tp3>tp2 : tp3<tp2))     // TP3 only when it is beyond TP2
      DrawFibLine(k+"TP3",lo,hi,tp3,clrGreen,STYLE_DOT,1);
   DrawTextLabel(k+"E",lo,entry,dir+" ENTRY "+DoubleToString(entry,_Digits),dir_col,true,8);
   DrawTextLabel(k+"SL",lo,sl,"SL "+DoubleToString(sl,_Digits),clrRed,!is_buy,8);
   DrawTextLabel(k+"TP1",lo,tp1,"TP1 "+DoubleToString(tp1,_Digits),clrLimeGreen,is_buy,8);
   DrawTextLabel(k+"TP2",lo,tp2,"TP2 "+DoubleToString(tp2,_Digits),clrLimeGreen,is_buy,8);
   if(tp3>0.0 && (is_buy ? tp3>tp2 : tp3<tp2))
      DrawTextLabel(k+"TP3",lo,tp3,"TP3 "+DoubleToString(tp3,_Digits),clrGreen,is_buy,8);
}

void EntryMarkInvalidateLatest()
{
   // Pre-confirmation terminations: drop the marks and free the zone+direction
   // key so the same zone may re-arm later. A CONFIRMED signal is history and
   // its arrow always survives (matching the COMPLETED path, which clears the
   // lines but keeps the published record).
   if(g_active_setup.confirmed_bar>=0) return;
   if(g_active_setup.setup_event_id!="") EntryKeyRemoveBySetup(g_active_setup.setup_event_id);
   EntryMarkClearBar0Preview();
   if(g_active_setup.created_time>0)
   {
      int n=ArraySize(g_buf_t);
      for(int i=0;i<n;i++)
      {
         if(g_buf_t[i]!=g_active_setup.created_time) continue;
         if(i<ArraySize(BufEntryBuy0)) BufEntryBuy0[i]=EMPTY_VALUE;
         if(i<ArraySize(BufEntrySell0)) BufEntrySell0[i]=EMPTY_VALUE;
         if(i<ArraySize(BufPrevBuy0))  BufPrevBuy0[i]=EMPTY_VALUE;
         if(i<ArraySize(BufPrevSell0)) BufPrevSell0[i]=EMPTY_VALUE;
         EntryMarkObject("CORE",i,true, true,true);  EntryMarkObject("CORE",i,false,true,true);
         EntryMarkObject("CORE",i,true, false,true); EntryMarkObject("CORE",i,false,false,true);
         EntryMarkDropObjectAt(i,"E"); EntryMarkDropObjectAt(i,"SL");
         EntryMarkDropObjectAt(i,"TP1"); EntryMarkDropObjectAt(i,"TP2");
         EntryMarkDropObjectAt(i,"TP3");
         break;
      }
   }
}

void MarkCoreSignal()
{
   if(!g_trade_setup.valid || !InpShowEntries) return;
   // v6.4.2 CHASE SUPPRESSION: "no entry marker, only the text" - when the chase
   // filter has already decided this signal is late, we keep the label (below,
   // in DrawEntrySignalVisuals) but do not paint an arrow the eye follows.
   if(InpChaseFilter && g_entry_last_late) return;
   int cb=g_trade_setup.confirmation_bar;
   if(cb<0 || cb>=ArraySize(g_buf_t)) return;
   if(SignalDrawStrength(g_trade_setup.confidence,g_trade_setup.reliability)<InpMinStrength) return;
   EntryMarkWriteAt(g_buf_t[cb],0,g_trade_setup.is_buy,true,g_trade_setup.entry);
   EntryMarkObjectsFor(g_buf_t[cb],0,g_trade_setup.is_buy,true);
}

// v6.4.2 PROXIMITY FILTER: distance (in ATR) from `from` to the nearest
// OPPOSING resting level of the given quality, i.e. the wall a BUY would be
// launched straight into (or a SELL would be launched straight down into).
// Returns -1 when there is no opposing level in range at all.
double NearestOpposingEdgeATR(const bool is_buy,const double from,const double atr)
{
   double bd=DBL_MAX;
   for(int i=0;i<ArraySize(g_zre_zones);i++)
   {
      double px=(g_zre_zones[i].side==ZRE_RESISTANCE ? g_zre_zones[i].hi : 0.0);
      if(!is_buy) px=(g_zre_zones[i].side==ZRE_SUPPORT ? g_zre_zones[i].lo : 0.0);
      if(px<=0.0) continue;
      if(is_buy  && px<=from) continue;
      if(!is_buy && px>=from) continue;
      if(g_zre_zones[i].strength<InpWatchMinQuality) continue;
      double d=MathAbs(px-from);
      if(d<bd) bd=d;
   }
   return (bd<DBL_MAX ? bd/MathMax(atr,_Point) : -1.0);
}


// v6.4.2 Phase 2: one-line proof record for every direction decision.
void DebugLogSignal(const string site,const string phase,const int dir,
                    const double zone_lo,const double zone_hi,const double entry,
                    const double sl,const string role,const string state,
                    const double o,const double h,const double l,const double c,
                    const string wick,const string why)
{
   if(!InpDebugLog) return;
   Print("[SignalDebug] ",_Symbol," ",TFName((ENUM_TIMEFRAMES)_Period)," | ",site," | ",phase,
         " | dir ",(dir>0?"BUY":(dir<0?"SELL":"NONE")),
         " | zone ",role," ",DoubleToString(zone_lo,_Digits),"-",DoubleToString(zone_hi,_Digits),
         " | state ",state,
         " | OHLC ",DoubleToString(o,_Digits),"/",DoubleToString(h,_Digits),"/",
              DoubleToString(l,_Digits),"/",DoubleToString(c,_Digits),
         " | wick ",wick,
         " | entry ",DoubleToString(entry,_Digits)," SL ",DoubleToString(sl,_Digits),
         " | ",why);
}

// v6.4.2: a zone keeps its causal role; only a CLOSED-BAR BREAK of the role edge
// reverses it (support becomes resistance and vice versa). Price merely sitting
// inside the band, or leaving it on the "wrong" side, never changes the role.

void DrawEntrySignalVisuals(const int total,const bool is_new_bar)
{
   int n=ArraySize(g_buf_t);
   if(n<3 || ArraySize(BufEntryBuy0)<n || ArraySize(BufEntrySell0)<n ||
      ArraySize(BufPrevBuy0)<n || ArraySize(BufPrevSell0)<n) return;
   g_entry_last_key=""; g_entry_last_late=false;   // v6.4.1: recompute, never inherit
   bool preview_live=(InpUseRetestLifecycle && g_active_setup.active &&
                      g_active_setup.state==STATE_PREVIEW);
   if(!preview_live) EntryMarkClearBar0Preview();

   //--- PREVIEW: hollow/faint marker on the forming bar + live level
   if(InpShowEntryPreviewMarks && preview_live)
   {
      int pb=total-1;
      EntryMarkWriteAt(g_buf_t[MathMin(pb,n-1)],0,g_active_setup.is_buy,false,g_active_setup.entry);
      EntryMarkObjectsFor(g_buf_t[MathMin(pb,n-1)],0,g_active_setup.is_buy,false);
      string nm=PFX+"ENTRY_PREVIEW";
      double ep=g_active_setup.entry;
      if(ObjectFind(0,nm)<0) ObjectCreate(0,nm,OBJ_HLINE,0,0,ep);
      ObjectSetDouble(0,nm,OBJPROP_PRICE,ep);
      ObjectSetInteger(0,nm,OBJPROP_COLOR,clrAqua);
      ObjectSetInteger(0,nm,OBJPROP_STYLE,STYLE_DASH);
      ObjectSetInteger(0,nm,OBJPROP_WIDTH,1);
      ObjectSetInteger(0,nm,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,nm,OBJPROP_BACK,true);
      DrawTextLabel(PFX+"ENTLVLPV",g_buf_t[MathMin(pb,n-1)],ep,
                    StringFormat("%s PREVIEW @ %.2f (live, non-authoritative)",
                                 g_active_setup.is_buy?"BUY":"SELL",ep),
                    clrAqua,g_active_setup.is_buy,8);
   }
   else if(ObjectFind(0,PFX+"ENTRY_PREVIEW")>=0) ObjectDelete(0,PFX+"ENTRY_PREVIEW");
   if(ObjectFind(0,PFX+"ENTLVLPV")>=0) ObjectDelete(0,PFX+"ENTLVLPV");

   //--- CONFIRMED: redraw every still-known signal from its immutable bar
   if(!is_new_bar) return;
   // Repaint-safe replay: after a history reload / full rebuild every stored
   // signal is re-painted from its immutable bar (marks are never remembered by
   // position, only by bar time + direction + source).
   if(InpShowEntries)
   for(int i=0;i<ArraySize(g_entry_keys);i++)
   {
      if(g_entry_key_bar[i]<=0) continue;                 // pseudo keys (alert dedup)
      EntryMarkWriteAt(g_entry_key_bar[i],g_entry_key_src[i],g_entry_key_buy[i],true,
                       g_entry_key_price[i]);
      EntryMarkObjectsFor(g_entry_key_bar[i],g_entry_key_src[i],g_entry_key_buy[i],true);
   }
   if(!InpShowEntries && !InpShowSLTP) return;
   if(!g_trade_setup.valid) return;
   int cb=g_trade_setup.confirmation_bar;
   if(cb<0 || cb>=n) return;
   if(SignalDrawStrength(g_trade_setup.confidence,g_trade_setup.reliability)<InpMinStrength) return;
   int te=n-1;
   double atr=MathMax(g_atr,_Point);
   double c_now=g_buf_c[te];
   double dist_atr=MathAbs(c_now-g_trade_setup.entry)/atr;
   g_entry_last_late=(InpChaseFilter && dist_atr>InpChaseMaxATR);
   string grade=InstitutionalLetterGrade(g_trade_setup.confidence,g_trade_setup.reliability,
                                         g_trade_setup.causal_path_score);
   string key=StringFormat("%s|%.5f|%s",g_trade_setup.setup_event_id,
                           (g_trade_setup.zone_top+g_trade_setup.zone_bottom)*0.5,
                           g_trade_setup.is_buy?"B":"S");
   g_entry_last_key=key;
   if(!EntryKeySeen(key)) EntryKeyAdd(key,g_buf_t[cb],0,g_trade_setup.is_buy,g_trade_setup.entry);
   MarkCoreSignal();
   if(InpShowSLTP)
   {
      datetime t_end=g_buf_t[n-1]+(datetime)(PeriodSeconds()*10);
      color dcol=(g_trade_setup.is_buy?clrDodgerBlue:clrCrimson);
      DrawEntryLevelsFor(g_buf_t[cb],g_trade_setup.is_buy,
                         g_trade_setup.entry,g_trade_setup.sl,g_trade_setup.tp1,g_trade_setup.tp2,
                         g_trade_setup.tp3,t_end,dcol);
   }
   if(!InpShowEntries) return;
   string tp3txt=(g_trade_setup.tp3>0.0 ? StringFormat(" | TP3 %.2f",g_trade_setup.tp3) : "");
   string txt=StringFormat("%s CONFIRMED @ %.2f | SL %.2f | TP1 %.2f | TP2 %.2f%s | RR %.2f | grade %s | inst %s | %s",
                           g_trade_setup.is_buy?"BUY":"SELL",g_trade_setup.entry,g_trade_setup.sl,
                           g_trade_setup.tp1,g_trade_setup.tp2,tp3txt,g_trade_setup.rr1,
                           g_trade_setup.quality_grade,grade,g_trade_setup.setup_event_id);
   if(g_entry_last_late)
      txt+=StringFormat(" | LATE (%.1f ATR from close) - wait for retest",dist_atr);
   color col=(g_entry_last_late?clrOrange:(g_trade_setup.is_buy?clrLime:clrTomato));
   if(InpProximityFilter)
   {
      double wall=NearestOpposingEdgeATR(g_trade_setup.is_buy,g_trade_setup.entry,atr);
      if(wall>=0.0 && wall<InpProximityMaxATR)
      {
         txt+=StringFormat(" | TOO CLOSE TO OPPOSING LEVEL (%.2f ATR) - not an entry",wall);
         col=clrOrange;
         if(InpDebugLog)
            DebugLogSignal("CORE","proximity-veto",(g_trade_setup.is_buy?1:-1),
                           g_trade_setup.zone_bottom,g_trade_setup.zone_top,g_trade_setup.entry,
                           g_trade_setup.sl,g_trade_setup.zone_source,"CONFIRMED",
                           g_buf_o[cb],g_buf_h[cb],g_buf_l[cb],g_buf_c[cb],
                           DoubleToString(g_candle_intel.wick_rejection,2),
                           "entry inside InpProximityMaxATR of an opposing zone edge");
      }
   }
   DrawTextLabel(PFX+"ENTLVL_"+IntegerToString((long)g_buf_t[cb])+"_TXT",g_buf_t[cb],
                 g_trade_setup.entry,txt,col,g_trade_setup.is_buy,9);
}

//--- Core confirmation publishes the mark the moment the state machine confirms:
//--- (a) the retest path, from the immutable active setup.
void EntryMarkCoreFromSetup()
{
   if(g_active_setup.confirmed_bar<0 || g_active_setup.confirmed_bar>=ArraySize(g_buf_t)) return;
   if(InpChaseFilter && g_entry_last_late) return;   // v6.4.2: late -> label only, no marker
   string key=StringFormat("%s|%.5f|%s",g_active_setup.setup_event_id,
                           (g_active_setup.zone_top+g_active_setup.zone_bottom)*0.5,
                           g_active_setup.is_buy?"B":"S");
   if(SignalDrawStrength(g_active_setup.confidence,g_active_setup.reliability)<InpMinStrength)
   { g_entry_last_key=""; return; }          // v6.4.1 MinStrength hides (and de-alerts) weak marks
   // DEDUP: one mark per zone+direction until the setup is invalidated
   // (EntryKeyRemoveBySetup releases the key). Re-marking the same signal is a
   // no-op, which is also what stops the "CONFIRMED over and over" repeats.
   g_entry_last_key=key;
   if(EntryKeyCooling(key)) return;                 // v6.4.2: cooldown in bars
   EntryKeyAdd(key,g_buf_t[g_active_setup.confirmed_bar],0,g_active_setup.is_buy,g_active_setup.entry);
   EntryMarkWriteAt(g_buf_t[g_active_setup.confirmed_bar],0,g_active_setup.is_buy,true,
                    g_active_setup.entry);
   EntryMarkObjectsFor(g_buf_t[g_active_setup.confirmed_bar],0,g_active_setup.is_buy,true);
   g_gate_audit.marks++;   g_gate_audit.core_marks++;
}
//--- (b) the retest-lifecycle-disabled path, from the published trade setup.
//---     Per-tick entry display also lives here: preview marks, confirmed
//---     visuals, chase verdict.
void EntryMarkCoreFromDirectSetup()
{
   if(!g_trade_setup.valid) return;
   int cb=g_trade_setup.confirmation_bar;
   if(cb<0 || cb>=ArraySize(g_buf_t)) return;
   string key=StringFormat("%s|%.5f|%s",g_trade_setup.setup_event_id,
                           (g_trade_setup.zone_top+g_trade_setup.zone_bottom)*0.5,
                           g_trade_setup.is_buy?"B":"S");
   if(SignalDrawStrength(g_trade_setup.confidence,g_trade_setup.reliability)<InpMinStrength)
   { g_entry_last_key=""; return; }          // v6.4.1 MinStrength hides (and de-alerts) weak marks
   g_entry_last_key=key;
   if(InpChaseFilter && g_entry_last_late) return;  // v6.4.2: late -> label only, no marker
   if(EntryKeyCooling(key)) return;                 // v6.4.2: cooldown in bars
   EntryKeyAdd(key,g_buf_t[cb],0,g_trade_setup.is_buy,g_trade_setup.entry);
   EntryMarkWriteAt(g_buf_t[cb],0,g_trade_setup.is_buy,true,g_trade_setup.entry);
   EntryMarkObjectsFor(g_buf_t[cb],0,g_trade_setup.is_buy,true);
   g_gate_audit.marks++;   g_gate_audit.core_marks++;
}
//--- ZRE (Zone Reaction Engine) entries: secondary layer, never authoritative.
void MarkZREEntry(const SZRESignal &s)
{
   if(!InpShowZREEntryMarks) return;
   if(s.bar_time<=0) return;
   string key=StringFormat("%s|%.5f|%s",s.zone_id,s.entry,s.is_buy?"B":"S");
   if(EntryKeySeen(key)) return;            // one signal per zone per direction until invalidated
   if(EntryKeyCooling(key)) return;         // v6.4.2: + cooldown in bars after a release
   if(InpProximityFilter)                   // v6.4.2: no BUY under a wall / SELL over one
   {
      double wall=NearestOpposingEdgeATR(s.is_buy,s.entry,MathMax(s.atr,g_atr));
      if(wall>=0.0 && wall<InpProximityMaxATR)
      {
         if(InpDebugLog)
            DebugLogSignal("ZRE","proximity-veto-mark",(s.is_buy?1:-1),s.zone_lo,s.zone_hi,
                           s.entry,s.sl,(s.is_buy?"SUPPORT":"RESISTANCE"),"REACTION CONFIRMED",
                           s.entry,s.entry,s.entry,s.entry,"0.0",
                           StringFormat("%.2f ATR to the opposing level",wall));
         return;
      }
   }
   EntryKeyAdd(key,s.bar_time,1,s.is_buy,s.entry);
   EntryMarkWriteAt(s.bar_time,1,s.is_buy,true,s.entry);
   EntryMarkObjectsFor(s.bar_time,1,s.is_buy,true);
   g_gate_audit.marks++;   g_gate_audit.zre_marks++;
}

//--------------------------------------------------------------------
// AUDIT-D1: the declutter cap, made to do what it says.
//
// SmartObjectCleanup() has always promised that when the chart passes the
// object cap it drops THE OLDEST ZONE_/STRUCT_/OB_/FVG_ decorations and never
// an entry mark. It did not: it measured with ObjectsTotal() (every object on
// the chart, not just ours), it deleted with ObjectsDeleteAll() (a whole family
// rather than the excess), and it filtered on OBJ_RECTANGLE (which the STRUCT_
// family never was, so that family could not contribute). Being one object over
// the cap could therefore erase every demand/supply box on the chart.
//
// These four functions are the corrected mechanism. Two are pure - the excess
// arithmetic and the oldest-slot choice - so both are testable at OnInit without
// a chart. Display only: nothing here reads a price series, changes a threshold,
// touches a verdict, or sends an order, and the cap value itself is unchanged
// (InpMaxChartObjects, else 900 with Clean and 1200 without).
//--------------------------------------------------------------------

// PURE. How many objects must go for the owned count to reach the cap. At the
// cap nothing is pruned (the cap is inclusive), and a non-positive cap means no
// cap at all, so nothing is pruned either.
int QSMC_DeclutterExcess(const int owned,const int cap)
  {
   if(cap<=0) return 0;
   if(owned<=0) return 0;
   if(owned<=cap) return 0;
   return owned-cap;
  }

// PURE. Index of the oldest slot not yet taken, or -1 when none is left. Ties go
// to the lower index, so a pass is reproducible. "Oldest" is the object's own
// anchor time: no price, no history and no symbol assumption. A shorter mask is
// treated as the bound, so a size mismatch can never read past either array.
int QSMC_OldestSlot(const datetime &times[],const bool &taken[])
  {
   int n=ArraySize(times);
   int m=ArraySize(taken);
   if(m<n) n=m;
   int best=-1;
   for(int i=0;i<n;i++)
     {
      if(taken[i]) continue;
      if(best<0 || times[i]<times[best]) best=i;
     }
   return best;
  }

// How many objects on this chart are ours. Walks the chart's own object list
// once, and is called once per new bar from the declutter path only - the same
// idiom QSMC_ApplyVisualPolicy() already uses.
int QSMC_CountOwnedObjects()
  {
   int owned=0;
   int total=ObjectsTotal(0,-1,-1);
   for(int i=total-1;i>=0;i--)
     {
      string name=ObjectName(0,i,-1,-1);
      if(name!="" && StringFind(name,PFX)==0) owned++;
     }
   return owned;
  }

// Delete at most `want` objects of one family, oldest first, and report how many
// really went. Any object type is eligible, so a family drawn as text is pruned
// like a family drawn as boxes. Two passes over the object list and no dynamic
// growth inside a loop; entry marks are in no family this is ever called with.
int QSMC_DeleteOldestFamily(const string prefix,const int want)
  {
   if(want<=0 || prefix=="") return 0;
   int total=ObjectsTotal(0,-1,-1);
   int found=0;
   for(int i=total-1;i>=0;i--)
     {
      string name=ObjectName(0,i,-1,-1);
      if(name!="" && StringFind(name,prefix)==0) found++;
     }
   if(found<=0) return 0;
   string   names[];
   datetime times[];
   bool     taken[];
   ArrayResize(names,found);
   ArrayResize(times,found);
   ArrayResize(taken,found);
   int k=0;
   for(int i=total-1;i>=0;i--)
     {
      string name=ObjectName(0,i,-1,-1);
      if(name=="" || StringFind(name,prefix)!=0) continue;
      names[k]=name;
      times[k]=(datetime)ObjectGetInteger(0,name,OBJPROP_TIME,0);
      taken[k]=false;
      k++;
     }
   int n=MathMin(want,k);
   int removed=0;
   for(int d=0;d<n;d++)
     {
      int slot=QSMC_OldestSlot(times,taken);
      if(slot<0) break;
      taken[slot]=true;
      if(ObjectDelete(0,names[slot])) removed++;
     }
   return removed;
  }

// AUDIT-D1 self-test: the two pure cores only - no chart, no object list, no
// terminal state - so a regression is caught at OnInit instead of on a long
// chart. Gated by InpMTEERunSelfTest, the file's existing self-test switch.
bool QSMC_DeclutterSelfTest(string &where)
  {
   where="";
   // DC-1 under the cap nothing is pruned.
   if(QSMC_DeclutterExcess(500,1200)!=0)
   { where="DC-1 under the cap nothing may be pruned"; return false; }
   // DC-2 the cap is inclusive: exactly at it, nothing is pruned.
   if(QSMC_DeclutterExcess(1200,1200)!=0)
   { where="DC-2 the cap is inclusive"; return false; }
   // DC-3 one over the cap costs ONE object, not a whole family.
   if(QSMC_DeclutterExcess(1201,1200)!=1)
   { where="DC-3 one over the cap must cost exactly one object"; return false; }
   // DC-4 the excess is the difference, so the chart lands on the cap.
   if(QSMC_DeclutterExcess(1500,900)!=600)
   { where="DC-4 the excess must be owned minus cap"; return false; }
   // DC-5 a non-positive cap means no cap: nothing is pruned.
   if(QSMC_DeclutterExcess(5000,0)!=0 || QSMC_DeclutterExcess(5000,-1)!=0)
   { where="DC-5 a non-positive cap must prune nothing"; return false; }
   // DC-6 a non-positive owned count can never produce a phantom excess.
   if(QSMC_DeclutterExcess(0,1200)!=0 || QSMC_DeclutterExcess(-5,1200)!=0)
   { where="DC-6 a non-positive owned count must prune nothing"; return false; }
   datetime t[4]; bool tk[4];
   t[0]=(datetime)300; t[1]=(datetime)100; t[2]=(datetime)200; t[3]=(datetime)100;
   tk[0]=false; tk[1]=false; tk[2]=false; tk[3]=false;
   // DC-7 the oldest slot is chosen by the object's own anchor time.
   if(QSMC_OldestSlot(t,tk)!=1)
   { where="DC-7 the oldest slot must be chosen by anchor time"; return false; }
   // DC-8 a tie goes to the lower index, so one pass is reproducible.
   if(QSMC_OldestSlot(t,tk)!=1)
   { where="DC-8 a tie must go to the lower index"; return false; }
   tk[1]=true;
   // DC-9 slots already taken are skipped, and the next oldest is chosen.
   if(QSMC_OldestSlot(t,tk)!=3)
   { where="DC-9 a taken slot must be skipped"; return false; }
   tk[0]=true; tk[2]=true; tk[3]=true;
   // DC-10 when every slot is taken the answer is -1, never an index.
   if(QSMC_OldestSlot(t,tk)!=-1)
   { where="DC-10 no free slot must return -1"; return false; }
   bool none[]; datetime notime[];
   if(QSMC_OldestSlot(notime,none)!=-1)
   { where="DC-11 an empty list must return -1"; return false; }
   return true;
  }

void SmartObjectCleanup(const bool isNewBar)
{
   if(!InpSmartObjectManagement) return;

   // v6.4.2 DECLUTTER: unbounded object growth is a real MT5 slowdown on a
   // long chart. Once per new bar, if the QSMC_* object count passes the cap,
   // drop the oldest ZONE_/STRUCT_/OB_/FVG_ decorations (never entry marks).
   if(isNewBar)
   {
      int cap=(InpMaxChartObjects>0 ? InpMaxChartObjects : (InpDeclutterMode?900:1200));
      // AUDIT-D1: the cap is on QSMC_* objects, which is what this input's own
      // label ("hard cap on QSMC_* chart objects per pass") and the comment above
      // have always said. ObjectsTotal() counts every object on the chart,
      // including other indicators' and the operator's own drawings, so measuring
      // with it pruned our zones to pay for somebody else's clutter.
      int owned=QSMC_CountOwnedObjects();
      int excess=QSMC_DeclutterExcess(owned,cap);
      if(excess>0)
      {
         // AUDIT-D1: "drop the oldest decorations" now means exactly that, and
         // only that many. The previous code called ObjectsDeleteAll(), which
         // removed EVERY object in a family - one object over the cap cost the
         // whole ZONE_ family - and it filtered on OBJ_RECTANGLE, which the
         // STRUCT_ family never was (structure marks are OBJ_TEXT, drawn by
         // DrawTextLabel), so cut[1] could never contribute at all.
         string cut[4]; cut[0]=PFX+"ZONE_"; cut[1]=PFX+"STRUCT_"; cut[2]=PFX+"OB_"; cut[3]=PFX+"FVG";
         for(int c=0;c<4 && excess>0;c++)
         {
            int removed=QSMC_DeleteOldestFamily(cut[c],excess);
            if(removed>0)
            {
               Print("[Objects] ",removed," ",cut[c],"* objects removed, oldest first (cap ",cap,
                     ", owned ",owned,")");
               excess-=removed;
            }
         }
         // Said out loud rather than hidden: if the four decoration families
         // cannot cover the excess, the chart stays over the cap. Entry marks,
         // the dashboard and every other family are never pruned to reach it.
         if(excess>0)
            Print("[Objects] still ",excess," over the cap ",cap," after pruning",
                  " ZONE_/STRUCT_/OB_/FVG oldest-first: entry marks and the dashboard are never pruned");
      }
   }

   if(!g_active_setup.active)
   {
      ObjectDelete(0,PFX+"SETUPZONE");
      ObjectDelete(0,PFX+"SETUPZONE_L");
      CleanupScaleObjects(); // v5.8.0: analytical scale levels follow their setup
   }

   if(!g_trade_setup.valid)
   {
      ObjectDelete(0,PFX+"ENTRY");
      ObjectDelete(0,PFX+"SL");
      ObjectDelete(0,PFX+"TP1");
      ObjectDelete(0,PFX+"TP2");
      ObjectDelete(0,PFX+"TP3");
      ObjectDelete(0,PFX+"ENTRY_ARROW");
      ObjectDelete(0,PFX+"CONNECT");
      ObjectDelete(0,PFX+"TRADE_BOX_BG");
      for(int i=0;i<10;i++) ObjectDelete(0,PFX+"TBOX_"+IntegerToString(i));
   }
}

void PrepareDynamicRedraw()
{
   // Index-based names become stale after array pruning.  Delete only the
   // dynamic categories, and only on a new bar, then redraw from masters.
   ObjectsDeleteAll(0,PFX+"ZRE_");   // v6.3.0: projections are redrawn by ZRE_Update
   ObjectsDeleteAll(0,PFX+"RXN_");   // v6.5.0: reaction labels are redrawn by RXN_Update
   ObjectsDeleteAll(0,PFX+"SNIPER_");// v6.5.2: sniper zones are redrawn by MTF_SniperZone_Draw
   ObjectsDeleteAll(0,PFX+"SBP3_"); // AUDIT-SB1: the Silver Bullet entry zone is
                                   // redrawn by SB_DrawEntryZone from the dashboard
   ObjectsDeleteAll(0,PFX+"WY_");   // AUDIT-WY1: the Wyckoff range box is redrawn
                                   // by WY_DrawRange from the dashboard
   ObjectsDeleteAll(0,PFX+"ZN_");
   ObjectsDeleteAll(0,PFX+"STR_");
   // v6.1.3 (L5b): the live objects are named STRUCT_/ZONE_/PD_ - the two
   // legacy prefixes above never matched them, so stale BOS/CHoCH labels
   // (e.g. a break re-classified BOS -> CHoCH on a full rebuild) and old
   // zones stayed on the chart underneath the current ones.
   ObjectsDeleteAll(0,PFX+"STRUCT_");
   ObjectsDeleteAll(0,PFX+"ZONE_");
   ObjectsDeleteAll(0,PFX+"PD_");
   ObjectsDeleteAll(0,PFX+"OB_");
   ObjectsDeleteAll(0,PFX+"BRK_");
   ObjectsDeleteAll(0,PFX+"FVG");
   ObjectsDeleteAll(0,PFX+"LIQ_");
   ObjectsDeleteAll(0,PFX+"KZ_");
   ObjectsDeleteAll(0,PFX+"PREM");
   ObjectsDeleteAll(0,PFX+"DISC");
   ObjectsDeleteAll(0,PFX+"OTE");
   ObjectsDeleteAll(0,PFX+"FIB_");
   ObjectsDeleteAll(0,PFX+"PFR_");
   ObjectDelete(0,PFX+"JUDAS");
}

//====================================================================
// INIT / DEINIT / EVENTS
//====================================================================
//====================================================================
// v6.1.0 PMI — PREDICTIVE MARKET INTELLIGENCE LAYER
// ADDITIVE research/intelligence layer. It observes the canonical closed-bar
// state and the authoritative decision; it NEVER creates, mutates, invalidates
// or authorises a trade setup. Entry authority remains
// CalculateAITradeSetup / ManageSetupLifecycle.
//====================================================================
struct SPMIConfig
{
   bool   enabled;
   int    fractal_n;
   int    mtf_window;
   int    structure_dedupe_window;
   double liq_tolerance_atr;
   double sweep_depth_min_atr;
   int    sweep_to_mss_bars;
   int    outcome_horizon;
   double risk_atr;
   double target_r;
   int    k_nearest;
   int    min_samples;
   int    snapshot_cap;
   int    max_tree_depth;
   int    min_tree_segment;
   int    tree_rebuild_every;
   int    replay_every;
   int    replay_bars;
   bool   valid;
};

//====================================================================
// v6.1.0 PMI — CORE TYPES
//====================================================================

//--- Phase 3: one authoritative snapshot of "where are we".
struct MarketState
{
   string   symbol;
   datetime timestamp;        // decision boundary (open of the forming bar)

   double   bid;              // recorded, never used for decisions
   double   ask;

   double   open;
   double   high;
   double   low;
   double   close;

   int      direction;        // +1 bullish / -1 bearish / 0 undecided

   double   volatility;       // ATR ratio vs baseline
   double   atr;
   int      regime;           // ENUM_PMI_REGIME
   int      vol_regime;       // ENUM_PMI_VOLREGIME

   int      htfBias;
   int      structureBias;

   double   premiumDiscount;  // 0..1 (1 = range high = premium)

   double   nearestBSL;
   double   nearestSSL;

   bool     sweepDetected;
   bool     displacementDetected;
   bool     mssDetected;

   bool     validOB;
   bool     validFVG;

   bool     retestDetected;
   bool     ltfConfirmation;

   int      setupState;       // ENUM_SIGNAL_STATE mirror
   string   setupStateText;

   double   confluenceScore;  // weighted evidence (NEVER a probability)
   double   setupQuality;     // quality class driver (NEVER a probability)

   int      session;          // ENUM_PMI_SESSION
   int      noTradeCode;      // ENUM_PMI_NO_TRADE
   string   noTradeReason;

   double   analogueHitRate;  // observed frequency, only when sample >= minimum
   int      analogueSample;
   bool     analogueSufficient;

   bool     entryReady;       // authoritative AND complete AND data-valid
   string   causalChainText;
   string   missingCondition;
};

//--- Phase 4: per-timeframe state. One slot per TF; a lower timeframe can
//--- never write into a higher timeframe's slot.
struct SPMITFState
{
   ENUM_TIMEFRAMES tf;
   bool     valid;
   int      closed_bars;
   datetime last_closed_time;   // open time of the last CLOSED HTF candle
   datetime available_time;     // close time of that candle (earliest action time)
   int      bias;               // swing-recency bias
   int      structure_dir;      // direction of last confirmed structure event
   int      last_event_type;    // PMI_STRUCT_*
   string   structure_state;    // BULLISH / BULLISH_PULLBACK / BEARISH / BEARISH_PULLBACK / NEUTRAL
   double   eq;
   double   range_high;
   double   range_low;
   double   pd_position;        // 0..1
   double   atr;
   double   close_price;
   int      swing_high_count;
   int      swing_low_count;
   datetime last_high_time;
   datetime last_low_time;
   string   label;
};

//--- Phase 6: structural event with full provenance.
struct StructureEvent
{
   ulong    id;
   string   idText;
   ENUM_TIMEFRAMES timeframe;
   int      type;              // PMI_STRUCT_BOS / CHOCH / MSS
   int      direction;         // +1 bullish break, -1 bearish break
   datetime originTime;        // swing origin time
   datetime confirmationTime;  // confirming HTF candle open time
   datetime availabilityTime;  // earliest time a chart decision could use it
   double   brokenLevel;
   int      sourceSwingIndex;  // index inside that timeframe's closed series
   bool     confirmed;
   bool     invalidated;
   int      originBar;
   int      confirmationBar;
   int      stale_bars;        // distance (chart bars) at last evaluation
};

//--- Phase 7: liquidity object with explicit status and timestamps.
struct SPMILiquidity
{
   ulong    id;
   string   idText;
   string   type;              // BSL SSL EQH EQL PDH PDL PWH PWL SESS_H SESS_L
   double   price;
   datetime creationTime;
   datetime confirmationTime;
   datetime availabilityTime;
   ENUM_TIMEFRAMES timeframe;
   int      strength;          // 1..5 (deterministic, documented)
   ENUM_PMI_LIQ_STATUS status;
   int      originBar;         // chart bar index (or -1 when computed from a prior period)
   int      availabilityBar;   // chart bar index from which it is actionable
   bool     is_external;
   double   penetrationATR;    // deepest penetration observed (closed bars)
   datetime lastTouchTime;
   int      touches;
};

//--- Phase 8: sweep measurement (a wick alone is never a sweep).
struct SPMISweep
{
   bool     valid;
   ulong    liquidityId;
   string   liquidityIdText;
   string   liquidityType;
   double   level;
   int      bar;
   datetime time;
   int      direction;         // +1 = SSL taken (bullish reversal candidate), -1 = BSL taken
   double   penetration;       // price beyond the level
   double   penetrationATR;
   double   closeBackATR;      // distance of the close back inside the level
   double   wickBodyRatio;
   double   closeLocation;     // 0..1 of the sweep candle
   bool     reclaimed;
   bool     displacementFollowed;
   int      htfBiasAtSweep;    // recorded causally (state at that bar)
   int      sessionAtSweep;
   double   qualityScore;      // measurement 0..100 (documented weights). NOT a probability.
   string   qualityLabel;      // NONE / WEAK / VALID / HIGH_QUALITY
};

//--- Phase 9: displacement measurement.
struct SPMIDisplacement
{
   bool     valid;
   int      bar;
   datetime time;
   int      direction;
   double   bodyATR;
   double   rangeATR;
   double   closeLocation;
   double   efficiency;        // |net move| / path length over the impulse run
   int      consecutiveImpulse;
   bool     brokeStructure;
   bool     createdFVG;
   double   volumeRatio;
   double   strength;          // 0..100, documented additive weights
   string   label;             // NONE / WEAK / MODERATE / STRONG / EXTREME
};

//--- Phase 10: the causal chain. Every stage has an id and a parent.
struct SPMISequence
{
   int      direction;
   bool     hasLiquidity;
   bool     hasSweep;
   bool     hasDisplacement;
   bool     hasMSS;               // true only for an actual Core CE_MSS event
   bool     hasStructure;         // Core-selected MSS / CHoCH / BOS (actual type below)
   bool     hasZone;
   bool     hasRetest;
   bool     hasLTFConfirm;
   bool     entryReady;

   ulong    liquidityEventId, sweepEventId, displacementEventId, mssEventId;
   ulong    structureEventId;
   ulong    obEventId, fvgEventId, retestEventId, ltfConfirmEventId;
   string   liquidityIdText, sweepIdText, displacementIdText, mssIdText;
   string   structureIdText, structureType;
   string   obIdText, fvgIdText, retestIdText, ltfConfirmIdText;

   int      liquidityBar, sweepBar, displacementBar, mssBar;
   int      structureBar;
   int      zoneBar, retestBar, ltfConfirmBar;
   datetime liquidityTime, sweepTime, displacementTime, mssTime;
   datetime structureTime;
   datetime zoneTime, retestTime, ltfConfirmTime;

   string   missingCondition;
   string   stateText;
   bool     causalOrderValid;
   string   causalBreakReason;
   int      stageIndex;        // index of the first unsatisfied stage
};

//--- Phase 12: location engine.
struct SPMILocation
{
   double   pd_d1;
   double   pd_h4;
   double   pd_h1;
   string   zone_d1;
   string   zone_h4;
   string   zone_h1;
   double   dist_pdh_atr;
   double   dist_pdl_atr;
   double   dist_pwh_atr;
   double   dist_pwl_atr;
   // v6.5.3: the LEVEL PRICES themselves, stored instead of being reconstructed
   // as price + distance*ATR in the panel. A reconstruction is only exact while
   // the ATR snapshot used to build the distance is the same one used to draw it;
   // storing the price removes that class of drift completely.
   double   pdh_price;
   double   pdl_price;
   double   pwh_price;
   double   pwl_price;
   double   dist_eqh_atr;
   double   dist_eql_atr;
   double   dist_obs_atr;      // nearest causal OB
   double   dist_fvg_atr;      // nearest causal FVG
   double   nearest_bsl;
   double   nearest_ssl;
   double   dist_bsl_atr;
   double   dist_ssl_atr;
   bool     valid;
};

//--- Phase 13: regime.
struct SPMIRegimeInfo
{
   ENUM_PMI_REGIME regime;
   string   label;
   ENUM_PMI_VOLREGIME vol_regime;
   string   vol_label;
   double   atr_ratio;
   double   atr;
   double   atr_percentile;
   double   efficiency;        // net move / gross move over the window
   string   detail;
};

//--- Phase 14: session (UTC internal, Algeria local for display only).
struct SPMISessionInfo
{
   int      session;           // ENUM_PMI_SESSION
   string   label;
   string   utc_time_text;
   string   algeria_time_text;
   bool     kill_zone;
   double   bars_into_session;
};

//--- Phase 17: historical analogue sample.
struct SPMISnapshot
{
   bool     used;
   int      bar;
   datetime time;
   double   close_price;
   double   atr;
   int      ctx_dir;           // hypothesis direction recorded at that bar
   double   v[PMI_FV_DIM];
};

//--- Phase 17: one analogue with its measured outcome.
struct SPMIAnalogue
{
   bool     valid;
   int      bar;
   datetime time;
   double   distance;
   double   mfe_r;
   double   mae_r;
   double   rr;
   int      bars_to_target;
   int      bars_to_invalidation;
   bool     target_hit;
   bool     invalidated;
   bool     censored;
   int      risk_dir;
};

//--- Phase 19: conditional statistic (with mandatory disclosure fields).
struct SPMIStat
{
   string   condition;
   int      sample;            // fully observed samples
   int      censored;          // excluded samples (measurement window truncated)
   int      target_hits;
   int      stop_hits;
   double   target_rate;       // % of fully observed samples
   double   median_mfe_r;
   double   median_mae_r;
   double   avg_rr;
   bool     sufficient;
   string   period_from;
   string   period_to;
   string   symbol;
   string   timeframe;
};

//--- Phase 18: one conditional price path.
struct SPMIPricePath
{
   string   pathId;
   string   label;
   int      direction;
   double   targetLiquidity;
   string   targetLiquidityType;
   ulong    targetLiquidityId;
   double   invalidation;
   string   requiredConditions[PMI_MAX_MISSING];
   int      requiredCount;
   string   satisfiedConditions[PMI_MAX_MISSING];
   int      satisfiedCount;
   string   missingConditions[PMI_MAX_MISSING];
   int      missingCount;
   int      analogueCount;
   double   mfeAvg;
   double   maeAvg;
   double   rrAvg;
   double   hitRate;
   bool     hitRateSufficient;
   ENUM_PMI_PATH_STATUS status;
   string   statusText;
};

//--- Phase 30: serializable predictive setup.
struct PredictiveSetup
{
   ulong    setupId;
   int      direction;
   int      state;             // ENUM_SIGNAL_STATE mirror
   string   stateText;
   double   entryZoneLow;
   double   entryZoneHigh;
   double   invalidation;
   double   target1;
   double   target2;
   double   target3;
   double   confluenceScore;   // weighted evidence, NOT a probability
   int      historicalSampleSize;
   double   historicalMFE;
   double   historicalMAE;
   double   analogueHitRate;
   bool     analogueSufficient;
   ulong    liquidityEventId;
   ulong    sweepEventId;
   ulong    displacementEventId;
   ulong    mssEventId;             // actual MSS only
   ulong    structureEventId;       // selected Core MSS / CHoCH / BOS
   ulong    obEventId;
   ulong    fvgEventId;
   ulong    retestEventId;
   ulong    ltfConfirmEventId;
   bool     entryReady;
   string   noTradeReason;
   string   causalChainText;
};

//--- Phase 15: recursive binary-tree research node.
//--- MQL5 has no pointers to structs, so the tree is stored in a flat
//--- pool (g_pmi_nodes[]) and the child links are indices into that
//--- pool; PMI_NODE_NONE (-1) is the "null" child.
struct MarketTreeNode
{
   int      startIndex;
   int      endIndex;
   int      depth;
   ENUM_TIMEFRAMES timeframe;
   double   high;
   double   low;
   double   midpoint;
   double   volatility;        // std-dev of returns over the segment (%)
   int      bullishEvents;
   int      bearishEvents;
   int      sweeps;
   int      displacements;
   int      mssEvents;
   int      completeSetups;
   int      failedSetups;
   double   qualityScore;
   int      splitAxis;         // ENUM_PMI_TREE_AXIS
   int      splitIndex;
   bool     terminal;
   int      eventsCounted;
   int      id_serial;         // deterministic creation ordinal
   int      left;              // pool index of left child (PMI_NODE_NONE)
   int      right;             // pool index of right child (PMI_NODE_NONE)
};

//--- Phase 28: data quality report.
struct SPMIDataQuality
{
   bool     ok;
   int      bars;
   int      first_bar;
   int      last_bar;
   datetime first_time;
   datetime last_time;
   int      duplicated_times;
   int      non_monotonic_times;
   int      invalid_ohlc;
   int      zero_range_bars;
   int      gaps;               // time gaps > period (weekends/holidays/missing data)
   int      expected_bars;
   double   coverage;           // actual / expected over the analysed span
   int      spread_anomalies;
   long     max_spread;
   double   median_spread;
   bool     sufficient_history;
   string   detail;
};

//--- Phase 24: candle-by-candle replay engine.
struct CausalReplayEngine
{
   bool     enabled;
   int      last_audited_bar;
   int      audits_run;
   int      bars_rederived;
   int      digests_stored;
   int      digest_ring_head;
   int      repaint_failures;
   int      lookahead_failures;
   int      causality_failures;
   string   first_failure_detail;
   string   last_report;
   bool     pass_repaint;
   bool     pass_lookahead;
   bool     pass_causality;
};

//--- Phase 31: structured event log entry.
struct SPMILogEntry
{
   datetime time;
   string   symbol;
   string   timeframe;
   string   kind;
   string   text;
};

//--- Published per-bar digest (replay audit evidence).
struct SPMIDigest
{
   bool     used;
   int      bar;
   datetime time;
   ulong    level_set_hash;
   ulong    level_status_hash;
   ulong    sequence_hash;
   int      level_count;
   // the level identities needed to re-derive the status purely from bars
   double   lv_price[PMI_MAX_LEVELS_AUDIT];
   int      lv_type[PMI_MAX_LEVELS_AUDIT];   // hashed type code (deterministic)
   int      lv_avail[PMI_MAX_LEVELS_AUDIT];
   int      lv_status[PMI_MAX_LEVELS_AUDIT];
};

//--- price-action feature bundle (Phase 5, chart timeframe, closed bars) --
struct SPMIPriceAction
{
   bool     valid;
   int      bar;
   datetime time;
   double   open,high,low,close;
   double   range_atr;
   double   body_atr;
   double   upper_wick_atr;
   double   lower_wick_atr;
   double   body_ratio;
   double   close_location;   // 0..1
   int      direction;        // +1 bullish candle, -1 bearish candle, 0 doji
   int      consecutive_dir;  // signed run length of same-direction closes
   bool     inside_bar;
   bool     expansion;
   bool     compression;
   bool     rejection_up;     // upper-wick rejection (supply)
   bool     rejection_down;   // lower-wick rejection (demand)
   bool     engulfing_bull;
   bool     engulfing_bear;
   bool     imbalance_gap;    // open beyond previous candle range
};

//--- research event ring record (kinds: see PMI_EV_* defines)
struct SPMIEventRec
{
   bool     used;
   int      bar;
   int      kind;
   int      dir;
   double   value;
};

//--- research tree node reference returned by SearchRecursive
struct SPMITreeNodeRef
{
   int    serial;
   int    start;
   int    end;
   int    depth;
   double distance;
   double volatility;
   double quality;
   int    events;
   double midpoint;
   int    axis;
};

//====================================================================
