//====================================================================
// FAST MTF EXECUTION ENTRY - TACTICAL ONLY
// Does not mutate g_trade_setup.valid or bypass institutional confirmation.
//====================================================================
ENUM_TIMEFRAMES SelectExecutionTF()
{
   if(!InpAutoExecutionTF) return InpExecutionTF;
   int sec=PeriodSeconds((ENUM_TIMEFRAMES)_Period);
   if(sec<=PeriodSeconds(PERIOD_M5))  return PERIOD_M1;
   if(sec<=PeriodSeconds(PERIOD_M30)) return PERIOD_M5;
   return PERIOD_M15;
}
// v6.4.1: "institutional confirmation" is a GRADE shown on the label, not a
// gate on the display. Grade the owning CORE setup when present; without one,
// a confirmed tactical entry is B and an unconfirmed preview is C.
string MTFEntryGrade(const bool confirmed,const bool core_owned)
{
   if(!confirmed) return "C";
   if(core_owned)
      return InstitutionalLetterGrade(g_active_setup.confidence,g_active_setup.reliability,
                                       g_active_setup.causal_path_score);
   return "B";
}
void ClearMTFExecutionEntry()
{
   g_tac_dir=0; g_tac_closed=false;
   g_mtf_entry_state=""; g_mtf_entry_price=0.0; g_mtf_entry_time=0;
   g_mtf_entry_late=false; g_mtf_sig_time=0;
   // v6.6.10 AUDIT-TAC: the authority verdict belongs to this display, so it is
   // cleared with it. A caller that wants to KEEP the reason (because the clear
   // was itself the decision) re-publishes it immediately after this call.
   g_mtf_entry_authority=""; g_mtf_entry_blocked=false; g_mtf_entry_src=-1;
   ObjectDelete(0,PFX+"MTF_ENTRY"); ObjectDelete(0,PFX+"MTF_ENTRY_TX");
   EntryMarkClearTactical();   // v6.4.1: no orphan arrow/preview mark when the signal lapses
}
void UpdateMTFExecutionEntry()
{
   if(!InpUseMTFExecutionEntry){ ClearMTFExecutionEntry(); return; }
   bool have_dir=false,bull=false,core_owned=false; double trigger=0.0; datetime trigger_time=0;
   // v6.6.10 AUDIT-TAC2: WHICH module supplied the direction decides how much the
   // display may claim. 0 = early-break live preview, 1 = the Core lifecycle owns
   // it, 2 = the higher-timeframe bias alone. Only src==2 can be downgraded to
   // CONTEXT, because that is the one branch with no location fact behind it -
   // exactly the rule the arbitration layer already enforces for alerts
   // (QSMC_Root.mqh BuildTacticalCandidate: "LOCATION FIRST (R1). Direction comes
   // from the zone, never from the HTF bias alone"). The display used to be the
   // only reader that did not apply it.
   int src=-1,trigger_bar=-1;
   if(g_early_break_structure_idx>=0 && g_early_break_price>0.0 &&
      g_early_break_status=="LIVE_PREVIEW")
   { have_dir=true; bull=g_early_break_bull; trigger=g_early_break_price; trigger_time=g_early_break_structure_time; src=0; }
   else if(g_active_setup.active)
   { have_dir=true; core_owned=true; bull=g_active_setup.is_buy; trigger=g_active_setup.entry; trigger_time=g_active_setup.created_time; src=1; }
   else if(g_htf_bias==1 || g_htf_bias==-1)
   {
      have_dir=true; bull=(g_htf_bias>0); src=2;
      for(int i=ArraySize(g_structures)-1;i>=0;i--)
      {
         if(g_structures[i].type=="INIT" || g_structures[i].bullish!=bull) continue;
         trigger=g_structures[i].price; trigger_time=g_structures[i].time;
         trigger_bar=g_structures[i].bar;   // chronological chart bar of the event
         break;
      }
   }
   if(!have_dir || trigger<=0.0){ ClearMTFExecutionEntry(); return; }
   if(InpUseHTFBias && g_htf_bias!=(bull?1:-1)){ ClearMTFExecutionEntry(); return; }
   //--- v6.6.10 AUDIT-TAC1 AUTHORITATIVE-STATE GATE. Runs before anything is
   //--- drawn, marked or handed to the arbiter, so a retired scenario cannot keep
   //--- a live preview and a stale trigger cannot look like a fresh entry.
   //--- CAUSALITY: this reads the last PUBLISHED closed-bar verdicts (DSE plans,
   //--- Core blacklist). UpdateMTFExecutionEntry() is called earlier in
   //--- OnCalculate than ScenarioUpdate(), so on the first tick of a new chart bar
   //--- the DSE snapshot is still the previous closed bar's. That is the newest
   //--- authoritative verdict that exists at this instant - strictly causal, never
   //--- look-ahead - and it is replaced by the current bar's verdict later in the
   //--- same OnCalculate pass, before the dashboard is drawn.
   string auth_reason="";
   ENUM_TACTICAL_AUTHORITY auth=TacticalAuthorityGate(bull,src,trigger_bar,trigger,auth_reason);
   if(auth==TAC_AUTH_BLOCKED || auth==TAC_AUTH_STALE)
   {
      ClearMTFExecutionEntry();
      // re-publish: the clear IS the decision, and the panel has to say why
      g_mtf_entry_src=src;
      g_mtf_entry_blocked=true;
      g_mtf_entry_authority=TacticalAuthorityName((int)auth)+" - "+auth_reason;
      // Same debug channel every other veto site uses (CORE / ZRE / RXN
      // proximity and direction vetoes); it is a no-op unless InpDebugLog.
      if(InpDebugLog)
         DebugLogSignal("MTF-TACTICAL","authority-gate",(bull?1:-1),0.0,0.0,trigger,0.0,
                        (bull?"BUY":"SELL"),TacticalAuthorityName((int)auth),
                        0.0,0.0,0.0,0.0,"",auth_reason);
      return;
   }
   ENUM_TIMEFRAMES etf=SelectExecutionTF(); g_mtf_entry_tf=etf;
   double atr=g_atr; if(atr<=0.0) atr=MathMax(100.0*_Point,10.0*_Point);
   double lh=iHigh(_Symbol,etf,0), ll=iLow(_Symbol,etf,0), lo=iOpen(_Symbol,etf,0), lc=iClose(_Symbol,etf,0);
   double ch=iHigh(_Symbol,etf,1), cl=iLow(_Symbol,etf,1), co=iOpen(_Symbol,etf,1), cc=iClose(_Symbol,etf,1);
   datetime lt=iTime(_Symbol,etf,0), ct=iTime(_Symbol,etf,1);
   if(lt<=0 || ct<=0){ ClearMTFExecutionEntry(); return; }
   // v6.1.3 (L5a): a trigger that predates the owning event is stale - clear
   // the display instead of leaving an old line/label behind.
   if(trigger_time>0 && ct<trigger_time){ ClearMTFExecutionEntry(); return; }
   double lp=(lc>0.0?lc:(bull?lh:ll));
   double close_c=(cc>0.0?cc:lc);
   // v6.4.1 CHASE FILTER: the old test silently dropped the entry once price ran
   // further than InpMTFEntryMaxDistanceATR ATR from the trigger, so the chart
   // showed nothing at all. Keep the zone visible and label it LATE; only a
   // CONFIRMED beyond the same limit is suppressed (that entry is stale).
   double dist_atr=(atr>0.0 ? MathAbs(lp-trigger)/atr : 0.0);
   double dist_close_atr=(atr>0.0 ? MathAbs(close_c-trigger)/atr : 0.0);
   bool far=(dist_atr>MathMax(0.1,InpMTFEntryMaxDistanceATR));
   bool too_far=(far && dist_close_atr>MathMax(0.1,InpMTFEntryMaxDistanceATR));
   if(too_far){ ClearMTFExecutionEntry(); return; }
   g_mtf_entry_late=(InpChaseFilter && dist_close_atr>InpChaseMaxATR);
   bool live_cross=bull ? (lh>=trigger && lc>=lo) : (ll<=trigger && lc<=lo);
   // v6.4.1 NO-REPAINT: CONFIRMED is a CLOSED execution-bar fact only. The
   // forming M5/M1 bar used to confirm via live_cross, which re-labelled the
   // same price PREVIEW/CONFIRMED on every tick and re-alerted each time.
   bool closed_confirm=bull ? (ch>=trigger && cc>co && cc>=trigger)
                            : (cl<=trigger && cc<co && cc<=trigger);
   // AUDIT-RS1: publish the tactical layer to the resolver. Cleared in
   // ClearMTFExecutionEntry() so a lapsed trigger never keeps voting.
   g_tac_dir=bull?1:-1; g_tac_closed=closed_confirm;
   // PREVIEW needs a reason: a live cross of the trigger, or the closed bar
   // that is heading for confirmation. Otherwise nothing is displayed.
   bool show_preview=live_cross;
   if(!closed_confirm && !show_preview){ ClearMTFExecutionEntry(); return; }
   // AUDIT-RS1: CONFIRMED is the resolver's word. With the resolver on this
   // layer says INFO - a closed execution bar is a fact, not a passed gate.
   string state=closed_confirm?(InpUseFinalResolver?"INFO":"CONFIRMED"):"PREVIEW";
   double ep=closed_confirm?cc:lc; datetime et=closed_confirm?ct:lt;
   string id=StringFormat("%s|%d|%I64d|%s|%.5f",_Symbol,(int)etf,(long)trigger_time,bull?"B":"S",trigger);
   // v6.4.1 DEDUP: a signal that already fired CONFIRMED never re-alerts as a
   // PREVIEW when the condition lapses and re-arms (that loop is what produced
   // the "same CONFIRMED entry over and over" journal spam).
   if(state=="PREVIEW" && g_last_mtf_entry_key==id+"|CONFIRMED"){ ClearMTFExecutionEntry(); return; }
   // v6.6.10 AUDIT-TAC3 (RESTORED DEDUP KEY). tools/apply_qsmc_arb_patch.py
   // EDIT 6 deleted the alert block that held the ONLY write to
   // g_last_mtf_entry_key and left both of its readers in place, so the key was
   // permanently "" and
   //   * the guard above - "a signal that already fired CONFIRMED never re-alerts
   //     as a PREVIEW when the condition lapses and re-arms (that loop is what
   //     produced the 'same CONFIRMED entry over and over' journal spam)" - could
   //     never fire, and
   //   * the g_mtf_sig_time re-anchor condition below was permanently true.
   // Writing the key back restores the documented v6.4.1 semantics. Alerts stay
   // owned by the arbitration layer; this key dedups the DISPLAY and the
   // signal-bar anchor only. It is deliberately never reset: the dedup is
   // permanent per (symbol, exec TF, trigger time, direction, trigger price).
   if(closed_confirm) g_last_mtf_entry_key=id+"|CONFIRMED";
   g_mtf_entry_state=state; g_mtf_entry_price=ep; g_mtf_entry_time=et;
   g_mtf_entry_src=src;
   g_mtf_entry_blocked=false;
   g_mtf_entry_authority=(auth==TAC_AUTH_CONTEXT ? TacticalAuthorityName((int)auth)+" - "+auth_reason : "");
   // v6.4.1: the honest anchor of a tactical signal is the bar that PRODUCED the
   // fact. live_cross reads the forming bar (it can still repaint), so the signal
   // bar is that bar only once it has closed; otherwise it is the closed bar.
   if(closed_confirm && InpAlertOnSignalBar &&
      (g_mtf_sig_time==0 || g_last_mtf_entry_key!=id+"|CONFIRMED"))
      g_mtf_sig_time=(live_cross ? iTime(_Symbol,etf,1) : iTime(_Symbol,etf,0));
   else if(!closed_confirm) g_mtf_sig_time=0;
   if(g_mtf_sig_time<=0 || g_mtf_sig_time>et) g_mtf_sig_time=et;
   // v6.6.0 SYMPTOM 1-4 FIX. The fact is RECORDED here and DECIDED by
   // the arbitration layer at the end of the bar (QSMC_ArbiterFeedAnd
   // Finalize -> CQuantumRoot::FinalizeBar). The v6.5.5 code called
   // FireQuantAlert() at the bottom of this function, which:
   //   - read no zone, no reaction, no room, no cooldown (symptoms 1,2);
   //   - ran before ZRE_Update/RXN_Update, so it could not see the zone
   //     list at all (symptoms 2,3);
   //   - built its dedupe key from g_mtf_sig_time, a value that is
   //     re-anchored to 0 on every PREVIEW bar, so the same signal
   //     alternated between two keys and re-fired (symptom 1);
   //   - printed the word CONFIRMED for a non-authoritative path (R7).
   if(InpArbEnabled && InpArbGateTactical && InpAlertOnMTFExecutionEntry &&
      QSMC_Root()!=NULL)
   {
      STacticalFact _tf;
      _tf.valid=true;
      _tf.bull=bull;
      _tf.closed_confirm=closed_confirm;
      _tf.entry_price=ep;
      _tf.exec_bar_time=et;
      _tf.exec_tf=etf;
      _tf.trigger=trigger;
      _tf.trigger_time=trigger_time;
      _tf.core_owned=core_owned;
      _tf.chase_atr=dist_close_atr;
      QSMC_Root().TacticalObserve(_tf);
   }
   // v6.4.1: the tactical entry is now an arrow + a graded label, not only an
   // HLINE plus a text label that the collision resolver could hide outright.
   if(InpShowMTFExecutionEntry)
   {
      string exect=TimeToString(et,TIME_MINUTES);
      string line=PFX+"MTF_ENTRY";
      if(ObjectFind(0,line)<0) ObjectCreate(0,line,OBJ_HLINE,0,0,ep);
      ObjectSetDouble(0,line,OBJPROP_PRICE,ep);
      ObjectSetInteger(0,line,OBJPROP_COLOR,closed_confirm?(bull?clrLime:clrTomato):clrAqua);
      ObjectSetInteger(0,line,OBJPROP_STYLE,closed_confirm?STYLE_SOLID:STYLE_DASH);
      ObjectSetInteger(0,line,OBJPROP_WIDTH,2); ObjectSetInteger(0,line,OBJPROP_SELECTABLE,false);
      string chase=(g_mtf_entry_late ? StringFormat(" | LATE (%.1f ATR from close) - wait for retest",dist_close_atr) : "");
      // v6.6.0 (R7): "CONFIRMED" is reserved for a signal that passed
      // every gate. The closed execution bar is an execution fact, not
      // a trade signal, so the label says TACTICAL-INFO.
      if(InpArbEnabled && InpArbGateTactical) chase+=" | gated by ARB";
      // v6.6.10 AUDIT-TAC2: a CONTEXT verdict says so on the label itself, not
      // only in a panel row - the label is what a trader reads first.
      if(auth==TAC_AUTH_CONTEXT) chase+=" | CONTEXT: "+auth_reason;
      if(g_mtf_sig_time>0 && g_mtf_sig_time!=et)
         chase+=" | @"+TimeToString(g_mtf_sig_time,TIME_MINUTES)+" (exec bar "+exect+")";
      // v6.6.10 AUDIT-TAC2: the word ENTRY is printed only when an authoritative
      // module still owns a live scenario on this side. "TACTICAL / PREVIEW MTF
      // BUY ENTRY PREVIEW" can therefore no longer appear over a side the
      // Directional Scenario Engine has retired or never had a plan for.
      string verb=(auth==TAC_AUTH_CONTEXT?"CONTEXT":"ENTRY");
      DrawTextLabel(PFX+"MTF_ENTRY_TX",g_mtf_sig_time,ep,
                    StringFormat("%s MTF %s %s %s @ %.2f | exec %s | grade %s%s",
                                 (closed_confirm?"TACTICAL-INFO (exec bar closed)":"TACTICAL / PREVIEW"),
                                 bull?"BUY":"SELL",verb,state,ep,TFName(etf),
                                 MTFEntryGrade(closed_confirm,core_owned),chase),
                    (g_mtf_entry_late?clrOrange:(closed_confirm?(bull?clrLime:clrTomato):clrAqua)),!bull,9);
      // v6.6.10: a CONTEXT verdict keeps its level line but never paints an entry
      // mark or arrow - the mark is the thing a trader reads as "here".
      if(auth!=TAC_AUTH_CONTEXT && (!far || closed_confirm))
      {
         EntryMarkTactical(bull,closed_confirm,ep);
         if(ArraySize(g_buf_t)>0)
            EntryMarkObjectsFor(g_buf_t[ArraySize(g_buf_t)-1],2,bull,closed_confirm);   // tactical buffer slot stays on the last bar
      }
   }
   else ClearMTFExecutionEntry();
   // v6.6.0: this block USED to call FireQuantAlert() directly. That was
   // the source of the reported alert storm: no zone, no reaction, no
   // room, no session and no data-quality check, plus a dedupe key that
   // alternated between two spellings whenever the signal re-armed.
   // The fact is now recorded above (TacticalObserve) and published once
   // per closed bar by the arbitration layer, which applies every gate.
   // The old globals are still maintained so the display is unchanged.
}

void DrawProvisionalFractals(const int total,const datetime &t[],const double &h[],const double &l[]);
void UpdateEarlyBreakPreview(const int total,const datetime &t[],const double &h[],const double &l[],const double &c[]);
//------------------------------------------------------------------ AUDIT-RS1
// ONE verdict for every surface. Four closed-bar layers vote; each vote is
// weighted by an input; the four weights must sum to exactly 100 (validated
// in OnInit, never renormalised). A side is CONFIRMED only here, and only
// when it is the ONLY side with votes and its weighted score reaches
// InpResMinScore. If both sides vote the verdict is CONFLICT-WAIT:
// disagreeing layers are evidence to stand aside, not a coin flip.
// Reads only globals published by closed-bar work earlier in OnCalculate:
// g_htf_bias (Bias), PA_ZoneAt (zone role), g_rxn_best_* (Reaction) and
// g_tac_dir/g_tac_closed (Tactical). Writes g_final_* and nothing else.
int ResolveFinalSignal(const int closed,string &why)
  {
   why="";
   if(closed<0 || closed>=ArraySize(g_buf_c)) return 0;
   double atr=(closed<ArraySize(g_atr_buf) && g_atr_buf[closed]>0.0)
              ?g_atr_buf[closed]:g_atr;
   int vote[4]; int w[4]; string nm[4];
   vote[0]=(InpUseHTFBias && g_htf_bias!=0)?(g_htf_bias>0?1:-1):0;
   w[0]=InpResWeightBias; nm[0]="bias";
   string zn=""; double zt=0.0,zb=0.0; int zd=0;
   vote[1]=PA_ZoneAt(g_buf_c[closed],closed,atr,zn,zt,zb,zd)
           ?(zd>0?1:(zd<0?-1:0)):0;
   w[1]=InpResWeightZone; nm[1]="zone";
   vote[2]=g_rxn_best_buy.valid?1:(g_rxn_best_sell.valid?-1:0);
   w[2]=InpResWeightReaction; nm[2]="reaction";
   vote[3]=g_tac_dir;
   w[3]=InpResWeightTactical; nm[3]="tactical";
   int buy=0,sell=0; string vb="",vs="";
   for(int k=0;k<4;k++)
     {
      if(vote[k]>0){ buy+=w[k];  if(vb!="") vb+="+"; vb+=nm[k]; }
      if(vote[k]<0){ sell+=w[k]; if(vs!="") vs+="+"; vs+=nm[k]; }
     }
   g_res_score=buy>0?buy:sell;
   if(buy>0 && sell>0)
     {
      why="CONFLICT: BUY "+vb+" ("+IntegerToString(buy)+") vs SELL "+vs+" ("+
          IntegerToString(sell)+") - disagreeing layers mean stand aside";
      return 2;
     }
   if(buy==0 && sell==0){ why="no layer voted - WAIT"; g_res_score=0; return 0; }
   int side=buy>0?1:-1; string voters=buy>0?vb:vs;
   if(g_res_score<InpResMinScore)
     {
      why=(side>0?"BUY":"SELL")+" evidence "+IntegerToString(g_res_score)+
          "/100 from "+voters+" is below InpResMinScore "+
          IntegerToString(InpResMinScore)+" - WAIT";
      return 0;
     }
   why=(side>0?"BUY":"SELL")+" CONFIRMED "+IntegerToString(g_res_score)+
       "/100 from "+voters+" - a weighted confluence count, not a probability";
   return side;
  }
//--------------------------------------------------------------------
// AUDIT-SC1: SCALPING STRATEGIES (M1-M5), display only, advisory.
//
// What already existed and is REUSED rather than duplicated:
//   * QSMC_PRESET_SCALPER in QSMC_Preset.mqh (auto-selected on M1-M5) and
//     QSMC_PresetInt/QSMC_PresetDouble, whose M1/M5 columns already carry the
//     scalper profile. The defaults below are that profile's numbers:
//     displacement 0.40 ATR, stop 0.80 ATR, target 1.20 ATR, RR floor 1.20.
//   * the published state of all six strategy modules (P3, Silver Bullet,
//     Wyckoff, Price Action / zones, Mean Reversion, Confluence) plus RXN's
//     best snapshots and the HTF bias. A scalping leg that re-derived any of
//     that would be a second opinion, which is the defect AUDIT-RS1 removed.
//   * MTF_SniperIsNewsBlackout() and IsInSession() for the vetoes, and
//     PA_ZoneAt() for the zone leg - one zone scan, as everywhere else.
//
// Ordering rule inherited from AUDIT-GS1: the vetoes that must never be traded
// away are tested FIRST - no data, spread cost, session, news - and each one
// returns immediately with its own reason. Only after them is evidence weighed.
//
// The score is a weighted confluence count, NOT a probability. The stop and
// target are advisory distances in ATR units; nothing here sends an order,
// touches the forming bar, or edits a verdict another layer owns.
//--------------------------------------------------------------------

// PURE. Spread cost as a fraction of ATR. A scalp whose cost is a large slice
// of the move it is trying to capture cannot work on any symbol, so this is a
// veto and not a weighted leg. No data => veto (never publish on a guess).
double SCALP_SpreadRatio(const double spread_pts,const double atr)
  {
   if(!(atr>0.0)) return DBL_MAX;
   if(!(spread_pts>=0.0)) return DBL_MAX;
   return (spread_pts*_Point)/atr;
  }

bool SCALP_SpreadVeto(const double spread_pts,const double atr,const double max_ratio_atr)
  {
   if(!(max_ratio_atr>0.0)) return true;
   return SCALP_SpreadRatio(spread_pts,atr)>max_ratio_atr;
  }

// PURE. Advisory reward:risk from two ATR multiples. A non-positive stop has no
// RR at all, so it reports 0 and the caller refuses.
double SCALP_RR(const double stop_atr,const double target_atr)
  {
   if(!(stop_atr>0.0) || !(target_atr>0.0)) return 0.0;
   return target_atr/stop_atr;
  }

// PURE. The six shipped weights, summed. OnInit refuses anything but 100.
int SCALP_WeightsSum()
  {
   return InpScalpWeightMomentum+InpScalpWeightEdge+InpScalpWeightSilverBullet+
          InpScalpWeightPowerOf3+InpScalpWeightWyckoff+InpScalpWeightConfluence;
  }

// PURE. Weighted points one side earned, and the legs that voted for it.
int SCALP_ScoreSide(const int side,const int &vote[],const int &w[],const string &nm[],
                    string &have)
  {
   int got=0; have="";
   for(int k=0;k<6;k++)
     {
      if(vote[k]==side && side!=0)
        {
         got+=w[k];
         if(have!="") have+="+";
         have+=nm[k];
        }
     }
   return got;
  }

// PURE. The same verdict rule the resolver uses, so a scalp can never disagree
// with the engine about what a disagreement means: both sides voting is
// CONFLICT (2), nothing voting is WAIT (0), and a lone side below the minimum
// is also WAIT - it is never promoted to look useful.
int SCALP_Decide(const int buy,const int sell,const int min_score)
  {
   if(buy>0 && sell>0) return 2;
   if(buy==0 && sell==0) return 0;
   int got=buy>0?buy:sell;
   if(got<min_score) return 0;
   return buy>0?1:-1;
  }

// The six votes, read from state the modules already published for this closed
// bar. vote[k] is +1 long, -1 short, 0 abstain - an abstain costs nothing and
// invents nothing.
void SCALP_Votes(const int closed,const double atr,int &vote[],const int &w_unused[],
                 string &nm[])
  {
   ArrayResize(vote,6); ArrayResize(nm,6);
   nm[0]="MOM"; nm[1]="EDGE"; nm[2]="SB"; nm[3]="P3"; nm[4]="WY"; nm[5]="CF";
   for(int k=0;k<6;k++) vote[k]=0;
   // SC-MOM: one closed bar that displaced price by the scalper profile's
   // 0.40 ATR. Read from the mirrored close buffer, never from the forming bar.
   if(closed>=1 && closed<ArraySize(g_buf_c) && atr>0.0)
     {
      double disp=g_buf_c[closed]-g_buf_c[closed-1];
      if(MathAbs(disp)>=InpScalpDispATR*atr) vote[0]=(disp>0?1:-1);
     }
   // SC-EDGE: mean reversion stretched into a causal zone whose role opposes the
   // stretch. Both facts come from the modules that already computed them.
   if(g_mr_ext_dir!=0)
     {
      string zn=""; double zt=0.0,zb=0.0; int zd=0;
      if(closed>=0 && closed<ArraySize(g_buf_c) &&
         PA_ZoneAt(g_buf_c[closed],closed,atr,zn,zt,zb,zd) && zd==-g_mr_ext_dir)
         vote[1]=-g_mr_ext_dir;
     }
   // SC-SB / SC-P3 / SC-WY: a resolved window, Judas verdict or spring/upthrust.
   vote[2]=(g_sb_active?g_sb_dir:0);
   vote[3]=g_p3_dir;
   vote[4]=(g_wy_active?g_wy_dir:0);
   // SC-CF: the Confluence Engine's own stronger side, at its OWN display
   // threshold - no second confluence rule and no new number to drift.
   if(g_cf_buy_score>=InpCFMinDisplayScore && g_cf_buy_score>g_cf_sell_score) vote[5]=1;
   else if(g_cf_sell_score>=InpCFMinDisplayScore && g_cf_sell_score>g_cf_buy_score) vote[5]=-1;
  }

// Module entry. Closed bar only; writes g_sc_* and nothing else.
void SCALP_Update(const int closed,const int rates_total)
  {
   g_sc_dir=0; g_sc_score=0; g_sc_legs=""; g_sc_why=""; g_sc_veto=false;
   g_sc_stop=0.0; g_sc_target=0.0; g_sc_rr=0.0; g_sc_bar=-1;
   // Never the forming bar, never a bar the mirror does not hold.
   if(closed<1 || closed>rates_total-2 || closed>=ArraySize(g_buf_c)) return;
   double atr=(closed<ArraySize(g_atr_buf) && g_atr_buf[closed]>0.0)
              ?g_atr_buf[closed]:g_atr;
   // ---- hard vetoes: tested first, reported first, never weighted away ----
   if(!(atr>0.0))
     {
      g_sc_veto=true;
      g_sc_why="HARD VETO: no ATR for this closed bar - a scalp has no cost model - WAIT";
      return;
     }
   if(SCALP_SpreadVeto((double)g_spread,atr,InpScalpMaxSpreadATR))
     {
      g_sc_veto=true;
      g_sc_why="HARD VETO: spread "+IntegerToString((int)g_spread)+" pts is "+
               DoubleToString(SCALP_SpreadRatio((double)g_spread,atr),3)+
               " ATR, above the "+DoubleToString(InpScalpMaxSpreadATR,3)+
               " ATR cap - the move would pay the broker - WAIT";
      return;
     }
   if(InpScalpRequireSession &&
      !IsInSession(g_buf_t[closed],SESSION_LONDON) &&
      !IsInSession(g_buf_t[closed],SESSION_NEWYORK))
     {
      g_sc_veto=true;
      g_sc_why="HARD VETO: outside the London/New York kill zones - WAIT";
      return;
     }
   if(MTF_SniperIsNewsBlackout(g_buf_t[closed]))
     {
      g_sc_veto=true;
      g_sc_why="HARD VETO: high-impact news blackout (Golden Rule 6) - WAIT";
      return;
     }
   // ---- weighted evidence ----
   int vote[]; string nm[]; int wdummy[];
   SCALP_Votes(closed,atr,vote,wdummy,nm);
   int w[6];
   w[0]=InpScalpWeightMomentum;   w[1]=InpScalpWeightEdge;
   w[2]=InpScalpWeightSilverBullet; w[3]=InpScalpWeightPowerOf3;
   w[4]=InpScalpWeightWyckoff;    w[5]=InpScalpWeightConfluence;
   string hb="",hs="";
   int buy=SCALP_ScoreSide(1,vote,w,nm,hb);
   int sell=SCALP_ScoreSide(-1,vote,w,nm,hs);
   g_sc_dir=SCALP_Decide(buy,sell,InpScalpMinScore);
   g_sc_score=(buy>0?buy:sell);
   g_sc_legs=(buy>=sell?hb:hs);
   if(g_sc_dir==2)
     {
      g_sc_score=0; g_sc_legs="";
      g_sc_why="CONFLICT: long "+hb+" ("+IntegerToString(buy)+") vs short "+hs+" ("+
               IntegerToString(sell)+") - disagreeing scalps mean stand aside";
      return;
     }
   if(g_sc_dir==0)
     {
      string miss="";
      for(int k=0;k<6;k++) if(vote[k]==0){ if(miss!="") miss+=" "; miss+=nm[k]; }
      g_sc_score=(buy>0||sell>0?g_sc_score:0);
      g_sc_why=(buy>0||sell>0?
                ((buy>0?"BUY":"SELL")+" evidence "+IntegerToString(g_sc_score)+"/100 from "+
                 (buy>0?hb:hs)+" below InpScalpMinScore "+IntegerToString(InpScalpMinScore)):
                "no scalping strategy voted")+
               " - abstained: "+(miss==""?"none":miss)+" - WAIT";
      return;
     }
   // Advisory geometry, in ATR units, then the RR floor. A scalp that does not
   // clear the floor is refused rather than published with a bad shape.
   g_sc_rr=SCALP_RR(InpScalpStopATR,InpScalpTargetATR);
   if(g_sc_rr<InpScalpMinRR)
     {
      g_sc_dir=0; g_sc_score=0; g_sc_legs="";
      g_sc_why="REFUSED: advisory RR "+DoubleToString(g_sc_rr,2)+" is below the "+
               DoubleToString(InpScalpMinRR,2)+" floor - WAIT";
      g_sc_rr=0.0;
      return;
     }
   double px=g_buf_c[closed];
   double stop_dist=InpScalpStopATR*atr, tgt_dist=InpScalpTargetATR*atr;
   g_sc_stop=(g_sc_dir>0?px-stop_dist:px+stop_dist);
   g_sc_target=(g_sc_dir>0?px+tgt_dist:px-tgt_dist);
   g_sc_bar=closed;
   g_sc_why="SCALP "+(g_sc_dir>0?"BUY":"SELL")+" "+IntegerToString(g_sc_score)+
            "/100 from "+g_sc_legs+" | stop "+DoubleToString(InpScalpStopATR,2)+
            " ATR @ "+DoubleToString(g_sc_stop,_Digits)+" | target "+
            DoubleToString(InpScalpTargetATR,2)+" ATR @ "+
            DoubleToString(g_sc_target,_Digits)+" | RR "+DoubleToString(g_sc_rr,2)+
            " - a weighted confluence count, not a probability";
  }

// AUDIT-SC1 self-test. Exercises the PURE cores with local values only - no
// chart, no series, no terminal state - so a regression is caught at OnInit
// instead of on a live bar. Gated by InpMTEERunSelfTest, the file's existing
// general self-test switch, exactly like the six modules before it.
bool SCALP_SelfTest(string &where)
  {
   where="";
   // SC-1 No ATR means no cost model, so the spread veto must fire rather than
   //      publish a scalp on a guess.
   if(!SCALP_SpreadVeto(0.0,0.0,0.10))
   { where="SC-1 no ATR must veto, never divide by zero"; return false; }
   // SC-2 A zero spread with real ATR is not a veto.
   if(SCALP_SpreadVeto(0.0,1000.0*_Point,0.10))
   { where="SC-2 a zero spread must not veto"; return false; }
   // SC-3 A spread that is 20% of ATR is above a 10% cap: vetoed.
   if(!SCALP_SpreadVeto(200.0,1000.0*_Point,0.10))
   { where="SC-3 a spread of 0.20 ATR must veto against a 0.10 ATR cap"; return false; }
   // SC-4 The cap itself is not a veto (strictly greater), so the boundary is
   //      documented rather than accidental.
   if(SCALP_SpreadVeto(100.0,1000.0*_Point,0.10))
   { where="SC-4 a spread exactly at the cap must not veto"; return false; }
   // SC-5 RR is target/stop, and a non-positive stop has no RR.
   if(MathAbs(SCALP_RR(0.80,1.20)-1.50)>1.0e-9 || SCALP_RR(0.0,1.20)!=0.0)
   { where="SC-5 RR must be target/stop, and 0 without a stop"; return false; }
   // SC-6 The shipped weights sum to exactly 100, or OnInit refuses.
   if(SCALP_WeightsSum()!=100)
   { where="SC-6 the six scalping weights must sum to 100"; return false; }
   int vote[6]; int w[6]; string nm[6];
   for(int k=0;k<6;k++){ vote[k]=0; w[k]=10; nm[k]="L"+IntegerToString(k); }
   string have="";
   // SC-7 Only votes equal to the side are counted.
   vote[0]=1; vote[3]=1; vote[5]=-1;
   if(SCALP_ScoreSide(1,vote,w,nm,have)!=20 || have!="L0+L3")
   { where="SC-7 a side counts only its own votes and names them"; return false; }
   // SC-8 The short side of the same votes is the mirror.
   if(SCALP_ScoreSide(-1,vote,w,nm,have)!=10 || have!="L5")
   { where="SC-8 the opposite side counts only its own votes"; return false; }
   // SC-9 Both sides voting is CONFLICT (2), never a coin flip, and nothing
   //      voting is WAIT (0).
   if(SCALP_Decide(30,10,25)!=2 || SCALP_Decide(0,0,25)!=0)
   { where="SC-9 disagreement is CONFLICT and silence is WAIT"; return false; }
   // SC-10 A lone side below the minimum stays WAIT; at or above it, it is the
   //       side - the minimum is inclusive, like every other floor here.
   if(SCALP_Decide(20,0,25)!=0 || SCALP_Decide(25,0,25)!=1 || SCALP_Decide(0,60,25)!=-1)
   { where="SC-10 a lone side is promoted only at or above the minimum"; return false; }
   return true;
  }

//--------------------------------------------------------------------
// AUDIT-OBS1: THE DECISION JOURNAL - one row per closed bar.
//
// Phase 1 found the observability gap: the file could say why the LAST alert
// was suppressed (AlertWhyNoPopup) and could count gate outcomes in aggregate
// (SSignalGateAudit), but nothing kept a per-bar record of what each decision
// layer said and, when nothing was published, WHICH layer said no. On a live
// chart that is the difference between auditing a missed setup and guessing.
//
// This is that record. It is written once per closed bar, after every layer
// has published, and it reuses their state verbatim - the resolver verdict,
// the weighted gate's own why-text, the scalping overlay's verdict and what
// was actually published as the primary direction. It re-derives nothing, so
// it cannot become a fifth opinion: it is a transcript, not a voter.
//
// Display and audit only. It holds no price series, creates no chart object,
// authorises no entry and sends no order. The ring buffer is bounded by
// InpObsJournalBars (10..500), so memory cannot grow with history, and the
// optional log is event-driven rather than per-bar, so it cannot flood.
//--------------------------------------------------------------------

// PURE. Ring-buffer slot arithmetic, kept separate so the self-test can
// exercise it without a chart, a series or any terminal state.
int OBS_NextIndex(const int current,const int cap)
  {
   if(cap<=0) return 0;
   int n=current+1;
   if(n>=cap) n=0;
   return n;
  }

// PURE. gate_state: 0 not run, 1 published, 2 evidence below minimum, 3 hard
// veto. An unknown value is reported as not-run rather than as a blank cell.
string OBS_GateStateName(const int state)
  {
   if(state==1) return "PUBLISHED";
   if(state==2) return "BELOW-MIN";
   if(state==3) return "HARD-VETO";
   return "not-run";
  }

// PURE. Derives the gate column from facts the gate already published. A veto
// outranks a strong evidence score on purpose: the journal must never read as
// "95/100 but no trade" without also saying which veto stopped it.
int OBS_GateState(const bool ran,const bool veto,const int score,const int min_score)
  {
   if(!ran) return 0;
   if(veto) return 3;
   if(score<min_score) return 2;
   return 1;
  }

// PURE. The most specific reason for a bar, in the order an operator asks:
// was it vetoed, was the evidence too thin, did a layer stand aside because of
// a conflict, or was there simply nothing? Silence is reported as silence.
string OBS_Reason(const int gate_state,const string gate_why,const int final_signal,
                  const string final_why,const int scalp_dir,const string scalp_why)
  {
   if(gate_state==3) return gate_why;
   if(gate_state==2) return gate_why;
   if(final_signal==2) return "resolver CONFLICT - "+final_why;
   if(scalp_dir==2) return "scalp CONFLICT - "+scalp_why;
   if(final_signal!=0) return final_why;
   if(scalp_dir!=0) return scalp_why;
   if(gate_state==1) return gate_why;
   return "no layer produced a verdict this bar";
  }

// PURE. The dispatcher's own encoding, documented at the struct field itself
// ("int source; // 1=ZRE, 2=RXN, 3=CORE legacy"). An unexpected value is named
// as unset rather than quietly relabelled as one of the three: a transcript that
// invents a source is worse than no transcript at all.
string OBS_SourceName(const int source)
  {
   if(source==3) return "CORE";
   if(source==2) return "RXN";
   if(source==1) return "ZRE";
   return "unset";
  }

// One row per closed bar. Reads only state the layers already published;
// writes only the journal. Never the forming bar, never twice for one bar.
void OBS_Record(const int closed,const int rates_total)
  {
   if(closed<1 || closed>rates_total-2 || closed>=ArraySize(g_buf_t)) return;
   datetime bt=g_buf_t[closed];
   if(bt<=0 || bt==g_obs_last_bar_time) return;
   int cap=(int)MathMax(10,MathMin(500,InpObsJournalBars));
   if(ArraySize(g_obs_rows)!=cap)
     {
      ArrayResize(g_obs_rows,cap);
      g_obs_filled=0; g_obs_next=0; g_obs_last_bar_time=0;
     }
   int gs=OBS_GateState(InpUseWeightedGates,g_wgate_veto,g_wgate_score,InpWGMinScore);
   SObsJournalRow r;
   r.bar_time=bt;
   r.final_signal=(InpUseFinalResolver?g_final_signal:0);
   r.res_score=(InpUseFinalResolver?g_res_score:0);
   r.gate_state=gs;
   r.gate_score=g_wgate_score;
   r.scalp_dir=(InpEnableScalping?g_sc_dir:0);
   r.scalp_score=(InpEnableScalping?g_sc_score:0);
   r.primary_dir=(g_alert_primary.valid?g_alert_primary.direction:0);
   r.primary_src=(g_alert_primary.valid?OBS_SourceName(g_alert_primary.source):"none");
   r.why=OBS_Reason(gs,(g_wgate_why==""?"-":g_wgate_why),r.final_signal,
                    (g_final_why==""?"-":g_final_why),r.scalp_dir,
                    (g_sc_why==""?"-":g_sc_why));
   g_obs_rows[g_obs_next]=r;
   g_obs_next=OBS_NextIndex(g_obs_next,cap);
   if(g_obs_filled<cap) g_obs_filled++;
   g_obs_last_bar_time=bt;
   // Opt-in and EVENT-driven: only a bar where something actually decided is
   // printed, so this can never become the per-bar log flood the gate forbids.
   if(InpObsLogEvents && (r.final_signal!=0 || r.gate_state==1 || r.gate_state==3 ||
      r.scalp_dir!=0))
      Print("QSMC OBS ",TimeToString(bt,TIME_DATE|TIME_MINUTES),
            " published=",r.primary_dir,"(",r.primary_src,")",
            " resolver=",r.final_signal,"/",r.res_score,
            " gate=",OBS_GateStateName(r.gate_state),"/",r.gate_score,
            " scalp=",r.scalp_dir,"/",r.scalp_score," | ",r.why);
  }

// The tooltip block: newest first, capped at InpObsTooltipBars, built from the
// ring buffer only. No chart object, no series access, no per-tick allocation
// beyond the string itself.
string OBS_JournalText(const int max_rows)
  {
   if(g_obs_filled<=0) return "";
   int want=(int)MathMax(1,MathMin(max_rows,g_obs_filled));
   string out="Decision journal (last "+IntegerToString(want)+
              " closed bars, newest first):\n";
   int slot=g_obs_next-1;
   for(int k=0;k<want;k++)
     {
      if(slot<0) slot=ArraySize(g_obs_rows)-1;
      SObsJournalRow r=g_obs_rows[slot];
      out+=TimeToString(r.bar_time,TIME_MINUTES)+" | ";
      if(InpObsShowPrimary)
         out+="pub:"+(r.primary_dir>0?"BUY":(r.primary_dir<0?"SELL":"-"))+
              "("+r.primary_src+") ";
      if(InpObsShowResolver)
         out+="res:"+(r.final_signal==1?"BUY":(r.final_signal==-1?"SELL":
                       (r.final_signal==2?"CONFLICT":"WAIT")))+"/"+
              IntegerToString(r.res_score)+" ";
      if(InpObsShowGate)
         out+="gate:"+OBS_GateStateName(r.gate_state)+"/"+
              IntegerToString(r.gate_score)+" ";
      if(InpObsShowScalp)
         out+="scalp:"+(r.scalp_dir==1?"BUY":(r.scalp_dir==-1?"SELL":
                        (r.scalp_dir==2?"CONFLICT":"WAIT")))+"/"+
              IntegerToString(r.scalp_score);
      out+="\n     why: "+r.why+"\n";
      slot--;
     }
   return out;
  }

// AUDIT-OBS1 self-test: the pure cores only - no chart, no series, no terminal
// state - so a regression is caught at OnInit instead of on a live bar. Gated
// by InpMTEERunSelfTest, the file's existing general self-test switch.
bool OBS_SelfTest(string &where)
  {
   where="";
   // OBS-1 the ring wraps at the cap and never returns a slot outside it.
   if(OBS_NextIndex(0,10)!=1 || OBS_NextIndex(8,10)!=9 || OBS_NextIndex(9,10)!=0)
   { where="OBS-1 the ring must wrap to slot 0 at the cap"; return false; }
   // OBS-2 a non-positive cap cannot produce a negative or runaway slot.
   if(OBS_NextIndex(5,0)!=0 || OBS_NextIndex(5,-3)!=0)
   { where="OBS-2 a non-positive cap must yield slot 0"; return false; }
   // OBS-3 every state has a name, including an unexpected value.
   if(OBS_GateStateName(0)!="not-run" || OBS_GateStateName(1)!="PUBLISHED" ||
      OBS_GateStateName(2)!="BELOW-MIN" || OBS_GateStateName(3)!="HARD-VETO" ||
      OBS_GateStateName(99)!="not-run")
   { where="OBS-3 every gate state must have a name"; return false; }
   // OBS-4 a layer that did not run reports not-run whatever the score says.
   if(OBS_GateState(false,false,95,60)!=0)
   { where="OBS-4 an unused gate must not claim a verdict"; return false; }
   // OBS-5 a veto outranks a strong score.
   if(OBS_GateState(true,true,95,60)!=3)
   { where="OBS-5 a hard veto outranks any evidence score"; return false; }
   // OBS-6 the minimum is inclusive, like every other floor in this file.
   if(OBS_GateState(true,false,59,60)!=2 || OBS_GateState(true,false,60,60)!=1)
   { where="OBS-6 the minimum is inclusive"; return false; }
   // OBS-7 a veto's own text is the reason, ahead of anything else that bar.
   if(OBS_Reason(3,"HARD VETO: spread",1,"resolver BUY",0,"")!="HARD VETO: spread")
   { where="OBS-7 the veto text is the most specific reason"; return false; }
   // OBS-8 a resolver conflict is named as a conflict, never as a side.
   if(StringFind(OBS_Reason(0,"-",2,"both voted",0,""),"resolver CONFLICT")<0)
   { where="OBS-8 a resolver conflict must be named"; return false; }
   // OBS-9 a scalping conflict is named when the resolver stood aside.
   if(StringFind(OBS_Reason(0,"-",0,"-",2,"legs disagree"),"scalp CONFLICT")<0)
   { where="OBS-9 a scalping conflict must be named"; return false; }
   // OBS-10 silence is reported as silence, not as a blank cell.
   if(OBS_Reason(0,"-",0,"-",0,"")!="no layer produced a verdict this bar")
   { where="OBS-10 silence must be reported as silence"; return false; }
   // OBS-11 the alert source is named by the dispatcher's own encoding, and an
   // unexpected value is reported as unset rather than relabelled as a source.
   if(OBS_SourceName(3)!="CORE" || OBS_SourceName(2)!="RXN" ||
      OBS_SourceName(1)!="ZRE" || OBS_SourceName(0)!="unset" ||
      OBS_SourceName(9)!="unset")
   { where="OBS-11 an unknown alert source must not be relabelled"; return false; }
   return true;
  }


