   bool     invalidated;
   int      age;
   int      source_index;
};

// One canonical Core path resolved from immutable setup IDs, current selected
// indices, or a fully connected causal-graph fallback. PMI reads this record;
// it never independently picks a sweep, displacement, or structure anchor.
struct SResolvedCorePath
{
   bool   valid;
   int    direction;              // +1 buy / -1 sell / 0 none
   int    sweep;
   int    displacement;
   int    structure;
   int    zone;
   string source;                 // ACTIVE_IDS / TRADE_IDS / SELECTED / GRAPH
};

