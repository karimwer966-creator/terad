//============================================================================
// SHARED CORE-PATH RESOLVER (Core -> PMI/UI, read-only)
// Precedence: immutable active/trade setup IDs, current selected Core indices,
// then a fully connected causal-graph path. Every event must be available at
// the last closed-bar decision boundary; live/forming-bar data is never used.
//============================================================================
void CorePathInit(SResolvedCorePath &path)
{
   path.valid=false;
   path.direction=0;
   path.sweep=-1;
   path.displacement=-1;
   path.structure=-1;
   path.zone=-1;
   path.source="NONE";
}

bool CorePathEventAvailable(const int event_index,const int closed)
{
   int n=ArraySize(g_causal_events);
   if(event_index<0 || event_index>=n || closed<0 ||
      closed+1>=ArraySize(g_buf_t)) return false;
   SCausalEvent ev=g_causal_events[event_index];
   datetime boundary=g_buf_t[closed+1];
   return (ev.event_bar>=0 && ev.event_bar<=closed &&
           ev.availability_bar>=0 && ev.availability_bar<=closed &&
           ev.event_time>0 && ev.event_time<=boundary &&
           ev.availability_time>0 && ev.availability_time<=boundary);
}

bool CorePathTryBuild(const int sweep,const int displacement,const int structure,
                      const int zone,const int closed,const string source,
                      SResolvedCorePath &path)
{
   CorePathInit(path);
   int n=ArraySize(g_causal_events);
   if(sweep<0 || displacement<0 || structure<0 ||
      sweep>=n || displacement>=n || structure>=n) return false;

   SCausalEvent sw=g_causal_events[sweep];
   SCausalEvent dp=g_causal_events[displacement];
   SCausalEvent st=g_causal_events[structure];
   bool structure_type=(st.type==CE_MSS || st.type==CE_CHOCH || st.type==CE_BOS);
   if(!structure_type || (InpRequireMSSAfterSweep && st.type!=CE_MSS) ||
      sw.type!=CE_LIQ_SWEEP || dp.type!=CE_DISPLACEMENT ||
      !CorePathEventAvailable(sweep,closed) ||
      !CorePathEventAvailable(displacement,closed) ||
      !CorePathEventAvailable(structure,closed)) return false;
   if(!sw.confirmed || sw.invalidated || !dp.confirmed || dp.invalidated ||
      !st.confirmed || st.invalidated) return false;
   if(sw.bullish!=dp.bullish || dp.bullish!=st.bullish) return false;
   if(!(sw.event_bar<dp.event_bar && dp.event_bar<st.event_bar &&
        sw.event_time<dp.event_time && dp.event_time<st.event_time &&
        sw.availability_time<=dp.event_time &&
        dp.availability_time<=st.event_time)) return false;
   if(!IsCausallyConnected(sweep,displacement) ||
      !IsCausallyConnected(displacement,structure)) return false;

   int valid_zone=-1;
   if(zone>=0 && zone<n)
   {
      SCausalEvent zn=g_causal_events[zone];
      bool zone_type_ok=(zn.type==CE_ORDER_BLOCK || zn.type==CE_FVG);
      if(zone_type_ok && zn.bullish==st.bullish && !zn.invalidated &&
         CorePathEventAvailable(zone,closed) &&
         IsCausallyConnected(structure,zone))
         valid_zone=zone;
   }
   path.valid=true;
   path.direction=(sw.bullish?1:-1);
   path.sweep=sweep;
   path.displacement=displacement;
   path.structure=structure;
   path.zone=valid_zone;
   path.source=source;
   return true;
}

bool CorePathTryIds(const string sweep_id,const string displacement_id,
                    const string structure_id,const string zone_id,
                    const int closed,const string source,SResolvedCorePath &path)
{
   if(sweep_id=="" || displacement_id=="" || structure_id=="") return false;
   int sw=FindCausalEventById(sweep_id);
   int dp=FindCausalEventById(displacement_id);
   int st=FindCausalEventById(structure_id);
   int zn=(zone_id=="" ? -1 : FindCausalEventById(zone_id));
   return CorePathTryBuild(sw,dp,st,zn,closed,source,path);
}

bool ResolveCoreCausalPath(const int closed,SResolvedCorePath &path)
{
   CorePathInit(path);
   if(closed<0 || closed+1>=ArraySize(g_buf_t)) return false;

   // An active setup owns the execution lane. Never substitute a newer graph
   // path for it if its immutable IDs are missing or fail validation.
   if(InpUseRetestLifecycle && g_active_setup.active)
   {
      if(CorePathTryIds(g_active_setup.sweep_event_id,
                        g_active_setup.displacement_event_id,
                        g_active_setup.structure_event_id,
                        g_active_setup.zone_event_id,closed,"ACTIVE_IDS",path))
         return true;
      CorePathInit(path);
      return false;
   }
   if(g_trade_setup.valid || g_trade_setup.confirmation_pending)
   {
      if(CorePathTryIds(g_trade_setup.sweep_event_id,
                        g_trade_setup.displacement_event_id,
                        g_trade_setup.structure_event_id,
                        g_trade_setup.zone_event_id,closed,"TRADE_IDS",path))
         return true;
      CorePathInit(path);
      return false;
   }

   // A freshly evaluated but gated candidate has IDs even though it is not a
   // valid/confirmed trade. Trust them only while they still match this pass's
   // selected structure, which prevents a terminated setup's stale IDs winning.
   if(g_selected_structure_event>=0 &&
      g_selected_structure_event<ArraySize(g_causal_events) &&
      g_trade_setup.sweep_event_id!="" &&
      g_trade_setup.displacement_event_id!="" &&
      g_trade_setup.structure_event_id==g_causal_events[g_selected_structure_event].id)
   {
      if(CorePathTryIds(g_trade_setup.sweep_event_id,
                        g_trade_setup.displacement_event_id,
                        g_trade_setup.structure_event_id,
                        g_trade_setup.zone_event_id,closed,"TRADE_IDS",path))
         return true;
   }

   // Selected indices are rebuilt with the Core graph and remapped on graph
   // compaction. They are valid only when the entire sweep->disp->structure
   // chain remains connected and available as of the decision boundary.
   if(CorePathTryBuild(g_selected_sweep_event,g_selected_displacement_event,
                       g_selected_structure_event,g_selected_zone_event,
                       closed,"SELECTED",path)) return true;

   // Last-resort deterministic fallback: newest valid Core structure whose
   // exact graph ancestors are a confirmed sweep and displacement. BOS and
   // CHoCH are intentionally accepted when MSS is not mandatory.
   int best_sweep=-1,best_disp=-1,best_struct=-1,best_zone=-1;
   datetime best_time=0;
   double best_strength=-DBL_MAX;
   string best_id="";
   int n=ArraySize(g_causal_events);
   for(int si=n-1;si>=0;si--)
   {
      SCausalEvent st=g_causal_events[si];
      if(st.type!=CE_MSS && st.type!=CE_CHOCH && st.type!=CE_BOS) continue;
      if(InpRequireMSSAfterSweep && st.type!=CE_MSS) continue;
      if(!CorePathEventAvailable(si,closed) || !st.confirmed || st.invalidated) continue;
      int dp=FindNearestCausalAncestor(si,CE_DISPLACEMENT,"");
      if(dp<0) continue;
      int sw=FindNearestCausalAncestor(dp,CE_LIQ_SWEEP,"");
      if(sw<0) continue;

      int zn_best=-1;
      double zn_strength=-DBL_MAX;
      string zn_id="";
      for(int zi=0;zi<n;zi++)
      {
         SCausalEvent zn=g_causal_events[zi];
         if((zn.type!=CE_ORDER_BLOCK && zn.type!=CE_FVG) ||
            zn.bullish!=st.bullish || zn.invalidated ||
            !CorePathEventAvailable(zi,closed) ||
            !IsCausallyConnected(si,zi)) continue;
         if(zn.strength>zn_strength+1e-9 ||
            (MathAbs(zn.strength-zn_strength)<=1e-9 &&
             (zn_id=="" || StringCompare(zn.id,zn_id)<0)))
         { zn_best=zi; zn_strength=zn.strength; zn_id=zn.id; }
      }

      SResolvedCorePath candidate;
      if(!CorePathTryBuild(sw,dp,si,zn_best,closed,"GRAPH",candidate)) continue;
      bool better=(best_struct<0 || st.availability_time>best_time ||
                   (st.availability_time==best_time && st.strength>best_strength+1e-9) ||
                   (st.availability_time==best_time &&
                    MathAbs(st.strength-best_strength)<=1e-9 &&
                    (best_id=="" || StringCompare(st.id,best_id)<0)));
      if(better)
      {
         best_sweep=sw; best_disp=dp; best_struct=si; best_zone=candidate.zone;
         best_time=st.availability_time; best_strength=st.strength; best_id=st.id;
      }
   }
   if(best_struct>=0 && CorePathTryBuild(best_sweep,best_disp,best_struct,best_zone,
                                         closed,"GRAPH",path)) return true;
   CorePathInit(path);
   return false;
}

