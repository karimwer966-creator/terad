bool     g_entry_last_late=false;     // v6.4.1 chase verdict for that signal
string g_blacklist_zone_type[]; // "BUY"/"SELL"
double g_blacklist_zone_center[];

//====================================================================
// v5.8.0 QUANTITATIVE INSTITUTIONAL ENGINE — STATE
// Everything below is DERIVED, closed-bar, deterministic state.
// It never mutates the causal architecture and never gates entry.
//====================================================================
long  g_buf_rv[];                 // real volume mirror of g_buf_tv (chronological)
int   h_ema_quant=INVALID_HANDLE; // EMA Slow on InpQuantEMATF (only when != chart TF)

// Effective (validated/clamped) configuration. Inputs are read-only in
// MQL5, so unsafe values fall back to safe defaults with a warning.
struct SQuantConfig
{
   bool   enabled;
   int    atr_baseline_bars;
   int    atr_percentile_bars;
   double atr_low_ratio;
   double atr_high_ratio;
   double atr_extreme_ratio;
   int    volume_avg_bars;
   double volume_spike_ratio;
   int    ema_slope_bars;
   double ema_slope_flat_atr;
   double late_entry_max_atr;
   double scale0_pct;
   double scale1_pct;
   double scale2_pct;
   double tp1_exit_pct;
   double tp2_exit_pct;
   double tp3_exit_pct;
   double quality_high;
   double quality_aplus;
   double risk_ref_volume;
   bool   valid;
};
SQuantConfig g_qcfg;

// Quantitative feature set (Phase 2). Closed-bar values only.
struct SQuantFeatures
{
   bool   computed;
   int    closed_bar;
   datetime decision_time;
   // volatility
   double atr;
   double atr_baseline;
   double atr_ratio;
   int    atr_percentile;      // 0..100 rank of ATR within window
   ENUM_VOL_CLASS vol_class;
   // last closed candle
   double body_atr;            // |close-open|/ATR
   double range_atr;           // (high-low)/ATR
   double wick_body_ratio;     // max wick / body (0 when body ~ 0)
   double close_location;      // 0..1
   // volume
   double volume_ratio;        // last closed volume / baseline
   bool   volume_spike;
   string volume_source;       // "TICK VOLUME" | "REAL VOLUME"
   // VWAP
   int    vwap_state;          // +1 above, -1 below, 0 at value, 2 unavailable
   double vwap_dist_atr;
   double vwap_value;
   // EMA slow
   int    ema_state;           // +1 price above, -1 below, 0 at EMA, 2 unavailable
   int    ema_slope_state;     // +1 rising, -1 falling, 0 flat, 2 unavailable
   double ema_slope_atr;       // per-bar slope normalized by ATR
   double ema_dist_atr;
   double ema_mtf_value;       // closed-HTF EMA mapped to this decision bar
   int    ema_mtf_state;       // +1/-1/0/2 (2 = unavailable)
   bool   ema_mtf_used;        // true when an HTF (> chart) TF is mapped
   string ema_mtf_label;       // e.g. "H1" or "CHART"
   // context alignment (VWAP + EMA + slope)
   string context_alignment;   // STRONG_BULLISH_CONTEXT / BULLISH_CONTEXT / ...
   // causal quality classifications (from the selected/active causal chain)
   ENUM_DISP_QUALITY  displacement_quality;
   ENUM_SWEEP_QUALITY sweep_quality;
   double sweep_depth_atr;     // penetration depth of the selected sweep
   double break_dist_atr;      // close beyond broken structure, ATR-normalized
   double zone_size_atr;       // selected zone height / ATR
   int    zone_age_bars;       // bars since zone origin
   int    zone_mitigations;    // touches recorded on the zone
   string retest_quality;      // CONFIRMED / PREVIEW / WAITING / NONE
   // premium / discount
   string pd_position;         // DISCOUNT / EQUILIBRIUM / PREMIUM / UNKNOWN
   // session
   string session_label;       // ASIA / LONDON / NEW YORK / OVERLAP / OFF
   bool   in_kill_zone;
   // HTF alignment
   bool   htf_aligned;         // chart direction agrees with HTF bias
   // geometry
   double tp1_dist_atr;
   double opposing_liq_dist_atr;
   // spread
   long   spread_points;
   double spread_atr;
   string spread_class;        // NORMAL / ELEVATED / HIGH / UNAVAILABLE
   // regime
   string regime;              // deterministic classifier label
   string regime_detail;
};
SQuantFeatures g_quant;

// Entry quality overlay (Phases 20-23). HARD-GATE MIRROR + soft scores.
struct SQuantQuality
{
   // hard gates (mirrored read-only from the authoritative architecture)
   bool   gate_causal_chain;
   bool   gate_structure_event;
   bool   gate_causal_zone;
   bool   gate_retest_lifecycle;
   bool   gate_close_confirmed;
   bool   gate_not_invalidated;
   bool   gate_target_geometry;
   bool   gate_executable_context;   // spread/blacklist/location mirror
   int    gates_passed;
   // soft scores (transparent, documented weights)
   double structural;   // 0..100
   double context;      // 0..10
   double execution;    // 0..10
   double geometry;     // 0..10
   double sniper_pillar;// 0..100 (8th scoring pillar: MTF_SniperZone_Engine)
   double eight_pillar_score; // 0..100 (75% scaled 7-pillar score + 25% Sniper pillar)
   double final_blend;  // 0..100
   string quality_class;// NO_SETUP/WATCH/LOW_QUALITY/MEDIUM_QUALITY/HIGH_QUALITY/A_PLUS_SETUP
   string entry_state;  // Phase 38 vocabulary
   bool   late_entry_risk;
   string primary_label;   // PRIMARY SETUP description
   string secondary_label; // SECONDARY/WATCH description
};
SQuantQuality g_quality;

// Analytical scaling plan (Phases 30-33). NO orders, ever.
struct SScalePlan
{
   bool   active;
   string setup_id;
   double scale0_pct;
   double scale1_pct;
   double scale2_pct;
   bool   scale1_ready;
   string scale1_reason;
   double scale1_level;
   bool   scale2_ready;
   string scale2_reason;
   double scale2_level;
   double tp_exit_pct[3];
   double remaining_after_tp1;
   double remaining_after_tp2;
   double remaining_after_tp3;
   ENUM_BE_STATE be_state;
   string be_reason;
   bool   risk_money_valid;
   double risk_money_ref;     // theoretical risk of reference volume at scale 0
   double risk_money_aggregate; // theoretical aggregate across scales
   string risk_note;
};
SScalePlan g_scale;

// Phase 2: Internal Market Data Layer
struct BarData
{
   datetime timestamp;
   double   open;
   double   high;
   double   low;
   double   close;
   long     tick_volume;
   long     real_volume;
   long     spread;
   double   range;
   double   body;
   double   upper_wick;
   double   lower_wick;
   double   body_ratio;
   int      direction; // +1 = bullish, -1 = bearish, 0 = neutral/doji
   double   atr;
   double   relative_range;  // range / atr
   double   relative_volume; // volume / avg_volume
};

// Phase 3: Candle Confirmation Engine (15 institutional properties)
struct SCandleIntelligence
{
   bool   valid;
   bool   is_displacement;
   bool   is_rejection;
   bool   is_engulfing;
   double body_range_ratio;
   double wick_rejection;
   double close_location;
   bool   is_expansion;
   bool   is_compression;
   int    consecutive_directional;
   bool   failed_breakout;
   bool   liquidity_rejection;
   bool   absorption_behavior;
   bool   imbalance_present;
   bool   follow_through;
   bool   volume_expansion;
   int    score;                  // 0-100
   string description;            // INSTITUTIONAL-LIKE PRICE ACTION / ORDER-FLOW CONSISTENT BEHAVIOR
   bool   confirms_buy;
   bool   confirms_sell;
};

// Phase 4: Institutional Behavior Model
struct SInstitutionalBehavior
{
   ENUM_INSTITUTIONAL_BEHAVIOR behavior;
   string label;
   string sequence_desc;
   double confidence;
};

// Phase 9, 10, 33: Setup Candidate with 10-Pillar Quality Scoring
struct SetupCandidate
{
   bool   valid;
   bool   is_buy;
   int    anchor_bar;
   int    sweep_event;
   int    disp_event;
   int    mss_event;
   int    ob_event;
   int    fvg_event;
   int    zone_event;
   string zone_source;
   double zone_top;
   double zone_bottom;
   double entry;
   double sl;
   double tp1;
   double tp2;
   double tp3;
   double rr1;
   double rr2;
   double rr3;
   
   // 10-Pillar Quality Scoring Model (Phase 10 & Phase 33)
   double score_structure;       // max 20 (MSS/BOS/CHoCH)
   double score_liquidity;       // max 20 (Liquidity + Sweep)
   double score_displacement;    // max 15 (Displacement impulse)
   double score_causality;       // max 15 (Graph + DP path)
   double score_retest;          // max 15 (Retest quality)
   double score_candle;          // max 7  (Candle confirmation)
   double score_vwap;            // max 3  (VWAP context)
   double score_ema;             // max 3  (EMA Slow context)
   double score_volatility;      // max 2  (Volatility / ATR regime)
   double total_score;           // max 100 SETUP QUALITY SCORE
   
   string quality_grade;         // "A+", "A", "B", "C", "NO_TRADE"
   ENUM_SIGNAL_STATE signal_state;
   ENUM_SETUP_RANK   rank;
   
   string reason;
   string blocker;
   string explanation[12];
   int    explanation_count;
};

// Phase 43: Historical Setup Record (Strict separation: Signal Data vs Post-Event Outcome)
struct SHistoricalSetup
{
   int      created_bar;
   datetime signal_time;       // creation decision boundary
   int      confirmation_bar;
   datetime confirmation_time; // actual later close boundary
   int      availability_bar;
   datetime availability_time; // first decision boundary at which the signal exists
   bool     is_buy;
   double   entry;
   double   sl;
   double   tp1;
   double   tp2;
   double   tp3;
   int      quality_score;
   string   market_regime;
   string   smc_evidence;
   int      vwap_state;
   int      ema_state;
   string   candle_confirmation;
   string   setup_id;
   
   // Post-event outcome data (recorded only after the fact, never affects signals)
   bool     resolved;
   bool     outcome_ambiguous;
   bool     tp1_hit;
   bool     tp2_hit;
   bool     tp3_hit;
   bool     sl_hit;
   double   realized_r;
   double   mae_r;
   double   mfe_r;
   datetime resolution_time;
};

// Immutable append-only fact record for a confirmed directional signal.
// Outcome tracking remains in SHistoricalSetup and never rewrites these fields.
struct SConfirmedSignalJournalEntry
{
   string   setup_id;
   bool     is_buy;
   int      created_bar;
   datetime created_time;
   int      confirmation_bar;
   datetime confirmation_time;
   int      availability_bar;
   datetime availability_time;
   double   zone_top;
   double   zone_bottom;
   double   entry;
   double   stop_loss;
   double   target1;
   double   target2;
   double   target3;
   string   sweep_event_id;
   string   displacement_event_id;
   string   structure_event_id;
   string   zone_event_id;
   string   candle_confirmation;
};

