//====================================================================
// v6.5.2 MTF_SniperZone_Engine — UNIFIED DATA STRUCTURES & GLOBALS
//====================================================================
struct SMTF_SniperLevel
{
   ENUM_TIMEFRAMES  tf;            // source timeframe
   double           price_high;    // zone upper boundary
   double           price_low;     // zone lower boundary
   int              type;          // 1=OB, 2=FVG, 3=Liquidity,
                                   // 4=Swing, 5=Fib, 6=VWAP
   int              direction;     // +1=Support, -1=Resistance
   int              touch_count;   // times tested and held
   int              breach_count;  // times violated
   datetime         created_time;  // first formation bar
   datetime         last_touched;  // most recent test
   double           strength;      // 0.0-1.0 composite score
   bool             is_fresh;      // true if never breached
   double           volume_at_zone;// MVP volume confirmation
};

struct SMTF_SniperCluster
{
   SMTF_SniperLevel level;               // unified Sniper level record
   double           raw_strength;        // unclamped SUM(strengths)*1.2 for ranking (Golden Rule 1)
   int              tf_mask;             // bitmask of contributing timeframes (bit 0=W1 .. bit 6=M5)
   int              tf_count;            // distinct timeframes in cluster
   int              type_mask;           // bitmask of contributing zone types (1..6)
   bool             has_ob_sweep_conf;   // OB + Liquidity Sweep confluence (Type_Weight = 1.00)
   bool             has_fvg_bos_conf;    // FVG + BOS confluence (Type_Weight = 0.85)
   bool             is_fib_786;          // true = Fib 0.786 (0.45), false = Fib 0.618 (0.35)
   int              reversal_touches;    // touches producing > 1x ATR reversal displacement
   string           tf_label;            // e.g. "W1+H4+M15"
   string           type_label;          // e.g. "OB+FVG"
   // Phase 3.4 Validation Gates
   bool             gate_native_overlap; // Gate a: overlaps native TF OB or FVG
   bool             gate_macro_aligned;  // Gate b: W1+D1+H4 macro consensus does not oppose
   bool             gate_h1_adx_ok;      // Gate c: H1 ADX(14) >= 20
   bool             gate_strength_ok;    // Gate d: strength >= 0.50
   bool             gates_all_passed;    // true iff a && b && c && d
   string           gate_fail_reason;    // first failing gate reason
   // Phase 4 Closed-Bar Entry Triggers (C1..C5)
   bool             price_at_zone;       // closed bar reached/tested the zone
   bool             swept_zone_wick;     // Golden Rule 2: wick pierced zone then closed inside
   bool             c1_candle_inside;    // C1: Engulfing or Pin Bar closing inside zone
   bool             c2_m5_micro_mss;     // C2: Micro MSS on M5 after zone touch
   bool             c3_m15_rsi_exit;     // C3: M15 RSI(14) exits <30 (BUY) or >70 (SELL)
   bool             c4_disp_15atr;       // C4: Displacement leg >= 1.5x ATR(14) after touch
   bool             c5_mvp_vol_12x;      // C5: Confirmation candle volume > 1.2x average
   int              conds_met;           // count of C1..C5 met (0..5)
   bool             session_ok;          // Golden Rule 5: London/NY or Asia with strength >= 0.90
   bool             news_ok;             // Golden Rule 6: outside +-30m high-impact news window
   string           entry_grade;         // "IDEAL", "ACCEPTABLE", "WATCH", or "BLOCKED"
   bool             entry_triggered;     // true if IDEAL or ACCEPTABLE and session_ok && news_ok
   // Phase 5 Trade Management (Analytical / Advisory — No OrderSend)
   double           entry_price;         // closed confirmation price
   double           sl_price;            // farther of zone+-0.3*ATR(chart) or opposing swing
   double           sl_dist_h1_atr;      // |entry - sl| / ATR(H1)
   bool             sl_hard_max_ok;      // true if <= 2.0 * ATR(14) on H1 (else SKIP trade)
   double           tp1_price;           // next opposing Sniper Zone or 1:1 R:R (close 50%)
   double           tp2_price;           // next HTF Sniper Zone or 2:1 R:R (close 30%)
   double           tp3_price;           // D1/W1 major liquidity or 3:1 R:R (close 20%)
   double           be_trigger_price;    // TP1 or entry +- 2*ATR displacement
   bool             be_active;           // true when BE condition reached on closed bars
   double           trail_sl_price;      // M15 swing +- 0.5*ATR trailing stop after TP2
   bool             trail_active;        // true when TP2 reached and trailing is active
   double           rec_lot_size;        // Golden Rule 7: 1-2% equity risk advisory lot size
   double           dist_atr;            // distance from current closed price in chart ATR units
};

