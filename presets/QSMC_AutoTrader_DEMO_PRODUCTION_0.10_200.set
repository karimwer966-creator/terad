; =====================================================================
; QSMC v6.6.20 - DEMO PRODUCTION preset (EA: QSMC_AutoTrader)
; هدف: جاهز للعمل على أي حساب ديمو - لوت ثابت 0.10 وخسارة يومية 200
;
; NUMBERS THIS PRESET ASKS FOR
;   volume          0.10 lots fixed, every trade (InpLotMode=FIXED)
;   daily stop      200 in the ACCOUNT CURRENCY (InpMaxDailyLossMoney=200)
;                   -> it WINS over the percent stop, and is still capped
;                   by HARD 10.00% of the day baseline, so it can never be
;                   looser than the guard. The attach banner prints the
;                   exact equity it will trip at.
;   entries         3 per server day | 1 open position | session 10:00-18:00
;
; ARMED, BUT STILL SAFE
;   InpEnableTrading=true + InpDryRun=false  -> this preset DOES trade
;   InpDemoOnly=true  -> a REAL account is still refused, whatever the login
;   InpRealAccountConfirm=""  -> and even with InpDemoOnly=false, live money
;                               needs the account number typed here
;
; READ BEFORE YOU ATTACH
;   1. 0.10 lots on XAUUSD is roughly 10 USD per 1.00 of price movement.
;      With the indicator's usual 2-5 USD stop that is 20-50 USD of risk on
;      ONE trade, i.e. 10-25% of a 200 daily budget. If your account is small,
;      the fixed-lot guard refuses the trade instead of taking it.
;   2. InpFixedLotsMaxRiskPercent=6.00 is the guard: a fixed volume whose stop
;      would cost more than 6% of equity is REFUSED (logged
;      "FIXED_LOT_TOO_BIG"), never sent. 0 would disable it - do not.
;   3. 200 must be in the account currency. The attach banner prints the
;      currency the broker reports; if it is not the currency you meant,
;      stop and change InpMaxDailyLossMoney.
;   4. This preset also clears persisted breaker state on load
;      (InpResetBreakersAtInit=true) so a stale day_base from an earlier
;      session cannot block the first run. Set it back to false afterwards.
;
; Pair with the indicator preset presets/nadir2_PRACTICAL_XAUUSD.set, and read
; docs/REPORT_AR_2026-11-06_CAUSAL_CHAIN.md for the signal-side fixes.
; =====================================================================
InpEnableTrading=true
InpDryRun=false
InpDemoOnly=true
InpRealAccountConfirm=
InpResetBreakersAtInit=true
InpPinTimeframeMinutes=15
InpMagic=20261027
InpIndicatorName=nadir2
InpTradeComment=QSMC-DEMO-0.10
InpLotMode=QSMC_LOT_FIXED
InpFixedLots=0.10
InpFixedLotsMaxRiskPercent=6.00
InpRiskPercent=0.10
InpMaxRiskPercent=0.10
InpTPLevel=QSMC_TP_LEVEL2
InpBreakEvenAtR=1.00
InpPartialCloseAtR=0.00
InpPartialClosePercent=50.0
InpUseTPPips=false
InpPipPoints=0
InpTP1Pips=100
InpTP2Pips=200
InpTP3Pips=300
InpTP1ClosePercent=40.0
InpTP2ClosePercent=40.0
InpMoveSLToBEAtTP1=false
InpMoveSLToTP1AtTP2=false
InpMaxDailyLossPercent=2.00
InpMaxDailyLossMoney=200.00
InpMaxAccountDrawdownPct=6.00
InpStopAfterConsecLoss=2
InpMaxOpenPositions=1
InpMaxTradesPerDay=3
InpMaxSpreadPoints=60
InpMaxSpreadFracOfStop=0.10
InpDeviationPoints=30
InpMaxDataAgeSeconds=30
InpMinRRAtFill=1.20
InpMinStopPoints=20
InpMaxStopPoints=5000
InpOrderRetryMax=3
InpMaxSignalAgeBars=2
InpCloseOnOpposite=false
InpSessionStartHour=10
InpSessionEndHour=18
InpCooldownAfterLossMin=60
InpPollSeconds=2
InpVerbose=false
InpHeartbeatSeconds=300
InpHeartbeatLookback=200
