; QuantumAutonomousTradingSystem only - XAUUSD
; Demo armed. REAL requires manual opt-in and exact account/server confirmation.
; Compile and test in Strategy Tester and demo before considering live trading.
; Keep stop, margin, broker and risk checks enabled.
; v1.20: InpStrategyProfile 0=CONSERVATIVE 1=BALANCED 2=ACTIVE (core confirmation; a sweep alone never trades).
InpSignalExecutionProfile=2
InpEnableTrading=true
InpDryRun=false
InpDemoOnly=true
InpAllowRealTrading=false
InpRealAccountConfirm=
InpRealServerConfirm=
InpMagic=26011091
InpTradeComment=QATS
InpDeviationPoints=30
InpResetBreakersAtInit=false
InpRiskPercent=0.10
InpMaxRiskPercent=0.10
InpRewardRisk=2.0
InpMinRR=1.5
InpMaxOpenPositions=1
InpMaxTradesPerDay=3
InpMaxDailyLossPercent=0.50
InpMaxDailyLossMoney=0.0
InpMaxAccountDrawdownPct=3.00
InpStopAfterConsecLoss=2
InpCooldownAfterLossMin=60
InpNeutralCloseR=0.0
InpMaxMarginUse=0.90
InpMaxSpreadPoints=50
InpMaxSpreadFracOfStop=0.20
InpMinStopPoints=20
InpMaxStopPoints=5000
InpSessionStartHour=0
InpSessionEndHour=0
InpMaxDataAgeSeconds=60
InpRequireZoneTouch=false
InpStrategyProfile=1
InpSetupWindowBars=6
InpConflictMargin=10
InpSwingLookback=120
InpSwingK=2
InpDisplaceATR=0.8
InpDisplaceBodyRatio=0.65
; v1.23: allow displacement to confirm on M15 when H1 shows none (ATR(M15)). H1 is checked first.
InpDisplaceM15=true
InpLiquidityToleranceATR=0.10
InpMinScore=55
InpUseEMAAlignmentVeto=true
InpAllowCounterBias=false
InpATRPeriod=14
InpBreakEvenAtR=1.0
InpPartialCloseAtR=1.5
InpPartialClosePercent=50.0
InpCloseOnOpposite=true
InpUseLimitEntry=true
InpLimitMaxDistATR=3.0
InpLimitExpiryMin=180
InpLimitEntryMode=0
InpLimitSLBufferATR=0.30
InpLimitMinRR=2.0
InpLimitNeedPD=true
InpPDEnforceMarket=true
InpPdShortLookback=48
InpPdSwingMaxAge=60
InpPdSwingMinATR=0.5
InpPdStaleBufferATR=0.5
InpPdHysteresisATR=0.25
; v1.23 phase 7: regime = report-only journal/SCORED field, never a gate; news filter opt-in (default off), fail-open on unreachable calendars; session hours are broker server-time, DST follows the broker clock.
InpRegimeEnable=true
InpRegimeAtrWindow=100
InpRegimeHighVolMult=1.5
InpRegimeLowVolMult=0.5
InpBrokerUtcOffsetMinutes=0
InpNewsFilterEnable=false
InpNewsBlockBeforeMin=30
InpNewsBlockAfterMin=30
InpNewsCurrencies=USD,XAU
InpNewsMinImportance=3
InpHeartbeatSeconds=300
InpVerbose=true
