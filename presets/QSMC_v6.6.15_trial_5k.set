; QSMC v6.6.15 — Conservative first-trial preset for a $5,000 account.
; Load this in QSMC_AutoTrader (Inputs tab -> Load).
; DRY RUN stays ON until the operator has reviewed the backtest + demo logs.

; ---- core ------------------------------------------------------------------
InpDryRun=true
InpMagic=20261027
InpIndicatorName=nadir2

; ---- risk (per trade 0.10% ≈ $5 stop-loss on $5k) --------------------------
InpLotMode=QSMC_LOT_RISK_PERCENT
InpRiskPercent=0.10
InpMaxRiskPercent=0.10
InpFixedLots=0.00

; ---- trial circuit breakers ------------------------------------------------
InpMaxDailyLossPercent=0.50       ; ≈ $25/day halt
InpMaxAccountDrawdownPct=3.00     ; ≈ $150 total halt, restart required
InpStopAfterConsecLoss=2          ; halt after 2 losing closes
InpMaxOpenPositions=1             ; one position at a time
InpMaxTradesPerDay=3              ; hard cap, well above the 2-loss breaker

; ---- filters ---------------------------------------------------------------
InpMaxSpreadPoints=60             ; absolute cap on XAUUSD (~0.60 USD)
InpMaxSpreadFracOfStop=0.10       ; spread must not exceed 10% of stop distance
InpMaxDataAgeSeconds=30           ; refuse on stale feed / disconnect
InpSniperNewsFilter=true          ; high-impact USD news blackout (nadir2 side)
InpUseWeightedGates=true          ; evidence-weighted gate scoring
InpMinRRAtFill=1.20               ; refuse if residual RR at fill < 1.2

; ---- session: London + NY kill zones only ----------------------------------
; Server time assumed EET (Frankfurt-based broker, winter: UTC+2, summer: UTC+3).
; London KillZone 07:00-10:00 London ⇒ 09:00-12:00 EET (winter) / 10:00-13:00 EET (summer).
; New York KillZone 07:00-10:00 NY ⇒ 14:00-17:00 EET (winter) / 15:00-18:00 EET (summer).
; Combined LDN+NY window 08:00-17:00 NY local ⇒ roughly 10:00-23:00 EET but
; we use a conservative single server window 10-18 and rely on nadir2 kill-zone
; detection for the precise 30-minute high-probability windows.
InpSessionStartHour=10
InpSessionEndHour=18
InpCooldownAfterLossMin=60        ; one hour cool-down after any losing close

; ---- exits: indicator-derived zones (no pip-ladder override) ---------------
InpUseTPPips=false
InpMinRR1=1.5                     ; TP1 floor 1.5R per the playbook
InpBreakEvenAtR=1.0               ; move SL to break-even at +1R
InpPartialCloseAtR=1.5            ; bank 50% at first target
InpPartialClosePercent=50.0

; ---- execution -------------------------------------------------------------
InpDeviationPoints=30              ; XAUUSD needs a bit more slippage tolerance
InpMaxSignalAgeBars=2
InpCloseOnOpposite=false
InpPollSeconds=2
InpVerbose=true                   ; log every refused signal for the journal
InpHeartbeatSeconds=300
