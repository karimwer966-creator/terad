; QSMC v6.6.18 — Conservative first-trial preset for a $5,000 (or larger) account.
; Load this in QSMC_AutoTrader (Inputs tab -> Load) AFTER pressing F7 on
; nadir2.mq5 and QSMC_AutoTrader.mq5 of the v6.6.18 build.
;
; Verified envelope against v6.6.18 source (MQL5/Experts/QSMC_AutoTrader.mq5):
;   - InpEnableTrading=false at load time (MASTER SWITCH OFF). You must set it
;     to true yourself after the EA has attached cleanly, printed the
;     "[QSMC_AT] iCustom handshake OK (silent EA_READER)" line, and run a full
;     cycle of heartbeats.
;   - InpDryRun=true  -> orders are journaled, never sent, until you flip it.
;   - InpDemoOnly=true -> refuses any non-DEMO account.
;   - InpIndicatorName=nadir2 (no surrounding quotes — v6.6.18 handshake fix
;     works with the literal name; this prevents the 4802 fallback at attach).
;   - Risk per trade 0.10% (hard ceiling 0.25% in code still wins over this).
;   - Daily loss 0.50% (baseline = EQUITY at server-day roll, not balance).
;   - Account DD 3% HALT (manual reset via InpResetBreakersAtInit=true).
;   - Consecutive-loss breaker 2; max 1 position; max 3 entries per day.
;   - Session window 10:00-18:00 server (London/NY overlap for XAUUSD).
;   - 60-minute cooldown after any losing close.
;   - Break-even at +1.00R, partial 50% at +1.50R (one exit manager owns the
;     position; pip ladder disabled).
;   - Spread <=60 pts, slippage <=30 pts, RR@fill >=1.20, signal age <=2 bars,
;     data fresh <30 s.
;
; Operational notes for v6.6.18:
;   1. Remove nadir2 from the chart BEFORE attaching the EA — the EA spawns
;      its own silent iCustom nadir2. If you leave a manual VISUAL nadir2 on
;      the chart you'll see duplicate panels (cosmetic) but no safety issue.
;   2. After attach, look for the line:
;        [QSMC_AT] iCustom handshake OK on attempt 1 (handle=NNN, silent EA_READER)
;      If you instead see "attempt ... produced a non-EA_READER instance"
;      repeated 3 times then fall back to the 4802 path, remove the EA,
;      re-compile nadir2.ex5, and re-attach.
;   3. TopDown SELL/BUY Alerts are informational (multi-timeframe bias); the
;      EA ONLY trades CORE_CONFIRMED signals. A heartbeat reading
;      "indicator verdict: LEG_GEOMETRY" means no trade is warranted and the
;      EA is doing its job.
;   4. DO NOT turn off InpDemoOnly, InpDryRun, or set InpRealAccountConfirm
;      on this preset. Copy to STAGE2 / STAGE3 presets for the ladder.

; ---- master safety switches -------------------------------------------------
InpEnableTrading=false             ; MASTER SWITCH: set to true ONLY after DRY RUN verified
InpDryRun=true                     ; journal orders, never send (flip only after verified journal)
InpDemoOnly=true                   ; refuses any real-money account
InpRealAccountConfirm=             ; must equal account login to allow real money
InpResetBreakersAtInit=false       ; set true ONLY to clear a tripped breaker after review

InpPinTimeframeMinutes=0
; ---- core -------------------------------------------------------------------
InpMagic=20261027
InpIndicatorName=nadir2            ; NO surrounding quotes (v6.6.18 handshake path expects literal)
InpTradeComment=QSMC-AUTO

; ---- risk (per trade 0.10% ~ $5 on $5k; HARD ceiling 0.25% enforced in code)
InpLotMode=QSMC_LOT_RISK_PERCENT
InpRiskPercent=0.10
InpMaxRiskPercent=0.10
InpFixedLots=0.00

; ---- target selection & exits -----------------------------------------------
InpTPLevel=QSMC_TP_LEVEL1
InpBreakEvenAtR=1.00
InpPartialCloseAtR=1.50
InpPartialClosePercent=50.0
InpUseTPPips=false
InpPipPoints=0
InpTP1Pips=100
InpTP2Pips=200
InpTP3Pips=300
InpTP1ClosePercent=40.0
InpTP2ClosePercent=40.0
InpMoveSLToBEAtTP1=true
InpMoveSLToTP1AtTP2=true

; ---- trial circuit breakers -------------------------------------------------
InpMaxDailyLossPercent=0.50
IInpMaxDailyLossMoney=0.00
InpFixedLotsMaxRiskPercent=2.00
npMaxAccountDrawdownPct=3.00
InpStopAfterConsecLoss=2
InpMaxOpenPositions=1
InpMaxTradesPerDay=3

; ---- filters ----------------------------------------------------------------
InpMaxSpreadPoints=60
InpMaxSpreadFracOfStop=0.10
InpDeviationPoints=30
InpMaxDataAgeSeconds=30
InpMinRRAtFill=1.20
InpMinStopPoints=20
InpMaxStopPoints=5000
InpOrderRetryMax=3
InpMaxSignalAgeBars=2
InpCloseOnOpposite=false

; ---- session: London/NY overlap 10:00-18:00 server --------------------------
InpSessionStartHour=10
InpSessionEndHour=18
InpCooldownAfterLossMin=60

; ---- execution / diagnostics ------------------------------------------------
InpPollSeconds=2
InpVerbose=true
InpHeartbeatSeconds=300
InpHeartbeatLookback=200
